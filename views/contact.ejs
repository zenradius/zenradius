<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t('customer.pages.contact.meta_title', 'Kontak Support') %> | <%= company %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0b1117">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" type="image/png">
  <link rel="stylesheet" href="/css/unified.css">
  <style>
    :root {
      --portal-bg: #132734;
      --portal-panel: rgba(20, 34, 43, 0.94);
      --portal-panel-strong: rgba(25, 42, 52, 0.97);
      --portal-line: rgba(188, 216, 220, 0.16);
      --portal-line-strong: rgba(71, 195, 182, 0.34);
      --portal-primary: #44cbb8;
      --portal-secondary: #2ea0d3;
      --portal-text: #ecf6f6;
      --portal-muted: #a8bec2;
      --portal-accent: #fbbf24;
      --surface-unified: linear-gradient(145deg, rgba(68, 203, 184, 0.18) 0%, rgba(46, 160, 211, 0.16) 50%, rgba(49, 184, 168, 0.13) 100%);
      --card-surface: linear-gradient(145deg, rgba(26, 44, 55, 0.95), rgba(16, 30, 40, 0.92));
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Inter, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at 12% -8%, rgba(76, 187, 209, 0.14), transparent 34%),
        radial-gradient(circle at 90% 0%, rgba(68, 203, 184, 0.16), transparent 38%),
        linear-gradient(180deg, #173447 0%, var(--portal-bg) 100%);
      color: var(--portal-text);
      line-height: 1.7;
      min-height: 100vh;
      -webkit-tap-highlight-color: transparent;
    }

    .hero-section {
      position: relative;
      padding: 62px 0 50px;
      border-bottom: 1px solid var(--portal-line);
      background: var(--surface-unified);
      overflow: hidden;
    }

    .hero-section::before {
      content: "";
      position: absolute;
      left: -12%;
      top: -18%;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(68, 203, 184, 0.24), transparent 62%);
      filter: blur(22px);
      pointer-events: none;
    }

    .hero-section::after {
      content: "";
      position: absolute;
      right: -8%;
      top: 12%;
      width: 360px;
      height: 360px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(46, 160, 211, 0.2), transparent 60%);
      filter: blur(20px);
      pointer-events: none;
    }

    .section-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      margin-bottom: 18px;
      border-radius: 999px;
      background: rgba(45, 212, 191, 0.08);
      border: 1px solid rgba(45, 212, 191, 0.22);
      color: #dffef9;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      position: relative;
      z-index: 1;
    }

    h1 {
      position: relative;
      z-index: 1;
      margin: 0;
      font-size: clamp(2.15rem, 5vw, 3.25rem);
      letter-spacing: -0.04em;
      font-weight: 800;
      line-height: 1.08;
      color: #f8fbff;
    }

    .lead {
      position: relative;
      z-index: 1;
      margin: 14px auto 0;
      max-width: 740px;
      color: #d5e0ea;
      font-size: 1.04rem;
    }

    .container { max-width: 1120px; }

    .content-card {
      position: relative;
      z-index: 1;
      max-width: 980px;
      margin: -18px auto 46px;
      padding: 34px 28px 28px;
      border-radius: 24px;
      background: var(--card-surface);
      border: 1px solid var(--portal-line);
      box-shadow: 0 16px 34px rgba(3, 14, 20, 0.34);
      backdrop-filter: blur(14px);
    }

    .content-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(130deg, rgba(255,255,255,0.04), transparent 36%, transparent 70%, rgba(68, 203, 184, 0.06));
      pointer-events: none;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .contact-item {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      min-height: 100%;
      padding: 20px 18px;
      border-radius: 18px;
      border: 1px solid var(--portal-line);
      background: rgba(11, 17, 23, 0.7);
      text-decoration: none;
      color: inherit;
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .contact-item:hover {
      transform: translateY(-2px);
      border-color: rgba(45, 212, 191, 0.32);
      box-shadow: 0 18px 30px rgba(45, 212, 191, 0.08);
    }

    .contact-icon {
      width: 52px;
      height: 52px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      flex-shrink: 0;
      border: 1px solid rgba(255,255,255,0.04);
    }

    .contact-info h6 {
      margin: 0 0 6px;
      color: #f8fbff;
      font-weight: 700;
      font-size: 1rem;
    }

    .contact-info p {
      margin: 0;
      color: #d2dfe7;
      font-size: 0.95rem;
      line-height: 1.7;
    }

    .btn-back {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 28px;
      padding: 12px 22px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--portal-primary), var(--portal-secondary));
      color: #05252b;
      border: 1px solid rgba(45, 212, 191, 0.22);
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 14px 28px rgba(46, 160, 211, 0.22);
      transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
    }

    .btn-back:hover {
      transform: translateY(-3px);
      box-shadow: 0 20px 34px rgba(46, 160, 211, 0.26);
      filter: brightness(1.04);
      color: #05252b;
    }

    .footer {
      padding: 0 18px 28px;
      text-align: center;
      color: rgba(157, 175, 189, 0.9);
      font-size: 0.85rem;
    }

    @media (max-width: 767.98px) {
      .hero-section { padding-top: 54px; }
      .content-card { margin: 0 14px 38px; padding: 26px 18px 22px; }
      .contact-grid { grid-template-columns: 1fr; }
      .footer { padding-bottom: 24px; }
    }
  </style>
</head>

<body>
  <div class="hero-section text-center">
    <div class="container">
      <span class="section-kicker"><i class="bi bi-headset me-1"></i> Hubungi Kami</span>
      <h1><%= t('customer.pages.contact.title', 'Hubungi Kami') %></h1>
      <p class="lead"><%= t('customer.pages.contact.subtitle', 'Kami siap membantu setiap kendala internet Anda.') %></p>
    </div>
  </div>

  <div class="container">
    <div class="content-card">
      <p class="text-center mb-4" style="margin-bottom: 28px; color: #d2dfe7;">
        <%= t('customer.pages.contact.p1', 'Tim support kami tersedia untuk melayani pertanyaan teknis, bantuan pembayaran, atau informasi pemasangan baru.') %>
      </p>

      <% let waContact=settings.company_phone || (settings.whatsapp_admin_numbers ? settings.whatsapp_admin_numbers[0] : '');
         let waLink=waContact ? `https://wa.me/${waContact.replace(/\D/g, '')}` : '#'; %>

      <div class="contact-grid">
        <a href="<%= waLink %>" class="contact-item" target="_blank" rel="noopener">
          <div class="contact-icon" style="background: rgba(34, 197, 94, 0.12); color: #86efac; border-color: rgba(34,197,94,0.2);">
            <i class="bi bi-whatsapp"></i>
          </div>
          <div class="contact-info">
            <h6><%= t('customer.pages.contact.whatsapp_title', 'WhatsApp Support') %></h6>
            <p><%= waContact || t('customer.pages.contact.whatsapp_fallback', 'Hubungi WhatsApp Kami') %> (<%= t('customer.pages.contact.fast_response', 'Respon Cepat') %>)</p>
          </div>
        </a>

        <div class="contact-item">
          <div class="contact-icon" style="background: rgba(251, 191, 36, 0.12); color: #fcd34d; border-color: rgba(251,191,36,0.18);">
            <i class="bi bi-envelope"></i>
          </div>
          <div class="contact-info">
            <h6><%= t('customer.pages.contact.email_title', 'Email Support') %></h6>
            <p><%= settings.company_email || `support@${company.toLowerCase().replace(/\s+/g, '')}.com` %></p>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-icon" style="background: rgba(96, 165, 250, 0.12); color: #93c5fd; border-color: rgba(96,165,250,0.18);">
            <i class="bi bi-clock"></i>
          </div>
          <div class="contact-info">
            <h6><%= t('customer.pages.contact.hours_title', 'Jam Operasional') %></h6>
            <p><%= settings.operational_hours || 'Setiap Hari: 08.00 - 22.00 WIB' %></p>
          </div>
        </div>

        <div class="contact-item">
          <div class="contact-icon" style="background: rgba(168, 85, 247, 0.12); color: #d8b4fe; border-color: rgba(168,85,247,0.18);">
            <i class="bi bi-geo-alt"></i>
          </div>
          <div class="contact-info">
            <h6><%= t('customer.pages.contact.address_title', 'Alamat Kantor') %></h6>
            <p><%= settings.company_address || 'Alamat kantor belum ditambahkan di pengaturan.' %></p>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a href="<%= isLoggedIn ? '/customer/dashboard' : '/customer/login' %>" class="btn-back">
          <i class="bi bi-arrow-left me-2"></i><%= t('common.back_to', 'Kembali ke') %> <%= isLoggedIn ? t('customer.dashboard_title', 'Dashboard Pelanggan') : t('common.portal', 'Portal') %>
        </a>
      </div>
    </div>
  </div>

  <div class="footer">
    &copy; <%= new Date().getFullYear() %> <%- footerInfo %>
  </div>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).catch(() => {});
      });
    }
  </script>
  <%- include('partials/customer_bottom_nav', { activeNav: 'none' }) %>
</body>
</html>
