<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
  <meta name="theme-color" content="#173945">
  <title>Reset Password | <%= settings.company_header || 'ZenRadius' %></title>
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" type="image/png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{height:100%}
    body{
      font-family:'DM Sans',system-ui,sans-serif;
      background:#173945;
      background-image:radial-gradient(circle at 8% 0%,#236060 0%,transparent 34%),radial-gradient(circle at 100% 100%,#173e4d 0%,transparent 42%),linear-gradient(135deg,#173740 0%,#183f51 52%,#194251 100%);
      display:flex;align-items:center;justify-content:center;
      min-height:100vh;min-height:100dvh;padding:24px;color:#edf7f5;
    }
    .wrap{width:100%;max-width:420px;display:flex;flex-direction:column;align-items:center}
    .card{
      width:100%;background:#173945;border:1px solid rgba(190,239,255,.28);
      border-radius:16px;padding:38px 32px 28px;box-shadow:0 20px 48px rgba(3,14,20,.45);
      display:flex;flex-direction:column;align-items:center;
    }
    .logo{width:min(220px,72%);height:auto;object-fit:contain;display:block;margin:0 auto 16px}
    .sub{font-size:13px;color:rgba(237,250,250,.72);font-weight:600;letter-spacing:.02em;margin-bottom:6px;text-align:center}
    .copy{font-size:12px;color:rgba(237,250,250,.58);text-align:center;line-height:1.6;max-width:300px;margin:0 auto 26px}
    .alert{width:100%;border-radius:10px;font-size:13px;padding:11px 12px;display:flex;align-items:center;gap:10px;margin-bottom:14px}
    .alert-danger{background:rgba(248,81,73,.1);color:#ff7b72;border:1px solid rgba(248,81,73,.22)}
    .alert-success{background:rgba(74,222,128,.1);color:#86efac;border:1px solid rgba(74,222,128,.22)}
    .alert-info{background:rgba(96,165,250,.1);color:#93c5fd;border:1px solid rgba(96,165,250,.22)}
    form{width:100%;max-width:320px;display:flex;flex-direction:column;align-items:stretch}
    .fg{margin-bottom:16px;width:100%}
    .fg:last-of-type{margin-bottom:22px}
    .fl{font-size:11px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#d9fffb;margin-bottom:7px;display:block;text-align:left}
    .field{position:relative;width:100%}
    .field i{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:rgba(190,239,255,.7);font-size:15px;pointer-events:none}
    .fc{
      width:100%;padding:12px 14px 12px 40px;font-size:14px;color:#f0fdfa;
      background:rgba(255,255,255,.06);border:1px solid rgba(190,239,255,.22);border-radius:10px;outline:none;transition:border-color .2s,box-shadow .2s,background .2s;
    }
    .fc::placeholder{color:rgba(237,250,250,.38)}
    .fc:focus{background:rgba(255,255,255,.09);border-color:rgba(45,212,191,.55);box-shadow:0 0 0 3px rgba(45,212,191,.14);color:#fff}
    .btn-p{
      align-self:center;min-width:160px;max-width:220px;padding:10px 22px;font-size:13px;font-weight:800;
      color:#f4fffd;background:linear-gradient(135deg,#236060 0%,#183f51 52%,#194251 100%);border:1px solid rgba(126,231,219,.48);border-radius:10px;box-shadow:0 8px 20px rgba(10,41,50,.24);
      display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:all .25s;
    }
    .btn-p:hover{background:linear-gradient(135deg,#2d7774 0%,#1d5264 52%,#205b68 100%)!important;border-color:rgba(166,247,235,.72)!important;color:#fff!important;filter:brightness(1.04);transform:translateY(-1px)}
    .btn-p:disabled{opacity:0.6;cursor:not-allowed;transform:none}
    .links{width:100%;max-width:320px;display:flex;justify-content:center;gap:12px;margin-top:14px;font-size:12px;flex-direction:column;align-items:center}
    .links a{color:#7dd3fc;font-weight:700;text-decoration:none}.links a:hover{text-decoration:underline}
    .info-text{width:100%;max-width:320px;font-size:11px;color:rgba(237,250,250,.68);line-height:1.5;background:rgba(96,165,250,.08);border:1px solid rgba(96,165,250,.22);border-radius:8px;padding:12px;margin-bottom:18px;text-align:center}
    .foot{margin-top:16px;padding-top:14px;border-top:1px solid rgba(190,239,255,.12);font-size:11px;color:rgba(237,250,250,.48);text-align:center;width:100%}
    .foot a{color:#7dd3fc;text-decoration:none;font-weight:700}.foot-links{font-size:11px;display:flex;justify-content:center;flex-wrap:wrap;gap:12px;margin:10px 0}
    .foot-links a{font-weight:400;color:rgba(237,250,250,.62)}
    .password-field-wrapper { position: relative; }
    .password-field-wrapper .eye-toggle {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      border: none;
      background: transparent;
      color: rgba(190, 239, 255, 0.7);
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      z-index: 2;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .password-field-wrapper .eye-toggle:hover {
      background: rgba(45, 212, 191, 0.08);
      color: #d9fffb;
    }
    .password-field-wrapper .form-control.with-eye { padding-right: 40px; }
    small{display:block;margin-top:4px}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <img class="logo" src="/img/logo.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" alt="<%= settings.company_header || 'ZenRadius' %>" onerror="this.src='/img/icon.png'">
      <p class="sub">Reset Kata Sandi</p>
      <p class="copy">Masukkan nomor WhatsApp terdaftar untuk menerima password baru melalui WhatsApp.</p>
      
      <% if (error) { %><div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-circle"></i> <%= error %></div><% } %>
      <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success" role="status"><i class="bi bi-check-circle"></i> <%= success %></div><% } %>
      
      <div class="info-text">
        <i class="bi bi-info-circle"></i> Password baru akan dikirim langsung ke nomor WhatsApp Anda. Gunakan password tersebut untuk login.
      </div>
      
      <form method="post" action="/customer/forgot-password" id="reset-form" onsubmit="return validateResetForm(event)">
        <div class="fg">
          <label class="fl" for="reset-phone">Nomor WhatsApp</label>
          <div class="field"><i class="bi bi-telephone"></i><input class="fc" id="reset-phone" name="phone" type="tel" autocomplete="tel" placeholder="Contoh: 081234567890" required></div>
          <small id="phone-error" style="color:#ff7b72;font-size:11px;display:none"></small>
        </div>
        <button class="btn-p" type="submit" id="reset-btn"><i class="bi bi-key"></i> Kirim Password Baru</button>
      </form>
      
      <div class="links">
        <a href="/customer/login">? Kembali ke Login</a>
      </div>
      
      <div class="foot">
        <div>&copy; <%= new Date().getFullYear() %> <%- footerInfo %></div>
      </div>
    </div>
  </div>

  <script>
    function validateResetForm(e) {
      e.preventDefault();
      
      const phone = document.getElementById('reset-phone').value.trim();
      const phoneError = document.getElementById('phone-error');
      const resetBtn = document.getElementById('reset-btn');
      
      // Reset error
      phoneError.style.display = 'none';
      
      let isValid = true;
      
      // Validate phone
      if (!phone) {
        phoneError.textContent = 'Nomor WhatsApp wajib diisi.';
        phoneError.style.display = 'block';
        isValid = false;
      } else if (!/^[0-9]{10,15}$/.test(phone.replace(/\D/g, ''))) {
        phoneError.textContent = 'Nomor WhatsApp harus berisi 10-15 digit angka.';
        phoneError.style.display = 'block';
        isValid = false;
      }
      
      if (isValid) {
        resetBtn.disabled = true;
        resetBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Mengirim...';
        document.getElementById('reset-form').submit();
      }
      
      return false;
    }

    document.querySelectorAll('.eye-toggle').forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.getAttribute('data-target');
        const input = document.getElementById(targetId);
        if (!input) return;

        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        const icon = button.querySelector('i');
        if (icon) {
          icon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
        }
      });
    });
  </script>
</body>
</html>
