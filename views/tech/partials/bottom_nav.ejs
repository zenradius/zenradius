  </div> <!-- End container -->

  <nav class="bottom-nav">
    <% (techBottomNav || []).forEach((item) => { %>
      <a href="<%= item.href %>" class="nav-item <%= (item.activePages || []).includes(activePage) ? 'active' : '' %>">
        <i class="<%= item.icon %>"></i>
        <span><%= item.labelKey ? t(item.labelKey, item.labelDefault) : item.labelDefault %></span>
      </a>
    <% }) %>
  </nav>

  <script>
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js', { scope: '/tech/' }).catch(() => {});

    setTimeout(() => {
      document.querySelectorAll('.alert').forEach(a => {
        const bsAlert = new bootstrap.Alert(a);
        bsAlert.close();
      });
    }, 4000);
  </script>
</body>
</html>
