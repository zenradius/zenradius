<!DOCTYPE html>
<html lang="<%= lang || 'id' %>" data-app-theme="<%= typeof appTheme !== 'undefined' ? appTheme : 'current' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pembayaran QRIS | <%= settings.company_header || 'ZenRadius - Pusat Layanan' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" type="image/png">
  <link rel="stylesheet" href="/css/unified.css">
  <link rel="stylesheet" href="/css/theme-tokens.css">
  <style>
    :root {
      /* Matches landing page (views/login.ejs) / public_voucher.ejs portal theme exactly */
      --font-sans: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif;
      --font-display: 'Space Grotesk', 'Plus Jakarta Sans', system-ui, sans-serif;
      --portal-bg: var(--bg, #101820);
      --portal-panel: var(--bg2, rgba(17, 29, 36, 0.94));
      --portal-panel-strong: var(--bg3, rgba(12, 23, 30, 0.98));
      --portal-line: var(--border, rgba(124, 221, 218, 0.18));
      --portal-primary: var(--primary, #2dd4bf);
      --portal-primary-strong: var(--accent, #22a7f0);
      --portal-accent: var(--warning, #fbbf24);
      --portal-text: var(--text, #edf7f5);
      --portal-muted: var(--muted, #a8bec2);
      --landing-bg: var(--body-bg-image, radial-gradient(circle at 8% 0%, #236060 0%, transparent 34%),
            radial-gradient(circle at 100% 100%, #173e4d 0%, transparent 42%),
            linear-gradient(135deg, #173740 0%, #183f51 52%, #194251 100%));
      /* Admin panel palette â€” dipakai untuk menyelaraskan halaman QRIS dengan pop-up Detail Pesanan Voucher di admin */
      --admin-bg2: var(--bg2, #173945);
      --admin-bg3: var(--bg3, #1b4656);
      --admin-border: var(--border, rgba(190,239,255,0.22));
      --admin-primary: var(--primary, #22D3EE);
      --admin-pdim: var(--pdim, color-mix(in srgb, var(--primary) 14%, transparent));
      --admin-btn-bg: var(--btn-bg, linear-gradient(135deg,#236060 0%,#183f51 52%,#194251 100%));
      --admin-btn-color: var(--btn-color, #f4fffd);
      --admin-btn-border: var(--btn-border, rgba(126,231,219,.48));
      --admin-btn-shadow: var(--btn-shadow, 0 8px 20px rgba(10,41,50,.24));
      --admin-btn-g-bg: var(--btn-g-bg, rgba(190,239,255,.08));
      --admin-btn-g-border: var(--btn-g-border, rgba(190,239,255,.22));
    }
    @keyframes softGlow {
      0%, 100% { box-shadow: 0 0 0 rgba(45, 212, 191, 0.06), 0 8px 18px rgba(23, 57, 69, 0.14); }
      50% { box-shadow: 0 0 0 2px rgba(45, 212, 191, 0.10), 0 12px 22px rgba(45, 212, 191, 0.12); }
    }
    body{
      background: var(--body-bg-solid, var(--admin-bg2));
      background-image: var(--body-bg-image, none);
      color: var(--portal-text);
      font-family: var(--font-sans);
      -webkit-tap-highlight-color: transparent;
    }
    .wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:18px}
    .cardx{background: linear-gradient(180deg, color-mix(in srgb, var(--portal-surface, var(--admin-bg2)) 92%, transparent) 0%, color-mix(in srgb, var(--portal-surface-raised, var(--admin-bg3)) 96%, transparent) 100%);backdrop-filter: blur(12px);border: 1px solid color-mix(in srgb, var(--portal-line, var(--admin-border)) 86%, transparent);border-radius: 22px;box-shadow: 0 18px 42px rgba(2, 10, 14, 0.34);overflow:hidden;max-width: 820px;width:100%;position:relative}
    .cardx::before { content:""; position:absolute; inset:0 auto auto 0; width:100%; height:140%; background: linear-gradient(135deg, rgba(255,255,255,0.04), transparent 40%, rgba(148,163,184,0.04)); pointer-events:none; }
    .head{background:linear-gradient(180deg, color-mix(in srgb, var(--portal-surface-raised, var(--admin-bg3)) 94%, transparent), color-mix(in srgb, var(--portal-surface, var(--admin-bg2)) 96%, transparent));padding:22px 20px;border-bottom:1px solid color-mix(in srgb, var(--portal-line, var(--admin-border)) 86%, transparent)}
    .body{padding:22px 20px}
    .muted{color: var(--portal-muted)}
    .btnx{border-radius:12px;font-weight:700;font-family: var(--font-display);transition: transform .18s ease, box-shadow .18s ease, filter .18s ease; min-height:46px; padding:10px 16px; line-height:1.2;}
    .btnx:hover{transform: translateY(-2px); filter: brightness(1.03);}
    .btn-primary{background:var(--admin-btn-bg);color:var(--admin-btn-color);border:1px solid var(--admin-btn-border);box-shadow:var(--admin-btn-shadow)}
    .btn-primary:hover{filter:brightness(1.12)!important;color:var(--admin-btn-color)!important}
    .btn-outline-light{border:1px solid var(--admin-btn-g-border);color:var(--portal-text);background:var(--admin-btn-g-bg)}
    .btn-outline-light:hover{background:rgba(190,239,255,.14);border-color:rgba(190,239,255,.34);color:#fff}
    a{color:#a5f4ed}
    .qris-box{background: linear-gradient(180deg, color-mix(in srgb, var(--portal-surface-raised, var(--admin-bg3)) 92%, transparent), color-mix(in srgb, var(--portal-surface, var(--admin-bg2)) 96%, transparent));border: 1px solid color-mix(in srgb, var(--portal-line, var(--admin-border)) 86%, transparent);border-radius: 20px;padding:18px;box-shadow:0 8px 22px rgba(0,0,0,.12)}
    .qrimg{width:100%;max-width:360px;border-radius:20px;background:color-mix(in srgb, var(--portal-surface, #fff) 8%, #fff);padding:14px;box-shadow:0 16px 36px rgba(2,10,14,.45)}
    .mono{font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace}
    .pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:800;border:1px solid var(--admin-border)}
    .pill-u{background: color-mix(in srgb, var(--soft-primary, var(--admin-pdim)) 86%, transparent);color:var(--portal-primary, #a5f4ed);border-color: color-mix(in srgb, var(--portal-line, color-mix(in srgb, var(--primary) .2800%, transparent)) 86%, transparent)}
    .form-control{
      background: color-mix(in srgb, var(--portal-surface, #fff) 10%, transparent);
      border: 1px solid color-mix(in srgb, var(--portal-line, var(--admin-border)) 86%, transparent);
      color: var(--portal-text);
      border-radius: 10px;
    }
    .form-control::placeholder{ color: color-mix(in srgb, var(--portal-muted, rgba(237, 250, 250, 0.38)) 92%, transparent); }
    .form-control:focus{
      background: color-mix(in srgb, var(--portal-surface, #fff) 14%, transparent);
      border-color: var(--portal-primary);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--soft-primary, rgba(45, 212, 191, 0.14)) 88%, transparent);
      color: #fff;
    }
    .amount-chip{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border-radius:999px;background:color-mix(in srgb, var(--soft-primary, rgba(190,239,255,.08)) 84%, transparent);border:1px solid color-mix(in srgb, var(--portal-line, rgba(190,239,255,.16)) 86%, transparent);font-weight:800}
    .summary-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .summary-item{background:color-mix(in srgb, var(--portal-surface, #1b4656) 68%, transparent);border:1px solid color-mix(in srgb, var(--portal-line, rgba(190,239,255,.1)) 86%, transparent);border-radius:16px;padding:12px 14px}
    .summary-item .label{font-size:12px;color:var(--portal-muted, rgba(190,239,255,.7));margin-bottom:4px}
    .summary-item .value{font-weight:800;word-break:break-word}
    .actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:center}
    .muted-note{max-width:520px;margin:0 auto}
    .qr-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.95fr);gap:14px;align-items:stretch;margin-bottom:14px}
    .qr-hero .hero-copy{background:linear-gradient(180deg, color-mix(in srgb, var(--portal-surface, var(--admin-bg2)) 88%, transparent), color-mix(in srgb, var(--portal-surface-raised, var(--admin-bg3)) 96%, transparent));border:1px solid color-mix(in srgb, var(--portal-line, var(--admin-border)) 86%, transparent);border-radius:18px;padding:18px}
    .qr-hero .hero-copy .headline{font-size:16px;font-weight:800;color:var(--portal-ink, #f8fafc)}
    .qr-hero .hero-copy .subline{font-size:14px;line-height:1.6;color:color-mix(in srgb, var(--portal-ink, rgba(237,247,245,.82)) 88%, transparent)}
    .qr-hero .hero-copy .chip-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}
    .qr-hero .hero-copy .chip-row .pill{background:color-mix(in srgb, var(--soft-primary, color-mix(in srgb, var(--primary) .1200%, transparent)) 82%, transparent);border-color:color-mix(in srgb, var(--portal-line, color-mix(in srgb, var(--primary) .1800%, transparent)) 86%, transparent);color:var(--portal-primary, #a5f4ed)}
    .qr-hero .qr-stage{background:linear-gradient(180deg, color-mix(in srgb, var(--portal-surface-raised, var(--admin-bg3)) 92%, transparent), color-mix(in srgb, var(--portal-surface, var(--admin-bg2)) 96%, transparent));border:1px solid color-mix(in srgb, var(--portal-line, var(--admin-border)) 86%, transparent);border-radius:20px;padding:18px;display:flex;align-items:center;justify-content:center}
    .qr-hero .qr-stage .qrimg{box-shadow:0 18px 38px rgba(2,10,14,.46)}
    .action-row{display:flex;justify-content:center;flex-wrap:wrap;gap:10px}
    .action-row .btnx{min-width:150px}
    @media(max-width:576px){
      .summary-grid{grid-template-columns:1fr}
      .amount-chip{font-size:13px}
    }
    @media(max-width:860px){
      .qr-hero{grid-template-columns:1fr}
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="cardx">
      <div class="head">
        <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
          <div>
            <div class="fw-bold" style="font-size:18px;font-family:var(--font-display)"><i class="bi bi-qr-code-scan me-2" style="color:var(--portal-primary, #2dd4bf)"></i>Pembayaran QRIS</div>
            <div class="muted small"><%= settings.company_header || 'ZenRadius - Pusat Layanan' %></div>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <% if (typeof changeMethodUrl !== 'undefined' && changeMethodUrl) { %>
              <a class="btn btn-outline-light btn-sm btnx" href="<%= changeMethodUrl %>">
                <i class="bi bi-arrow-repeat me-1"></i> Ubah Metode
              </a>
            <% } %>
            <% if (typeof cancelUrl !== 'undefined' && cancelUrl) { %>
              <form method="POST" action="<%= cancelUrl %>" onsubmit="return confirm('Batalkan transaksi pembayaran ini?');" style="display:inline">
                <button type="submit" class="btn btn-outline-light btn-sm btnx" style="color:#fca5a5;border-color:color-mix(in srgb, #ef4444 40%, transparent)">
                  <i class="bi bi-x-circle me-1"></i> Batalkan
                </button>
              </form>
            <% } %>
            <% if (backUrl) { %>
              <a class="btn btn-outline-light btn-sm btnx" href="<%= backUrl %>">
                <i class="bi bi-arrow-left me-1"></i> Kembali
              </a>
            <% } %>
          </div>
        </div>
      </div>
      <div class="body">
        <% if (error) { %>
          <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
          </div>
        <% } else { %>
          <% if (info) { %>
            <div class="alert alert-success">
              <i class="bi bi-check-circle me-2"></i><%= info %>
            </div>
          <% } %>
          <%
            const kindSafe = String(kind || 'invoice').toLowerCase();
            const isVoucher = kindSafe === 'voucher';
            const refPrefix = isVoucher ? 'VOUCHER' : 'INV';
            const refId = String(reference || invoiceId || '');
            const channelLabel = String((details && (details.paymentName || details.via || details.channel)) || method || gateway || 'QRIS').trim();
            const expiredLabel = String((details && details.expired) || '').trim();
          %>
          <div class="mb-3">
            <div class="fw-bold" style="font-size:18px"><%= customerName || (isVoucher ? 'Pembeli Voucher' : 'Pelanggan') %></div>
            <div class="muted small">
              <%= refPrefix %>-<%= refId %>
              <% if (periodText) { %> â€¢ <%= periodText %><% } %>
            </div>
          </div>

          <div class="qris-box">
            <div class="qr-hero">
              <div class="hero-copy">
                <div class="headline mb-2"><i class="bi bi-qr-code-scan me-1"></i>Scan QR untuk Membayar</div>
                <div class="subline mb-3">Gunakan aplikasi perbankan atau dompet digital yang mendukung QRIS. Pastikan nominal pembayaran sesuai.</div>
                  <div class="chip-row">
                  <span class="pill pill-u"><i class="bi bi-cash-stack"></i> Rp <%= Number(amount || 0).toLocaleString('id-ID') %></span>
                  <% if (channelLabel) { %>
                    <span class="pill pill-u"><i class="bi bi-qr-code-scan"></i> <%= channelLabel %></span>
                  <% } %>
                  <% if (expiredLabel) { %>
                    <span class="pill pill-u"><i class="bi bi-clock"></i> Berlaku s/d <%= expiredLabel %></span>
                  <% } else { %>
                    <span class="pill pill-u"><i class="bi bi-clock"></i> Menunggu pembayaran</span>
                  <% } %>
                </div>
                <div class="summary-grid mt-3 text-start">
                  <div class="summary-item">
                    <div class="label">Status</div>
                    <div class="value">Siap dipindai</div>
                  </div>
                  <div class="summary-item">
                    <div class="label">Total Pembayaran</div>
                    <div class="value">Rp <%= Number(amount || 0).toLocaleString('id-ID') %></div>
                  </div>
                </div>
                <div class="action-row mt-3">
                  <button class="btn btn-outline-light btn-sm btnx" type="button" id="copyAmountBtn">
                    <i class="bi bi-clipboard me-1"></i> Salin Nominal
                  </button>
                  <% if (qrImageUrl) { %>
                    <button class="btn btn-outline-light btn-sm btnx" type="button" id="downloadQrBtn">
                      <i class="bi bi-download me-1"></i> Download QRIS
                    </button>
                  <% } %>
                </div>
              </div>

              <div class="qr-stage">
                <% if (qrImageUrl) { %>
                  <img class="qrimg" src="<%= qrImageUrl %>" alt="QRIS">
                <% } else if (paymentUrl) { %>
                  <div class="alert alert-warning mb-0 w-100 text-center">
                    QR belum tersedia. <a href="<%= paymentUrl %>" target="_blank" rel="noopener">Buka halaman pembayaran</a>
                  </div>
                <% } else { %>
                  <div class="alert alert-warning mb-0 w-100">
                    QRIS belum tersedia dari gateway pembayaran.
                  </div>
                <% } %>
              </div>
            </div>
            <div class="muted small muted-note mt-3 text-center">
              Status pembayaran diperbarui otomatis setelah transaksi terverifikasi.
              <br><i class="bi bi-check2-circle me-1"></i>Tidak perlu mengirim bukti pembayaran â€” transaksi diverifikasi otomatis oleh sistem.
            </div>
          </div>

          <% if (helpText) { %>
            <div class="alert alert-info mt-3 mb-0">
              <i class="bi bi-info-circle me-2"></i><%= helpText %>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    /* eslint-disable */
    (function () {
      var amount = <%= Number(amount || 0) || 0 %>;
      var qrSrc = <%- JSON.stringify(String(qrImageUrl || '')) %>;
      var kindSafe = <%- JSON.stringify(String(kind || 'invoice').toLowerCase()) %>;
      var refPrefix = kindSafe === 'voucher' ? 'VOUCHER' : 'INV';
      var refId = <%- JSON.stringify(String(reference || invoiceId || '')) %>;
      var copy = async function (text) {
        try {
          if (navigator && navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(String(text));
            return true;
          }
        } catch (e) {
          // Clipboard API not available
        }
        try {
          const ta = document.createElement('textarea');
          ta.value = String(text);
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.focus();
          ta.select();
          const ok = document.execCommand('copy');
          document.body.removeChild(ta);
          return ok;
        } catch (e) {
          return false;
        }
      };

      var aBtn = document.getElementById('copyAmountBtn');
      if (aBtn) aBtn.addEventListener('click', async function () {
        if (!amount) return;
        await copy(amount);
      });

      var dBtn = document.getElementById('downloadQrBtn');
      if (dBtn) dBtn.addEventListener('click', async function () {
        if (!qrSrc) return;
        var fileName = 'QRIS-' + refPrefix + '-' + String(refId).replace(/[^a-zA-Z0-9_-]/g, '') + '.png';
        try {
          if (qrSrc.startsWith('data:image/')) {
            var a = document.createElement('a');
            a.href = qrSrc;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            a.remove();
            return;
          }
          var res = await fetch(qrSrc, { credentials: 'same-origin' });
          if (!res.ok) throw new Error('Fetch failed');
          var blob = await res.blob();
          var url = URL.createObjectURL(blob);
          var a = document.createElement('a');
          a.href = url;
          a.download = fileName;
          document.body.appendChild(a);
          a.click();
          a.remove();
          setTimeout(() => {
            try { URL.revokeObjectURL(url); } catch (e) { /* ignore */ }
          }, 1200);
        } catch (e) {
          try { window.open(qrSrc, '_blank', 'noopener'); } catch (e2) { /* ignore */ }
        }
      });

      // Auto-polling untuk cek status pembayaran (hanya untuk invoice & voucher)
      var supportsPolling = kindSafe === 'voucher' || kindSafe === 'invoice';
      var pollInterval = 5000; // 5 detik
      var maxPolls = 120; // Max 10 menit (120 x 5 detik)
      var pollCount = 0;

      var checkPaymentStatus = async function () {
        if (pollCount >= maxPolls) {
          console.log('Polling stopped: max attempts reached');
          return;
        }
        pollCount++;

        try {
          var token = <%- JSON.stringify(String(publicToken || '')) %>;
          var url = kindSafe === 'voucher'
            ? '/pelanggan/voucher/status/' + refId + '?t=' + encodeURIComponent(token)
            : '/pelanggan/payment/status/' + refId + '?t=' + encodeURIComponent(token);

          var res = await fetch(url, {
            method: 'GET',
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json' }
          });
          
          if (!res.ok) {
            throw new Error('Status check failed');
          }

          var data = await res.json();

          // Jika status sudah fulfilled/paid, redirect ke halaman status
          if (data.status === 'fulfilled' || data.status === 'paid') {
            var backUrl = <%- JSON.stringify(String(backUrl || '')) %>;
            if (backUrl) {
              window.location.href = backUrl;
            } else {
              var redirectUrl = kindSafe === 'voucher'
                ? '/pelanggan/voucher?order=' + refId + '&t=' + encodeURIComponent(token)
                : '/pelanggan/billing?invoice=' + refId;
              window.location.href = redirectUrl;
            }
            return;
          }

          // Lanjutkan polling jika masih pending
          setTimeout(checkPaymentStatus, pollInterval);
        } catch (err) {
          console.error('Payment status check error:', err);
          // Retry meskipun error
          setTimeout(checkPaymentStatus, pollInterval);
        }
      };

      // Mulai polling setelah 3 detik (beri waktu user lihat QR dulu)
      if (supportsPolling) {
        setTimeout(checkPaymentStatus, 3000);
      }
    })();
    /* eslint-enable */
  </script>
</body>
</html>
