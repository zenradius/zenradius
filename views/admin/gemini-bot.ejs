<!DOCTYPE html>
<html lang="<%= lang || 'id' %>" data-app-theme="<%= typeof appTheme !== 'undefined' ? appTheme : 'current' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Gemini Bot | <%= company %></title>
  <meta name="theme-color" content="<%= (typeof appTheme !== 'undefined' && appTheme === 'space') ? '#0B1028' : (typeof appTheme !== 'undefined' && appTheme === 'orbit') ? '#F2F5FA' : '#0f172a' %>">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" type="image/png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/theme-tokens.css">
</head>
<body>
<%- include('partials/sidebar', { activePage: 'gemini_bot', company }) %>
<div class="mw">
<%- include('partials/licenseGraceBar') %>
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-robot"></i> Gemini Bot</div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i> <%= t('common.logout', 'Logout') %></a>
    </div>
  </div>
  <div class="page">

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type==='success'?'s':'d' %>">
      <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

    <div class="card mb16">
      <div class="card-hd">
        <h6><i class="bi bi-robot"></i> <%= t('admin.gemini.status_title', 'Status Gemini Bot') %></h6>
        <span class="badge <%= settings.gemini_enabled ? 'bs' : 'bd' %>"><%= settings.gemini_enabled ? t('common.active', 'Aktif') : t('common.inactive', 'Nonaktif') %></span>
      </div>
      <div class="card-bd">
        <p style="margin:0 0 10px;color:var(--muted);font-size:13px">
          <%= t('admin.gemini.status_hint', 'Asisten AI Gemini dipakai oleh bot WhatsApp dan Telegram untuk memahami bahasa natural dan menjalankan perintah otomatis (function calling).') %>
        </p>
        <div style="display:flex;gap:20px;flex-wrap:wrap;font-size:13px">
          <span><i class="bi bi-key"></i> <%= t('admin.gemini.api_key_label', 'API Key') %>:
            <b><%= settings.gemini_api_key ? t('admin.gemini.key_set', 'Sudah diisi') : t('admin.gemini.key_empty', 'Belum diisi') %></b>
          </span>
          <span><i class="bi bi-cpu"></i> <%= t('admin.gemini.model_label', 'Model') %>: <b class="mono"><%= settings.gemini_model || 'gemini-3.5-flash' %></b></span>
        </div>
      </div>
    </div>

    <form method="POST" action="/admin/settings">
      <input type="hidden" name="_redirect" value="/admin/gemini-bot">

      <div class="card mb16">
        <div class="card-hd"><h6><i class="bi bi-sliders"></i> <%= t('admin.gemini.settings_title', 'Pengaturan Gemini AI') %></h6></div>
        <div class="card-bd">
          <div class="form-row mb16">
            <div class="fg">
              <label class="fl">Enable AI Gemini</label>
              <select class="fs" name="gemini_enabled">
                <option value="true" <%= settings.gemini_enabled ? 'selected' : '' %>><%= t('common.active', 'Aktif') %></option>
                <option value="false" <%= !settings.gemini_enabled ? 'selected' : '' %>><%= t('common.inactive', 'Nonaktif') %></option>
              </select>
              <div style="font-size:10px;color:var(--muted);margin-top:4px">Aktifkan agar bot dapat memahami bahasa natural dan menjalankan perintah otomatis via AI.</div>
            </div>
            <div class="fg">
              <label class="fl">API Key Gemini</label>
              <input class="fc" type="password" name="gemini_api_key" value="<%= settings.gemini_api_key || '' %>" placeholder="AIza...">
              <div style="font-size:10px;color:var(--muted);margin-top:4px">Dapatkan gratis dari <a href="https://aistudio.google.com/app/apikey" target="_blank" style="color:var(--brand);font-weight:600">Google AI Studio</a>.</div>
            </div>
          </div>
          <div class="form-row mb16">
            <div class="fg">
              <label class="fl">Model Gemini</label>
              <input class="fc" name="gemini_model" value="<%= settings.gemini_model || 'gemini-3.5-flash' %>" placeholder="gemini-3.5-flash">
              <div style="font-size:10px;color:var(--muted);margin-top:4px">Model utama. Jika tidak tersedia, sistem otomatis mencoba model cadangan (3.5-flash-lite, 2.5-flash, 2.0-flash).</div>
            </div>
            <div class="fg">
              <label class="fl">Asisten AI Admin (WhatsApp)</label>
              <select class="fs" name="whatsapp_ai_enabled">
                <option value="true" <%= settings.whatsapp_ai_enabled !== false ? 'selected' : '' %>><%= t('common.active', 'Aktif') %></option>
                <option value="false" <%= settings.whatsapp_ai_enabled === false ? 'selected' : '' %>><%= t('common.inactive', 'Nonaktif') %></option>
              </select>
              <div style="font-size:10px;color:var(--muted);margin-top:4px">Izinkan admin chat bebas ke bot WhatsApp (mis. "isolir pelanggan Budi") yang dieksekusi AI via function calling.</div>
            </div>
          </div>
          <div class="fg">
            <label class="fl">Asisten AI Telegram</label>
            <select class="fs" name="telegram_ai_enabled">
              <option value="true" <%= settings.telegram_ai_enabled !== false ? 'selected' : '' %>><%= t('common.active', 'Aktif') %></option>
              <option value="false" <%= settings.telegram_ai_enabled === false ? 'selected' : '' %>><%= t('common.inactive', 'Nonaktif') %></option>
            </select>
            <div style="font-size:10px;color:var(--muted);margin-top:4px">Aktifkan <span class="mono">/tanya</span>, mention bot di grup, serta chat bebas admin pada bot Telegram.</div>
          </div>
        </div>
        <div class="card-bd" style="border-top:1px solid var(--border);padding-top:20px;text-align:right">
          <button type="submit" class="btn btn-p"><i class="bi bi-save"></i> <%= t('admin.gemini.save', 'Simpan Pengaturan') %></button>
        </div>
      </div>
    </form>

    <div class="card mb16">
      <div class="card-hd"><h6><i class="bi bi-plug"></i> <%= t('admin.gemini.test_title', 'Uji Koneksi') %></h6></div>
      <div class="card-bd">
        <p style="margin:0 0 12px;color:var(--muted);font-size:13px">
          <%= t('admin.gemini.test_hint', 'Uji apakah API Key Gemini valid dan bisa terhubung ke model yang dipilih.') %>
        </p>
        <form method="POST" action="/admin/whatsapp/test-gemini">
          <button type="submit" class="btn btn-p"><i class="bi bi-robot"></i> Test Koneksi Gemini</button>
        </form>
      </div>
    </div>

    <div class="card mb16">
      <div class="card-hd"><h6><i class="bi bi-info-circle"></i> Panduan Singkat</h6></div>
      <div class="card-bd">
        <ol style="margin:0;padding-left:18px;color:var(--muted);font-size:13px;line-height:2">
          <li>Buka <a href="https://aistudio.google.com/app/apikey" target="_blank" style="color:var(--brand);font-weight:600">Google AI Studio</a> lalu buat API Key.</li>
          <li>Tempel API Key pada kolom di atas, dan biarkan model default <span class="mono">gemini-3.5-flash</span> bila tidak yakin.</li>
          <li>Set <b>Enable AI Gemini</b> ke <b>Aktif</b>, lalu klik <b>Simpan Pengaturan</b>.</li>
          <li>Klik <b>Test Koneksi Gemini</b> untuk memastikan API Key valid.</li>
          <li>Asisten AI langsung tersedia di bot WhatsApp dan Telegram sesuai pilihan di atas.</li>
        </ol>
      </div>
    </div>
  </div>
</div>
</body>
</html>
