            <div class="fg" style="margin-top:10px">
              <label class="fl">QRIS Static Payload (String)</label>
              <textarea class="fc" name="qris_static_payload" rows="3" placeholder="000201010211...6304XXXX"><%= settings.qris_static_payload || '' %></textarea>
              <div style="font-size:10px; color:var(--muted); margin-top:4px">Jika diisi, sistem akan membuat QRIS dinamis per transaksi (nominal langsung terisi saat scan). Jika kosong, sistem pakai URL gambar seperti biasa.</div>
            </div>
            <div style="margin-top:10px">
              <div style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap">
                <div class="fg" style="min-width:260px; flex: 1 1 260px">
                  <label class="fl">Upload Gambar QRIS (opsional)</label>
                  <input class="fc" type="file" id="qris_upload_file" name="qris_file" accept="image/png,image/jpeg,image/jpg,image/webp">
                  <div style="font-size:10px; color:var(--muted); margin-top:4px">Jika di-upload, sistem akan menyimpan file dan otomatis mengisi URL QRIS.</div>
                </div>
                <button class="btn btn-s" type="button" id="qris_upload_btn" style="height:38px"><i class="bi bi-upload"></i> Upload</button>
              </div>
            </div>
            <script src="https://unpkg.com/jsqr@1.4.0/dist/jsQR.js" integrity="sha384-b5Ya4Bq3qCyz39m2ISh+4DxjAIljdeFwK/BsXLuj9gugaNwAcj/ia15fxNZL9Nlx" crossorigin="anonymous"></script>
            <script>
              (function () {
                const fileInput = document.getElementById('qris_upload_file');
                const btn = document.getElementById('qris_upload_btn');
                if (!fileInput || !btn) return;

                const normalizePayload = (raw) => {
                  let s = String(raw || '').replace(/[\r\n\t]+/g, '').trim();
                  const idx = s.indexOf('000201');
                  if (idx > 0) s = s.slice(idx);
                  const lastCrc = s.lastIndexOf('6304');
                  if (lastCrc >= 0 && s.length >= lastCrc + 8) s = s.slice(0, lastCrc + 8);
                  return s;
                };

                const decodeQrPayloadInBrowser = async (file) => {
                  try {
                    if (!window.jsQR) return '';
                    const url = URL.createObjectURL(file);
                    const img = new Image();
                    img.decoding = 'async';
                    img.src = url;
                    await new Promise((resolve, reject) => {
                      img.onload = () => resolve();
                      img.onerror = () => reject(new Error('Gagal membaca gambar'));
                    });
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d', { willReadFrequently: true });
                    if (!ctx) return '';
                    canvas.width = img.naturalWidth || img.width || 0;
                    canvas.height = img.naturalHeight || img.height || 0;
                    if (!canvas.width || !canvas.height) return '';
                    ctx.drawImage(img, 0, 0);
                    const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                    const res = window.jsQR(imageData.data, canvas.width, canvas.height, { inversionAttempts: 'attemptBoth' });
                    URL.revokeObjectURL(url);
                    if (!res || !res.data) return '';
                    const s = normalizePayload(res.data);
                    return s.startsWith('000201') ? s : '';
                  } catch {
                    return '';
                  }
                };

                btn.addEventListener('click', async () => {
                  const f = fileInput.files && fileInput.files[0] ? fileInput.files[0] : null;
                  if (!f) return;
                  const fd = new FormData();
                  fd.append('qris_file', f);
                  const payload = await decodeQrPayloadInBrowser(f);
                  if (payload) fd.append('qris_payload', payload);
                  btn.disabled = true;
                  try {
                    const r = await fetch('/admin/settings/qris-upload', { method: 'POST', body: fd, credentials: 'same-origin' });
                    if (!r.ok) throw new Error('Upload gagal');
                    window.location.href = '/admin/settings';
                  } catch (e) {
                    window.location.href = '/admin/settings';
                  } finally {
                    btn.disabled = false;
                  }
                });
              })();
            </script>
