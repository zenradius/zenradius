<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.settings.title', 'Pengaturan') %> | <%= company %></title>
  <meta name="theme-color" content="#0f172a">
  <link rel="icon" href="/img/icon.png" type="image/png">
  <link rel="apple-touch-icon" href="/img/icon.png">
  <link rel="manifest" href="/admin/manifest.webmanifest">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<%- include('partials/sidebar', { activePage: (typeof activePage !== 'undefined' && activePage ? activePage : 'settings'), company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-gear"></i> <%= t('admin.settings.system_title', 'Pengaturan Sistem') %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
            <div class="lang-dropdown">
        <button type="button" class="lang-btn" onclick="toggleLangDropdown(this)" aria-haspopup="true" aria-expanded="false">
          <i class="bi bi-globe"></i> <span><%= (lang || 'id').toUpperCase() %></span> <i class="bi bi-chevron-down" style="font-size:10px"></i>
        </button>
        <div class="lang-menu">
          <a href="/lang/id" class="lang-item <%= (lang || 'id') === 'id' ? 'active' : '' %>">Indonesia</a>
          <a href="/lang/en" class="lang-item <%= (lang || 'id') === 'en' ? 'active' : '' %>">English</a>
        </div>
      </div>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i> <%= t('common.logout', 'Logout') %></a>
    </div>
  </div>
  <div class="page">

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type==='success'?'s':'d' %>">
      <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

    <!-- E-Wallet Notification Logs View -->
    <% if (typeof viewMode !== 'undefined' && viewMode === 'ewallet_logs') { %>
    <div class="page-container" style="max-width: 100%; padding: 0;">
      <!-- Header Section -->
      <div style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(14, 165, 233, 0.05) 100%); border-bottom: 1px solid rgba(59, 130, 246, 0.15); padding: 28px; border-radius: 12px 12px 0 0; margin-bottom: 0;">
        <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 12px;">
          <div style="width: 48px; height: 48px; background: linear-gradient(135deg, var(--primary), #0ea5e9); border-radius: 12px; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-wallet2" style="font-size: 24px; color: white;"></i>
          </div>
          <div>
            <h5 style="margin: 0; font-size: 18px; font-weight: 700;">Log Notifikasi E-Wallet (Webhook)</h5>
            <p style="margin: 4px 0 0 0; font-size: 12px; color: var(--muted);">Monitor semua payment notifications dari MacroDroid, Tripay, Midtrans, Xendit, Duitku</p>
          </div>
        </div>
      </div>

      <!-- Main Card -->
      <div class="card" style="border-radius: 0 0 12px 12px; border-top: none; margin: 0;">
        <div class="card-bd" style="padding: 24px;">
          
          <!-- Quick Stats -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 24px;">
            <div style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.15); border-radius: 10px; padding: 14px; text-align: center;">
              <div style="font-size: 11px; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Status Live</div>
              <div style="font-size: 16px; font-weight: 700; color: #10b981;"><i class="bi bi-broadcast" id="live_indicator" style="margin-right: 6px;"></i><span id="live_status">Offline</span></div>
            </div>
            <div style="background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.15); border-radius: 10px; padding: 14px; text-align: center;">
              <div style="font-size: 11px; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Total Logs</div>
              <div style="font-size: 16px; font-weight: 700; color: var(--primary);" id="total_logs">0</div>
            </div>
            <div style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.15); border-radius: 10px; padding: 14px; text-align: center;">
              <div style="font-size: 11px; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Berhasil</div>
              <div style="font-size: 16px; font-weight: 700; color: #10b981;" id="success_count">0</div>
            </div>
          </div>

          <!-- Filter & Control Bar -->
          <div style="background: rgba(0, 0, 0, 0.02); padding: 16px; border-radius: 10px; margin-bottom: 24px; border: 1px solid var(--border);">
            <div style="display: grid; grid-template-columns: 2fr 2fr 1fr auto; gap: 12px; align-items: flex-end;">
              <div class="fg" style="margin-bottom: 0;">
                <label class="fl">🔍 Service Filter</label>
                <select class="fs" id="ew_service" onchange="loadEwalletLogs()" style="margin-bottom: 0;">
                  <option value="">Semua Service</option>
                  <option value="Tripay">🔵 Tripay</option>
                  <option value="Midtrans">🟢 Midtrans</option>
                  <option value="Xendit">🟡 Xendit</option>
                  <option value="Duitku">🟣 Duitku</option>
                  <option value="E-Wallet">📱 E-Wallet</option>
                </select>
              </div>
              <div class="fg" style="margin-bottom: 0;">
                <label class="fl">🔎 Search Content</label>
                <input class="fc" id="ew_q" placeholder="Cari nominan, reference, atau konten..." onchange="loadEwalletLogs()" style="margin-bottom: 0;">
              </div>
              <div class="fg" style="margin-bottom: 0;">
                <label class="fl">📊 Limit</label>
                <input class="fc" type="number" id="ew_limit" value="200" min="10" max="1000" onchange="loadEwalletLogs()" style="margin-bottom: 0;">
              </div>
              <div style="display: flex; gap: 8px;">
                <button type="button" class="btn btn-p btn-sm btn-icon" id="ew_live_btn" onclick="toggleEwalletLive()" title="Toggle Live Mode"><i class="bi bi-broadcast"></i></button>
                <button type="button" class="btn btn-g btn-sm btn-icon" onclick="loadEwalletLogs()" title="Refresh Data"><i class="bi bi-arrow-repeat"></i></button>
                <button type="button" class="btn btn-d btn-sm btn-icon" onclick="clearEwalletLogs()" title="Clear All Logs"><i class="bi bi-trash"></i></button>
              </div>
            </div>
          </div>

          <!-- Notification Alert -->
          <div style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(14, 165, 233, 0.05) 100%); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 10px; padding: 16px; margin-bottom: 24px; display: flex; align-items: center; gap: 14px;">
            <div style="flex-shrink: 0; width: 40px; height: 40px; background: rgba(59, 130, 246, 0.15); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
              <i class="bi bi-bell" style="font-size: 18px; color: var(--primary);"></i>
            </div>
            <div style="flex: 1;">
              <div style="font-size: 13px; font-weight: 600; margin-bottom: 4px;">Browser Notifications</div>
              <div style="font-size: 12px; color: var(--muted); margin-bottom: 8px;" id="ew_notif_hint">Aktifkan notifikasi untuk mendapat alert real-time saat ada payment notification baru</div>
              <button type="button" class="btn btn-s btn-sm" onclick="enableEwalletNotif()"><i class="bi bi-bell"></i> Aktifkan Notif</button>
            </div>
          </div>

          <!-- Logs Table -->
          <div style="border-radius: 10px; border: 1px solid var(--border); overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
            <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
              <thead>
                <tr style="background: linear-gradient(90deg, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.03) 100%); border-bottom: 1px solid var(--border);">
                  <th style="padding: 14px; text-align: left; font-weight: 700; color: var(--muted); min-width: 165px;">📅 Waktu</th>
                  <th style="padding: 14px; text-align: left; font-weight: 700; color: var(--muted); min-width: 110px;">🏢 Service</th>
                  <th style="padding: 14px; text-align: left; font-weight: 700; color: var(--muted); min-width: 125px;">💰 Nominal</th>
                  <th style="padding: 14px; text-align: left; font-weight: 700; color: var(--muted); min-width: 90px;">✓ Status</th>
                  <th style="padding: 14px; text-align: left; font-weight: 700; color: var(--muted); min-width: 140px;">🔗 Matched</th>
                  <th style="padding: 14px; text-align: left; font-weight: 700; color: var(--muted);">📝 Content</th>
                  <th style="padding: 14px; text-align: center; font-weight: 700; color: var(--muted); min-width: 50px;">⚙️</th>
                </tr>
              </thead>
              <tbody id="ew_logs_body">
                <tr>
                  <td colspan="7" style="padding: 32px 14px; text-align: center; color: var(--muted);">
                    <i class="bi bi-hourglass-split" style="opacity: 0.5; margin-right: 8px;"></i>Memuat data...
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Footer Info -->
          <div style="margin-top: 20px; padding: 14px; background: linear-gradient(135deg, rgba(59, 130, 246, 0.05) 0%, rgba(14, 165, 233, 0.02) 100%); border-radius: 8px; border-left: 3px solid var(--primary); font-size: 12px; color: var(--muted);">
            <i class="bi bi-info-circle" style="color: var(--primary); margin-right: 8px; font-weight: 600;"></i>
            <span><strong>Tips:</strong> Log terbaru muncul di paling atas. Aktifkan Live Mode untuk auto-refresh setiap 5 detik dengan browser notification saat ada payment baru.</span>
          </div>
        </div>
      </div>
    </div>
    <% } else { %>

    <form method="POST" action="/admin/settings">

        <!-- Telegram Bot dipindahkan ke halaman /admin/telegram-bot (menu UTAMA > Telegram Bot) -->
        <% if (false) { %>
        <div class="card mb16">
          <div class="card-hd"><h6><i class="bi bi-telegram"></i> <%= t('admin.settings.telegram.title', 'Pengaturan Telegram Bot (Backup Admin)') %></h6></div>
          <div class="card-bd">
            <div class="form-row">
              <div class="fg">
                <label class="fl"><%= t('admin.settings.telegram.status', 'Status Bot Telegram') %></label>
                <select class="fs" name="telegram_enabled">
                  <option value="true" <%= settings.telegram_enabled ? 'selected' : '' %>><%= t('common.active', 'Aktif') %></option>
                  <option value="false" <%= !settings.telegram_enabled ? 'selected' : '' %>><%= t('common.inactive', 'Nonaktif') %></option>
                </select>
              </div>
              <div class="fg">
                <label class="fl"><%= t('admin.settings.telegram.admin_id', 'Admin Telegram ID') %></label>
                <input class="fc" name="telegram_admin_id" value="<%= settings.telegram_admin_id || '' %>" placeholder="Contoh: 12345678">
              </div>
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.settings.telegram.bot_token', 'Telegram Bot Token') %></label>
              <div style="display:flex;gap:8px">
                <input class="fc" name="telegram_bot_token" value="<%= settings.telegram_bot_token || '' %>" placeholder="Dapatkan dari @BotFather">
                <button type="button" class="btn btn-g" onclick="syncTelegram()" title="<%= t('admin.settings.telegram.sync_title', 'Sinkronkan / Hapus Webhook Lama') %>"><i class="bi bi-arrow-repeat"></i> <%= t('admin.settings.telegram.sync', 'Sinkronkan') %></button>
              </div>
            </div>
          </div>
        </div>
        <% } %>

        <!-- Lisensi Domain (Seumur Hidup) -->
        <div class="card mb16">
          <div class="card-hd" style="display:flex; justify-content:space-between; align-items:center;">
            <h6><i class="bi bi-shield-lock"></i> Lisensi Domain (Seumur Hidup)</h6>
            <button type="button" class="btn btn-s" onclick="openLicenseActivationModal()" style="font-size:11px; padding:4px 10px; height:auto; margin:0;"><i class="bi bi-patch-check-fill"></i> Aktivasi Lisensi</button>
          </div>
          <div class="card-bd">
            <div class="fg">
              <label class="fl">Kode Lisensi untuk domain <code><%= typeof currentHost !== 'undefined' ? currentHost : '' %></code></label>
              <input class="fc" name="domain_license_key" value="<%= settings.domain_license_key || '' %>" placeholder="Format: XXXX-XXXX-XXXX-XXXX" pattern="^([A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4}-[A-Z0-9]{4})?$" autocomplete="off" style="font-family:monospace">
              <small class="text-muted">
                <% if (typeof licenseValid !== 'undefined') { %>
                  Status: <% if (licenseValid) { %><span style="color:#2dd4bf">● Valid</span> — Terima kasih telah mendukung pengembangan ZenRadius. Lisensi resmi Anda turut menjaga keberlanjutan inovasi dan dukungan teknis berkualitas bagi seluruh pengguna.<% } else { %><span style="color:#f87171">● Tidak valid / belum diisi</span> — Setiap lisensi resmi adalah bentuk apresiasi atas kerja keras dan dedikasi Developer dalam menghadirkan sistem yang andal. Hubungi Developer Resmi untuk mendaftarkan domain Anda dan miliki kode lisensi premium seumur hidup.<% } %>
                <% } else { %>
                  Setiap lisensi resmi adalah bentuk apresiasi atas kerja keras dan dedikasi Developer dalam menghadirkan sistem yang andal. Hubungi Developer Resmi untuk mendaftarkan domain Anda dan miliki kode lisensi premium seumur hidup.
                <% } %>
              </small>
            </div>
          </div>
        </div>


        <div class="settings-grid">
        <div class="card mb16">
          <div class="card-hd"><h6><i class="bi bi-person-gear"></i> Pengaturan Profil</h6></div>
          <div class="card-bd">
        
        <!-- General Info -->
        <div>
          <h6 style="font-size:13px;color:var(--muted);margin-bottom:12px;text-transform:uppercase;letter-spacing:1px"><i class="bi bi-info-circle"></i> <%= t('admin.settings.app_info', 'Info Aplikasi') %></h6>
          <div class="fg">
            <label class="fl"><%= t('admin.settings.company_name', 'Nama Aplikasi / Perusahaan') %></label>
            <input class="fc" name="company_header" value="<%= settings.company_header || '' %>" placeholder="ZenRadius">
          </div>
          <div class="fg">
            <label class="fl">URL Publik Aplikasi (Public Base URL)</label>
            <input class="fc" name="public_base_url" value="<%= settings.public_base_url || '' %>" placeholder="https://app.zenradius.net">
            <div style="font-size:10px; color:var(--muted); margin-top:4px">Digunakan untuk menyusun tautan login pelanggan yang dikirim via WhatsApp. Contoh: <span class="mono">https://app.zenradius.net</span></div>
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.settings.footer_info', 'Info Footer') %></label>
            <input class="fc" name="footer_info" value="<%= settings.footer_info || '' %>" placeholder="ZenRadius - All Rights Reserved">
          </div>
          <div class="form-row">
            <div class="fg">
              <label class="fl"><%= t('admin.settings.owner_name', 'Nama Manajer / Owner') %></label>
              <input class="fc" name="company_manager" value="<%= settings.company_manager || '' %>" placeholder="Admin Pusat">
            </div>
            <div class="fg">
              <label class="fl"><%= t('admin.settings.primary_phone', 'Telepon Utama (CS)') %></label>
              <input class="fc" name="company_phone" value="<%= settings.company_phone || '' %>" placeholder="081234567890">
            </div>
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.settings.company_email', 'Email Perusahaan') %></label>
            <input class="fc" name="company_email" value="<%= settings.company_email || '' %>" placeholder="support@zenradius.net">
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.settings.office_address', 'Alamat Kantor') %></label>
            <input class="fc" name="company_address" value="<%= settings.company_address || '' %>" placeholder="Jl. Utama No. 123">
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.settings.operational_hours', 'Jam Operasional') %></label>
            <input class="fc" name="operational_hours" value="<%= settings.operational_hours || '' %>" placeholder="Setiap Hari: 08.00 - 22.00 WIB">
          </div>
        </div>
          </div>
        </div>

        <!-- Server Settings -->
        <div class="card mb16">
          <div class="card-hd"><h6><i class="bi bi-gear"></i> Pengaturan Server</h6></div>
          <div class="card-bd">
            <div class="fg" style="margin-top:15px; border-top: 1px dashed var(--border); padding-top: 15px;">
              <label class="fl">Ganti Logo Aplikasi (berlaku di seluruh tampilan: landing, login semua role, dashboard, sidebar, invoice, PWA)</label>
              <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap">
                <div style="flex: 1 1 200px">
                  <input class="fc" type="file" id="logo_upload_file" name="logo_file" accept="image/png,image/jpeg,image/jpg,image/webp">
                  <div style="font-size:10px; color:var(--muted); margin-top:4px">Format file: PNG/JPG/WebP. Ukuran maks 2MB. Logo akan langsung di-upload dan menimpa yang lama. Ikon PWA & favicon otomatis disinkronkan.</div>
                </div>
                <button class="btn btn-s" type="button" id="logo_upload_btn"><i class="bi bi-upload"></i> Upload Logo</button>
              </div>
              <div style="margin-top:10px; display:flex; gap:12px; align-items:center;">
                <div style="font-size:10px; color:var(--muted)">Logo Saat Ini:</div>
                <img src="/img/logo.png?v=<%= Date.now() %>" alt="Current Logo" style="height:40px; object-fit:contain; background:rgba(255,255,255,0.05); border-radius:6px; padding:4px; border:1px solid var(--border)">
              </div>
            </div>
            <div class="form-row">
              <div class="fg">
                <label class="fl"><%= t('admin.settings.server_port', 'Port Server') %></label>
                <input class="fc" type="number" name="server_port" value="<%= settings.server_port || 3001 %>">
              </div>
              <div class="fg">
                <label class="fl"><%= t('admin.settings.timezone', 'Zona Waktu') %></label>
                <select class="fs" name="timezone">
                  <option value="Asia/Jakarta" <%= settings.timezone === 'Asia/Jakarta' ? 'selected' : '' %>>WIB (Asia/Jakarta)</option>
                  <option value="Asia/Makassar" <%= settings.timezone === 'Asia/Makassar' ? 'selected' : '' %>>WITA (Asia/Makassar)</option>
                  <option value="Asia/Jayapura" <%= settings.timezone === 'Asia/Jayapura' ? 'selected' : '' %>>WIT (Asia/Jayapura)</option>
                </select>
              </div>
              <div class="fg">
                <label class="fl"><%= t('admin.settings.customer_otp_login', 'Login OTP Pelanggan') %></label>
                <select class="fs" name="login_otp_enabled">
                  <option value="true" <%= settings.login_otp_enabled ? 'selected' : '' %>><%= t('admin.settings.otp_enabled', 'Aktif (Kirim via WA)') %></option>
                  <option value="false" <%= !settings.login_otp_enabled ? 'selected' : '' %>><%= t('admin.settings.otp_disabled', 'Nonaktif (Langsung)') %></option>
                </select>
              </div>
            </div>
            <div class="hint" style="margin-top:6px;color:var(--warning)">
              <i class="bi bi-info-circle"></i> <strong>Pembayaran Kolektor:</strong> Pengaturan approval pembayaran kolektor sekarang diatur per akun kolektor pada menu Manajemen Kolektor, bukan dari pengaturan global.
            </div>
            <div class="fg" style="margin-top:15px; border-top:1px dashed var(--border); padding-top:15px;">
              <label class="fl">Kredensial Admin</label>
              <% if (!settings.admin_password) { %>
              <div class="hint" style="margin-bottom:8px;color:var(--danger)">
                <i class="bi bi-exclamation-triangle"></i> Login masih menggunakan kredensial bawaan dari <code>.env</code>. Isi username & password di bawah lalu simpan — kredensial bawaan akan otomatis dinonaktifkan.
              </div>
              <% } else { %>
              <div class="hint" style="margin-bottom:8px">
                <i class="bi bi-shield-check"></i> Kredensial bawaan <code>.env</code> sudah dinonaktifkan. Login hanya dengan kredensial di bawah.
              </div>
              <% } %>
              <div class="form-row">
                <div class="fg">
                  <label class="fl">Username Admin</label>
                  <input class="fc" name="admin_username" value="<%= settings.admin_username || '' %>">
                </div>
                <div class="fg">
                  <label class="fl">Password Admin</label>
                  <input class="fc" type="password" name="admin_password" value="<%= settings.admin_password || '' %>">
                </div>
              </div>
              <label class="fl">Admin API Key (Untuk akses luar)</label>
              <input class="fc" name="admin_api_key" value="<%= settings.admin_api_key || '' %>">
            </div>
          </div>
        </div>

        <!-- Office Attendance Settings -->
        <div class="card mb16">
          <div class="card-hd"><h6><i class="bi bi-geo-alt"></i> Lokasi & Absensi</h6></div>
          <div class="card-bd">
            <div class="form-row">
              <div>
                <div class="fg">
                  <label class="fl"><%= t('admin.settings.office_lat', 'Latitude Kantor') %></label>
                  <input class="fc" name="office_lat" value="<%= settings.office_lat || '' %>" placeholder="-6.xxx">
                </div>
                <div class="fg">
                  <label class="fl"><i class="bi bi-shield-check"></i> Geofencing Absensi</label>
                  <select class="fs" name="attendance_geofencing">
                    <option value="true" <%= settings.attendance_geofencing === 'true' || settings.attendance_geofencing === true ? 'selected' : '' %>>Aktif (Validasi Lokasi)</option>
                    <option value="false" <%= settings.attendance_geofencing === 'false' || settings.attendance_geofencing === false ? 'selected' : '' %>>Nonaktif (Bebas)</option>
                  </select>
                </div>
              </div>
              <div>
                <div class="fg">
                  <label class="fl"><%= t('admin.settings.office_lng', 'Longitude Kantor') %></label>
                  <input class="fc" name="office_lng" value="<%= settings.office_lng || '' %>" placeholder="106.xxx">
                </div>
                <div class="fg">
                  <label class="fl"><i class="bi bi-geo-alt"></i> Radius Absensi (meter)</label>
                  <input type="number" class="fc" name="attendance_radius" value="<%= settings.attendance_radius || '100' %>" placeholder="100" min="10" max="1000">
                </div>
              </div>
            </div>
            <div class="hint" style="margin-top:-6px;margin-bottom:12px;color:var(--muted)">
              <i class="bi bi-info-circle"></i> Koordinat kantor digunakan untuk validasi lokasi absensi karyawan (geofencing)
            </div>
