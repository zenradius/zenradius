window.openLicenseActivationModal = function() {
  const modal = document.getElementById('licenseActivationModal');
  const input = document.getElementById('lic_domain_input');
  if (modal) {
    modal.style.display = 'flex';
    if (input) {
      // Ambil domain saat ini di browser sebagai rujukan default
      const currentLoc = window.location.hostname;
      input.value = currentLoc === 'localhost' || currentLoc === '127.0.0.1' ? '' : currentLoc;
      input.focus();
    }
  }
};

window.closeLicenseActivationModal = function() {
  const modal = document.getElementById('licenseActivationModal');
  if (modal) modal.style.display = 'none';
};

window.submitLicenseActivationOrder = function() {
  const input = document.getElementById('lic_domain_input');
  if (!input || !input.value.trim()) {
    input.focus();
    return;
  }
  const domain = input.value.trim().toLowerCase().replace(/^(https?:\/\/)?(www\.)?/, '').split('/')[0];
  
  // Teks pesanan eksklusif yang sangat profesional
  const message = `Halo Developer ZenRadius,\n\nSaya ingin memesan Lisensi Premium Seumur Hidup (Lifetime) ZenRadius untuk domain berikut:\n\n🌐 DOMAIN: ${domain}\n💰 HARGA: Rp 150.000 (1 domain, seumur hidup)\n\nMohon informasikan metode pembayarannya. Setelah pembayaran, harap daftarkan domain ini dan terbitkan Serial Kunci Aktivasi resminya.\n\nTerima kasih atas dedikasinya mengembangkan ZenRadius.`;
  
  const waUrl = `https://wa.me/6285178008881?text=${encodeURIComponent(message)}`;
  window.open(waUrl, '_blank');
  closeLicenseActivationModal();
};
