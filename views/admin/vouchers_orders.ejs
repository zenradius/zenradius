<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" type="image/png">
  <title>Pesanan Voucher Pelanggan | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .mtabs { display: flex; gap: 10px; margin-bottom: 14px; border-bottom: 1px solid var(--border); padding-bottom: 10px; }
    .mtab { padding: 8px 14px; border-radius: 8px; cursor: pointer; color: var(--muted); transition: all 0.2s; font-weight: 700; text-decoration: none; }
    .mtab:hover { background: rgba(255,255,255,0.06); color: var(--text); }
    .mtab.active { background: linear-gradient(135deg,#236060 0%,#183f51 52%,#194251 100%); color: #f4fffd; border:1px solid rgba(126,231,219,.48); box-shadow:0 8px 20px rgba(10,41,50,.24); }
    html[data-theme="light"] .mtab { background: transparent; color: var(--muted); }
    html[data-theme="light"] .mtab:hover { background: rgba(0,0,0,0.04); color: var(--text); }
    html[data-theme="light"] .mtab.active { background: linear-gradient(135deg,#6366f1 0%,#818cf8 52%,#7c3aed 100%); color: #ffffff; border-color: rgba(99,102,241,.48); box-shadow: 0 8px 20px rgba(99,102,241,.12); }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace; }
    .status-pill{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:999px;font-size:11.5px;font-weight:700;border:1px solid transparent}
    .status-pending{background:rgba(251,191,36,.12);color:#fbbf24;border-color:rgba(251,191,36,.3)}
    .status-paid{background:rgba(59,130,246,.12);color:#60a5fa;border-color:rgba(59,130,246,.3)}
    .status-fulfilled{background:rgba(34,197,94,.12);color:#4ade80;border-color:rgba(34,197,94,.3)}
    .status-cancelled{background:rgba(148,163,184,.12);color:#94a3b8;border-color:rgba(148,163,184,.3)}
    .wa-ok{color:#4ade80;font-size:11px}
    .wa-err{color:#f87171;font-size:11px}
    .btn-xs{padding:4px 9px;font-size:11.5px;border-radius:7px;white-space:nowrap}
    .act-row{display:flex;gap:6px;flex-wrap:wrap}

    /* Detail modal — palette selaras dengan modal Restart Aplikasi (views/admin/update.ejs) */
    .rs-overlay{position:fixed;inset:0;z-index:2000;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(10,30,38,.72);backdrop-filter:blur(6px)}
    .rs-overlay.show{display:flex;animation:rsFade .25s ease}
    .rs-card{width:100%;max-width:560px;background:var(--bg2);border:1px solid var(--border);border-radius:16px;padding:0;text-align:left;box-shadow:0 24px 60px rgba(0,0,0,.45);color:var(--text);max-height:88vh;overflow:auto}
    .rs-mh{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:20px 24px;border-bottom:1px solid var(--border)}
    .rs-mh-title{display:flex;align-items:center;gap:12px}
    .cf-icon{width:44px;height:44px;flex:none;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--primary);background:var(--pdim);border:1px solid rgba(34,211,238,.35)}
    .rs-mh h3{margin:0;font-size:17px;font-weight:700;color:var(--text)}
    .rs-mc{background:none;border:none;color:var(--muted);font-size:22px;cursor:pointer;line-height:1;padding:4px}
    .rs-mc:hover{color:var(--text)}
    .rs-mbody{padding:22px 24px}
    .rs-mf{padding:14px 24px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:10px}
    @keyframes rsFade{from{opacity:0}to{opacity:1}}

    .det-list{display:flex;flex-direction:column}
    .det-row{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:10px 0;border-bottom:1px solid var(--border)}
    .det-row:last-child{border-bottom:none}
    .det-k{font-size:12.5px;color:var(--muted);font-weight:600;flex:0 0 auto;min-width:170px}
    .det-v{font-size:13px;font-weight:600;word-break:break-word;color:var(--text);text-align:right}
    .det-section{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted);font-weight:700;padding:16px 0 6px;border-bottom:1px solid var(--border);margin-bottom:2px}
    .det-section:first-child{padding-top:0}
    @media (max-width:520px){.det-row{flex-direction:column;gap:2px}.det-v{text-align:left}.det-k{min-width:0}}
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'mikrotik', company }) %>
<div class="mw">
<%- include('partials/licenseGraceBar') %>
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-receipt-cutoff"></i> Pesanan Voucher Pelanggan</div>
    <div class="tb-right" style="display:flex;align-items:center;gap:15px">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">
    <% const mTab = 'voucher_orders'; %>
    <% if (msg) { %>
      <div class="alert <%= msg.type === 'success' ? 's' : (msg.type === 'error' ? 'd' : 'w') %>"><%= msg.text %></div>
    <% } %>

    <div class="mtabs">
      <a href="/admin/mikrotik" class="mtab"><i class="bi bi-router"></i> Monitoring</a>
      <a href="/admin/vouchers" class="mtab"><i class="bi bi-ticket-perforated"></i> Voucher Hotspot</a>
      <a href="/admin/vouchers/orders" class="mtab active"><i class="bi bi-receipt-cutoff"></i> Pesanan Voucher</a>
      <a href="/admin/routers" class="mtab"><i class="bi bi-hdd-network"></i> Router</a>
    </div>

    <div class="stat-grid" style="grid-template-columns:repeat(5,1fr);margin-bottom:20px">
      <div class="sc p"><i class="bi bi-collection sc-icon"></i><div class="sc-label">Total</div><div class="sc-val" id="stat-total">0</div></div>
      <div class="sc w"><i class="bi bi-clock-history sc-icon"></i><div class="sc-label">Menunggu Bayar</div><div class="sc-val" id="stat-pending">0</div></div>
      <div class="sc s"><i class="bi bi-hourglass-split sc-icon"></i><div class="sc-label">Diproses (Paid)</div><div class="sc-val" id="stat-paid">0</div></div>
      <div class="sc"><i class="bi bi-check2-circle sc-icon"></i><div class="sc-label">Selesai</div><div class="sc-val" id="stat-fulfilled">0</div></div>
      <div class="sc d"><i class="bi bi-exclamation-triangle sc-icon"></i><div class="sc-label">Macet / Perlu Aksi</div><div class="sc-val" id="stat-stuck">0</div></div>
    </div>

    <div class="card" style="margin-bottom:16px">
      <div class="card-bd" style="padding:14px 18px">
        <div class="filter-title"><i class="bi bi-funnel-fill"></i> Pencarian &amp; Filter</div>
        <form class="srow" style="margin:0" onsubmit="return false">
          <div class="sinput" style="max-width:320px">
            <i class="bi bi-search"></i>
            <input class="fc" id="vo-search" placeholder="Cari No. WA / Order ID / Kode Voucher..." oninput="debounceReload()">
          </div>
          <select class="fs" id="vo-status" style="max-width:220px" onchange="reloadOrders()">
            <option value="">-- Semua Status --</option>
            <option value="pending">Menunggu Pembayaran</option>
            <option value="paid">Dibayar (Diproses)</option>
            <option value="fulfilled">Selesai</option>
            <option value="cancelled">Dibatalkan</option>
          </select>
          <button class="btn btn-g btn-sm" onclick="reloadOrders()"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card-hd">
        <h6><i class="bi bi-list-check"></i> Daftar Pesanan Voucher</h6>
      </div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th>ID</th>
              <th>WA Pembeli</th>
              <th>Paket</th>
              <th>Harga</th>
              <th>Gateway</th>
              <th>Status</th>
              <th>Kode Voucher</th>
              <th>WA Notif</th>
              <th>Dibuat</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody id="orders-list">
            <tr><td colspan="10" class="text-center text-muted">Memuat data...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  function fmtRp(n) { return 'Rp ' + Number(n || 0).toLocaleString('id-ID'); }

  function statusBadge(status) {
    const map = {
      pending: ['status-pending', 'bi-clock-history', 'Menunggu Bayar'],
      paid: ['status-paid', 'bi-hourglass-split', 'Diproses'],
      fulfilled: ['status-fulfilled', 'bi-check2-circle', 'Selesai'],
      cancelled: ['status-cancelled', 'bi-x-circle', 'Dibatalkan']
    };
    const [cls, icon, label] = map[status] || ['status-pending', 'bi-question-circle', status];
    return `<span class="status-pill ${cls}"><i class="bi ${icon}"></i> ${label}</span>`;
  }

  let debounceTimer = null;
  function debounceReload() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(reloadOrders, 350);
  }

  async function reloadOrders() {
    const status = document.getElementById('vo-status').value;
    const q = document.getElementById('vo-search').value.trim();
    const params = new URLSearchParams();
    if (status) params.set('status', status);
    if (q) params.set('q', q);
    params.set('limit', '200');

    const tbody = document.getElementById('orders-list');
    tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted">Memuat data...</td></tr>';

    try {
      const res = await fetch('/admin/api/vouchers/orders?' + params.toString());
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'Gagal memuat data');

      const stats = data.stats || {};
      document.getElementById('stat-total').innerText = stats.total || 0;
      document.getElementById('stat-pending').innerText = stats.pending || 0;
      document.getElementById('stat-paid').innerText = stats.paid || 0;
      document.getElementById('stat-fulfilled').innerText = stats.fulfilled || 0;
      document.getElementById('stat-stuck').innerText = stats.stuck || 0;

      const rows = data.rows || [];
      if (rows.length === 0) {
        tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted">Belum ada pesanan voucher.</td></tr>';
        return;
      }

      tbody.innerHTML = rows.map(o => {
        let waInfo = '<span class="text-muted small">-</span>';
        if (o.status === 'fulfilled' || o.status === 'paid') {
          if (Number(o.wa_sent) === 1) waInfo = '<span class="wa-ok"><i class="bi bi-whatsapp"></i> Terkirim</span>';
          else if (o.wa_error) waInfo = `<span class="wa-err" title="${(o.wa_error || '').replace(/"/g, '&quot;')}"><i class="bi bi-exclamation-triangle"></i> Gagal</span>`;
        }

        const actions = [`<button class="btn btn-g btn-xs" onclick="showDetail(${o.id})"><i class="bi bi-eye"></i> Detail</button>`];
        if (o.status === 'paid') {
          actions.push(`<button class="btn btn-p btn-xs" onclick="retryFulfillment(${o.id})"><i class="bi bi-arrow-repeat"></i> Retry</button>`);
          actions.push(`<button class="btn btn-d btn-xs" onclick="cancelOrder(${o.id})"><i class="bi bi-x-lg"></i> Batal</button>`);
        } else if (o.status === 'pending') {
          actions.push(`<button class="btn btn-d btn-xs" onclick="cancelOrder(${o.id})"><i class="bi bi-x-lg"></i> Batal</button>`);
        } else if (o.status === 'fulfilled') {
          actions.push(`<button class="btn btn-g btn-xs" onclick="copyCode('${o.voucher_code || ''}')"><i class="bi bi-clipboard"></i> Salin Kode</button>`);
          actions.push(`<button class="btn btn-p btn-xs" onclick="resendWa(${o.id})"><i class="bi bi-whatsapp"></i> Kirim Ulang WA</button>`);
        }

        return `<tr>
          <td class="mono">#${o.id}</td>
          <td class="mono">${o.buyer_phone || '-'}</td>
          <td>${o.profile_name || '-'}<div class="text-muted small">${o.validity || ''}</div></td>
          <td>${fmtRp(o.price)}</td>
          <td>${o.payment_gateway || '-'}</td>
          <td>${statusBadge(o.status)}</td>
          <td class="mono">${o.voucher_code || '-'}</td>
          <td>${waInfo}</td>
          <td class="text-muted small">${o.created_at || '-'}</td>
          <td><div class="act-row">${actions.join('')}</div></td>
        </tr>`;
      }).join('');
    } catch (e) {
      tbody.innerHTML = `<tr><td colspan="10" class="text-center text-danger">Gagal memuat: ${e.message}</td></tr>`;
    }
  }

  async function retryFulfillment(orderId) {
    if (!confirm(`Coba proses ulang voucher untuk order #${orderId}? Sistem akan membuat user hotspot baru di MikroTik dan mengirim WA.`)) return;
    try {
      const res = await fetch(`/admin/api/vouchers/orders/${orderId}/retry-fulfillment`, { method: 'POST' });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'Gagal retry');
      alert(data.already ? 'Order sudah pernah fulfilled sebelumnya.' : 'Voucher berhasil dibuat ulang!');
      reloadOrders();
    } catch (e) {
      alert('Gagal: ' + e.message);
    }
  }

  async function cancelOrder(orderId) {
    if (!confirm(`Batalkan order #${orderId}? Tindakan ini tidak bisa dibatalkan kembali.`)) return;
    try {
      const res = await fetch(`/admin/api/vouchers/orders/${orderId}/cancel`, { method: 'POST' });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'Gagal membatalkan');
      reloadOrders();
    } catch (e) {
      alert('Gagal: ' + e.message);
    }
  }

  async function resendWa(orderId) {
    if (!confirm(`Kirim ulang notifikasi WhatsApp berisi kode voucher untuk order #${orderId}?`)) return;
    try {
      const res = await fetch(`/admin/api/vouchers/orders/${orderId}/resend-wa`, { method: 'POST' });
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'Gagal mengirim WA');
      alert('WhatsApp berhasil dikirim ulang.');
      reloadOrders();
    } catch (e) {
      alert('Gagal: ' + e.message);
    }
  }

  function copyCode(code) {
    if (!code) return;
    navigator.clipboard.writeText(code).then(() => {
      alert('Kode voucher disalin: ' + code);
    }).catch(() => {
      alert('Gagal menyalin. Kode: ' + code);
    });
  }

  function openModal(id){ document.getElementById(id)?.classList.add('show'); document.getElementById(id)?.setAttribute('aria-hidden', 'false'); }
  function closeModal(id){ document.getElementById(id)?.classList.remove('show'); document.getElementById(id)?.setAttribute('aria-hidden', 'true'); }

  async function showDetail(orderId) {
    const body = document.getElementById('detailBody');
    body.innerHTML = '<div class="text-center text-muted">Memuat...</div>';
    openModal('detailModal');
    try {
      const res = await fetch(`/admin/api/vouchers/orders/${orderId}`);
      const data = await res.json();
      if (!data.ok) throw new Error(data.error || 'Gagal memuat detail');
      const o = data.order;

      let waInfo = '-';
      if (Number(o.wa_sent) === 1) waInfo = `<span class="wa-ok"><i class="bi bi-whatsapp"></i> Terkirim ${o.wa_sent_at || ''}</span>`;
      else if (o.wa_error) waInfo = `<span class="wa-err"><i class="bi bi-exclamation-triangle"></i> ${o.wa_error}</span>`;

      body.innerHTML = `
        <div class="det-list">
          <div class="det-section">Informasi Pesanan</div>
          <div class="det-row"><span class="det-k">Order ID</span><span class="det-v mono">#${o.id}</span></div>
          <div class="det-row"><span class="det-k">Status</span><span class="det-v">${statusBadge(o.status)}</span></div>
          <div class="det-row"><span class="det-k">No. WhatsApp Pembeli</span><span class="det-v mono">${o.buyer_phone || '-'}</span></div>
          <div class="det-row"><span class="det-k">Router</span><span class="det-v">${o.router_name || 'Default'}</span></div>

          <div class="det-section">Detail Paket</div>
          <div class="det-row"><span class="det-k">Paket</span><span class="det-v">${o.profile_name || '-'}</span></div>
          <div class="det-row"><span class="det-k">Durasi</span><span class="det-v">${o.validity || '-'}</span></div>
          <div class="det-row"><span class="det-k">Harga</span><span class="det-v">${fmtRp(o.price)}</span></div>

          <div class="det-section">Pembayaran</div>
          <div class="det-row"><span class="det-k">Gateway Pembayaran</span><span class="det-v">${o.payment_gateway || '-'}</span></div>
          <div class="det-row"><span class="det-k">Ref. Pembayaran</span><span class="det-v mono">${o.payment_reference || '-'}</span></div>

          <div class="det-section">Voucher &amp; Notifikasi</div>
          <div class="det-row"><span class="det-k">Kode Voucher</span><span class="det-v mono">${o.voucher_code || '-'}</span></div>
          <div class="det-row"><span class="det-k">Status WA</span><span class="det-v">${waInfo}</span></div>

          <div class="det-section">Riwayat Waktu</div>
          <div class="det-row"><span class="det-k">Dibuat</span><span class="det-v">${o.created_at || '-'}</span></div>
          <div class="det-row"><span class="det-k">Dibayar</span><span class="det-v">${o.paid_at || '-'}</span></div>
          <div class="det-row"><span class="det-k">Selesai (Fulfilled)</span><span class="det-v">${o.fulfilled_at || '-'}</span></div>
          <div class="det-row"><span class="det-k">Kedaluwarsa Bayar</span><span class="det-v">${o.payment_expires_at || '-'}</span></div>
        </div>
      `;
    } catch (e) {
      body.innerHTML = `<div class="text-danger">Gagal memuat detail: ${e.message}</div>`;
    }
  }

  reloadOrders();
</script>

<div class="rs-overlay" id="detailModal" aria-hidden="true">
  <div class="rs-card" role="dialog" aria-modal="true" aria-labelledby="detailTitle">
    <div class="rs-mh">
      <div class="rs-mh-title">
        <div class="cf-icon"><i class="bi bi-receipt-cutoff"></i></div>
        <h3 id="detailTitle">Detail Pesanan Voucher</h3>
      </div>
      <button class="rs-mc" onclick="closeModal('detailModal')">&times;</button>
    </div>
    <div class="rs-mbody" id="detailBody"></div>
    <div class="rs-mf">
      <button type="button" class="btn btn-g" onclick="closeModal('detailModal')">Tutup</button>
    </div>
  </div>
</div>
</body>
</html>
