<!DOCTYPE html>
<html lang="<%= lang || 'id' %>" data-app-theme="<%= typeof appTheme !== 'undefined' ? appTheme : 'current' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== 'undefined' ? brandVersion : 'zenradius' %>" type="image/png">
  <title><%= t('admin.onu_stickers.title', 'Cetak Stiker Modem / ONU') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/theme-tokens.css">
  <style>
    @page {
      size: A4 portrait;
      margin: 6mm 6mm;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      color: #142d35;
      background: #eaf0f1;
      padding: 28px 18px 40px;
    }

    /* Screen UI Controls (Hidden when printed) */
    .screen-controls {
      max-width: 1120px;
      margin: 0 auto 24px;
      background: #fff;
      border: 1px solid #d4e0e2;
      border-top: 4px solid #087e82;
      border-radius: 8px;
      padding: 22px 24px 18px;
      color: #142d35;
      box-shadow: 0 8px 24px rgba(20, 45, 53, .08);
    }
    .ctrl-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
      border-bottom: 1px solid #e1e9ea;
      padding-bottom: 16px;
      flex-wrap: wrap;
      gap: 10px;
    }
    .ctrl-title {
      font-size: 20px;
      font-weight: 750;
      display: flex;
      align-items: center;
      gap: 8px;
      color: #14535b;
    }
    .ctrl-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      border: none;
      transition: all .15s ease;
    }
    .btn-primary {
      background: #087e82;
      color: #ffffff;
      box-shadow: 0 3px 8px rgba(8, 126, 130, .2);
    }
    .btn-primary:hover {
      background: #06696d;
    }
    .btn-secondary {
      background: #f0f5f5;
      color: #34535a;
      border: 1px solid #d4e0e2;
    }
    .btn-secondary:hover {
      background: #e4eeee;
    }
    .filter-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 12px;
      margin-bottom: 12px;
    }
    .fg {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .fg label {
      font-size: 11px;
      font-weight: 700;
      color: #637c81;
      text-transform: uppercase;
      letter-spacing: 0;
    }
    .fg select, .fg input {
      background: #fff;
      border: 1px solid #cbd9db;
      color: #18363d;
      padding: 10px 11px;
      border-radius: 5px;
      font-size: 13px;
    }
    .fg select:focus, .fg input:focus { outline: 2px solid rgba(8,126,130,.2); border-color: #087e82; }

    /* Print Page Container */
    .print-sheet {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto 20px;
      background: #ffffff;
      padding: 4mm 4mm;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
      border-radius: 4px;
      page-break-after: always;
      break-after: page;
    }

    /* Sticker Grid: 2 Columns x 5 Rows = 10 stickers per A4 */
    .sticker-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 3.5mm 3.5mm;
    }

    /* Individual Sticker: Name Tag Size (~96mm x 53mm) */
    .sticker-card {
      width: 100%;
      height: 54mm;
      border: 0.35mm dashed #aab9ba;
      border-radius: 2mm;
      padding: 4mm 4.5mm 3.5mm;
      background: #ffffff;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      page-break-inside: avoid;
      break-inside: avoid;
      box-sizing: border-box;
    }

    .sticker-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1.5mm;
      background: linear-gradient(90deg, #087e82 0 68%, #d39a3b 68% 100%);
    }

    /* Header */
    .st-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      border-bottom: 0.3mm solid #dce5e5;
      padding-bottom: 2mm;
      margin-bottom: 1mm;
    }
    .st-brand {
      display: flex;
      align-items: center;
      gap: 6px;
      min-width: 0;
    }
    .st-logo {
      height: 8mm;
      max-width: 26mm;
      object-fit: contain;
      object-position: left center;
    }
    .st-company {
      font-size: 10px;
      font-weight: 900;
      color: #0f172a;
      line-height: 1.1;
      text-transform: uppercase;
      max-width: 70mm;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .st-badge {
      font-size: 8px;
      font-weight: 700;
      color: #14535b;
      background: #e8f3f1;
      padding: 1.2mm 2mm;
      border-radius: 2mm;
      border: 0.25mm solid #c6dfdc;
      white-space: nowrap;
    }

    /* Body 2 Columns */
    .st-body {
      display: flex;
      gap: 2.5mm;
      align-items: stretch;
      flex: 1;
      margin: 1.5mm 0;
    }

    /* Left Side: Cust details & Guidance */
    .st-left {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 1.5mm;
      min-width: 0;
    }

    .cust-info-box {
      background: #f5f8f7;
      border: 0.25mm solid #e0e8e7;
      border-radius: 1.5mm;
      padding: 2mm 2.5mm;
      line-height: 1.45;
    }
    .cust-row {
      display: flex;
      align-items: baseline;
      font-size: 8.4px;
      color: #3b5559;
    }
    .cust-row .label {
      width: 13mm;
      color: #657b7e;
      font-weight: 700;
      flex-shrink: 0;
    }
    .cust-row .val {
      font-weight: 800;
      color: #17363c;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* Important Warnings / Tips Box */
    .tips-box {
      background: #fbf7ed;
      border: 0.25mm solid #eadbb8;
      border-radius: 1.5mm;
      padding: 2mm 2.5mm;
      display: flex;
      flex-direction: column;
      justify-content: space-evenly;
      gap: 1.4mm;
      flex: 1;
    }
    .tip-item {
      display: flex;
      align-items: flex-start;
      gap: 1.5mm;
      font-size: 8.1px;
      color: #665633;
      line-height: 1.3;
    }
    .tip-item i {
      font-size: 10px;
      flex-shrink: 0;
      margin-top: 0.5px;
    }
    .tip-item strong {
      color: #74551c;
      font-weight: 800;
      letter-spacing: 0;
    }

    /* Right Side: QR Code */
    .st-right {
      width: 30mm;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: #f4f8f7;
      border: 0.3mm solid #dce8e6;
      border-radius: 2mm;
      padding: 1.5mm;
      flex-shrink: 0;
    }
    .qr-img {
      width: 23mm;
      height: 23mm;
      object-fit: contain;
      display: block;
    }
    .qr-label {
      font-size: 7.5px;
      font-weight: 900;
      color: #087e82;
      text-transform: uppercase;
        letter-spacing: 0;
      margin-top: 1px;
      line-height: 1.1;
    }
    .qr-sub {
      font-size: 6.5px;
      color: #64748b;
      line-height: 1;
      margin-top: 0.5px;
    }

    /* Footer */
    .st-footer {
      border-top: 0.25mm solid #dce5e5;
      padding-top: 1.5mm;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 7.5px;
      color: #475569;
    }
    .st-cs {
      display: flex;
      align-items: center;
      gap: 3px;
      font-weight: 800;
      color: #176b59;
    }
    .st-cs i {
      color: #23876f;
      font-size: 8.5px;
    }
    .st-notice {
      color: #788b8e;
      font-size: 6.8px;
    }

    @media print {
      body {
        background: #ffffff !important;
        padding: 0 !important;
      }
      .screen-controls {
        display: none !important;
      }
      .print-sheet {
        box-shadow: none !important;
        margin: 0 !important;
        padding: 0 !important;
        border-radius: 0 !important;
      }
      .sticker-card {
        border: 0.35mm dashed #aab9ba !important;
      }
    }
    @media (max-width: 700px) {
      body { padding: 12px; }
      .screen-controls { padding: 16px; }
      .ctrl-header { align-items: flex-start; }
      .ctrl-title { font-size: 17px; }
      .ctrl-actions { width: 100%; }
      .ctrl-actions .btn { flex: 1; justify-content: center; }
      .filter-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .filter-grid .fg:last-child { grid-column: 1 / -1; }
      .print-sheet { transform-origin: top left; }
    }
    @media (max-width: 460px) {
      .filter-grid { grid-template-columns: 1fr; }
      .filter-grid .fg:last-child { grid-column: auto; }
      .ctrl-actions { flex-direction: column; }
      .ctrl-actions .btn { width: 100%; }
    }
    .onu-print-page { background: var(--bg); color: var(--text); padding: 0; }
    .onu-print-page .screen-controls { max-width: none; margin: 0 0 18px; padding: 0; color: var(--text); background: var(--panel); border: 1px solid var(--border); border-top: 0; border-radius: 8px; box-shadow: none; }
    .onu-print-page .ctrl-header { margin: 0; padding: 14px 18px; border-bottom: 1px solid var(--border); }
    .onu-print-page .ctrl-title { color: var(--text); font-size: 16px; }
    .onu-print-page .ctrl-actions .btn { min-height: 38px; }
    .onu-print-page .filter-grid { padding: 16px 18px 0; }
    .onu-print-page .fg label { color: var(--muted); }
    .onu-print-page .fg select, .onu-print-page .fg input { background: var(--bg2); color: var(--text); border-color: var(--border); }
    .onu-print-page .screen-hint { padding: 0 18px 16px; color: var(--muted); font-size: 12px; }
    .onu-print-page .print-preview-head { display:flex; justify-content:space-between; align-items:center; gap:12px; margin: 0 0 10px; color: var(--muted); font-size:12px; }
    .onu-print-page .sheet-viewport { overflow-x:auto; padding: 0 0 14px; }
    .onu-print-page .print-sheet { box-shadow: 0 6px 24px rgba(8,35,62,.14); border:1px solid #d9e4eb; }
    .onu-print-page .sticker-grid { gap: 2.5mm; }
    .onu-print-page .sticker-card { display:flex; padding:0; height:54mm; border:0; border-radius:2.2mm; background:#fff; box-shadow: inset 0 0 0 .25mm #b7c9d8; }
    .onu-print-page .sticker-card::before { display:none; }
    .label-header { height:9.5mm; flex:0 0 9.5mm; padding:1.2mm 3mm; display:flex; justify-content:space-between; align-items:center; gap:4mm; color:#fff; background:#073d78; border-radius:2.2mm 2.2mm 0 0; position:relative; overflow:hidden; }
    .label-header::after { content:""; position:absolute; height:1.2mm; width:35mm; right:14mm; bottom:-.6mm; background:#24b7ec; transform:skewX(-35deg); }
    .label-brand { display:flex; align-items:center; min-width:0; }
    .label-logo { display:block; width:auto; max-width:44mm; height:7mm; object-fit:contain; object-position:left center; }
    .label-company { max-width:65mm; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#fff; font-size:12px; font-weight:800; }
    .label-tagline { max-width:52mm; color:#dceeff; font-size:8px; line-height:1.2; text-align:right; }
    .label-content { flex:1; min-height:0; padding:1.2mm 2.5mm 1mm; display:flex; flex-direction:column; gap:1mm; }
    .label-top, .label-bottom { display:grid; gap:2mm; min-height:0; }
    .label-top { grid-template-columns:1.08fr 1fr; height:13mm; }
    .label-bottom { grid-template-columns:1.45fr 1fr; flex:1; }
    .label-panel { min-width:0; border:.25mm solid #a9dfff; border-radius:2mm; background:#edf7ff; color:#123f73; overflow:hidden; }
    .label-panel-title { height:4mm; margin:0; padding:0 2mm; display:flex; align-items:center; gap:1.2mm; color:#073d78; font-size:8px; font-weight:800; line-height:1; }
    .label-panel-title i { font-size:11px; }
    .wifi-panel { padding-bottom:1mm; }
    .wifi-lines { padding:0 2mm; font-size:7.5px; line-height:1.55; }
    .wifi-line { display:grid; grid-template-columns:15mm 2mm minmax(0,1fr); align-items:baseline; gap:.5mm; }
    .wifi-line span:first-child { font-weight:700; }
    .wifi-line strong { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#102f56; font-size:8px; }
    .wifi-note { padding:0 2mm; color:#315d87; font-size:6px; }
    .label-customer { padding:0 2mm; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#315d87; font-size:6.3px; }
    .led-panel { padding-bottom:.7mm; }
    .led-rows { padding:0 2mm; display:grid; gap:.3mm; }
    .led-row { display:grid; grid-template-columns:2.5mm 15mm 1.5mm minmax(0,1fr); align-items:center; gap:.6mm; min-height:1.4mm; font-size:5.8px; line-height:1; }
    .led-row strong { font-size:6.5px; }
    .led-dot { width:2.2mm; height:2.2mm; border-radius:50%; box-shadow:0 0 0 .25mm rgba(0,0,0,.07); }
    .led-green { background:#20bf82; }.led-blue { background:#1599e5; }.led-yellow { background:#f3bd2f; }.led-red { background:#e7474b; }
    .steps-panel { padding-bottom:1mm; background:#f3f9ff; }
    .steps-title { height:5mm; padding:0 2mm; display:flex; align-items:center; gap:1.5mm; color:#fff; background:#0a4a8f; font-size:8px; font-weight:800; }
    .steps-list { padding:1mm 1.6mm; display:grid; grid-template-columns:1fr 1fr; column-gap:1.5mm; row-gap:.8mm; }
    .step { display:grid; grid-template-columns:4mm minmax(0,1fr); gap:1mm; align-items:start; min-width:0; color:#183b63; }
    .step-num { width:3.5mm; height:3.5mm; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; background:#0b4d91; font-size:6px; font-weight:800; }
    .step-copy { font-size:5.8px; line-height:1.25; }
    .step-copy strong { display:block; color:#123960; font-size:6.3px; }
    .help-panel { display:flex; flex-direction:column; padding:1.4mm; background:#e9f5ff; }
    .help-heading { height:3.3mm; margin:0; display:flex; align-items:center; gap:1mm; color:#073d78; font-size:8px; font-weight:800; flex:0 0 3.3mm; }
    .help-body { display:grid; grid-template-columns:16mm minmax(0,1fr); gap:1.2mm; align-items:center; flex:1; min-height:0; }
    .help-qr { width:15mm; height:15mm; display:block; background:#fff; padding:.5mm; border-radius:1mm; }
    .help-meta { display:grid; gap:1.3mm; min-width:0; }
    .help-row { display:grid; grid-template-columns:3mm minmax(0,1fr); gap:1mm; align-items:center; color:#16436e; font-size:5.7px; line-height:1.2; overflow-wrap:anywhere; }
    .help-row i { color:#0b568d; font-size:8px; }
    .help-row strong { display:block; font-size:6px; }
    .help-qr-label { margin-top:.3mm; color:#0b568d; text-align:center; font-size:4.5px; font-weight:700; line-height:1; }
    .label-footer { min-height:5.5mm; padding:.8mm 3mm; display:flex; justify-content:space-between; align-items:center; gap:2mm; color:#fff; background:#073d78; border-radius:0 0 2.2mm 2.2mm; font-size:7px; }
    .label-footer i { color:#22b9ee; font-size:10px; margin-right:1mm; }
    .label-footer-note { color:#dceeff; font-size:6px; white-space:nowrap; }
    @media print {
      html, body.onu-print-page { width:210mm; min-width:210mm; margin:0 !important; padding:0 !important; background:#fff !important; }
      .onu-print-page .sb, .onu-print-page .topbar, .onu-print-page .screen-controls, .onu-print-page .print-preview-head, .onu-print-page .license-grace-bar { display:none !important; }
      .onu-print-page .mw, .onu-print-page .page, .onu-print-page .sheet-viewport { width:auto !important; max-width:none !important; margin:0 !important; padding:0 !important; overflow:visible !important; }
      .onu-print-page .print-sheet { width:198mm; min-height:285mm; margin:0 auto !important; padding:0 !important; border:0 !important; border-radius:0 !important; box-shadow:none !important; }
      .onu-print-page .sticker-card { -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important; }
    }
  </style>
</head>
<body class="onu-print-page">
<%- include('partials/sidebar', { activePage: 'onu_stickers', company }) %>
<div class="mw">
<%- include('partials/licenseGraceBar') %>
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-qr-code-scan"></i> <%= t('admin.onu_stickers.title', 'Cetak Stiker ONU') %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <div class="lang-dropdown">
        <button type="button" class="lang-btn" onclick="toggleLangDropdown(this)" aria-haspopup="true" aria-expanded="false">
          <i class="bi bi-globe"></i> <span><%= (lang || 'id').toUpperCase() %></span> <i class="bi bi-chevron-down" style="font-size:10px"></i>
        </button>
        <div class="lang-menu">
          <a href="/lang/id" class="lang-item <%= (lang || 'id') === 'id' ? 'active' : '' %>">Indonesia</a>
          <a href="/lang/en" class="lang-item <%= (lang || 'id') === 'en' ? 'active' : '' %>">English</a>
        </div>
      </div>
      <a href="/admin/logout" class="btn btn-g btn-sm" title="<%= t('common.logout', 'Logout') %>"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">

  <!-- Screen-only Controls -->
  <div class="screen-controls card">
    <div class="ctrl-header card-hd">
      <div class="ctrl-title">
        <i class="bi bi-qr-code-scan"></i><span><%= t('admin.onu_stickers.heading', 'Cetak Stiker Modem / ONU (Name Tag Size)') %></span>
      </div>
      <div class="ctrl-actions">
        <button type="button" class="btn btn-primary" onclick="window.print()">
          <i class="bi bi-printer-fill"></i> <%= t('admin.onu_stickers.print', 'Cetak Stiker (A4 / PDF)') %>
        </button>
        <a href="/admin/customers" class="btn btn-secondary">
          <i class="bi bi-arrow-left"></i> <%= t('admin.onu_stickers.back', 'Kembali') %>
        </a>
      </div>
    </div>
    <div class="card-bd">

    <form method="GET" action="/admin/onu-stickers" id="filterForm">
      <div class="filter-grid">
        <div class="fg">
          <label><%= t('admin.onu_stickers.mode', 'Mode Cetak') %></label>
          <select name="mode" onchange="document.getElementById('filterForm').submit()">
            <option value="blank" <%= mode === 'blank' ? 'selected' : '' %>><%= t('admin.onu_stickers.mode_blank', 'Template Blank (Stok Teknisi Lapangan)') %></option>
            <option value="customers" <%= mode === 'customers' ? 'selected' : '' %>><%= t('admin.onu_stickers.mode_customers', 'Data Pelanggan (Personalized)') %></option>
          </select>
        </div>

        <% if (mode === 'blank') { %>
          <div class="fg">
            <label><%= t('admin.onu_stickers.count', 'Jumlah Stiker') %></label>
            <select name="count" onchange="document.getElementById('filterForm').submit()">
              <option value="10" <%= count === 10 ? 'selected' : '' %>>10 <%= t('admin.onu_stickers.stickers_one_sheet', 'Stiker (1 Lembar A4)') %></option>
              <option value="20" <%= count === 20 ? 'selected' : '' %>>20 <%= t('admin.onu_stickers.stickers_two_sheets', 'Stiker (2 Lembar A4)') %></option>
              <option value="30" <%= count === 30 ? 'selected' : '' %>>30 <%= t('admin.onu_stickers.stickers_three_sheets', 'Stiker (3 Lembar A4)') %></option>
              <option value="1" <%= count === 1 ? 'selected' : '' %>><%= t('admin.onu_stickers.count_single', '1 Stiker (Thermal / Satuan)') %></option>
            </select>
          </div>
        <% } else { %>
          <div class="fg">
            <label><%= t('admin.onu_stickers.filter_router', 'Filter Router') %></label>
            <select name="router_id" onchange="document.getElementById('filterForm').submit()">
              <option value=""><%= t('admin.onu_stickers.all_routers', 'Semua Router') %></option>
              <% (routers || []).forEach(r => { %>
                <option value="<%= r.id %>" <%= String(selectedRouterId) === String(r.id) ? 'selected' : '' %>><%= r.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="fg">
            <label><%= t('admin.onu_stickers.search', 'Cari Pelanggan') %></label>
            <input type="text" name="q" value="<%= searchQuery || '' %>" placeholder="<%= t('admin.onu_stickers.search_placeholder', 'Ketik nama / ID...') %>" />
          </div>
        <% } %>

        <div class="fg">
          <label><%= t('admin.onu_stickers.cs_phone', 'No. CS / WA Bantuan (Tampil di Stiker)') %></label>
          <input type="text" name="cs_phone" value="<%= csPhone %>" placeholder="08xxxxxxxxxx" onchange="document.getElementById('filterForm').submit()" />
        </div>

        <% if (mode === 'customers') { %>
          <div class="fg" style="justify-content:flex-end">
            <button type="submit" class="btn btn-primary" style="justify-content:center"><i class="bi bi-search"></i> <%= t('admin.onu_stickers.apply', 'Tampilkan') %></button>
          </div>
        <% } %>
      </div>
    </form>
    <div class="screen-hint" style="display:flex;align-items:center;gap:6px;">
      <i class="bi bi-info-circle"></i>
      <%= t('admin.onu_stickers.hint', 'Ukuran stiker diatur presisi standar Name Tag / Kartu ID (~8.5cm x 5.4cm). Format A4 memuat 10 stiker per lembar. Gunakan kertas stiker HVS atau Glossy.') %>
    </div>
  </div>
  </div>

  <div class="print-preview-head screen-only">
    <span><i class="bi bi-printer"></i> <%= t('admin.onu_stickers.preview', 'Pratinjau hasil cetak') %></span>
    <span><%= stickers.length %> <%= t('admin.onu_stickers.sticker_count', 'stiker') %></span>
  </div>
  <div class="sheet-viewport">

  <!-- Printable Sheets (Auto breaks pages if items > 10) -->
  <% 
    const STICKERS_PER_PAGE = 10;
    const totalPages = Math.max(1, Math.ceil(stickers.length / STICKERS_PER_PAGE));
    for (let pageIdx = 0; pageIdx < totalPages; pageIdx++) {
      const pageItems = stickers.slice(pageIdx * STICKERS_PER_PAGE, (pageIdx + 1) * STICKERS_PER_PAGE);
  %>
    <div class="print-sheet">
      <div class="sticker-grid">
        <% pageItems.forEach(item => { %>
          <div class="sticker-card">
            <header class="label-header">
              <div class="label-brand">
                <% if (hasCustomLogo) { %>
                  <img src="/img/logo.png?v=<%= typeof brandVersion !== 'undefined' ? brandVersion : 'zenradius' %>" class="label-logo" alt="Logo <%= company %>">
                <% } else { %>
                  <span class="label-company"><%= company %></span>
                <% } %>
              </div>
              <div class="label-tagline"><%= typeof brandTagline !== 'undefined' && brandTagline ? brandTagline : t('admin.onu_stickers.tagline', 'Internet Lancar, Hidup Makin Mudah') %></div>
            </header>

            <div class="label-content">
              <div class="label-top">
                <section class="label-panel wifi-panel">
                  <h3 class="label-panel-title"><i class="bi bi-wifi"></i> <%= t('admin.onu_stickers.wifi_info', 'Informasi Wi-Fi') %></h3>
                  <% if (item.name || item.id_display) { %><div class="label-customer"><%= [item.name, item.id_display].filter(Boolean).join(' · ') %></div><% } %>
                  <div class="wifi-lines">
                    <div class="wifi-line"><span><%= t('admin.onu_stickers.ssid', 'Nama (SSID)') %></span><span>:</span><strong><%= item.ssid || 'ZenRadius-XXXX' %></strong></div>
                    <div class="wifi-line"><span><%= t('admin.onu_stickers.password', 'Password') %></span><span>:</span><strong><%= item.wifiPassword || 'XXXXXXXX' %></strong></div>
                  </div>
                  <div class="wifi-note"><%= t('admin.onu_stickers.wifi_note', 'Sesuaikan dengan konfigurasi modem saat pemasangan') %></div>
                </section>

                <section class="label-panel led-panel">
                  <h3 class="label-panel-title"><i class="bi bi-lightbulb"></i> <%= t('admin.onu_stickers.led_title', 'Indikator LED') %></h3>
                  <div class="led-rows">
                    <div class="led-row"><span class="led-dot led-green"></span><strong>Power</strong><span>:</span><span><%= t('admin.onu_stickers.led_power', 'Menyala = modem hidup') %></span></div>
                    <div class="led-row"><span class="led-dot led-blue"></span><strong>Internet</strong><span>:</span><span><%= t('admin.onu_stickers.led_internet', 'Menyala = terhubung') %></span></div>
                    <div class="led-row"><span class="led-dot led-green"></span><strong>Wi-Fi</strong><span>:</span><span><%= t('admin.onu_stickers.led_wifi', 'Menyala = Wi-Fi aktif') %></span></div>
                    <div class="led-row"><span class="led-dot led-yellow"></span><strong>LAN</strong><span>:</span><span><%= t('admin.onu_stickers.led_lan', 'Menyala = perangkat terhubung') %></span></div>
                    <div class="led-row"><span class="led-dot led-red"></span><strong>LOS / Alarm</strong><span>:</span><span><%= t('admin.onu_stickers.led_los', 'Merah = gangguan jaringan') %></span></div>
                  </div>
                </section>
              </div>

              <div class="label-bottom">
                <section class="label-panel steps-panel">
                  <div class="steps-title"><i class="bi bi-gear-fill"></i> <%= t('admin.onu_stickers.trouble_title', 'Jika Internet Lemot / Tidak Stabil') %></div>
                  <div class="steps-list">
                    <div class="step"><span class="step-num">1</span><div class="step-copy"><strong><%= t('admin.onu_stickers.step_devices', 'Cek Perangkat Anda') %></strong><%= t('admin.onu_stickers.step_devices_text', 'Pastikan tidak terlalu banyak perangkat terhubung.') %></div></div>
                    <div class="step"><span class="step-num">2</span><div class="step-copy"><strong><%= t('admin.onu_stickers.step_restart', 'Restart Modem') %></strong><%= t('admin.onu_stickers.step_restart_text', 'Cabut listrik 30 detik, lalu nyalakan kembali.') %></div></div>
                    <div class="step"><span class="step-num">3</span><div class="step-copy"><strong><%= t('admin.onu_stickers.step_location', 'Cek Lokasi Modem') %></strong><%= t('admin.onu_stickers.step_location_text', 'Letakkan di tempat terbuka dan tidak terhalang.') %></div></div>
                    <div class="step"><span class="step-num">4</span><div class="step-copy"><strong><%= t('admin.onu_stickers.step_contact', 'Hubungi CS') %></strong><%= t('admin.onu_stickers.step_contact_text', 'Jika masih bermasalah, hubungi layanan pelanggan.') %></div></div>
                  </div>
                </section>

                <section class="label-panel help-panel">
                  <h3 class="help-heading"><i class="bi bi-headset"></i> <%= t('admin.onu_stickers.help_title', 'Butuh Bantuan?') %></h3>
                  <div class="help-body">
                    <div>
                      <img src="<%= item.qrCodeDataUrl %>" class="help-qr" alt="QR Portal Pelanggan">
                      <div class="help-qr-label"><%= t('admin.onu_stickers.qr_label', 'Scan untuk portal pelanggan') %></div>
                    </div>
                    <div class="help-meta">
                      <div class="help-row"><i class="bi bi-whatsapp"></i><span><strong>WhatsApp</strong><%= csPhone %></span></div>
                      <div class="help-row"><i class="bi bi-telephone"></i><span><strong><%= t('admin.onu_stickers.phone_label', 'Telepon') %></strong><%= csPhone %></span></div>
                      <div class="help-row"><i class="bi bi-clock"></i><span><strong><%= t('admin.onu_stickers.hours_label', 'Jam Operasional') %></strong><%= settings.operational_hours || '08.00 - 22.00 WIB' %></span></div>
                    </div>
                  </div>
                </section>
              </div>
            </div>

            <footer class="label-footer">
              <span><i class="bi bi-wifi"></i><%= t('admin.onu_stickers.thank_you', 'Terima kasih telah menggunakan layanan kami') %></span>
              <span class="label-footer-note"><%= t('admin.onu_stickers.notice', 'Tempel pada modem pelanggan') %></span>
            </footer>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
  </div>
  </div>
  </div>

</body>
</html>
