<!DOCTYPE html>
<html lang="<%= lang || 'id' %>" data-app-theme="<%= typeof appTheme !== 'undefined' ? appTheme : 'current' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== 'undefined' ? brandVersion : 'zenradius' %>" type="image/png">
  <title><%= t('admin.onu_stickers.title', 'Cetak Stiker Modem / ONU') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    @page {
      size: A4 portrait;
      margin: 6mm 6mm;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      color: #142d35;
      background: #eaf0f1;
      padding: 28px 18px 40px;
    }

    /* Screen UI Controls (Hidden when printed) */
    .screen-controls {
      max-width: 1120px;
      margin: 0 auto 24px;
      background: #fff;
      border: 1px solid #d4e0e2;
      border-top: 4px solid #087e82;
      border-radius: 8px;
      padding: 22px 24px 18px;
      color: #142d35;
      box-shadow: 0 8px 24px rgba(20, 45, 53, .08);
    }
    .ctrl-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
      border-bottom: 1px solid #e1e9ea;
      padding-bottom: 16px;
      flex-wrap: wrap;
      gap: 10px;
    }
    .ctrl-title {
      font-size: 20px;
      font-weight: 750;
      display: flex;
      align-items: center;
      gap: 8px;
      color: #14535b;
    }
    .ctrl-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      border: none;
      transition: all .15s ease;
    }
    .btn-primary {
      background: #087e82;
      color: #ffffff;
      box-shadow: 0 3px 8px rgba(8, 126, 130, .2);
    }
    .btn-primary:hover {
      background: #06696d;
    }
    .btn-secondary {
      background: #f0f5f5;
      color: #34535a;
      border: 1px solid #d4e0e2;
    }
    .btn-secondary:hover {
      background: #e4eeee;
    }
    .filter-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 12px;
      margin-bottom: 12px;
    }
    .fg {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .fg label {
      font-size: 11px;
      font-weight: 700;
      color: #637c81;
      text-transform: uppercase;
      letter-spacing: 0;
    }
    .fg select, .fg input {
      background: #fff;
      border: 1px solid #cbd9db;
      color: #18363d;
      padding: 10px 11px;
      border-radius: 5px;
      font-size: 13px;
    }
    .fg select:focus, .fg input:focus { outline: 2px solid rgba(8,126,130,.2); border-color: #087e82; }

    /* Print Page Container */
    .print-sheet {
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto 20px;
      background: #ffffff;
      padding: 4mm 4mm;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
      border-radius: 4px;
      page-break-after: always;
      break-after: page;
    }

    /* Sticker Grid: 2 Columns x 5 Rows = 10 stickers per A4 */
    .sticker-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 3.5mm 3.5mm;
    }

    /* Individual Sticker: Name Tag Size (~96mm x 53mm) */
    .sticker-card {
      width: 100%;
      height: 54mm;
      border: 0.35mm dashed #aab9ba;
      border-radius: 2mm;
      padding: 4mm 4.5mm 3.5mm;
      background: #ffffff;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      page-break-inside: avoid;
      break-inside: avoid;
      box-sizing: border-box;
    }

    .sticker-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1.5mm;
      background: linear-gradient(90deg, #087e82 0 68%, #d39a3b 68% 100%);
    }

    /* Header */
    .st-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      border-bottom: 0.3mm solid #dce5e5;
      padding-bottom: 2mm;
      margin-bottom: 1mm;
    }
    .st-brand {
      display: flex;
      align-items: center;
      gap: 6px;
      min-width: 0;
    }
    .st-logo {
      height: 8mm;
      max-width: 26mm;
      object-fit: contain;
      object-position: left center;
    }
    .st-company {
      font-size: 10px;
      font-weight: 900;
      color: #0f172a;
      line-height: 1.1;
      text-transform: uppercase;
      max-width: 70mm;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .st-badge {
      font-size: 8px;
      font-weight: 700;
      color: #14535b;
      background: #e8f3f1;
      padding: 1.2mm 2mm;
      border-radius: 2mm;
      border: 0.25mm solid #c6dfdc;
      white-space: nowrap;
    }

    /* Body 2 Columns */
    .st-body {
      display: flex;
      gap: 2.5mm;
      align-items: stretch;
      flex: 1;
      margin: 1.5mm 0;
    }

    /* Left Side: Cust details & Guidance */
    .st-left {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 1.5mm;
      min-width: 0;
    }

    .cust-info-box {
      background: #f5f8f7;
      border: 0.25mm solid #e0e8e7;
      border-radius: 1.5mm;
      padding: 2mm 2.5mm;
      line-height: 1.45;
    }
    .cust-row {
      display: flex;
      align-items: baseline;
      font-size: 8.4px;
      color: #3b5559;
    }
    .cust-row .label {
      width: 13mm;
      color: #657b7e;
      font-weight: 700;
      flex-shrink: 0;
    }
    .cust-row .val {
      font-weight: 800;
      color: #17363c;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* Important Warnings / Tips Box */
    .tips-box {
      background: #fbf7ed;
      border: 0.25mm solid #eadbb8;
      border-radius: 1.5mm;
      padding: 2mm 2.5mm;
      display: flex;
      flex-direction: column;
      justify-content: space-evenly;
      gap: 1.4mm;
      flex: 1;
    }
    .tip-item {
      display: flex;
      align-items: flex-start;
      gap: 1.5mm;
      font-size: 8.1px;
      color: #665633;
      line-height: 1.3;
    }
    .tip-item i {
      font-size: 10px;
      flex-shrink: 0;
      margin-top: 0.5px;
    }
    .tip-item strong {
      color: #74551c;
      font-weight: 800;
      letter-spacing: 0;
    }

    /* Right Side: QR Code */
    .st-right {
      width: 30mm;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: #f4f8f7;
      border: 0.3mm solid #dce8e6;
      border-radius: 2mm;
      padding: 1.5mm;
      flex-shrink: 0;
    }
    .qr-img {
      width: 23mm;
      height: 23mm;
      object-fit: contain;
      display: block;
    }
    .qr-label {
      font-size: 7.5px;
      font-weight: 900;
      color: #087e82;
      text-transform: uppercase;
        letter-spacing: 0;
      margin-top: 1px;
      line-height: 1.1;
    }
    .qr-sub {
      font-size: 6.5px;
      color: #64748b;
      line-height: 1;
      margin-top: 0.5px;
    }

    /* Footer */
    .st-footer {
      border-top: 0.25mm solid #dce5e5;
      padding-top: 1.5mm;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 7.5px;
      color: #475569;
    }
    .st-cs {
      display: flex;
      align-items: center;
      gap: 3px;
      font-weight: 800;
      color: #176b59;
    }
    .st-cs i {
      color: #23876f;
      font-size: 8.5px;
    }
    .st-notice {
      color: #788b8e;
      font-size: 6.8px;
    }

    @media print {
      body {
        background: #ffffff !important;
        padding: 0 !important;
      }
      .screen-controls {
        display: none !important;
      }
      .print-sheet {
        box-shadow: none !important;
        margin: 0 !important;
        padding: 0 !important;
        border-radius: 0 !important;
      }
      .sticker-card {
        border: 0.35mm dashed #aab9ba !important;
      }
    }
    @media (max-width: 700px) {
      body { padding: 12px; }
      .screen-controls { padding: 16px; }
      .ctrl-header { align-items: flex-start; }
      .ctrl-title { font-size: 17px; }
      .ctrl-actions { width: 100%; }
      .ctrl-actions .btn { flex: 1; justify-content: center; }
      .filter-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .filter-grid .fg:last-child { grid-column: 1 / -1; }
      .print-sheet { transform-origin: top left; }
    }
    @media (max-width: 460px) {
      .filter-grid { grid-template-columns: 1fr; }
      .filter-grid .fg:last-child { grid-column: auto; }
      .ctrl-actions { flex-direction: column; }
      .ctrl-actions .btn { width: 100%; }
    }
  </style>
</head>
<body>

  <!-- Screen-only Controls -->
  <div class="screen-controls">
    <div class="ctrl-header">
      <div class="ctrl-title">
        <i class="bi bi-qr-code-scan"></i><span><%= t('admin.onu_stickers.heading', 'Cetak Stiker Modem / ONU (Name Tag Size)') %></span>
      </div>
      <div class="ctrl-actions">
        <button type="button" class="btn btn-primary" onclick="window.print()">
          <i class="bi bi-printer-fill"></i> <%= t('admin.onu_stickers.print', 'Cetak Stiker (A4 / PDF)') %>
        </button>
        <a href="/admin/customers" class="btn btn-secondary">
          <i class="bi bi-arrow-left"></i> <%= t('admin.onu_stickers.back', 'Kembali') %>
        </a>
      </div>
    </div>

    <form method="GET" action="/admin/onu-stickers" id="filterForm">
      <div class="filter-grid">
        <div class="fg">
          <label><%= t('admin.onu_stickers.mode', 'Mode Cetak') %></label>
          <select name="mode" onchange="document.getElementById('filterForm').submit()">
            <option value="blank" <%= mode === 'blank' ? 'selected' : '' %>><%= t('admin.onu_stickers.mode_blank', 'Template Blank (Stok Teknisi Lapangan)') %></option>
            <option value="customers" <%= mode === 'customers' ? 'selected' : '' %>><%= t('admin.onu_stickers.mode_customers', 'Data Pelanggan (Personalized)') %></option>
          </select>
        </div>

        <% if (mode === 'blank') { %>
          <div class="fg">
            <label><%= t('admin.onu_stickers.count', 'Jumlah Stiker') %></label>
            <select name="count" onchange="document.getElementById('filterForm').submit()">
              <option value="10" <%= count === 10 ? 'selected' : '' %>>10 <%= t('admin.onu_stickers.stickers_one_sheet', 'Stiker (1 Lembar A4)') %></option>
              <option value="20" <%= count === 20 ? 'selected' : '' %>>20 <%= t('admin.onu_stickers.stickers_two_sheets', 'Stiker (2 Lembar A4)') %></option>
              <option value="30" <%= count === 30 ? 'selected' : '' %>>30 <%= t('admin.onu_stickers.stickers_three_sheets', 'Stiker (3 Lembar A4)') %></option>
              <option value="1" <%= count === 1 ? 'selected' : '' %>><%= t('admin.onu_stickers.count_single', '1 Stiker (Thermal / Satuan)') %></option>
            </select>
          </div>
        <% } else { %>
          <div class="fg">
            <label><%= t('admin.onu_stickers.filter_router', 'Filter Router') %></label>
            <select name="router_id" onchange="document.getElementById('filterForm').submit()">
              <option value=""><%= t('admin.onu_stickers.all_routers', 'Semua Router') %></option>
              <% (routers || []).forEach(r => { %>
                <option value="<%= r.id %>" <%= String(selectedRouterId) === String(r.id) ? 'selected' : '' %>><%= r.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="fg">
            <label><%= t('admin.onu_stickers.search', 'Cari Pelanggan') %></label>
            <input type="text" name="q" value="<%= searchQuery || '' %>" placeholder="<%= t('admin.onu_stickers.search_placeholder', 'Ketik nama / ID...') %>" />
          </div>
        <% } %>

        <div class="fg">
          <label><%= t('admin.onu_stickers.cs_phone', 'No. CS / WA Bantuan (Tampil di Stiker)') %></label>
          <input type="text" name="cs_phone" value="<%= csPhone %>" placeholder="08xxxxxxxxxx" onchange="document.getElementById('filterForm').submit()" />
        </div>

        <% if (mode === 'customers') { %>
          <div class="fg" style="justify-content:flex-end">
            <button type="submit" class="btn btn-primary" style="justify-content:center"><i class="bi bi-search"></i> <%= t('admin.onu_stickers.apply', 'Tampilkan') %></button>
          </div>
        <% } %>
      </div>
    </form>
    <div style="font-size: 11px; color: #94a3b8; display:flex; align-items:center; gap:6px;">
      <i class="bi bi-info-circle"></i>
      <%= t('admin.onu_stickers.hint', 'Ukuran stiker diatur presisi standar Name Tag / Kartu ID (~8.5cm x 5.4cm). Format A4 memuat 10 stiker per lembar. Gunakan kertas stiker HVS atau Glossy.') %>
    </div>
  </div>

  <!-- Printable Sheets (Auto breaks pages if items > 10) -->
  <% 
    const STICKERS_PER_PAGE = 10;
    const totalPages = Math.max(1, Math.ceil(stickers.length / STICKERS_PER_PAGE));
    for (let pageIdx = 0; pageIdx < totalPages; pageIdx++) {
      const pageItems = stickers.slice(pageIdx * STICKERS_PER_PAGE, (pageIdx + 1) * STICKERS_PER_PAGE);
  %>
    <div class="print-sheet">
      <div class="sticker-grid">
        <% pageItems.forEach(item => { %>
          <div class="sticker-card">
            
            <!-- 1. Header -->
            <div class="st-header">
              <div class="st-brand">
                <% if (hasCustomLogo) { %>
                  <img src="/img/logo.png?v=<%= typeof brandVersion !== 'undefined' ? brandVersion : 'zenradius' %>" class="st-logo" alt="Logo <%= company %>" />
                <% } else { %>
                  <span class="st-company"><%= company %></span>
                <% } %>
              </div>
              <span class="st-badge"><i class="bi bi-router"></i> MODEM ONU</span>
            </div>

            <!-- 2. Body -->
            <div class="st-body">
              
              <!-- Left: Info & Warnings -->
              <div class="st-left">
                <div class="cust-info-box">
                  <div class="cust-row">
                    <span class="label"><%= t('admin.onu_stickers.label_name', 'Nama') %></span>: <span class="val"><%= item.name || '..................................................' %></span>
                  </div>
                  <div class="cust-row">
                    <span class="label"><%= t('admin.onu_stickers.label_id', 'ID / Inet') %></span>: <span class="val"><%= item.id_display || '..................................................' %></span>
                  </div>
                  <% if (item.package_name) { %>
                    <div class="cust-row">
                      <span class="label"><%= t('admin.onu_stickers.label_package', 'Paket') %></span>: <span class="val" style="color:#0284c7"><%= item.package_name %></span>
                    </div>
                  <% } %>
                </div>

                <div class="tips-box">
                  <div class="tip-item">
                    <i class="bi bi-lightning-charge-fill" style="color:#d97706"></i>
                    <div><strong><%= t('admin.onu_stickers.tip_storm_title', 'Waspada Petir:') %></strong> <%= t('admin.onu_stickers.tip_storm', 'Cabut adaptor daya & kabel saat hujan lebat!') %></div>
                  </div>
                  <div class="tip-item">
                    <i class="bi bi-arrow-repeat" style="color:#2563eb"></i>
                    <div><strong><%= t('admin.onu_stickers.tip_reboot_title', 'Cara Reboot:') %></strong> <%= t('admin.onu_stickers.tip_reboot', 'Matikan power 10 detik, nyalakan kembali saat lambat.') %></div>
                  </div>
                  <div class="tip-item">
                    <i class="bi bi-exclamation-triangle-fill" style="color:#dc2626"></i>
                    <div><strong><%= t('admin.onu_stickers.tip_los_title', 'LOS Merah:') %></strong> <%= t('admin.onu_stickers.tip_los', 'Kabel optik bermasalah/putus, segera kontak CS.') %></div>
                  </div>
                </div>
              </div>

              <!-- Right: QR Code -->
              <div class="st-right">
                <img src="<%= item.qrCodeDataUrl %>" class="qr-img" alt="QR Server" />
                <div class="qr-label"><i class="bi bi-phone"></i> <%= t('admin.onu_stickers.qr_label', 'SCAN DI APLIKASI') %></div>
                <div class="qr-sub"><%= t('admin.onu_stickers.qr_sub', 'Auto-koneksi Server') %></div>
              </div>

            </div>

            <!-- 3. Footer -->
            <div class="st-footer">
              <div class="st-cs">
                <i class="bi bi-whatsapp"></i> <%= t('admin.onu_stickers.cs_label', 'CS / Bantuan') %>: <%= csPhone %>
              </div>
              <div class="st-notice">
                <%= t('admin.onu_stickers.notice', 'Tempel pada Modem Pelanggan') %>
              </div>
            </div>

          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

</body>
</html>
