<!DOCTYPE html>
<html lang="<%= lang || 'id' %>" data-app-theme="<%= typeof appTheme !== 'undefined' ? appTheme : 'current' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== 'undefined' ? brandVersion : 'zenradius' %>" type="image/png">
  <title><%= t('admin.onu_stickers.title', 'Cetak Stiker Modem / ONU') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/theme-tokens.css">
  <style>
    @page {
      size: A4 portrait;
      margin: 6mm 6mm;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      color: #142d35;
      background: #eaf0f1;
      padding: 28px 18px 40px;
    }

    /* Screen UI Controls (Hidden when printed) */
    .screen-controls {
      max-width: 1120px;
      margin: 0 auto 24px;
      background: #fff;
      border: 1px solid #d4e0e2;
      border-top: 4px solid #087e82;
      border-radius: 8px;
      padding: 22px 24px 18px;
      color: #142d35;
      box-shadow: 0 8px 24px rgba(20, 45, 53, .08);
    }
    .ctrl-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
      border-bottom: 1px solid #e1e9ea;
      padding-bottom: 16px;
      flex-wrap: wrap;
      gap: 10px;
    }
    .ctrl-title {
      font-size: 20px;
      font-weight: 750;
      display: flex;
      align-items: center;
      gap: 8px;
      color: #14535b;
    }
    .ctrl-title-copy { display:grid; gap:3px; }
    .ctrl-title-copy strong { color:var(--text); font-size:15px; font-weight:700; }
    .ctrl-title-copy small { color:var(--muted); font-size:11px; font-weight:400; line-height:1.4; }
    .ctrl-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      border: none;
      transition: all .15s ease;
    }
    .btn-primary {
      background: var(--primary);
      color: var(--bg);
      box-shadow: none;
    }
    .btn-primary:hover {
      background: var(--primary);
    }
    .btn-secondary {
      background: var(--bg2);
      color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-secondary:hover {
      background: var(--bg3);
    }
    .filter-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; align-items:end; padding:0 18px 18px; }
    .panel-section-label { display:block; padding:16px 18px 10px; color:var(--muted); font-size:10px; font-weight:700; letter-spacing:.6px; text-transform:uppercase; }
    .fg { min-width:0; margin:0; display:flex; flex-direction:column; gap:6px; }
    .fg .fl { margin:0; color:var(--muted); font-size:10px; font-weight:700; }
    .fg .fc { min-width:0; height:42px; padding:9px 12px; border-radius:7px; }
    .sticker-empty { min-height:150px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:24px; color:var(--muted); background:var(--panel); border:1px solid var(--border); border-radius:8px; text-align:center; }
    .sticker-empty i { color:var(--primary); font-size:26px; }
    .sticker-empty strong { color:var(--text); font-size:15px; }
    .sticker-empty span { font-size:12px; }
    .fg {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .fg label {
      font-size: 11px;
      font-weight: 700;
      color: #637c81;
      text-transform: uppercase;
      letter-spacing: 0;
    }
    .fg select, .fg input {
      background: #fff;
      border: 1px solid #cbd9db;
      color: #18363d;
      padding: 10px 11px;
      border-radius: 5px;
      font-size: 13px;
    }
    .fg select:focus, .fg input:focus { outline: 2px solid var(--pdim); border-color: var(--primary); }

    /* Print Page Container */
    .print-sheet {
      width: 198mm;
      min-height: 285mm;
      margin: 0 auto 20px;
      background: #ffffff;
      padding: 0;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
      border-radius: 4px;
      page-break-after: always;
      break-after: page;
    }

    .sticker-grid {
      display:grid;
      grid-template-columns:repeat(2, 94mm);
      justify-content:center;
      gap:3mm;
    }

    .sticker-card {
      width:94mm;
      height: 54mm;
      border: 0.35mm dashed #aab9ba;
      border-radius: 2mm;
      padding: 4mm 4.5mm 3.5mm;
      background: #ffffff;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      page-break-inside: avoid;
      break-inside: avoid;
      box-sizing: border-box;
    }

    @media print {
      body {
        background: #ffffff !important;
        padding: 0 !important;
      }
      .screen-controls {
        display: none !important;
      }
      .print-sheet {
        box-shadow: none !important;
        margin: 0 !important;
        padding: 0 !important;
        border-radius: 0 !important;
      }
      .sticker-card {
        border: 0.35mm dashed #aab9ba !important;
      }
    }
    @media (max-width: 900px) {
      .filter-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
    @media (max-width: 700px) {
      body { padding: 12px; }
      .screen-controls { padding: 16px; }
      .ctrl-header { align-items: flex-start; }
      .ctrl-title { font-size: 17px; }
      .ctrl-actions { width: 100%; }
      .ctrl-actions .btn { flex: 1; justify-content: center; }
      .print-sheet { transform-origin: top left; }
    }
    @media (max-width: 460px) {
      .filter-grid { grid-template-columns: 1fr; }
      .ctrl-actions { flex-direction: column; }
      .ctrl-actions .btn { width: 100%; }
    }
    .onu-print-page { background: var(--bg); color: var(--text); padding: 0; }
    .onu-print-page .screen-controls { max-width: none; margin: 0 0 18px; padding: 0; color: var(--text); background: var(--panel); border: 1px solid var(--border); border-top: 0; border-radius: 8px; box-shadow: none; }
    .onu-print-page .ctrl-header { margin: 0; padding: 14px 18px; border-bottom: 1px solid var(--border); }
    .onu-print-page .ctrl-title { color: var(--text); font-size: 16px; }
    .onu-print-page .ctrl-actions .btn { min-height: 38px; }
    .onu-print-page .filter-grid { padding:0 18px 18px; }
    .onu-print-page .panel-section-label { padding:16px 18px 10px; }
    .onu-print-page .fg label { color: var(--muted); }
    .onu-print-page .fg select, .onu-print-page .fg input { background: var(--bg2); color: var(--text); border-color: var(--border); }
    .onu-print-page .print-preview-head { display:flex; justify-content:space-between; align-items:center; gap:12px; margin: 0 0 10px; color: var(--muted); font-size:12px; }
    .onu-print-page .sheet-viewport { overflow-x:auto; padding: 0 0 14px; }
    .onu-print-page .print-sheet { width:198mm; min-height:285mm; box-shadow: 0 6px 24px rgba(8,35,62,.14); border:1px solid #d9e4eb; }
    .onu-print-page .sticker-card { --label-accent:var(--primary); --label-surface:var(--bg2); --label-surface-alt:var(--bg3); --label-ink:var(--text); --label-muted:var(--muted); --label-border:var(--border); display:flex; width:94mm; padding:0; height:54mm; border:0; border-radius:2.2mm; color:var(--label-ink); background:var(--label-surface); box-shadow:inset 0 0 0 .25mm var(--label-border); }
    .onu-print-page .sticker-card::before { content:""; position:absolute; top:0; left:0; right:0; height:1.3mm; background:linear-gradient(90deg, var(--label-accent) 0 62%, color-mix(in srgb, var(--label-accent) 40%, #d39a3b) 62% 100%); }
    .label-header { flex:0 0 auto; margin-top:1.3mm; padding:1.5mm 3mm 1.3mm; display:flex; justify-content:space-between; align-items:center; gap:3mm; color:var(--label-ink); background:var(--label-surface-alt); border-bottom:.25mm solid var(--label-border); }
    .label-brand { display:flex; align-items:center; gap:2mm; min-width:0; }
    .label-logo { display:block; width:auto; max-width:18mm; height:6.6mm; object-fit:contain; object-position:left center; }
    .label-brand-text { display:grid; gap:.35mm; min-width:0; }
    .label-company { max-width:46mm; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--label-ink); font-size:10.5px; font-weight:800; line-height:1.1; }
    .label-tagline { max-width:46mm; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--label-muted); font-size:6.3px; line-height:1.1; }
    .label-badge { flex:0 0 auto; display:inline-flex; align-items:center; gap:1mm; padding:.7mm 2mm; color:#fff; background:var(--label-accent); border-radius:99mm; font-size:6.4px; font-weight:800; white-space:nowrap; }
    .label-body { flex:1; min-height:0; display:flex; flex-direction:column; gap:1.1mm; padding:1.4mm 3mm; }
    .label-identity { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:center; gap:2mm; padding:1.2mm 2.2mm; background:color-mix(in srgb, var(--label-accent) 12%, var(--label-surface)); border:.25mm solid var(--label-border); border-radius:2mm; }
    .identity-rows { display:grid; gap:1.1mm; min-width:0; }
    .identity-row { display:grid; grid-template-columns:14mm 2mm minmax(0,1fr); align-items:baseline; gap:.6mm; color:var(--label-muted); font-size:7.6px; line-height:1.25; }
    .identity-row strong { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--label-ink); font-size:8.6px; font-weight:800; }
    .identity-qr { width:13mm; height:13mm; display:block; background:#fff; padding:.5mm; border-radius:1mm; }
    .label-steps { display:grid; grid-template-columns:1fr 1fr; gap:1.2mm 2mm; }
    .step-item { display:grid; grid-template-columns:4.4mm minmax(0,1fr); gap:1.2mm; align-items:start; min-width:0; }
    .step-num { width:4.4mm; height:4.4mm; display:flex; align-items:center; justify-content:center; color:#fff; background:var(--label-accent); border-radius:50%; font-size:6.4px; font-weight:800; }
    .step-copy { display:grid; gap:.3mm; min-width:0; }
    .step-copy strong { color:var(--label-ink); font-size:7px; font-weight:800; line-height:1.15; }
    .step-copy small { color:var(--label-muted); font-size:6.2px; line-height:1.18; }
    .label-benefit { display:flex; align-items:center; gap:1.6mm; padding:1mm 2.2mm; color:var(--label-ink); background:var(--label-surface-alt); border-radius:1.5mm; font-size:6.4px; line-height:1.2; }
    .label-benefit i { flex:0 0 auto; color:var(--label-accent); font-size:9px; }
    .label-benefit b { font-weight:800; }
    .label-footer { margin-top:auto; display:flex; justify-content:space-between; align-items:center; gap:2mm; padding:1.3mm 3mm; color:#fff; background:color-mix(in srgb, var(--label-accent) 62%, #06232f); border-radius:0 0 2.2mm 2.2mm; }
    .footer-contact { display:flex; flex-wrap:wrap; align-items:center; gap:.6mm 2.4mm; min-width:0; }
    .footer-item { display:inline-flex; align-items:center; gap:.9mm; font-size:6.2px; line-height:1.1; white-space:nowrap; }
    .footer-item i { font-size:8px; opacity:.92; }
    .footer-warn { display:inline-flex; align-items:center; gap:.9mm; font-size:5.8px; font-weight:700; white-space:nowrap; color:#ffe08a; }
    @media print {
      html, body.onu-print-page { width:210mm; min-width:210mm; margin:0 !important; padding:0 !important; background:#fff !important; }
      .onu-print-page .sb, .onu-print-page .topbar, .onu-print-page .screen-controls, .onu-print-page .print-preview-head, .onu-print-page .license-grace-bar { display:none !important; }
      .onu-print-page .mw, .onu-print-page .page, .onu-print-page .sheet-viewport { width:auto !important; max-width:none !important; margin:0 !important; padding:0 !important; overflow:visible !important; }
      .onu-print-page .print-sheet { width:198mm; min-height:285mm; margin:0 auto !important; padding:0 !important; border:0 !important; border-radius:0 !important; box-shadow:none !important; }
      .onu-print-page .sticker-card { -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important; }
      .onu-print-page .sticker-empty { display:none !important; }
    }
  </style>
</head>
<body class="onu-print-page">
<%- include('partials/sidebar', { activePage: 'onu_stickers', company }) %>
<div class="mw">
<%- include('partials/licenseGraceBar') %>
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-qr-code-scan"></i> <%= t('admin.onu_stickers.title', 'Cetak Stiker ONU') %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <div class="lang-dropdown">
        <button type="button" class="lang-btn" onclick="toggleLangDropdown(this)" aria-haspopup="true" aria-expanded="false">
          <i class="bi bi-globe"></i> <span><%= (lang || 'id').toUpperCase() %></span> <i class="bi bi-chevron-down" style="font-size:10px"></i>
        </button>
        <div class="lang-menu">
          <a href="/lang/id" class="lang-item <%= (lang || 'id') === 'id' ? 'active' : '' %>">Indonesia</a>
          <a href="/lang/en" class="lang-item <%= (lang || 'id') === 'en' ? 'active' : '' %>">English</a>
        </div>
      </div>
      <a href="/admin/logout" class="btn btn-g btn-sm" title="<%= t('common.logout', 'Logout') %>"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">

  <!-- Screen-only Controls -->
  <div class="screen-controls card">
    <div class="ctrl-header card-hd">
      <div class="ctrl-title">
        <i class="bi bi-qr-code-scan"></i><span class="ctrl-title-copy"><strong><%= t('admin.onu_stickers.heading', 'Cetak Stiker Modem / ONU') %></strong><small><%= t('admin.onu_stickers.heading_hint', 'Kelola data dan ukuran cetak dalam satu panel') %></small></span>
      </div>
      <div class="ctrl-actions">
        <button type="button" class="btn btn-p" onclick="window.print()" <%= stickers.length ? '' : 'disabled' %>>
          <i class="bi bi-printer-fill"></i> <%= t('admin.onu_stickers.print', 'Cetak Stiker (A4 / PDF)') %>
        </button>
        <a href="/admin/customers" class="btn btn-g">
          <i class="bi bi-arrow-left"></i> <%= t('admin.onu_stickers.back', 'Kembali') %>
        </a>
      </div>
    </div>
    <div class="card-bd">

    <form method="GET" action="/admin/onu-stickers" id="filterForm">
      <span class="panel-section-label"><%= t('admin.onu_stickers.filter_section', 'Filter & Ukuran Cetak') %></span>
      <div class="filter-grid">
        <div class="fg">
          <label class="fl"><%= t('admin.onu_stickers.filter_router', 'Filter Router') %></label>
          <select class="fc" name="router_id" onchange="this.form.submit()">
            <option value=""><%= t('admin.onu_stickers.all_routers', 'Semua Router') %></option>
            <% (routers || []).forEach(r => { %>
              <option value="<%= r.id %>" <%= String(selectedRouterId || '') === String(r.id) ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="fg">
          <label class="fl"><%= t('admin.onu_stickers.search', 'Cari Pelanggan') %></label>
          <input class="fc" type="search" name="q" value="<%= searchQuery || '' %>" placeholder="<%= t('admin.onu_stickers.search_placeholder', 'Ketik nama / ID...') %>" />
        </div>
        <div class="fg">
          <label class="fl"><%= t('admin.onu_stickers.sheet_size', 'Stiker per lembar A4') %></label>
          <select class="fc" name="page_size" onchange="this.form.submit()">
            <option value="10" <%= stickersPerPage === 10 ? 'selected' : '' %>>94 × 54 mm · 10 <%= t('admin.onu_stickers.per_sheet', 'per lembar') %></option>
            <option value="8" <%= stickersPerPage === 8 ? 'selected' : '' %>>94 × 54 mm · 8 <%= t('admin.onu_stickers.per_sheet', 'per lembar') %></option>
            <option value="6" <%= stickersPerPage === 6 ? 'selected' : '' %>>94 × 54 mm · 6 <%= t('admin.onu_stickers.per_sheet', 'per lembar') %></option>
            <option value="4" <%= stickersPerPage === 4 ? 'selected' : '' %>>94 × 54 mm · 4 <%= t('admin.onu_stickers.per_sheet', 'per lembar') %></option>
          </select>
        </div>
        <div class="fg">
          <label class="fl"><%= t('admin.onu_stickers.cs_phone', 'No. CS / WA Bantuan (Tampil di Stiker)') %></label>
          <input class="fc" type="text" name="cs_phone" value="<%= csPhone %>" placeholder="08xxxxxxxxxx" />
        </div>
      </div>
    </form>
  </div>
  </div>

  <div class="print-preview-head screen-only">
    <span><i class="bi bi-printer"></i> <%= t('admin.onu_stickers.preview', 'Pratinjau hasil cetak') %></span>
    <span><%= stickers.length %> <%= t('admin.onu_stickers.sticker_count', 'stiker') %> · 94 × 54 mm</span>
  </div>
  <div class="sheet-viewport">

  <% if (stickers.length > 0) { %>
  <!-- Personalized customer stickers sized for A4 -->
  <% 
    const STICKERS_PER_PAGE = stickersPerPage;
    const totalPages = Math.ceil(stickers.length / STICKERS_PER_PAGE);
    for (let pageIdx = 0; pageIdx < totalPages; pageIdx++) {
      const pageItems = stickers.slice(pageIdx * STICKERS_PER_PAGE, (pageIdx + 1) * STICKERS_PER_PAGE);
  %>
    <div class="print-sheet page-size-<%= stickersPerPage %>">
      <div class="sticker-grid">
        <% pageItems.forEach(item => { %>
          <div class="sticker-card">
            <header class="label-header">
              <div class="label-brand">
                <img src="/img/logo.png?v=<%= typeof brandVersion !== 'undefined' ? brandVersion : 'zenradius' %>" class="label-logo" alt="Logo <%= stickerBranding.name %>" onerror="this.onerror=null;this.src='/img/icon.png'">
                <span class="label-brand-text">
                  <span class="label-company"><%= stickerBranding.name %></span>
                  <% if (stickerBranding.tagline) { %><span class="label-tagline"><%= stickerBranding.tagline %></span><% } %>
                </span>
              </div>
              <span class="label-badge"><i class="bi bi-router-fill"></i> <%= t('admin.onu_stickers.badge', 'MODEM / ONU') %></span>
            </header>

            <div class="label-body">
              <div class="label-identity">
                <div class="identity-rows">
                  <% if (stickerFields.includes('customer_no')) { %><div class="identity-row"><span><%= t('admin.onu_stickers.field_no', 'No ID') %></span><span>:</span><strong><%= item.customer_no || '-' %></strong></div><% } %>
                  <% if (stickerFields.includes('name')) { %><div class="identity-row"><span><%= t('admin.onu_stickers.name_label', 'Nama') %></span><span>:</span><strong><%= item.name || '-' %></strong></div><% } %>
                </div>
                <img src="<%= item.qrCodeDataUrl %>" class="identity-qr" alt="<%= t('admin.onu_stickers.qr_label', 'Portal Pelanggan') %>">
              </div>

              <div class="label-steps">
                <div class="step-item"><span class="step-num">1</span><span class="step-copy"><strong><%= t('admin.onu_stickers.step_restart', 'Restart Modem') %></strong><small><%= t('admin.onu_stickers.step_restart_text', 'Matikan 30 detik lalu nyalakan kembali.') %></small></span></div>
                <div class="step-item"><span class="step-num">2</span><span class="step-copy"><strong><%= t('admin.onu_stickers.step_los', 'Cek Lampu LOS') %></strong><small><%= t('admin.onu_stickers.step_los_text', 'Jika merah menyala, hubungi CS.') %></small></span></div>
                <div class="step-item"><span class="step-num">3</span><span class="step-copy"><strong><%= t('admin.onu_stickers.step_devices', 'Cek Perangkat') %></strong><small><%= t('admin.onu_stickers.step_devices_text', 'Kurangi perangkat yang terhubung.') %></small></span></div>
                <div class="step-item"><span class="step-num">4</span><span class="step-copy"><strong><%= t('admin.onu_stickers.step_scan', 'Scan QR Bantuan') %></strong><small><%= t('admin.onu_stickers.step_scan_text', 'Akses portal pelanggan kapan saja.') %></small></span></div>
              </div>

              <div class="label-benefit"><i class="bi bi-wifi"></i><span><b><%= t('admin.onu_stickers.benefit_title', 'Internet stabil untuk keluarga Anda.') %></b> <%= t('admin.onu_stickers.benefit_text', 'Butuh bantuan? Hubungi layanan kami.') %></span></div>
            </div>

            <footer class="label-footer">
              <span class="footer-contact">
                <% if (stickerBranding.phone) { %><span class="footer-item"><i class="bi bi-telephone-fill"></i><%= stickerBranding.phone %></span><% } %>
                <% if (stickerBranding.email) { %><span class="footer-item"><i class="bi bi-envelope-fill"></i><%= stickerBranding.email %></span><% } %>
                <% if (stickerBranding.website) { %><span class="footer-item"><i class="bi bi-globe2"></i><%= stickerBranding.website %></span><% } %>
                <% (stickerBranding.socials || []).forEach(social => { %><span class="footer-item"><i class="bi <%= social.icon %>"></i><%= social.value %></span><% }) %>
              </span>
              <span class="footer-warn"><i class="bi bi-lightning-charge-fill"></i><%= t('admin.onu_stickers.footer_warn', 'Cabut saat hujan/petir') %></span>
            </footer>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
  <% } else { %>
    <div class="sticker-empty screen-only">
      <i class="bi bi-person-x"></i>
      <strong><%= t('admin.onu_stickers.empty_title', 'Pelanggan tidak ditemukan') %></strong>
