<!DOCTYPE html>
<html lang="<%= lang || 'id' %>" data-app-theme="<%= typeof appTheme !== 'undefined' ? appTheme : 'current' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== 'undefined' ? brandVersion : 'zenradius' %>" type="image/png">
  <title><%= t('admin.onu_stickers.title', 'Cetak Stiker Modem / ONU') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/theme-tokens.css">
  <style>
    @page {
      size: A4 portrait;
      margin: 6mm 6mm;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    body {
      font-family: "Segoe UI", Arial, sans-serif;
      color: #142d35;
      background: #eaf0f1;
      padding: 28px 18px 40px;
    }

    /* Screen UI Controls (Hidden when printed) */
    .screen-controls {
      max-width: 1120px;
      margin: 0 auto 24px;
      background: #fff;
      border: 1px solid #d4e0e2;
      border-top: 4px solid #087e82;
      border-radius: 8px;
      padding: 22px 24px 18px;
      color: #142d35;
      box-shadow: 0 8px 24px rgba(20, 45, 53, .08);
    }
    .ctrl-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
      border-bottom: 1px solid #e1e9ea;
      padding-bottom: 16px;
      flex-wrap: wrap;
      gap: 10px;
    }
    .ctrl-title {
      font-size: 20px;
      font-weight: 750;
      display: flex;
      align-items: center;
      gap: 8px;
      color: #14535b;
    }
    .ctrl-title-copy { display:grid; gap:3px; }
    .ctrl-title-copy strong { color:var(--text); font-size:15px; font-weight:700; }
    .ctrl-title-copy small { color:var(--muted); font-size:11px; font-weight:400; line-height:1.4; }
    .ctrl-actions {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      border: none;
      transition: all .15s ease;
    }
    .btn-primary {
      background: var(--primary);
      color: var(--bg);
      box-shadow: none;
    }
    .btn-primary:hover {
      background: var(--primary);
    }
    .btn-secondary {
      background: var(--bg2);
      color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-secondary:hover {
      background: var(--bg3);
    }
    .filter-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; align-items:end; padding:18px; }
    .fg { min-width:0; margin:0; display:flex; flex-direction:column; gap:6px; }
    .fg .fl { margin:0; color:var(--muted); font-size:10px; font-weight:700; }
    .fg .fc { min-width:0; height:42px; padding:9px 12px; border-radius:7px; }
    .sticker-fields { padding:0 18px 16px; }
    .fields-toolbar { display:flex; justify-content:space-between; align-items:center; gap:16px; padding:14px 0; border-top:1px solid var(--border); }
    .fields-title { display:block; color:var(--text); font-size:13px; font-weight:700; }
    .fields-subtitle { display:block; margin-top:3px; color:var(--muted); font-size:11px; line-height:1.4; }
    .fields-options { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
    .sticker-field { min-height:40px; display:flex; align-items:center; gap:9px; padding:9px 11px; color:var(--text); background:var(--bg2); border:1px solid var(--border); border-radius:7px; font-size:12px; cursor:pointer; transition:border-color .16s ease,background .16s ease; }
    .sticker-field:hover { border-color:var(--primary); background:var(--pdim); }
    .sticker-field input { flex:0 0 16px; width:16px; height:16px; margin:0; accent-color:var(--primary); }
    .fields-submit { flex:0 0 auto; min-height:38px; }
    .sticker-empty { min-height:150px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:24px; color:var(--muted); background:var(--panel); border:1px solid var(--border); border-radius:8px; text-align:center; }
    .sticker-empty i { color:var(--primary); font-size:26px; }
    .sticker-empty strong { color:var(--text); font-size:15px; }
    .sticker-empty span { font-size:12px; }
    .fg {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .fg label {
      font-size: 11px;
      font-weight: 700;
      color: #637c81;
      text-transform: uppercase;
      letter-spacing: 0;
    }
    .fg select, .fg input {
      background: #fff;
      border: 1px solid #cbd9db;
      color: #18363d;
      padding: 10px 11px;
      border-radius: 5px;
      font-size: 13px;
    }
    .fg select:focus, .fg input:focus { outline: 2px solid var(--pdim); border-color: var(--primary); }

    /* Print Page Container */
    .print-sheet {
      width: 198mm;
      min-height: 285mm;
      margin: 0 auto 20px;
      background: #ffffff;
      padding: 0;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
      border-radius: 4px;
      page-break-after: always;
      break-after: page;
    }

    .sticker-grid {
      display:grid;
      grid-template-columns:repeat(2, 94mm);
      justify-content:center;
      gap:3mm;
    }

    .sticker-card {
      width:94mm;
      height: 54mm;
      border: 0.35mm dashed #aab9ba;
      border-radius: 2mm;
      padding: 4mm 4.5mm 3.5mm;
      background: #ffffff;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      page-break-inside: avoid;
      break-inside: avoid;
      box-sizing: border-box;
    }

    .sticker-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1.5mm;
      background: linear-gradient(90deg, #087e82 0 68%, #d39a3b 68% 100%);
    }

    /* Header */
    .st-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      border-bottom: 0.3mm solid #dce5e5;
      padding-bottom: 2mm;
      margin-bottom: 1mm;
    }
    .st-brand {
      display: flex;
      align-items: center;
      gap: 6px;
      min-width: 0;
    }
    .st-logo {
      height: 8mm;
      max-width: 26mm;
      object-fit: contain;
      object-position: left center;
    }
    .st-company {
      font-size: 10px;
      font-weight: 900;
      color: #0f172a;
      line-height: 1.1;
      text-transform: uppercase;
      max-width: 70mm;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .st-badge {
      font-size: 8px;
      font-weight: 700;
      color: #14535b;
      background: #e8f3f1;
      padding: 1.2mm 2mm;
      border-radius: 2mm;
      border: 0.25mm solid #c6dfdc;
      white-space: nowrap;
    }

    /* Body 2 Columns */
    .st-body {
      display: flex;
      gap: 2.5mm;
      align-items: stretch;
      flex: 1;
      margin: 1.5mm 0;
    }

    /* Left Side: Cust details & Guidance */
    .st-left {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 1.5mm;
      min-width: 0;
    }

    .cust-info-box {
      background: #f5f8f7;
      border: 0.25mm solid #e0e8e7;
      border-radius: 1.5mm;
      padding: 2mm 2.5mm;
      line-height: 1.45;
    }
    .cust-row {
      display: flex;
      align-items: baseline;
      font-size: 8.4px;
      color: #3b5559;
    }
    .cust-row .label {
      width: 13mm;
      color: #657b7e;
      font-weight: 700;
      flex-shrink: 0;
    }
    .cust-row .val {
      font-weight: 800;
      color: #17363c;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* Important Warnings / Tips Box */
    .tips-box {
      background: #fbf7ed;
      border: 0.25mm solid #eadbb8;
      border-radius: 1.5mm;
      padding: 2mm 2.5mm;
      display: flex;
      flex-direction: column;
      justify-content: space-evenly;
      gap: 1.4mm;
      flex: 1;
    }
    .tip-item {
      display: flex;
      align-items: flex-start;
      gap: 1.5mm;
      font-size: 8.1px;
      color: #665633;
      line-height: 1.3;
    }
    .tip-item i {
      font-size: 10px;
      flex-shrink: 0;
      margin-top: 0.5px;
    }
    .tip-item strong {
      color: #74551c;
      font-weight: 800;
      letter-spacing: 0;
    }

    /* Right Side: QR Code */
    .st-right {
      width: 30mm;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: #f4f8f7;
      border: 0.3mm solid #dce8e6;
      border-radius: 2mm;
      padding: 1.5mm;
      flex-shrink: 0;
    }
    .qr-img {
      width: 23mm;
      height: 23mm;
      object-fit: contain;
      display: block;
    }
    .qr-label {
      font-size: 7.5px;
      font-weight: 900;
      color: #087e82;
      text-transform: uppercase;
        letter-spacing: 0;
      margin-top: 1px;
      line-height: 1.1;
    }
    .qr-sub {
      font-size: 6.5px;
      color: #64748b;
      line-height: 1;
      margin-top: 0.5px;
    }

    /* Footer */
    .st-footer {
      border-top: 0.25mm solid #dce5e5;
      padding-top: 1.5mm;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 7.5px;
      color: #475569;
    }
    .st-cs {
      display: flex;
      align-items: center;
      gap: 3px;
      font-weight: 800;
      color: #176b59;
    }
    .st-cs i {
      color: #23876f;
      font-size: 8.5px;
    }
    .st-notice {
      color: #788b8e;
      font-size: 6.8px;
    }

    @media print {
      body {
        background: #ffffff !important;
        padding: 0 !important;
      }
      .screen-controls {
        display: none !important;
      }
      .print-sheet {
        box-shadow: none !important;
        margin: 0 !important;
        padding: 0 !important;
        border-radius: 0 !important;
      }
      .sticker-card {
        border: 0.35mm dashed #aab9ba !important;
      }
    }
    @media (max-width: 900px) {
      .filter-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
      .fields-options { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
    @media (max-width: 700px) {
      body { padding: 12px; }
      .screen-controls { padding: 16px; }
      .ctrl-header { align-items: flex-start; }
      .ctrl-title { font-size: 17px; }
      .ctrl-actions { width: 100%; }
      .ctrl-actions .btn { flex: 1; justify-content: center; }
      .print-sheet { transform-origin: top left; }
    }
    @media (max-width: 460px) {
      .filter-grid { grid-template-columns: 1fr; }
      .ctrl-actions { flex-direction: column; }
      .ctrl-actions .btn { width: 100%; }
      .fields-toolbar { align-items:flex-start; flex-direction:column; gap:10px; }
      .fields-submit { width:100%; justify-content:center; }
      .fields-options { grid-template-columns:1fr; }
    }
    .onu-print-page { background: var(--bg); color: var(--text); padding: 0; }
    .onu-print-page .screen-controls { max-width: none; margin: 0 0 18px; padding: 0; color: var(--text); background: var(--panel); border: 1px solid var(--border); border-top: 0; border-radius: 8px; box-shadow: none; }
    .onu-print-page .ctrl-header { margin: 0; padding: 14px 18px; border-bottom: 1px solid var(--border); }
    .onu-print-page .ctrl-title { color: var(--text); font-size: 16px; }
    .onu-print-page .ctrl-actions .btn { min-height: 38px; }
    .onu-print-page .filter-grid { padding:18px; }
    .onu-print-page .sticker-fields { padding:0 18px 16px; }
    .onu-print-page .fg label { color: var(--muted); }
    .onu-print-page .fg select, .onu-print-page .fg input { background: var(--bg2); color: var(--text); border-color: var(--border); }
    .onu-print-page .screen-hint { padding: 0 18px 16px; color: var(--muted); font-size: 12px; }
    .onu-print-page .print-preview-head { display:flex; justify-content:space-between; align-items:center; gap:12px; margin: 0 0 10px; color: var(--muted); font-size:12px; }
    .onu-print-page .sheet-viewport { overflow-x:auto; padding: 0 0 14px; }
    .onu-print-page .print-sheet { width:198mm; min-height:285mm; box-shadow: 0 6px 24px rgba(8,35,62,.14); border:1px solid #d9e4eb; }
    .onu-print-page .sticker-card { --label-accent:var(--primary); --label-surface:var(--bg2); --label-surface-alt:var(--bg3); --label-ink:var(--text); --label-muted:var(--muted); --label-border:var(--border); display:flex; width:94mm; padding:0; height:54mm; border:0; border-radius:2.2mm; color:var(--label-ink); background:var(--label-surface); box-shadow:inset 0 0 0 .25mm var(--label-border); }
    .onu-print-page .sticker-card::before { display:none; }
    .label-header { height:9.5mm; flex:0 0 9.5mm; padding:1.2mm 3mm; display:flex; justify-content:space-between; align-items:center; gap:4mm; color:var(--label-ink); background:var(--label-surface-alt); border-radius:2.2mm 2.2mm 0 0; position:relative; overflow:hidden; }
    .label-header::after { content:""; position:absolute; height:1.2mm; width:35mm; right:14mm; bottom:-.6mm; background:var(--label-accent); transform:skewX(-35deg); }
    .label-brand { display:flex; align-items:center; min-width:0; }
    .label-logo { display:block; width:auto; max-width:44mm; height:7mm; object-fit:contain; object-position:left center; }
    .label-company { max-width:65mm; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--label-ink); font-size:12px; font-weight:800; }
    .label-tagline { max-width:52mm; color:var(--label-muted); font-size:8px; line-height:1.2; text-align:right; }
    .label-content { flex:1; min-height:0; padding:1.2mm 2.5mm 1mm; display:flex; flex-direction:column; gap:1mm; }
    .label-top { display:grid; grid-template-columns:1.1fr 1fr; gap:2mm; height:25mm; min-height:0; }
    .label-bottom { display:flex; flex-direction:column; gap:1mm; flex:1; min-height:0; }
    .label-panel { min-width:0; border:.25mm solid var(--label-border); border-radius:2mm; background:var(--label-surface); color:var(--label-ink); overflow:hidden; }
    .label-panel-title { min-height:5mm; margin:0; padding:0 2.2mm; display:flex; align-items:center; gap:1.4mm; color:var(--label-ink); font-size:8.5px; font-weight:800; line-height:1.15; }
    .label-panel-title i { flex:0 0 auto; color:var(--label-accent); font-size:12px; }
    .customer-lines { padding:0 2.2mm 1mm; display:grid; gap:1.8mm; }
    .customer-line { display:grid; grid-template-columns:15mm 2mm minmax(0,1fr); align-items:baseline; gap:.7mm; color:var(--label-muted); font-size:8.8px; line-height:1.3; }
    .customer-line strong { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--label-ink); font-size:9.3px; font-weight:700; }
    .help-panel { display:flex; flex-direction:column; padding:1mm 1.4mm; background:var(--label-surface-alt); }
    .help-heading { min-height:4.5mm; margin:0; display:flex; align-items:center; gap:1.3mm; color:var(--label-ink); font-size:8.5px; font-weight:800; }
    .help-heading i { color:var(--label-accent); font-size:12px; }
    .help-body { display:grid; grid-template-columns:18mm minmax(0,1fr); gap:1.4mm; align-items:center; flex:1; min-height:0; }
    .help-qr { width:17mm; height:17mm; display:block; background:#fff; padding:.6mm; border-radius:1mm; }
    .help-meta { display:grid; gap:1.5mm; min-width:0; }
    .help-row { display:grid; grid-template-columns:3.4mm minmax(0,1fr); gap:1mm; align-items:center; color:var(--label-muted); font-size:6.8px; line-height:1.2; overflow-wrap:anywhere; }
    .help-row i { color:var(--label-accent); font-size:9px; }
    .help-row strong { display:block; color:var(--label-ink); font-size:7px; }
    .help-qr-label { margin-top:.5mm; color:var(--label-ink); text-align:center; font-size:5.8px; font-weight:700; line-height:1.15; }
    .led-strip { min-height:10mm; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); align-items:center; gap:1mm; padding:1mm 2mm; background:var(--label-surface-alt); border:.25mm solid var(--label-border); border-radius:1.5mm; }
    .led-chip { min-width:0; display:grid; grid-template-columns:2.2mm minmax(0,1fr); align-items:start; gap:1mm; color:var(--label-ink); font-size:7px; line-height:1.1; }
    .led-chip-copy { display:grid; gap:.5mm; }
    .led-chip-copy strong { font-size:7px; font-weight:800; }
    .led-chip-copy small { color:var(--label-muted); font-size:6.2px; line-height:1.15; }
    .led-dot { width:2.2mm; height:2.2mm; flex:0 0 2.2mm; border-radius:50%; box-shadow:0 0 0 .25mm rgba(0,0,0,.07); }
    .led-green { background:#20bf82; }.led-blue { background:#1599e5; }.led-red { background:#e7474b; }
    .quick-tip { min-height:7mm; display:flex; align-items:flex-start; gap:1.5mm; padding:1mm 2mm; color:var(--label-muted); font-size:7.2px; line-height:1.25; }
    .quick-tip i { flex:0 0 auto; color:var(--label-accent); font-size:10px; }
    .quick-tip-copy { display:grid; gap:.4mm; }
    .quick-tip-copy strong { color:var(--label-ink); font-size:7.4px; }
    @media print {
      html, body.onu-print-page { width:210mm; min-width:210mm; margin:0 !important; padding:0 !important; background:#fff !important; }
      .onu-print-page .sb, .onu-print-page .topbar, .onu-print-page .screen-controls, .onu-print-page .print-preview-head, .onu-print-page .license-grace-bar { display:none !important; }
      .onu-print-page .mw, .onu-print-page .page, .onu-print-page .sheet-viewport { width:auto !important; max-width:none !important; margin:0 !important; padding:0 !important; overflow:visible !important; }
      .onu-print-page .print-sheet { width:198mm; min-height:285mm; margin:0 auto !important; padding:0 !important; border:0 !important; border-radius:0 !important; box-shadow:none !important; }
      .onu-print-page .sticker-card { -webkit-print-color-adjust:exact !important; print-color-adjust:exact !important; }
      .onu-print-page .sticker-empty { display:none !important; }
    }
  </style>
</head>
<body class="onu-print-page">
<%- include('partials/sidebar', { activePage: 'onu_stickers', company }) %>
<div class="mw">
<%- include('partials/licenseGraceBar') %>
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-qr-code-scan"></i> <%= t('admin.onu_stickers.title', 'Cetak Stiker ONU') %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <div class="lang-dropdown">
        <button type="button" class="lang-btn" onclick="toggleLangDropdown(this)" aria-haspopup="true" aria-expanded="false">
          <i class="bi bi-globe"></i> <span><%= (lang || 'id').toUpperCase() %></span> <i class="bi bi-chevron-down" style="font-size:10px"></i>
        </button>
        <div class="lang-menu">
          <a href="/lang/id" class="lang-item <%= (lang || 'id') === 'id' ? 'active' : '' %>">Indonesia</a>
          <a href="/lang/en" class="lang-item <%= (lang || 'id') === 'en' ? 'active' : '' %>">English</a>
        </div>
      </div>
      <a href="/admin/logout" class="btn btn-g btn-sm" title="<%= t('common.logout', 'Logout') %>"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </div>
  <div class="page">

  <!-- Screen-only Controls -->
  <div class="screen-controls card">
    <div class="ctrl-header card-hd">
      <div class="ctrl-title">
        <i class="bi bi-qr-code-scan"></i><span class="ctrl-title-copy"><strong><%= t('admin.onu_stickers.heading', 'Cetak Stiker Modem / ONU') %></strong><small><%= t('admin.onu_stickers.heading_hint', 'Kelola data dan ukuran cetak dalam satu panel') %></small></span>
      </div>
      <div class="ctrl-actions">
        <button type="button" class="btn btn-p" onclick="window.print()" <%= stickers.length ? '' : 'disabled' %>>
          <i class="bi bi-printer-fill"></i> <%= t('admin.onu_stickers.print', 'Cetak Stiker (A4 / PDF)') %>
        </button>
        <a href="/admin/customers" class="btn btn-g">
          <i class="bi bi-arrow-left"></i> <%= t('admin.onu_stickers.back', 'Kembali') %>
        </a>
      </div>
    </div>
    <div class="card-bd">

    <form method="GET" action="/admin/onu-stickers" id="filterForm">
      <div class="filter-grid">
        <div class="fg">
          <label class="fl"><%= t('admin.onu_stickers.filter_router', 'Filter Router') %></label>
          <select class="fc" name="router_id">
            <option value=""><%= t('admin.onu_stickers.all_routers', 'Semua Router') %></option>
            <% (routers || []).forEach(r => { %>
              <option value="<%= r.id %>" <%= String(selectedRouterId || '') === String(r.id) ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="fg">
          <label class="fl"><%= t('admin.onu_stickers.search', 'Cari Pelanggan') %></label>
          <input class="fc" type="search" name="q" value="<%= searchQuery || '' %>" placeholder="<%= t('admin.onu_stickers.search_placeholder', 'Ketik nama / ID...') %>" />
        </div>
        <div class="fg">
          <label class="fl"><%= t('admin.onu_stickers.sheet_size', 'Stiker per lembar A4') %></label>
          <select class="fc" name="page_size">
            <option value="10" <%= stickersPerPage === 10 ? 'selected' : '' %>>94 × 54 mm · 10 <%= t('admin.onu_stickers.per_sheet', 'per lembar') %></option>
            <option value="8" <%= stickersPerPage === 8 ? 'selected' : '' %>>94 × 54 mm · 8 <%= t('admin.onu_stickers.per_sheet', 'per lembar') %></option>
            <option value="6" <%= stickersPerPage === 6 ? 'selected' : '' %>>94 × 54 mm · 6 <%= t('admin.onu_stickers.per_sheet', 'per lembar') %></option>
            <option value="4" <%= stickersPerPage === 4 ? 'selected' : '' %>>94 × 54 mm · 4 <%= t('admin.onu_stickers.per_sheet', 'per lembar') %></option>
          </select>
        </div>
        <div class="fg">
          <label class="fl"><%= t('admin.onu_stickers.cs_phone', 'No. CS / WA Bantuan (Tampil di Stiker)') %></label>
          <input class="fc" type="text" name="cs_phone" value="<%= csPhone %>" placeholder="08xxxxxxxxxx" />
        </div>
      </div>
      <input type="hidden" name="fields_configured" value="1">
      <div class="sticker-fields">
        <div class="fields-toolbar">
          <div><span class="fields-title"><%= t('admin.onu_stickers.fields_title', 'Data yang dicetak') %></span><small class="fields-subtitle"><%= t('admin.onu_stickers.fields_hint', 'Pilih informasi pelanggan yang ingin ditampilkan pada setiap stiker.') %></small></div>
          <button type="submit" class="btn btn-p fields-submit"><i class="bi bi-funnel"></i> <%= t('admin.onu_stickers.apply', 'Tampilkan') %></button>
        </div>
        <div class="fields-options">
          <label class="sticker-field"><input type="checkbox" name="fields" value="customer_no" <%= stickerFields.includes('customer_no') ? 'checked' : '' %>><span><%= t('admin.onu_stickers.field_no', 'No ID') %></span></label>
          <label class="sticker-field"><input type="checkbox" name="fields" value="name" <%= stickerFields.includes('name') ? 'checked' : '' %>><span><%= t('admin.onu_stickers.name_label', 'Nama') %></span></label>
        </div>
      </div>
    </form>
    <div class="screen-hint" style="display:flex;align-items:center;gap:6px;">
      <i class="bi bi-info-circle"></i>
      <%= t('admin.onu_stickers.hint', 'Ukuran setiap stiker 94 × 54 mm. Ukuran bodi ONU ZTE/Huawei berbeda tiap model; ukur area datar sebelum menempel. Saat mencetak A4, pilih skala 100% / Actual size.') %>
    </div>
  </div>
  </div>

  <div class="print-preview-head screen-only">
    <span><i class="bi bi-printer"></i> <%= t('admin.onu_stickers.preview', 'Pratinjau hasil cetak') %></span>
    <span><%= stickers.length %> <%= t('admin.onu_stickers.sticker_count', 'stiker') %> · 94 × 54 mm</span>
  </div>
  <div class="sheet-viewport">

  <% if (stickers.length > 0) { %>
  <!-- Personalized customer stickers sized for A4 -->
  <% 
    const STICKERS_PER_PAGE = stickersPerPage;
    const totalPages = Math.ceil(stickers.length / STICKERS_PER_PAGE);
    for (let pageIdx = 0; pageIdx < totalPages; pageIdx++) {
      const pageItems = stickers.slice(pageIdx * STICKERS_PER_PAGE, (pageIdx + 1) * STICKERS_PER_PAGE);
  %>
    <div class="print-sheet page-size-<%= stickersPerPage %>">
      <div class="sticker-grid">
        <% pageItems.forEach(item => { %>
          <div class="sticker-card">
            <header class="label-header">
              <div class="label-brand">
                <% if (hasCustomLogo) { %>
                  <img src="/img/logo.png?v=<%= typeof brandVersion !== 'undefined' ? brandVersion : 'zenradius' %>" class="label-logo" alt="Logo <%= company %>">
                <% } else { %>
                  <span class="label-company"><%= company %></span>
                <% } %>
              </div>
              <div class="label-tagline"><%= typeof brandTagline !== 'undefined' && brandTagline ? brandTagline : t('admin.onu_stickers.tagline', 'Internet Lancar, Hidup Makin Mudah') %></div>
            </header>

            <div class="label-content">
              <div class="label-top">
                <section class="label-panel customer-panel">
                  <h3 class="label-panel-title"><i class="bi bi-person-vcard"></i> <%= t('admin.onu_stickers.customer_info', 'Informasi Pelanggan') %></h3>
                  <div class="customer-lines">
                    <% if (stickerFields.includes('customer_no')) { %><div class="customer-line"><span><%= t('admin.onu_stickers.field_no', 'No ID') %></span><span>:</span><strong><%= item.customer_no || '-' %></strong></div><% } %>
                    <% if (stickerFields.includes('name')) { %><div class="customer-line"><span><%= t('admin.onu_stickers.name_label', 'Nama') %></span><span>:</span><strong><%= item.name || '-' %></strong></div><% } %>
                  </div>
                </section>

                <section class="label-panel help-panel">
                  <h3 class="help-heading"><i class="bi bi-qr-code-scan"></i> <%= t('admin.onu_stickers.help_title', 'Scan / Bantuan') %></h3>
                  <div class="help-body">
                    <div>
                      <img src="<%= item.qrCodeDataUrl %>" class="help-qr" alt="QR Portal Pelanggan">
                      <div class="help-qr-label"><%= t('admin.onu_stickers.qr_label', 'Portal Pelanggan') %></div>
                    </div>
                    <div class="help-meta">
                      <div class="help-row"><i class="bi bi-whatsapp"></i><span><strong>WhatsApp</strong><%= csPhone %></span></div>
                      <div class="help-row"><i class="bi bi-clock"></i><span><strong><%= t('admin.onu_stickers.hours_label', 'Jam Operasional') %></strong><%= settings.operational_hours || '08.00 - 22.00 WIB' %></span></div>
                    </div>
                  </div>
                </section>
              </div>

              <div class="label-bottom">
                <div class="led-strip" aria-label="<%= t('admin.onu_stickers.led_title', 'Indikator LED') %>">
                  <span class="led-chip"><i class="led-dot led-green"></i><span class="led-chip-copy"><strong>Power</strong><small><%= t('admin.onu_stickers.led_power_copy', 'Hijau: modem menyala') %></small></span></span>
                  <span class="led-chip"><i class="led-dot led-blue"></i><span class="led-chip-copy"><strong>Internet</strong><small><%= t('admin.onu_stickers.led_internet_copy', 'Biru: internet terhubung') %></small></span></span>
                  <span class="led-chip"><i class="led-dot led-green"></i><span class="led-chip-copy"><strong>Wi-Fi</strong><small><%= t('admin.onu_stickers.led_wifi_copy', 'Hijau: Wi-Fi aktif') %></small></span></span>
                  <span class="led-chip"><i class="led-dot led-red"></i><span class="led-chip-copy"><strong>LOS</strong><small><%= t('admin.onu_stickers.led_los_copy', 'Merah: sinyal optik terganggu') %></small></span></span>
                </div>
                <div class="quick-tip"><i class="bi bi-info-circle-fill"></i><span class="quick-tip-copy"><strong><%= t('admin.onu_stickers.quick_tip_title', 'Koneksi bermasalah?') %></strong><span><%= t('admin.onu_stickers.quick_tip', 'Matikan modem 30 detik lalu nyalakan kembali. Jika LOS merah tetap menyala, hubungi CS.') %></span></span></div>
              </div>
            </div>

          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
  <% } else { %>
    <div class="sticker-empty screen-only">
      <i class="bi bi-person-x"></i>
      <strong><%= t('admin.onu_stickers.empty_title', 'Pelanggan tidak ditemukan') %></strong>
      <span><%= t('admin.onu_stickers.empty_hint', 'Ubah pencarian atau filter router untuk menampilkan stiker.') %></span>
    </div>
  <% } %>
  </div>
  </div>
  </div>

</body>
</html>
