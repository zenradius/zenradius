<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
  <meta name="theme-color" content="#173945">
  <title><%= t('common.login', 'Login') %> Admin | <%= company %></title>
  <link rel="manifest" href="/manifest-admin.webmanifest">
  <link rel="icon" href="/img/icon.png" type="image/png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{height:100%}
    body{
      font-family:'DM Sans',system-ui,sans-serif;
      background:#173945;
      background-image:radial-gradient(circle at 8% 0%,#236060 0%,transparent 34%),radial-gradient(circle at 100% 100%,#173e4d 0%,transparent 42%),linear-gradient(135deg,#173740 0%,#183f51 52%,#194251 100%);
      display:flex;align-items:center;justify-content:center;
      min-height:100vh;min-height:100dvh;padding:24px;color:#edf7f5;
    }
    .wrap{width:100%;max-width:420px;display:flex;flex-direction:column;align-items:center;gap:0}
    .card{
      width:100%;background:#173945;border:1px solid rgba(190,239,255,.28);
      border-radius:16px;padding:38px 32px 28px;box-shadow:0 20px 48px rgba(3,14,20,.45);
      display:flex;flex-direction:column;align-items:center;
    }
    .logo{width:min(220px,72%);height:auto;object-fit:contain;display:block;margin:0 auto 16px}
    .sub{font-size:13px;color:rgba(237,250,250,.72);font-weight:600;letter-spacing:.02em;margin-bottom:6px;text-align:center}
    .copy{font-size:12px;color:rgba(237,250,250,.58);text-align:center;line-height:1.6;max-width:300px;margin:0 auto 26px}
    .alert-d{width:100%;background:rgba(248,81,73,.1);color:#ff7b72;border:1px solid rgba(248,81,73,.22);padding:11px 12px;border-radius:10px;font-size:13px;display:flex;align-items:center;gap:10px;margin-bottom:18px}
    form{width:100%;max-width:320px;display:flex;flex-direction:column;align-items:stretch}
    .fg{margin-bottom:16px;width:100%}
    .fg:last-of-type{margin-bottom:22px}
    .fl{font-size:11px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#d9fffb;margin-bottom:7px;display:block;text-align:left}
    .field{position:relative;width:100%}
    .field i{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:rgba(190,239,255,.7);font-size:15px;pointer-events:none}
    .fc{
      width:100%;padding:12px 14px 12px 40px;font-size:14px;color:#f0fdfa;
      background:rgba(255,255,255,.06);border:1px solid rgba(190,239,255,.22);border-radius:10px;
      outline:none;transition:border-color .2s,box-shadow .2s,background .2s;
    }
    .fc::placeholder{color:rgba(237,250,250,.38)}
    .fc:focus{background:rgba(255,255,255,.09);border-color:rgba(45,212,191,.55);box-shadow:0 0 0 3px rgba(45,212,191,.14);color:#fff}
    .btn-p{
      align-self:center;min-width:160px;max-width:220px;padding:10px 22px;font-size:13px;font-weight:800;
      color:#f4fffd;background:linear-gradient(135deg,#236060 0%,#183f51 52%,#194251 100%);border:1px solid rgba(126,231,219,.48);border-radius:10px;box-shadow:0 8px 20px rgba(10,41,50,.24);
      display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:all .25s;
    }
    .btn-p:hover{background:linear-gradient(135deg,#2d7774 0%,#1d5264 52%,#205b68 100%)!important;border-color:rgba(166,247,235,.72)!important;color:#fff!important;filter:brightness(1.04);transform:translateY(-1px)}
    .back{margin-top:18px;font-size:12px;color:rgba(237,250,250,.62);text-decoration:none;display:inline-flex;align-items:center;gap:6px}
    .back:hover{color:#7dd3fc}
    .foot{margin-top:16px;padding-top:14px;border-top:1px solid rgba(190,239,255,.12);font-size:11px;color:rgba(237,250,250,.48);text-align:center;width:100%}
    
    /* Eye Toggle Button */
    .eye-toggle {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: rgba(190, 239, 255, 0.72);
      cursor: pointer;
      padding: 0;
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      transition: all 0.2s ease;
      border-radius: 6px;
      box-shadow: none;
    }
    
    .eye-toggle:hover {
      color: rgba(45, 212, 191, 0.95);
      background: transparent;
      border: none;
      box-shadow: none;
    }
    
    .eye-toggle:active {
      transform: translateY(-50%) scale(0.96);
    }
    
    .password-field-wrapper {
      position: relative;
      width: 100%;
    }

    .fc.with-eye {
      padding-right: 42px;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <img class="logo" src="/img/logo.png?v=zenradius" alt="ZenRadius" onerror="this.src='/img/icon.png'">
      <p class="sub">Pusat Administrasi</p>
      <p class="copy">Kelola jaringan, pelanggan, tagihan, dan layanan dari satu pusat administrasi.</p>
      <% if (typeof error !=='undefined' && error) { %>
        <div class="alert-d"><i class="bi bi-exclamation-circle"></i><span><%= error %></span></div>
      <% } %>
      <form method="POST" action="<%= typeof loginAction !== 'undefined' ? loginAction : '/admin/login' %>">
        <div class="fg">
          <label class="fl" for="admin-username"><%= t('admin.login.username', 'Username') %></label>
          <div class="field"><i class="bi bi-person"></i><input class="fc" id="admin-username" name="username" placeholder="admin" required autocomplete="username"></div>
        </div>
        <div class="fg">
          <label class="fl" for="admin-password"><%= t('admin.login.password', 'Password') %></label>
          <div class="field">
            <i class="bi bi-key"></i>
            <input class="fc" id="admin-password" type="password" name="password" placeholder="••••••••" required autocomplete="current-password">
            <button type="button" class="eye-toggle" data-target="admin-password" title="Tampilkan/Sembunyikan password">
              <i class="bi bi-eye"></i>
            </button>
          </div>
        </div>
        <button type="submit" class="btn-p"><i class="bi bi-box-arrow-in-right"></i> <%= t('admin.login.sign_in', 'Masuk Sekarang') %></button>
      </form>
      <div style="margin-top: 16px; margin-bottom: 8px;">
        <button type="button" id="btn-install-pwa" class="btn btn-sm d-inline-flex align-items-center gap-2 px-3 py-2 fw-bold" style="background: rgba(45, 212, 191, 0.08); border: 1px solid rgba(126, 231, 219, 0.38); color: #d9fffb; border-radius: 9px; font-size: 12px; transition: all 0.25s;" onmouseover="this.style.background='rgba(45, 212, 191, 0.16)'" onmouseout="this.style.background='rgba(45, 212, 191, 0.08)'">
          <i class="bi bi-download"></i> Aplikasi Admin
        </button>
      </div>

      <!-- PWA Install Modal -->
      <div class="modal fade" id="pwaInstallModal" tabindex="-1" aria-hidden="true" style="text-align: left;">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 480px; width: 100%;">
          <div class="modal-content text-white shadow-2xl" style="background: linear-gradient(145deg, #173945 0%, #0f2a36 100%); border: 1px solid rgba(190, 239, 255, 0.25)!important; border-radius: 20px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);">
            <div class="modal-header border-0 pb-0" style="padding: 24px 24px 10px;">
              <h5 class="modal-title fw-bold d-flex align-items-center gap-2" style="font-family: inherit; font-size: 1.25rem;">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 32px; height: 32px; background: rgba(45, 212, 191, 0.15); color: #2dd4bf;">
                  <i class="bi bi-phone-vibrate-fill"></i>
                </span>
                Pasang Aplikasi Portal
              </h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="opacity: 0.7; transition: opacity 0.15s;"></button>
            </div>
            
            <div class="modal-body px-4 py-3" style="font-family: inherit;">
              <p class="small mb-4" style="color: rgba(237, 250, 250, 0.85); font-size: 0.88rem; line-height: 1.6;">
                Dapatkan akses instan, cepat, dan hemat kuota ke sistem layanan <strong style="color: #2dd4bf;"><%= company || 'ZenRadius' %></strong> langsung dari layar utama ponsel Anda tanpa harus membuka browser lagi.
              </p>

              <!-- Tab Navigation for Platforms -->
              <ul class="nav nav-pills mb-3 gap-2" id="pwaTab" role="tablist" style="border-bottom: 0; display: flex; width: 100%;">
                <li class="nav-item" role="presentation" style="flex: 1;">
                  <button class="nav-link active w-100 d-flex align-items-center justify-content-center gap-2 py-2.5 rounded-3 fw-bold border-0 fs-7" id="android-tab" data-bs-toggle="pill" data-bs-target="#pwa-android" type="button" role="tab" aria-controls="pwa-android" aria-selected="true" style="font-size: 0.8rem; background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.7); outline: none;">
                    <i class="bi bi-android2 text-success"></i> ANDROID / PC
                  </button>
                </li>
                <li class="nav-item" role="presentation" style="flex: 1;">
                  <button class="nav-link w-100 d-flex align-items-center justify-content-center gap-2 py-2.5 rounded-3 fw-bold border-0 fs-7" id="ios-tab" data-bs-toggle="pill" data-bs-target="#pwa-ios" type="button" role="tab" aria-controls="pwa-ios" aria-selected="false" style="font-size: 0.8rem; background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.7); outline: none;">
                    <i class="bi bi-apple text-white"></i> IPHONE / IPAD
                  </button>
                </li>
              </ul>

              <!-- Custom style injection for active pills override -->
              <style>
                #pwaTab .nav-link.active {
                  background: rgba(45, 212, 191, 0.15) !important;
                  color: #2dd4bf !important;
                  box-shadow: inset 0 0 0 1px rgba(45, 212, 191, 0.3) !important;
                }
                .step-container {
                  display: flex;
                  gap: 14px;
                  margin-bottom: 20px;
                  position: relative;
                }
                .step-container:not(:last-child)::after {
                  content: '';
                  position: absolute;
                  left: 14px;
                  top: 30px;
                  bottom: -15px;
                  width: 1px;
                  background: rgba(45, 212, 191, 0.1);
                }
                .step-number {
                  width: 30px;
                  height: 30px;
                  border-radius: 50%;
                  background: rgba(45, 212, 191, 0.08);
                  border: 1px solid rgba(45, 212, 191, 0.25);
                  color: #2dd4bf;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  font-weight: 700;
                  font-size: 0.82rem;
                  flex-shrink: 0;
                }
                .step-content {
                  padding-top: 4px;
                }
                .step-title {
                  font-size: 0.88rem;
                  font-weight: 700;
                  color: #ffffff;
                  margin-bottom: 4px;
                }
                .step-desc {
                  font-size: 0.8rem;
                  color: rgba(237, 250, 250, 0.72);
                  line-height: 1.5;
                }
                
                /* Mobile responsiveness optimizations for the PWA modal */
                @media (max-width: 575.98px) {
                  #pwaInstallModal .modal-dialog {
                    margin: 16px;
                    max-width: calc(100% - 32px) !important;
                  }
                  #pwaInstallModal .modal-content {
                    border-radius: 16px;
                  }
                  #pwaInstallModal .modal-header {
                    padding: 20px 20px 8px !important;
                  }
                  #pwaInstallModal .modal-title {
                    font-size: 1.15rem !important;
                  }
                  #pwaInstallModal .modal-body {
                    padding: 16px 20px !important;
                  }
                  #pwaInstallModal .modal-body p.small {
                    font-size: 0.82rem !important;
                    margin-bottom: 16px !important;
                    line-height: 1.5;
                  }
                  #pwaTab .nav-link {
                    padding-top: 8px !important;
                    padding-bottom: 8px !important;
                    font-size: 0.72rem !important;
                    gap: 6px !important;
                  }
                  #pwaTabContent > div > div {
                    padding: 16px !important;
                    border-radius: 12px !important;
                  }
                  .step-container {
                    gap: 10px;
                    margin-bottom: 16px;
                  }
                  .step-number {
                    width: 26px;
                    height: 26px;
                    font-size: 0.75rem;
                  }
                  .step-container:not(:last-child)::after {
                    left: 12px;
                    top: 26px;
                    bottom: -12px;
                  }
                  .step-content {
                    padding-top: 2px;
                  }
                  .step-title {
                    font-size: 0.82rem !important;
                  }
                  .step-desc {
                    font-size: 0.75rem !important;
                  }
                  #pwaInstallModal .modal-footer {
                    padding: 0 20px 20px !important;
                    flex-direction: row !important;
                    gap: 8px !important;
                  }
                  #pwaInstallModal .modal-footer .btn {
                    padding-top: 10px !important;
                    padding-bottom: 10px !important;
                    font-size: 0.8rem !important;
                  }
                  #modal-btn-install-direct i {
                    font-size: 1.05rem !important;
                  }
                }
              </style>

              <div class="tab-content" id="pwaTabContent">
                <!-- Android / PC Tab Content -->
                <div class="tab-pane fade show active" id="pwa-android" role="tabpanel" aria-labelledby="android-tab">
                  <div style="background: rgba(8, 20, 26, 0.4); padding: 20px; border-radius: 14px; border: 1px solid rgba(190, 239, 255, 0.08);">
                    <div class="step-container">
                      <div class="step-number">1</div>
                      <div class="step-content">
                        <div class="step-title">Ketuk Pasang Aplikasi</div>
                        <div class="step-desc">Tekan tombol <strong style="color: #2dd4bf;">"Pasang Sekarang"</strong> di bawah dialog untuk mulai instalasi.</div>
                      </div>
                    </div>
                    <div class="step-container">
                      <div class="step-number">2</div>
                      <div class="step-content">
                        <div class="step-title">Konfirmasi Pemasangan</div>
                        <div class="step-desc">Pilih opsi <strong style="color: #ffffff;">Instal</strong> atau <strong style="color: #ffffff;">Tambahkan</strong> ketika jendela konfimasi sistem muncul di browser.</div>
                      </div>
                    </div>
                    <div class="step-container mb-0">
                      <div class="step-number">3</div>
                      <div class="step-content">
                        <div class="step-title">Aplikasi Siap Digunakan</div>
                        <div class="step-desc">Ikon aplikasi resmi akan otomatis terpasang pada layar utama perangkat Anda secara instan.</div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- iOS / Safari Tab Content -->
                <div class="tab-pane fade" id="pwa-ios" role="tabpanel" aria-labelledby="ios-tab">
                  <div style="background: rgba(8, 20, 26, 0.4); padding: 20px; border-radius: 14px; border: 1px solid rgba(190, 239, 255, 0.08);">
                    <div class="step-container">
                      <div class="step-number">1</div>
                      <div class="step-content">
                        <div class="step-title">Buka Menu Bagikan</div>
                        <div class="step-desc">Ketuk ikon <strong style="color: #2dd4bf;">Bagikan (Share)</strong> <i class="bi bi-share text-info"></i> pada bagian panel navigasi bawah browser Safari.</div>
                      </div>
                    </div>
                    <div class="step-container">
                      <div class="step-number">2</div>
                      <div class="step-content">
                        <div class="step-title">Tambahkan ke Layar Utama</div>
                        <div class="step-desc">Gulir pilihan ke bawah lalu pilih menu <strong style="color: #ffffff;">Tambah ke Layar Utama (Add to Home Screen)</strong> <i class="bi bi-plus-square text-info"></i>.</div>
                      </div>
                    </div>
                    <div class="step-container mb-0">
                      <div class="step-number">3</div>
                      <div class="step-content">
                        <div class="step-title">Selesaikan Pemasangan</div>
                        <div class="step-desc">Ketuk tombol <strong style="color: #2dd4bf;">Tambah (Add)</strong> di sudut kanan atas untuk menaruh ikon aplikasi di layar beranda.</div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex gap-2">
              <button type="button" id="modal-btn-install-direct" class="btn fw-bold px-4 py-2.5 rounded-3 border-0 flex-fill d-flex align-items-center justify-content-center gap-2" onclick="triggerPwaInstallDirect()" style="background: #2dd4bf; color: #071e25; font-size: 0.88rem; box-shadow: 0 10px 15px -3px rgba(45, 212, 191, 0.25); transition: transform 0.15s, box-shadow 0.15s;" onmouseover="this.style.transform='translateY(-1px)'; this.style.boxShadow='0 12px 20px -3px rgba(45, 212, 191, 0.35)';" onmouseout="this.style.transform='none'; this.style.boxShadow='0 10px 15px -3px rgba(45, 212, 191, 0.25)';">
                <i class="bi bi-cloud-arrow-down-fill fs-5"></i> Pasang Sekarang
              </button>
              <button type="button" class="btn fw-bold px-4 py-2.5 rounded-3 flex-fill d-flex align-items-center justify-content-center" data-bs-dismiss="modal" style="background: rgba(255, 255, 255, 0.06); color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.1) !important; font-size: 0.88rem; transition: background 0.15s;" onmouseover="this.style.background='rgba(255, 255, 255, 0.1)';" onmouseout="this.style.background='rgba(255, 255, 255, 0.06)';">Batal</button>
            </div>
          </div>
        </div>
      </div>

      <a href="/" class="back"><i class="bi bi-arrow-left"></i> Kembali ke Halaman</a>
      <div class="foot">&copy; <%= new Date().getFullYear() %> <%- footerInfo %></div>
    </div>
  </div>
  
  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Eye Toggle Functionality
    function togglePasswordVisibility(button) {
      const targetId = button.getAttribute('data-target');
      const passwordInput = document.getElementById(targetId);
      const isPassword = passwordInput.type === 'password';
      
      if (isPassword) {
        passwordInput.type = 'text';
        button.classList.add('visible');
        button.innerHTML = '<i class="bi bi-eye-slash"></i>';
      } else {
        passwordInput.type = 'password';
        button.classList.remove('visible');
        button.innerHTML = '<i class="bi bi-eye"></i>';
      }
    }

    // Initialize eye toggle buttons
    document.querySelectorAll('.eye-toggle').forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        togglePasswordVisibility(button);
      });
    });

    // Add "with-eye" class to password inputs for proper spacing
    document.querySelectorAll('.eye-toggle').forEach(button => {
      const targetId = button.getAttribute('data-target');
      const input = document.getElementById(targetId);
      if (input) {
        input.classList.add('with-eye');
      }
    });

    let deferredPwaPrompt = null;
    window.addEventListener('beforeinstallprompt', e => { 
      e.preventDefault(); 
      deferredPwaPrompt = e; 
    });
    
    const pwaInstallModalEl = document.getElementById('pwaInstallModal');
    let pwaBsModal = null;
    if (pwaInstallModalEl) {
      pwaBsModal = new bootstrap.Modal(pwaInstallModalEl);
    }

    document.getElementById('btn-install-pwa')?.addEventListener('click', () => {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then(() => {
          deferredPwaPrompt = null;
        });
      } else {
        if (pwaBsModal) {
          pwaBsModal.show();
        }
      }
    });

    function triggerPwaInstallDirect() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then((choiceResult) => {
          if (choiceResult.outcome === 'accepted') {
            if (pwaBsModal) pwaBsModal.hide();
          }
          deferredPwaPrompt = null;
        });
      }
    }
  </script>
</body>
</html>
