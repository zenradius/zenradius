<!DOCTYPE html>
<html lang="<%= lang || 'id' %>" data-app-theme="<%= typeof appTheme !== 'undefined' ? appTheme : 'current' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.theme.title', 'Tema Aplikasi') %> | <%= company %></title>
  <meta name="theme-color" content="#0f172a">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" type="image/png">
  <link rel="apple-touch-icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>">
  <link rel="manifest" href="/admin/manifest.webmanifest">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/theme-tokens.css">
  <style>
    .theme-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;margin-top:16px}
    .theme-card{position:relative;border:2px solid var(--border);border-radius:16px;overflow:hidden;background:var(--bg2);transition:.2s border-color,.2s transform;cursor:pointer}
    .theme-card:hover{transform:translateY(-2px)}
    .theme-card.active{border-color:var(--primary);box-shadow:0 0 0 3px var(--pdim)}
    .theme-card .preview{padding:16px;display:flex;gap:10px;min-height:150px}
    .theme-card .preview .mini-sidebar{width:44px;border-radius:10px;display:flex;flex-direction:column;align-items:center;gap:10px;padding:10px 0}
    .theme-card .preview .mini-sidebar span{width:20px;height:20px;border-radius:6px;opacity:.85}
    .theme-card .preview .mini-main{flex:1;display:flex;flex-direction:column;gap:8px}
    .theme-card .preview .mini-header{height:20px;border-radius:6px}
    .theme-card .preview .mini-card{flex:1;border-radius:10px;padding:10px;display:flex;flex-direction:column;gap:8px;justify-content:center}
    .theme-card .preview .mini-line{height:8px;border-radius:4px}
    .theme-card .preview .mini-btn{width:70px;height:22px;border-radius:8px;margin-top:4px}
    .theme-card .info{padding:14px 16px;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
    .theme-card .info h6{margin:0;font-size:14px;font-weight:700}
    .theme-card .info p{margin:2px 0 0;font-size:11.5px;color:var(--muted)}
    .active-badge{font-size:11px;font-weight:700;background:var(--primary);color:#fff;padding:4px 10px;border-radius:999px;display:flex;align-items:center;gap:4px}
    .theme-card form{margin:0}
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'theme_settings', company }) %>
<div class="mw">
<%- include('partials/licenseGraceBar') %>
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-palette2"></i> <%= t('admin.theme.title', 'Tema Aplikasi') %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i> <%= t('common.logout', 'Logout') %></a>
    </div>
  </div>
  <div class="page">

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type==='success'?'s':'d' %>">
      <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

    <div class="card">
      <div class="card-hd"><i class="bi bi-palette2"></i> <%= t('admin.theme.title', 'Tema Aplikasi') %></div>
      <div class="card-bd">
        <p style="color:var(--muted);font-size:13px;margin:0 0 4px">
          <%= t('admin.theme.desc', 'Pilih tampilan global untuk seluruh aplikasi ZenRadius (Admin, Pelanggan, Reseller, Teknisi, Kolektor, dan halaman login). Perubahan berlaku untuk semua pengguna.') %>
        </p>

        <div class="theme-grid">
          <!-- Theme: design (DESIGN.md / CasaOS) -->
          <form method="post" action="/admin/theme-settings">
            <input type="hidden" name="app_theme" value="design">
            <button type="submit" class="theme-card <%= currentTheme === 'design' ? 'active' : '' %>" style="width:100%;text-align:left;border:2px solid <%= currentTheme==='design' ? 'var(--primary)' : 'var(--border)' %>;background:none;padding:0;font:inherit;color:inherit">
              <div class="preview" style="background:#121418">
                <div class="mini-sidebar" style="background:#1C1F26">
                  <span style="background:#007BFF"></span><span style="background:#2A2F3A"></span><span style="background:#2A2F3A"></span>
                </div>
                <div class="mini-main">
                  <div class="mini-header" style="background:#1C1F26"></div>
                  <div class="mini-card" style="background:#1C1F26;border:1px solid #2E3440">
                    <div class="mini-line" style="background:#2A2F3A;width:70%"></div>
                    <div class="mini-line" style="background:#2A2F3A;width:45%"></div>
                    <div class="mini-btn" style="background:#007BFF"></div>
                  </div>
                </div>
              </div>
              <div class="info">
                <div>
                  <h6><%= t('admin.theme.design_name', 'ZenRadius Dark') %></h6>
                  <p><%= t('admin.theme.design_desc', 'Tema gelap modern berbasis CasaOS Design System') %></p>
                </div>
                <% if (currentTheme === 'design') { %>
                  <span class="active-badge"><i class="bi bi-check-circle-fill"></i> <%= t('admin.theme.active', 'Aktif') %></span>
                <% } else { %>
                  <span class="btn btn-sm btn-g"><%= t('admin.theme.use', 'Gunakan') %></span>
                <% } %>
              </div>
            </button>
          </form>

          <!-- Theme: current (existing ZenRadius look) -->
          <form method="post" action="/admin/theme-settings">
            <input type="hidden" name="app_theme" value="current">
            <button type="submit" class="theme-card <%= currentTheme === 'current' ? 'active' : '' %>" style="width:100%;text-align:left;border:2px solid <%= currentTheme==='current' ? 'var(--primary)' : 'var(--border)' %>;background:none;padding:0;font:inherit;color:inherit">
              <div class="preview" style="background:#173945">
                <div class="mini-sidebar" style="background:#183f51">
                  <span style="background:#22D3EE"></span><span style="background:#1b4656"></span><span style="background:#1b4656"></span>
                </div>
                <div class="mini-main">
                  <div class="mini-header" style="background:#183f51"></div>
                  <div class="mini-card" style="background:#173945;border:1px solid rgba(190,239,255,.22)">
                    <div class="mini-line" style="background:#1b4656;width:70%"></div>
                    <div class="mini-line" style="background:#1b4656;width:45%"></div>
                    <div class="mini-btn" style="background:linear-gradient(135deg,#22D3EE,#38BDF8)"></div>
                  </div>
                </div>
              </div>
              <div class="info">
                <div>
                  <h6><%= t('admin.theme.current_name', 'ZenRadius Teal') %></h6>
                  <p><%= t('admin.theme.current_desc', 'Tampilan asli ZenRadius bernuansa teal (default)') %></p>
                </div>
                <% if (currentTheme === 'current') { %>
                  <span class="active-badge"><i class="bi bi-check-circle-fill"></i> <%= t('admin.theme.active', 'Aktif') %></span>
                <% } else { %>
                  <span class="btn btn-sm btn-g"><%= t('admin.theme.use', 'Gunakan') %></span>
                <% } %>
              </div>
            </button>
          </form>
        </div>
      </div>
    </div>

  </div>
</div>
</body>
</html>
