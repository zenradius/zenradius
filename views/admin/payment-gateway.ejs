<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Payment Gateway | <%= company %></title>
  <meta name="theme-color" content="#0f172a">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" type="image/png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<%- include('partials/sidebar', { activePage: 'payment_gateway', company }) %>
<div class="mw">
<%- include('partials/licenseGraceBar') %>
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-credit-card-2-front"></i> Payment Gateway</div>
    <div class="tb-right">
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i> <%= t('common.logout', 'Logout') %></a>
    </div>
  </div>
  <div class="page">

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type==='success'?'s':'d' %>">
      <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

    <form method="POST" action="/admin/settings">
      <input type="hidden" name="_redirect" value="/admin/payment-gateway">

      <!-- Stat Grid Penunjuk Gateway Aktif -->
      <div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin-bottom: 24px;">
        <% 
          let activeGw = String(settings.default_gateway || 'tripay').toLowerCase();
          let gwName = 'Tripay';
          let gwIcon = 'bi-credit-card-2-front';
          let gwClass = 'i';
          let gwStatus = 'Nonaktif';
          let isGwActive = false;

          if (activeGw === 'ipaymu') {
            gwName = 'iPaymu';
            gwIcon = 'bi-wallet2';
            gwClass = settings.ipaymu_enabled === true || settings.ipaymu_enabled === 'true' ? 's' : 'd';
            isGwActive = settings.ipaymu_enabled === true || settings.ipaymu_enabled === 'true';
          } else if (activeGw === 'tripay') {
            gwName = 'Tripay';
            gwIcon = 'bi-credit-card-2-back';
            gwClass = settings.tripay_enabled === true || settings.tripay_enabled === 'true' ? 's' : 'd';
            isGwActive = settings.tripay_enabled === true || settings.tripay_enabled === 'true';
          } else if (activeGw === 'midtrans') {
            gwName = 'Midtrans';
            gwIcon = 'bi-shield-check';
            gwClass = settings.midtrans_enabled === true || settings.midtrans_enabled === 'true' ? 's' : 'd';
            isGwActive = settings.midtrans_enabled === true || settings.midtrans_enabled === 'true';
          } else if (activeGw === 'xendit') {
            gwName = 'Xendit';
            gwIcon = 'bi-building-fill-up';
            gwClass = settings.xendit_enabled === true || settings.xendit_enabled === 'true' ? 's' : 'd';
            isGwActive = settings.xendit_enabled === true || settings.xendit_enabled === 'true';
          } else if (activeGw === 'duitku') {
            gwName = 'Duitku';
            gwIcon = 'bi-file-lock2';
            gwClass = settings.duitku_enabled === true || settings.duitku_enabled === 'true' ? 's' : 'd';
            isGwActive = settings.duitku_enabled === true || settings.duitku_enabled === 'true';
          }
        %>
        <!-- Card 1: Default/Active Gateway -->
        <div class="sc <%= gwClass %>" style="padding-right: 20px;">
          <div class="sc-icon"><i class="bi <%= gwIcon %>"></i></div>
          <div class="sc-label">Gateway Default / Aktif</div>
          <div class="sc-val" style="font-size: 22px; display: flex; align-items: center; gap: 8px;">
            <%= gwName %>
            <span class="pill <%= isGwActive ? 'pill-p' : 'pill-u' %>" style="font-size: 10px; padding: 2px 8px; font-weight: 700;">
              <%= isGwActive ? 'Aktif' : 'Nonaktif' %>
            </span>
          </div>
          <div class="sc-sub">Gateway utama untuk memproses pembayaran otomatis</div>
        </div>

        <!-- Card 2: QRIS Statis Status -->
        <%
          const hasStaticQris = (String(settings.qris_static_qr_url || '').trim() || String(settings.qris_static_payload || '').trim()) && (settings.qris_static_enabled !== false && settings.qris_static_enabled !== 'false' && settings.qris_static_enabled !== 0 && settings.qris_static_enabled !== '0');
        %>
        <div class="sc <%= hasStaticQris ? 's' : 'w' %>" style="padding-right: 20px;">
          <div class="sc-icon"><i class="bi bi-qr-code-scan"></i></div>
          <div class="sc-label">Metode QRIS Mandiri / Statis</div>
          <div class="sc-val" style="font-size: 22px; display: flex; align-items: center; gap: 8px;">
            QRIS Statis
            <span class="pill <%= hasStaticQris ? 'pill-p' : 'pill-u' %>" style="font-size: 10px; padding: 2px 8px; font-weight: 700;">
              <%= hasStaticQris ? 'Aktif' : 'Nonaktif' %>
            </span>
          </div>
          <div class="sc-sub">Pembayaran mandiri via QRIS gambar/payload</div>
        </div>
      </div>

      <div class="card mb16">
        <div class="card-hd"><h6><i class="bi bi-wallet2"></i> Pengaturan Payment Gateway</h6></div>
        <div class="card-bd">

          <div class="form-row" style="margin-bottom: 20px;">
            <div class="fg">
              <label class="fl" style="font-weight: 700; color: #fff;">Pilih Gateway untuk Dikonfigurasi</label>
              <select class="fs" id="gateway_selector" name="default_gateway" onchange="showGatewayPanel(this.value)" style="border: 2px solid rgba(34, 211, 238, 0.4); background: rgba(15, 23, 42, 0.62); height: 44px; font-weight: 600; color: #fff;">
                <option value="ipaymu">iPaymu (Urutan Pertama)</option>
                <option value="tripay">Tripay</option>
                <option value="midtrans">Midtrans</option>
                <option value="xendit">Xendit</option>
                <option value="duitku">Duitku</option>
              </select>
              <div style="font-size:11px; color:#a8bec2; margin-top:6px; line-height: 1.4;"><i class="bi bi-info-circle me-1" style="color: var(--primary);"></i> Gateway yang dipilih di atas akan otomatis diatur sebagai **Gateway Aktif Utama** untuk melayani transaksi pembelian voucher pelanggan di portal.</div>
            </div>
          </div>

          <!-- Tripay Section -->
          <div id="panel-tripay" class="gw-panel" style="background: rgba(15, 23, 42, 0.4); padding: 20px; border: 1px solid var(--border); border-radius: 12px; margin-bottom: 20px;">
            <h6 style="font-size:14px; font-weight:700; color:#fff; margin-bottom: 15px; display:flex; align-items:center; gap:8px;"><i class="bi bi-credit-card-2-back text-info"></i> Tripay API Integration</h6>
            <div class="form-row3">
              <div class="fg">
                <label class="fl">Status Tripay</label>
                <select class="fs" name="tripay_enabled">
                  <option value="true" <%= settings.tripay_enabled === true ? 'selected' : '' %>>Aktif</option>
                  <option value="false" <%= settings.tripay_enabled === false ? 'selected' : '' %>>Nonaktif</option>
                </select>
              </div>
              <div class="fg">
                <label class="fl">Tripay API Key</label>
                <input class="fc" name="tripay_api_key" value="<%= settings.tripay_api_key || '' %>" type="password">
              </div>
              <div class="fg">
                <label class="fl">Tripay Private Key</label>
                <input class="fc" name="tripay_private_key" value="<%= settings.tripay_private_key || '' %>" type="password">
              </div>
            </div>
            <div class="form-row3" style="margin-top: 15px;">
              <div class="fg">
                <label class="fl">Tripay Merchant Code</label>
                <input class="fc" name="tripay_merchant_code" value="<%= settings.tripay_merchant_code || '' %>" placeholder="Txxxx">
              </div>
              <div class="fg">
                <label class="fl">Tripay Mode</label>
                <select class="fs" name="tripay_mode">
                  <option value="sandbox" <%= settings.tripay_mode === 'sandbox' ? 'selected' : '' %>>Sandbox</option>
                  <option value="live" <%= settings.tripay_mode === 'live' ? 'selected' : '' %>>Live</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Midtrans Section -->
          <div id="panel-midtrans" class="gw-panel" style="background: rgba(15, 23, 42, 0.4); padding: 20px; border: 1px solid var(--border); border-radius: 12px; margin-bottom: 20px;">
            <h6 style="font-size:14px; font-weight:700; color:#fff; margin-bottom: 15px; display:flex; align-items:center; gap:8px;"><i class="bi bi-shield-check text-success"></i> Midtrans API Integration</h6>
            <div class="form-row3">
              <div class="fg">
                <label class="fl">Status Midtrans</label>
                <select class="fs" name="midtrans_enabled">
                  <option value="true" <%= settings.midtrans_enabled === true ? 'selected' : '' %>>Aktif</option>
                  <option value="false" <%= settings.midtrans_enabled === false ? 'selected' : '' %>>Nonaktif</option>
                </select>
              </div>
              <div class="fg">
                <label class="fl">Midtrans Server Key</label>
                <input class="fc" name="midtrans_server_key" value="<%= settings.midtrans_server_key || '' %>" type="password">
              </div>
              <div class="fg">
                <label class="fl">Midtrans Mode</label>
                <select class="fs" name="midtrans_mode">
                  <option value="sandbox" <%= settings.midtrans_mode === 'sandbox' ? 'selected' : '' %>>Sandbox</option>
                  <option value="live" <%= settings.midtrans_mode === 'live' ? 'selected' : '' %>>Live</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Xendit Section -->
          <div id="panel-xendit" class="gw-panel" style="background: rgba(15, 23, 42, 0.4); padding: 20px; border: 1px solid var(--border); border-radius: 12px; margin-bottom: 20px; margin-top: 20px;">
            <h6 style="font-size:14px; font-weight:700; color:#fff; margin-bottom: 15px; display:flex; align-items:center; gap:8px;"><i class="bi bi-building-fill-up text-primary"></i> Xendit API Integration</h6>
            <div class="form-row2">
              <div class="fg">
                <label class="fl">Status Xendit</label>
                <select class="fs" name="xendit_enabled">
                  <option value="true" <%= settings.xendit_enabled === true ? 'selected' : '' %>>Aktif</option>
                  <option value="false" <%= settings.xendit_enabled === false ? 'selected' : '' %>>Nonaktif</option>
                </select>
              </div>
              <div class="fg">
                <label class="fl">Xendit Secret API Key</label>
                <input class="fc" name="xendit_api_key" value="<%= settings.xendit_api_key || '' %>" type="password" placeholder="xnd_development_...">
              </div>
            </div>
            <div style="font-size: 11px; color:#a8bec2; margin-top: 8px;"><i class="bi bi-info-circle me-1" style="color:var(--primary);"></i> Xendit menggunakan callback token yang disetting di dashboard Xendit.</div>
          </div>

          <!-- Duitku Section -->
          <div id="panel-duitku" class="gw-panel" style="background: rgba(15, 23, 42, 0.4); padding: 20px; border: 1px solid var(--border); border-radius: 12px; margin-bottom: 20px; margin-top: 20px;">
            <h6 style="font-size:14px; font-weight:700; color:#fff; margin-bottom: 15px; display:flex; align-items:center; gap:8px;"><i class="bi bi-file-lock2 text-warning"></i> Duitku API Integration</h6>
            <div class="form-row3">
              <div class="fg">
                <label class="fl">Status Duitku</label>
                <select class="fs" name="duitku_enabled">
                  <option value="true" <%= settings.duitku_enabled === true ? 'selected' : '' %>>Aktif</option>
                  <option value="false" <%= settings.duitku_enabled === false ? 'selected' : '' %>>Nonaktif</option>
                </select>
              </div>
              <div class="fg">
                <label class="fl">Duitku Merchant Code</label>
                <input class="fc" name="duitku_merchant_code" value="<%= settings.duitku_merchant_code || '' %>" placeholder="Dxxxx">
              </div>
              <div class="fg">
                <label class="fl">Duitku API Key</label>
                <input class="fc" name="duitku_api_key" value="<%= settings.duitku_api_key || '' %>" type="password">
              </div>
            </div>
            <div class="form-row2" style="margin-top: 15px;">
              <div class="fg">
                <label class="fl">Duitku Mode</label>
                <select class="fs" name="duitku_mode">
                  <option value="sandbox" <%= settings.duitku_mode === 'sandbox' ? 'selected' : '' %>>Sandbox</option>
                  <option value="live" <%= settings.duitku_mode === 'live' ? 'selected' : '' %>>Live</option>
                </select>
              </div>
            </div>
          </div>

          <!-- iPaymu Section -->
          <div id="panel-ipaymu" class="gw-panel" style="background: rgba(15, 23, 42, 0.4); padding: 20px; border: 1px solid var(--border); border-radius: 12px; margin-bottom: 20px; margin-top: 20px;">
            <h6 style="font-size:14px; font-weight:700; color:#fff; margin-bottom: 15px; display:flex; align-items:center; gap:8px;"><i class="bi bi-wallet2 text-success"></i> iPaymu Integration (Urutan Utama)</h6>
            <div class="form-row3">
              <div class="fg">
                <label class="fl">Status iPaymu</label>
                <select class="fs" name="ipaymu_enabled">
                  <option value="true" <%= settings.ipaymu_enabled === true || settings.ipaymu_enabled === 'true' ? 'selected' : '' %>>Aktif</option>
                  <option value="false" <%= settings.ipaymu_enabled === false || settings.ipaymu_enabled === 'false' ? 'selected' : '' %>>Nonaktif</option>
                </select>
              </div>
              <div class="fg">
                <label class="fl">Nomor Virtual Account (VA)</label>
                <input class="fc" name="ipaymu_va" value="<%= settings.ipaymu_va || '' %>" autocomplete="off" placeholder="Nomor VA dari dashboard iPaymu">
              </div>
              <div class="fg">
                <label class="fl">iPaymu API Key</label>
                <input class="fc" name="ipaymu_api_key" value="<%= settings.ipaymu_api_key || '' %>" type="password" autocomplete="new-password" placeholder="API Key dari dashboard iPaymu">
              </div>
            </div>
            <div class="form-row2" style="margin-top: 15px;">
              <div class="fg">
                <label class="fl">iPaymu Mode</label>
                <select class="fs" name="ipaymu_mode">
                  <option value="sandbox" <%= settings.ipaymu_mode === 'sandbox' ? 'selected' : '' %>>Sandbox</option>
                  <option value="live" <%= settings.ipaymu_mode === 'live' || settings.ipaymu_mode === 'production' ? 'selected' : '' %>>Live</option>
                </select>
              </div>
            </div>
            <div style="font-size:11px; color:#a8bec2; margin-top:8px"><i class="bi bi-info-circle me-1" style="color:var(--primary);"></i> Gunakan VA dan API Key sesuai mode. Atur callback iPaymu ke Link Webhook di bawah; mode Live memerlukan IP statis dan domain terdaftar.</div>
          </div>

          <div class="fg" style="margin-top: 15px;">
            <label class="fl">Link Webhook (Copy ke Dashboard Gateway)</label>
            <div style="display:flex;gap:8px">
              <input class="fc" id="webhook_url" readonly value="<%= (typeof paymentWebhookUrl !== 'undefined' && paymentWebhookUrl) ? paymentWebhookUrl : ('http://' + (settings.server_host || 'localhost') + ':' + (settings.server_port || 3001) + '/customer/payment/callback') %>">
              <button type="button" class="btn btn-g" onclick="copyInput('webhook_url', 'Link Webhook')"><i class="bi bi-copy"></i></button>
            </div>
            <div style="font-size: 10px; color: var(--muted); margin-top: 4px;">Gunakan link ini sebagai webhook / notify URL pada dashboard gateway, termasuk iPaymu.</div>
          </div>

        </div>
        <div class="card-bd" style="border-top:1px solid var(--border);padding-top:20px;text-align:right">
          <button type="submit" class="btn btn-p"><i class="bi bi-save"></i> Simpan Pengaturan</button>
        </div>
      </div>
    </form>
  </div>
</div>

<script src="https://unpkg.com/jsqr@1.4.0/dist/jsQR.js" integrity="sha384-b5Ya4Bq3qCyz39m2ISh+4DxjAIljdeFwK/BsXLuj9gugaNwAcj/ia15fxNZL9Nlx" crossorigin="anonymous"></script>
<script>
function showGatewayPanel(key) {
  document.querySelectorAll('.gw-panel').forEach(el => { el.style.display = 'none'; });
  const target = document.getElementById('panel-' + key);
  if (target) target.style.display = 'block';
  try { localStorage.setItem('pg_selected_gateway', key); } catch(e) {}
}

document.addEventListener('DOMContentLoaded', () => {
  const sel = document.getElementById('gateway_selector');
  let initial = '<%= settings.default_gateway || "tripay" %>';
  try {
    const saved = localStorage.getItem('pg_selected_gateway');
    if (saved && document.getElementById('panel-' + saved)) initial = saved;
  } catch(e) {}
  if (!document.getElementById('panel-' + initial)) initial = 'tripay';
  if (sel) sel.value = initial;
  showGatewayPanel(initial);
});

function copyInput(id, name) {
  const el = document.getElementById(id);
  if (el) {
    el.select();
    document.execCommand('copy');
    alert(name + ' berhasil disalin!');
  }
}

function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sidebarOverlay').classList.toggle('show');
}
</script>
</body>
</html>
