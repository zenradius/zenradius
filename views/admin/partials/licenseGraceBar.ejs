<% if (typeof licenseGrace !== 'undefined' && licenseGrace && licenseGrace.inGrace) { %>
<div class="lic-grace-bar" role="alert">
  <div class="ic"><i class="bi bi-shield-exclamation"></i></div>
  <div class="txt">
    <div class="ttl">
      <span>Lisensi belum aktif</span>
      <span class="dom"><%= typeof licenseHost !== 'undefined' ? licenseHost : '' %></span>
    </div>
    <div class="sub">
      Akses penuh akan dikunci dalam <span class="days"><i class="bi bi-hourglass-split"></i><%= licenseGrace.daysLeft %> hari</span> — aktifkan sekarang agar layanan tidak terganggu.
    </div>
  </div>
  <div class="acts">
    <a class="a1" href="/admin/settings#license"><i class="bi bi-patch-check-fill"></i> Aktivasi Lisensi</a>
    <% if (typeof licenseInfo !== 'undefined' && licenseInfo) { %>
    <a class="a2" href="<%= licenseInfo.buildOrderUrl(typeof licenseHost !== 'undefined' ? licenseHost : '') %>" target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i> Order Lisensi</a>
    <% } %>
  </div>
</div>
<% } %>
