<% const __licOnSettings = (typeof activePage !== 'undefined' && activePage === 'settings'); %>
<% if (typeof licenseGrace !== 'undefined' && licenseGrace && licenseGrace.inGrace && !__licOnSettings) { %>
<% const __licDays = Number(licenseGrace.daysLeft) || 0; const __licPrice = (typeof licenseInfo !== 'undefined' && licenseInfo && licenseInfo.LICENSE_PRICE_LABEL) ? String(licenseInfo.LICENSE_PRICE_LABEL).replace(/\s*\(.*?\)\s*/g,'').trim() : 'Rp 300.000'; %>
<div class="lic-modal" id="licModal" role="dialog" aria-modal="true" aria-labelledby="licTitle">
  <div class="lic-card">
    <div class="hd">
      <div class="ic"><i class="bi bi-shield-lock"></i></div>
      <h3 id="licTitle">Aktivasi Lisensi Diperlukan</h3>
      <span class="dom"><i class="bi bi-globe2"></i><%= typeof licenseHost !== 'undefined' ? licenseHost : '' %></span>
    </div>
    <div class="bd">
      ZenRadius dikembangkan dan dirawat oleh Developer independen dengan dedikasi penuh. Lisensi resmi Anda menjaga pembaruan, keamanan, dan dukungan teknis tetap berjalan &mdash; sekali bayar <strong style="color:var(--text)"><%= __licPrice %></strong>, berlaku selamanya untuk 1 domain.
      <div class="cnt"><b><%= __licDays %></b><span>hari tersisa sebelum akses dibatasi</span></div>
    </div>
    <div class="ft">
      <a class="a1" href="/admin/settings#license"><i class="bi bi-key-fill"></i> Masukkan Kunci Lisensi</a>
      <% if (typeof licenseInfo !== 'undefined' && licenseInfo) { %>
      <a class="a2" href="<%= licenseInfo.buildOrderUrl(typeof licenseHost !== 'undefined' ? licenseHost : '') %>" target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i> Order Lisensi via WhatsApp</a>
      <% } %>
      <button type="button" class="a3" onclick="licModalClose()">Lanjutkan tanpa aktivasi</button>
    </div>
  </div>
</div>
<script>
(function(){
  var KEY = 'zr_lic_popup_last', INTERVAL = 30000;
  var m = document.getElementById('licModal');
  if (!m) return;
  window.licModalClose = function(){ m.classList.remove('show'); try{ localStorage.setItem(KEY, String(Date.now())); }catch(e){} };
  function show(){ m.classList.add('show'); try{ localStorage.setItem(KEY, String(Date.now())); }catch(e){} }
  var last = 0; try{ last = parseInt(localStorage.getItem(KEY) || '0', 10) || 0; }catch(e){}
  var wait = Math.max(0, INTERVAL - (Date.now() - last));
  setTimeout(function tick(){ show(); setTimeout(tick, INTERVAL); }, wait);
  m.addEventListener('click', function(e){ if (e.target === m) licModalClose(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') licModalClose(); });
})();
</script>
<% } %>
