<% const __licOnSettings = (typeof activePage !== 'undefined' && activePage === 'settings'); %>
<% if (typeof licenseGrace !== 'undefined' && licenseGrace && licenseGrace.inGrace && !__licOnSettings) { %>
<% const __licDays = Number(licenseGrace.daysLeft) || 0; const __licPrice = (typeof licenseInfo !== 'undefined' && licenseInfo && licenseInfo.LICENSE_PRICE_LABEL) ? String(licenseInfo.LICENSE_PRICE_LABEL).replace(/\s*\(.*?\)\s*/g,'').trim() : 'Rp 300.000'; const __licHost = (typeof licenseHost !== 'undefined' ? licenseHost : ''); const __licTotal = (typeof licenseInfo !== 'undefined' && licenseInfo && licenseInfo.LICENSE_GRACE_DAYS) ? Number(licenseInfo.LICENSE_GRACE_DAYS) : 7; const __licPct = Math.max(4, Math.min(100, Math.round((__licDays / __licTotal) * 100))); const __licEnd = licenseGrace.endsAt ? new Date(licenseGrace.endsAt) : null; const __licEndStr = __licEnd ? __licEnd.toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) : ''; %>
<div class="licg-modal" id="licModal" role="dialog" aria-modal="true" aria-labelledby="licTitle">
  <div class="licg-dialog">
    <div class="licg-grip"></div>
    <div class="licg-head">
      <button type="button" class="licg-close" onclick="licModalClose()" aria-label="Tutup"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="licg-body">
      <div class="licg-hero">
        <div class="licg-hero-ic"><i class="bi bi-shield-lock-fill"></i></div>
        <div class="licg-hero-t">
          <h4>Lisensi Belum Diaktifkan</h4>
          <div class="licg-domain"><i class="bi bi-globe2"></i><%= __licHost %></div>
          <p><strong><%= __licHost %></strong> punya nama yang bagus, masa belum diaktivasi? 😊<br>Sayang kalau domain sekeren ini belum mendapatkan perlindungan dan dukungan penuh dari ZenRadius. Yuk, aktifkan lisensinya sekarang—sekali bayar, berlaku selamanya.</p>
        </div>
      </div>

      <div class="licg-grace">
        <div class="licg-grace-top">
          <div>
            <div class="licg-stat-l"><i class="bi bi-hourglass-split"></i> Sisa Masa Tenggang</div>
            <div class="licg-grace-v"><%= __licDays %> <small>hari</small></div>
          </div>
          <div class="licg-grace-right">
            <div class="licg-stat-l"><i class="bi bi-infinity"></i> Lisensi Resmi</div>
            <div class="licg-grace-p"><%= __licPrice %> <small>/ selamanya</small></div>
          </div>
        </div>
        <div class="licg-bar"><i style="width:<%= __licPct %>%"></i></div>
        <div class="licg-grace-meta">
          <% if (__licEndStr) { %><span><i class="bi bi-calendar-event"></i> Berakhir <%= __licEndStr %></span><% } %>
          <span><i class="bi bi-lock"></i> Setelah itu akses admin dibatasi hingga lisensi aktif</span>
        </div>
      </div>

      <p class="licg-desc">ZenRadius dikembangkan dan dirawat secara berkelanjutan oleh Developer independen. Lisensi resmi Anda menjaga pembaruan, keamanan, dan dukungan teknis tetap berjalan untuk seluruh pengguna.</p>

      <ul class="licg-list">
        <li><i class="bi bi-check-circle-fill"></i> Sekali bayar, berlaku selamanya untuk 1 domain</li>
        <li><i class="bi bi-check-circle-fill"></i> Pembaruan fitur &amp; keamanan berkelanjutan</li>
        <li><i class="bi bi-check-circle-fill"></i> Dukungan teknis langsung dari Developer</li>
      </ul>
    </div>
    <div class="licg-actions">
      <button type="button" class="btn btn-g" onclick="licModalClose()">Nanti Saja</button>
      <% if (typeof licenseInfo !== 'undefined' && licenseInfo) { %>
      <a class="btn btn-s" href="<%= licenseInfo.buildOrderUrl(typeof licenseHost !== 'undefined' ? licenseHost : '') %>" target="_blank" rel="noopener" id="licOrderBtn"><i class="bi bi-cart-plus"></i> Order Lisensi</a>
      <% } %>
      <a class="btn btn-p" href="/admin/settings#license" onclick="licToInput(event)"><i class="bi bi-patch-check-fill"></i> Aktivasi Lisensi</a>
    </div>
  </div>
</div>
<script>
(function(){
  var KEY = 'zr_lic_popup_last', INTERVAL = 30000;
  var m = document.getElementById('licModal');
  if (!m) return;
  window.licModalClose = function(){ m.classList.remove('show'); try{ localStorage.setItem(KEY, String(Date.now())); }catch(e){} };
  window.licToInput = function(e){
    e.preventDefault();
    licModalClose();
    window.location.href = '/admin/settings#license';
    setTimeout(function(){
      var input = document.getElementsByName('domain_license_key')[0];
      if(input){ input.focus(); input.select(); }
    }, 150);
  };
  function show(){ m.classList.add('show'); try{ localStorage.setItem(KEY, String(Date.now())); }catch(e){} }
  var last = 0; try{ last = parseInt(localStorage.getItem(KEY) || '0', 10) || 0; }catch(e){}
  var wait = Math.max(0, INTERVAL - (Date.now() - last));
  setTimeout(function tick(){ show(); setTimeout(tick, INTERVAL); }, wait);
  m.addEventListener('click', function(e){ if (e.target === m) licModalClose(); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') licModalClose(); });
})();
</script>
<% } %>
