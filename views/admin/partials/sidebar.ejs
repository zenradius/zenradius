  </div>
  <nav class="sb-nav">
    <% (sidebarSections || []).forEach((section, sIdx) => { 
      // check if any item in this section is currently active
      const hasActiveItem = section.items.some(item => (item.activePages || []).includes(activePage));
    %>
      <div class="sb-section-group <%= hasActiveItem ? 'open' : '' %>" data-section-id="<%= sIdx %>">
        <div class="sb-section" onclick="toggleSidebarSection(this)">
          <span><%= section.labelKey ? t(section.labelKey, section.labelDefault) : section.labelDefault %></span>
          <i class="bi bi-chevron-right sb-sec-chev"></i>
        </div>
        <div class="sb-section-items">
          <% section.items.forEach((item) => { %>
            <a
              href="<%= item.hrefResolved %>"
              class="sb-item <%= (item.activePages || []).includes(activePage) ? 'active' : '' %>"
            >
              <i class="<%= item.icon %>"></i>
              <span><%= item.labelKey ? t(item.labelKey, item.labelDefault) : item.labelDefault %></span>
              <% if (item.key === 'update') { %>
                <span id="updateBadge" style="display:none;margin-left:auto;padding:2px 7px;border-radius:999px;background:var(--danger);color:#fff;font-size:10px;font-weight:700;animation:pulse 1.5s infinite">● Update</span>
              <% } %>
            </a>
          <% }) %>
        </div>
      </div>
    <% }) %>

    <% if (typeof isMasterAdmin === 'undefined' || !isMasterAdmin) { %>
      <!-- Lisensi dinonaktifkan -->
    <% } %>

    <a href="/admin/logout" class="sb-item logout">
      <i class="bi bi-box-arrow-left"></i><span><%= t('common.logout', 'Logout') %></span>
    </a>
    <div class="mt-4 px-3 py-2 text-center" style="border-top: 1px solid rgba(255,255,255,0.1);">
      <a href="https://github.com/zenradius/zenradius" target="_blank"
        style="color: #94a3b8; font-size: 11px; text-decoration: none; font-weight: 600;">
        ZENRADIUS
      </a>
    </div>
  </nav>
</aside>

<div id="lockedMenuModal" class="locked-menu-modal">
  <div class="locked-menu-dialog" role="dialog" aria-modal="true" aria-labelledby="lockedMenuTitle">
    <div class="locked-menu-head">
      <div class="locked-menu-title">
        <div class="locked-menu-icon">
          <i class="bi bi-lock-fill"></i>
        </div>
        <div>
          <div id="lockedMenuTitle" class="locked-menu-heading">Menu Terkunci</div>
          <div class="locked-menu-subtitle">Aktivasi diperlukan untuk membuka fitur ini</div>
        </div>
      </div>
      <button type="button" class="btn btn-g btn-sm" onclick="hideLockedMenuNotice()" aria-label="Tutup" style="padding:6px 10px">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
    <div class="locked-menu-body">
      <div id="lockedMenuModalMessage">
        Menu ini sedang terkunci.
      </div>
      <div class="locked-menu-notice">
        Hubungi Master Admin untuk membuka akses ke menu ini.
      </div>
    </div>
    <div class="locked-menu-footer">
      <button type="button" class="btn btn-p" onclick="hideLockedMenuNotice()">
        <i class="bi bi-check2-circle"></i> Mengerti
      </button>
    </div>
  </div>
</div>

<script>
  function toggleSidebar() {
    const sb = document.getElementById('sidebar');
    const ov = document.getElementById('sidebarOverlay');
    sb.classList.toggle('open');
    ov.classList.toggle('show');
  }

  // Akordeon collapse/expand menu section
  function toggleSidebarSection(secHeader) {
    const group = secHeader.closest('.sb-section-group');
    if (!group) return;
    const wasOpen = group.classList.contains('open');
    
    // Jangan menutup jika mengklik group menu tempat halaman aktif berada kecuali jika Anda benar-benar me-collapse-nya (atau tutup yang lain)
    document.querySelectorAll('.sb-section-group').forEach(function(g) {
      if (g !== group) {
        g.classList.remove('open');
      }
    });

    if (wasOpen) {
      group.classList.remove('open');
    } else {
      group.classList.add('open');
    }
    
    // Simpan preferensi status lipatan jika di-perlukan (opsional)
    try {
      localStorage.setItem('zs-sb-sec-' + group.dataset.sectionId, group.classList.contains('open') ? '1' : '0');
    } catch(e) {}
  }

  // Restore sidebar state dari localStorage (kecuali jika ada menu aktif di section tersebut)
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.sb-section-group').forEach(function(g) {
      // jika ada menu aktif, pastikan selalu terbuka
      const hasActive = g.classList.contains('open');
      if (hasActive) return;
      
      try {
        const stored = localStorage.getItem('zs-sb-sec-' + g.dataset.sectionId);
        if (stored === '1') {
          g.classList.add('open');
        }
      } catch(e) {}
    });
  });

  function showLockedMenuNotice(message) {
    const modal = document.getElementById('lockedMenuModal');
    const messageBox = document.getElementById('lockedMenuModalMessage');
    if (messageBox) {
      messageBox.textContent = message || 'Menu ini sedang terkunci.';
    }
    if (modal) {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    return false;
  }

  function hideLockedMenuNotice() {
    const modal = document.getElementById('lockedMenuModal');
    if (modal) {
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }
  }

  // Language dropdown helper
  document.addEventListener('click', function(event) {
    const dropdowns = document.querySelectorAll('.lang-dropdown');
    dropdowns.forEach(function(dropdown) {
      if (!dropdown.contains(event.target)) dropdown.classList.remove('open');
    });
  });
  function toggleLangDropdown(btn) {
    const dropdown = btn.closest('.lang-dropdown');
    if (!dropdown) return;
    const isOpen = dropdown.classList.contains('open');
    document.querySelectorAll('.lang-dropdown').forEach(function(d) { d.classList.remove('open'); });
    if (!isOpen) dropdown.classList.add('open');
  }

  // Custom dropdown (gaya sama dengan pilihan bahasa) untuk semua <select class="fs">
  (function(){ var s=document.createElement('script'); s.src='/js/zen-select.js?v=3'; s.defer=true; document.head.appendChild(s); })();
  // Toast notifications & Scroll helper
  (function(){ var s=document.createElement('script'); s.src='/js/zen-helpers.js?v=1'; s.defer=true; document.head.appendChild(s); })();

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') hideLockedMenuNotice();
  });

  // Badge "Ada update" hanya di menu Update GitHub
  (function() {
    const badge = document.getElementById('updateBadge');
    if (!badge) return;
    const url = '/admin/api/update/check';
    let interval = null;
    async function checkUpdate() {
      try {
        const res = await fetch(url, { cache: 'no-store' });
        if (!res.ok) return;
        const data = await res.json();
          if (data && data.hasError) {
            badge.style.display = 'inline-flex';
            badge.style.background = 'var(--warning)';
            badge.textContent = '● Cek gagal';
            badge.title = data.error || 'Status update tidak dapat diperiksa';
          } else if (data && data.needsUpdate) {
          badge.style.display = 'inline-flex';
            badge.style.background = 'var(--danger)';
            badge.textContent = '● Update';
          badge.title = 'Versi baru tersedia: ' + (data.remoteVersion || '');
        } else {
          badge.style.display = 'none';
        }
      } catch (e) {}
    }
    checkUpdate();
    // Polling ringan tiap 10 menit (jangan tiap detik, hemat git fetch)
    interval = setInterval(checkUpdate, 600000);
    // Tambah animasi pulse
    const style = document.createElement('style');
    style.textContent = '@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}';
    document.head.appendChild(style);
  })();

  // Realtime WhatsApp Connection Indicator Dot
  (function() {
    const dot = document.getElementById('waSidebarStatusDot');
    if (!dot) return;
    async function updateWaStatus() {
      try {
        const res = await fetch('/admin/api/whatsapp/status', { cache: 'no-store' });
        if (!res.ok) return;
        const data = await res.json();
        const conn = String(data.connection || '').toLowerCase();
        if (conn === 'open' || conn === 'connected') {
          dot.style.background = '#34D399';
          dot.style.boxShadow = '0 0 8px rgba(52, 211, 153, 0.7)';
          dot.title = 'WhatsApp: Terhubung (Connected)';
        } else if (conn === 'connecting' || conn === 'close') {
          dot.style.background = '#FBBF24';
          dot.style.boxShadow = '0 0 8px rgba(251, 191, 36, 0.7)';
          dot.title = 'WhatsApp: Menghubungkan / Butuh Scan QR';
        } else {
          dot.style.background = '#F87171';
          dot.style.boxShadow = '0 0 8px rgba(248, 113, 113, 0.7)';
          dot.title = 'WhatsApp: Terputus (Disconnected)';
        }
      } catch (e) {
        dot.style.background = '#F87171';
        dot.style.boxShadow = '0 0 8px rgba(248, 113, 113, 0.7)';
        dot.title = 'WhatsApp: Gagal Memeriksa Koneksi';
      }
    }
    updateWaStatus();
    // Periksa status koneksi WA setiap 30 detik
    setInterval(updateWaStatus, 30000);
    // Tambahkan animasi berdenyut untuk dot indikatormu
    const pulseStyle = document.createElement('style');
    pulseStyle.textContent = '#waSidebarStatusDot { animation: pulse 2s infinite ease-in-out; }';
    document.head.appendChild(pulseStyle);
  })();
</script>

