<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" type="image/png">
  <title><%= t('admin.nav.voucher_packages', 'Paket Voucher') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .vp-ico{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--wdim);color:var(--warning);border:1px solid rgba(251,191,36,.28);box-shadow:0 0 12px rgba(251,191,36,.15);font-size:16px;flex-shrink:0}
    .vp-ico.off{background:rgba(125,133,144,.12);color:var(--muted);border-color:rgba(125,133,144,.2);box-shadow:none}
    .price-main{font-weight:700;font-size:13.5px;letter-spacing:-.2px}
    .code-preview{font-family:'Consolas','Monaco',monospace;font-size:11.5px;background:var(--bg3);border:1px dashed rgba(190,239,255,.3);border-radius:8px;padding:3px 9px;color:var(--primary);letter-spacing:1px;display:inline-block}
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'voucher_packages', company }) %>

<div class="mw">
<%- include('partials/licenseGraceBar') %>
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-ticket-perforated"></i>
      <span><%= t('admin.nav.voucher_packages', 'Paket Voucher') %></span>
    </div>
    <div class="tb-right">
      <span class="adm-badge">
        <i class="bi bi-person-fill"></i>
        <%= (typeof session !== 'undefined' && session && session.isCashier) ? t('admin.role.cashier', 'Kasir') : t('admin.role.admin', 'Admin') %>
      </span>
      <button class="btn btn-p btn-sm" onclick="openModal('addVpModal')"><i class="bi bi-plus-lg"></i> <%= t('admin.voucher_packages.add', 'Tambah Paket Voucher') %></button>
    </div>
  </div>

  <div class="page">
    <div id="msg-box"></div>

    <div class="stat-grid">
      <div class="sc w">
        <i class="bi bi-ticket-perforated-fill sc-icon"></i>
        <div class="sc-label"><%= t('admin.voucher_packages.stats.total', 'Total Paket Voucher') %></div>
        <div class="sc-val" id="vp-stat-total">-</div>
        <div class="sc-sub"><span id="vp-stat-active">-</span> <%= t('common.active', 'Aktif').toLowerCase() %> · <span id="vp-stat-inactive">-</span> <%= t('common.inactive', 'Nonaktif').toLowerCase() %></div>
      </div>
      <div class="sc s">
        <i class="bi bi-cash-coin sc-icon"></i>
        <div class="sc-label"><%= t('admin.voucher_packages.stats.min_price', 'Harga Termurah') %></div>
        <div class="sc-val" style="font-size:20px" id="vp-stat-min">-</div>
        <div class="sc-sub"><%= t('admin.voucher_packages.stats.max_price', 'Termahal') %>: <span id="vp-stat-max">-</span></div>
      </div>
      <div class="sc p">
        <i class="bi bi-hdd-network-fill sc-icon"></i>
        <div class="sc-label"><%= t('admin.voucher_packages.stats.routers', 'Router Terpakai') %></div>
        <div class="sc-val" id="vp-stat-routers">-</div>
        <div class="sc-sub"><%= t('admin.voucher_packages.stats.routers_sub', 'Router dengan profil voucher') %></div>
      </div>
      <div class="sc i">
        <i class="bi bi-clock-history sc-icon"></i>
        <div class="sc-label"><%= t('admin.voucher_packages.stats.validity', 'Variasi Masa Aktif') %></div>
        <div class="sc-val" id="vp-stat-validity">-</div>
        <div class="sc-sub" id="vp-stat-validity-sub"><%= t('admin.voucher_packages.stats.validity_sub', 'Durasi berbeda tersedia') %></div>
      </div>
    </div>

    <div class="card" style="margin-bottom:16px">
      <div class="card-bd" style="padding:14px 18px">
        <div class="filter-title"><i class="bi bi-funnel-fill"></i> <%= t('admin.common.search_filter', 'Pencarian & Filter') %></div>
        <form class="srow" style="margin:0" onsubmit="return false">
          <div class="sinput" style="max-width:320px">
            <i class="bi bi-search"></i>
            <input class="fc" id="vp-search" placeholder="<%= t('admin.voucher_packages.search_placeholder', 'Cari profil / prefix...') %>" oninput="filterVpTable()">
          </div>
          <% if (routers && routers.length > 0) { %>
          <select id="router-filter" class="fs" style="max-width:240px" onchange="changeRouterFilter(this.value)">
            <option value="" <%= (!selectedRouterId) ? 'selected' : '' %>><%= t('admin.voucher_packages.all_routers', '-- Semua Router --') %></option>
            <% routers.forEach(r => { %>
              <option value="<%= r.id %>" <%= (String(selectedRouterId||'') === String(r.id)) ? 'selected' : '' %>><%= r.name %></option>
            <% }) %>
          </select>
          <% } %>
          <select id="vp-status-filter" class="fs" style="max-width:170px" onchange="filterVpTable()">
            <option value=""><%= t('admin.customers.filter.all_status', 'Semua Status') %></option>
            <option value="1"><%= t('common.active', 'Aktif') %></option>
            <option value="0"><%= t('common.inactive', 'Nonaktif') %></option>
          </select>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card-hd">
        <h6><i class="bi bi-list-ul"></i> <%= t('admin.voucher_packages.list', 'Daftar Paket Voucher Hotspot') %> (<span id="vp-count">0</span>)</h6>
      </div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th><%= t('admin.voucher_packages.table.profile', 'Nama Profil') %></th>
              <th><%= t('admin.voucher_packages.table.router', 'Router') %></th>
              <th><%= t('admin.voucher_packages.table.price', 'Harga') %></th>
              <th><%= t('admin.voucher_packages.table.validity', 'Masa Aktif') %></th>
              <th><%= t('admin.voucher_packages.table.prefix', 'Prefix Kode') %></th>
              <th><%= t('admin.voucher_packages.table.code_length', 'Panjang Kode') %></th>
              <th><%= t('admin.voucher_packages.table.status', 'Status') %></th>
              <th><%= t('admin.voucher_packages.table.actions', 'Aksi') %></th>
            </tr>
          </thead>
          <tbody id="vp-tbody">
            <tr><td colspan="8" class="text-center text-muted" style="padding:20px"><%= t('admin.voucher_packages.loading', 'Memuat data...') %></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal Tambah -->
<div class="mo" id="addVpModal">
  <div class="mb">
    <form id="addVpForm">
      <div class="mh"><span class="mt"><%= t('admin.voucher_packages.modal.add_title', 'Tambah Paket Voucher') %></span><button type="button" class="mc" onclick="closeModal('addVpModal')">&times;</button></div>
      <div class="mbody">
        <% if (routers && routers.length > 0) { %>
        <div class="fg">
          <label class="fl"><%= t('admin.voucher_packages.form.router', 'Router') %></label>
          <select name="router_id" id="a-vp-router" class="fs" required>
            <option value=""><%= t('admin.voucher_packages.choose_router', '-- Pilih Router --') %></option>
            <% routers.forEach(r => { %><option value="<%= r.id %>"><%= r.name %></option><% }) %>
          </select>
        </div>
        <% } else { %>
        <div class="alert alert-w"><%= t('admin.voucher_packages.no_router', 'Belum ada router aktif. Tambahkan router terlebih dahulu di menu Router.') %></div>
        <% } %>
        <div class="fg"><label class="fl"><%= t('admin.voucher_packages.form.profile', 'Nama Profil Hotspot') %></label><input type="text" name="profile_name" id="a-vp-profile" class="fc" placeholder="Contoh: 1Jam, 1Hari" required></div>
        <div class="fg"><label class="fl"><%= t('admin.voucher_packages.form.price', 'Harga (Rp)') %></label><input type="number" name="price" id="a-vp-price" class="fc" min="0" required></div>
        <div class="fg"><label class="fl"><%= t('admin.voucher_packages.form.validity', 'Masa Aktif') %></label><input type="text" name="validity" id="a-vp-validity" class="fc" placeholder="Contoh: 1h, 1d, 7d" required></div>
        <div class="fg"><label class="fl"><%= t('admin.voucher_packages.form.prefix', 'Prefix Kode (opsional)') %></label><input type="text" name="prefix" id="a-vp-prefix" class="fc" placeholder="Contoh: VC"></div>
        <div class="fg"><label class="fl"><%= t('admin.voucher_packages.form.code_length', 'Panjang Kode') %></label><input type="number" name="code_length" id="a-vp-code-length" class="fc" min="4" max="16" value="6"></div>
        <div class="fg">
          <label class="fl"><%= t('admin.voucher_packages.form.charset', 'Karakter Kode') %></label>
          <select name="charset" id="a-vp-charset" class="fs">
            <option value="mixed"><%= t('admin.voucher_packages.charset.mixed', 'Huruf & Angka') %></option>
            <option value="numeric"><%= t('admin.voucher_packages.charset.numeric', 'Angka Saja') %></option>
            <option value="alpha"><%= t('admin.voucher_packages.charset.alpha', 'Huruf Saja') %></option>
          </select>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('addVpModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><%= t('common.save', 'Simpan') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit -->
<div class="mo" id="editVpModal">
  <div class="mb">
    <form id="editVpForm">
      <input type="hidden" name="id" id="e-vp-id">
      <div class="mh"><span class="mt"><%= t('admin.voucher_packages.modal.edit_title', 'Edit Paket Voucher') %></span><button type="button" class="mc" onclick="closeModal('editVpModal')">&times;</button></div>
      <div class="mbody">
        <% if (routers && routers.length > 0) { %>
        <div class="fg">
          <label class="fl"><%= t('admin.voucher_packages.form.router', 'Router') %></label>
          <select name="router_id" id="e-vp-router" class="fs" required>
            <% routers.forEach(r => { %><option value="<%= r.id %>"><%= r.name %></option><% }) %>
          </select>
        </div>
        <% } %>
        <div class="fg"><label class="fl"><%= t('admin.voucher_packages.form.profile', 'Nama Profil Hotspot') %></label><input type="text" name="profile_name" id="e-vp-profile" class="fc" required></div>
        <div class="fg"><label class="fl"><%= t('admin.voucher_packages.form.price', 'Harga (Rp)') %></label><input type="number" name="price" id="e-vp-price" class="fc" min="0" required></div>
        <div class="fg"><label class="fl"><%= t('admin.voucher_packages.form.validity', 'Masa Aktif') %></label><input type="text" name="validity" id="e-vp-validity" class="fc" required></div>
        <div class="fg"><label class="fl"><%= t('admin.voucher_packages.form.prefix', 'Prefix Kode (opsional)') %></label><input type="text" name="prefix" id="e-vp-prefix" class="fc"></div>
        <div class="fg"><label class="fl"><%= t('admin.voucher_packages.form.code_length', 'Panjang Kode') %></label><input type="number" name="code_length" id="e-vp-code-length" class="fc" min="4" max="16"></div>
        <div class="fg">
          <label class="fl"><%= t('admin.voucher_packages.form.charset', 'Karakter Kode') %></label>
          <select name="charset" id="e-vp-charset" class="fs">
            <option value="mixed"><%= t('admin.voucher_packages.charset.mixed', 'Huruf & Angka') %></option>
            <option value="numeric"><%= t('admin.voucher_packages.charset.numeric', 'Angka Saja') %></option>
            <option value="alpha"><%= t('admin.voucher_packages.charset.alpha', 'Huruf Saja') %></option>
          </select>
        </div>
        <div class="fg">
          <label class="fl"><%= t('admin.voucher_packages.form.status', 'Status') %></label>
          <select name="is_active" id="e-vp-status" class="fs">
            <option value="1"><%= t('common.active', 'Aktif') %></option>
            <option value="0"><%= t('common.inactive', 'Nonaktif') %></option>
          </select>
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('editVpModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><%= t('admin.voucher_packages.save_changes', 'Simpan Perubahan') %></button>
      </div>
    </form>
  </div>
</div>

<script>
const I18N = {
  confirmDeleteVoucherPackage: "<%= t('admin.voucher_packages.confirm_delete', 'Hapus paket voucher ini?') %>",
  loadFailed: "<%= t('admin.voucher_packages.load_failed', 'Gagal memuat data paket voucher.') %>",
  saveFailed: "<%= t('admin.voucher_packages.save_failed', 'Gagal menyimpan paket voucher.') %>",
  deleteFailed: "<%= t('admin.voucher_packages.delete_failed', 'Gagal menghapus paket voucher.') %>",
  empty: "<%= t('admin.voucher_packages.empty', 'Belum ada paket voucher.') %>",
  allRoutersShort: "<%= t('admin.voucher_packages.all_routers_short', '-') %>"
};

function openModal(id) { document.getElementById(id).classList.add('show'); }
function closeModal(id) { document.getElementById(id).classList.remove('show'); }

function showMsg(type, text) {
  const box = document.getElementById('msg-box');
  box.innerHTML = '<div class="alert alert-' + (type === 'error' ? 'd' : 's') + '">' + text + '</div>';
  setTimeout(() => { box.innerHTML = ''; }, 4000);
}

function changeRouterFilter(routerId) {
  const url = new URL(window.location.href);
  if (routerId) url.searchParams.set('router_id', routerId);
  else url.searchParams.delete('router_id');
  window.location.href = url.toString();
}

function escapeHtml(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

async function loadVoucherPackages() {
  const params = new URLSearchParams(window.location.search);
  const routerId = params.get('router_id') || '';
  const qs = routerId ? ('?router_id=' + encodeURIComponent(routerId)) : '';
  const tbody = document.getElementById('vp-tbody');
  try {
    // 2. Efek Kerangka Memuat Data (Skeleton Loading Shimmer)
    tbody.innerHTML = `
      <tr>
        <td colspan="8" style="padding:0">
          <div class="skeleton-shimmer-row"></div>
          <div class="skeleton-shimmer-row"></div>
          <div class="skeleton-shimmer-row"></div>
        </td>
      </tr>
    `;
    const res = await fetch('/admin/api/vouchers/packages' + qs);
    const data = await res.json();
    if (!data.ok) throw new Error(data.error || I18N.loadFailed);
    const rows = data.rows || [];
    document.getElementById('vp-count').textContent = rows.length;
    renderVpStats(rows);
    if (rows.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted" style="padding:20px">' + I18N.empty + '</td></tr>';
      return;
    }
    tbody.innerHTML = rows.map(r => `
      <tr data-name="${escapeHtml(String(r.profile_name || '').toLowerCase())} ${escapeHtml(String(r.prefix || '').toLowerCase())}" data-active="${r.is_active ? 1 : 0}">
        <td><strong>${escapeHtml(r.profile_name)}</strong></td>
        <td>${escapeHtml(r.router_name || I18N.allRoutersShort)}</td>
        <td><div class="price-main">Rp ${Number(r.price).toLocaleString('id-ID')}</div></td>
        <td>${escapeHtml(r.validity)}</td>
        <td>${escapeHtml(r.prefix || '-')}</td>
        <td>${r.code_length} digits</td>
        <td><span class="badge ${r.is_active ? 'bs' : 'bd'}">${r.is_active ? 'Aktif' : 'Nonaktif'}</span></td>
        <td>
          <div class="d-flex gap-2">
            <button class="btn btn-g btn-icon btn-sm" onclick='editVp(${JSON.stringify(r).replace(/'/g, "&#39;")})'><i class="bi bi-pencil"></i></button>
            <button class="btn btn-d btn-icon btn-sm" onclick="deleteVp(${r.id})"><i class="bi bi-trash"></i></button>
          </div>
        </td>
      </tr>
    `).join('');
    filterVpTable();
  } catch (e) {
    tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted" style="padding:20px">' + escapeHtml(e.message || I18N.loadFailed) + '</td></tr>';
  }
}

function renderVpStats(rows) {
  const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
  const act = rows.filter(r => r.is_active).length;
  set('vp-stat-total', rows.length);
  set('vp-stat-active', act);
  set('vp-stat-inactive', rows.length - act);
  const prices = rows.map(r => Number(r.price) || 0).filter(p => p > 0);
  set('vp-stat-min', prices.length ? 'Rp ' + Math.min(...prices).toLocaleString('id-ID') : '-');
  set('vp-stat-max', prices.length ? 'Rp ' + Math.max(...prices).toLocaleString('id-ID') : '-');
  set('vp-stat-routers', new Set(rows.map(r => r.router_id || r.router_name || 'all')).size);
  const vals = [...new Set(rows.map(r => String(r.validity || '').trim()).filter(Boolean))];
  set('vp-stat-validity', vals.length);
  if (vals.length) set('vp-stat-validity-sub', vals.slice(0, 5).join(' · ') + (vals.length > 5 ? ' …' : ''));
}

function filterVpTable() {
  const q = (document.getElementById('vp-search')?.value || '').trim().toLowerCase();
  const st = document.getElementById('vp-status-filter')?.value || '';
  document.querySelectorAll('#vp-tbody tr[data-name]').forEach(tr => {
    const okQ = !q || tr.dataset.name.includes(q);
    const okS = !st || tr.dataset.active === st;
    tr.style.display = okQ && okS ? '' : 'none';
  });
}

function editVp(r) {
  document.getElementById('e-vp-id').value = r.id;
  const routerSel = document.getElementById('e-vp-router');
  if (routerSel) routerSel.value = r.router_id || '';
  document.getElementById('e-vp-profile').value = r.profile_name;
  document.getElementById('e-vp-price').value = r.price;
  document.getElementById('e-vp-validity').value = r.validity;
  document.getElementById('e-vp-prefix').value = r.prefix || '';
  document.getElementById('e-vp-code-length').value = r.code_length;
  document.getElementById('e-vp-charset').value = r.charset || 'mixed';
  document.getElementById('e-vp-status').value = r.is_active;
  openModal('editVpModal');
}

async function deleteVp(id) {
  if (!confirm(I18N.confirmDeleteVoucherPackage)) return;
  try {
    const res = await fetch('/admin/api/vouchers/packages/' + id + '/delete', { method: 'POST' });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error || I18N.deleteFailed);
    showMsg('success', I18N.deleteFailed === undefined ? 'OK' : 'Berhasil dihapus.');
    loadVoucherPackages();
  } catch (e) {
    showMsg('error', e.message || I18N.deleteFailed);
  }
}

async function submitVpForm(form, isEdit) {
  const fd = new FormData(form);
  const payload = Object.fromEntries(fd.entries());
  try {
    const res = await fetch('/admin/api/vouchers/packages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (!data.ok) throw new Error(data.error || I18N.saveFailed);
    showMsg('success', 'Berhasil disimpan.');
    closeModal(isEdit ? 'editVpModal' : 'addVpModal');
    form.reset();
    loadVoucherPackages();
  } catch (e) {
    showMsg('error', e.message || I18N.saveFailed);
  }
}

document.getElementById('addVpForm').addEventListener('submit', function (e) {
  e.preventDefault();
  submitVpForm(this, false);
});
document.getElementById('editVpForm').addEventListener('submit', function (e) {
  e.preventDefault();
  submitVpForm(this, true);
});

loadVoucherPackages();
</script>
</body>
</html>
