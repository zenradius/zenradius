<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Payment Qris Statis | <%= company %></title>
  <meta name="theme-color" content="#0f172a">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" type="image/png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<%- include('partials/sidebar', { activePage: 'payment_qris_static', company }) %>
<div class="mw">
<%- include('partials/licenseGraceBar') %>
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-qr-code-scan"></i> Payment Qris Statis</div>
    <div class="tb-right">
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i> <%= t('common.logout', 'Logout') %></a>
    </div>
  </div>

  <!-- Shortcut ke Log Notifikasi E-Wallet (menggantikan tab Webhook & Notifikasi yang duplikat) -->
  <div style="display: flex; gap: 8px; padding: 12px 16px; background: var(--bg3); border-bottom: 1px solid var(--border); flex-wrap: wrap; align-items: center; justify-content: flex-end;">
    <a href="/admin/ewallet-logs" class="btn btn-g btn-sm"><i class="bi bi-wallet2"></i> Lihat Log Notifikasi E-Wallet</a>
  </div>
  <div class="page">

    <% if (msg) { %>
    <div class="alert alert-<%= msg.type==='success'?'s':'d' %>">
      <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <%= msg.text %>
    </div>
    <% } %>

    <!-- TAB: Konfigurasi -->
    <div id="tab-config" class="tab-content" style="display: block;">

    <!-- Stat Card QRIS Statis -->
    <div class="stat-grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin-bottom: 24px;">
      <%
        const hasStaticQris = (String(settings.qris_static_qr_url || '').trim() || String(settings.qris_static_payload || '').trim()) && (settings.qris_static_enabled !== false && settings.qris_static_enabled !== 'false' && settings.qris_static_enabled !== 0 && settings.qris_static_enabled !== '0');
      %>
      <div class="sc <%= hasStaticQris ? 's' : 'w' %>" style="padding-right: 20px;">
        <div class="sc-icon"><i class="bi bi-qr-code-scan"></i></div>
        <div class="sc-label">Metode QRIS Mandiri / Statis</div>
        <div class="sc-val" style="font-size: 22px; display: flex; align-items: center; gap: 8px;">
          QRIS Statis
          <span class="pill <%= hasStaticQris ? 'pill-p' : 'pill-u' %>" style="font-size: 10px; padding: 2px 8px; font-weight: 700;">
            <%= hasStaticQris ? 'Aktif' : 'Nonaktif' %>
          </span>
        </div>
        <div class="sc-sub">Pembayaran mandiri via upload QRIS gambar atau teks payload</div>
      </div>
    </div>

    <form method="POST" action="/admin/settings">
      <input type="hidden" name="_redirect" value="/admin/payment-qris-static">

      <div class="card mb16">
        <div class="card-hd"><h6><i class="bi bi-qr-code-scan"></i> Pengaturan Payment QRIS Statis</h6></div>
        <div class="card-bd">

          <div id="panel-qris" style="background: rgba(0,0,0,0.02); padding: 15px; border-radius: 12px; margin-bottom: 15px;">
            <h6 style="font-size:12px; margin-bottom: 10px;">QRIS Statis (Semi-Otomatis)</h6>
            <div class="form-row3">
              <div class="fg">
                <label class="fl">Status QRIS Statis</label>
                <select class="fs" name="qris_static_enabled">
                  <option value="true" <%= (settings.qris_static_enabled !== false && settings.qris_static_enabled !== 'false') ? 'selected' : '' %>>Aktif</option>
                  <option value="false" <%= (settings.qris_static_enabled === false || settings.qris_static_enabled === 'false') ? 'selected' : '' %>>Nonaktif</option>
                </select>
              </div>
              <div class="fg">
                <label class="fl">QRIS Static QR URL</label>
                <input class="fc" name="qris_static_qr_url" value="<%= settings.qris_static_qr_url || '' %>" placeholder="https://.../qris.png atau link QRIS">
              </div>
              <div class="fg">
                <label class="fl">Catatan</label>
                <input class="fc" value="Pusat layanan pelanggan akan menampilkan QRIS + nominal unik (kode bayar)." readonly>
              </div>
            </div>
            <div class="fg" style="margin-top:10px">
              <label class="fl">QRIS Static Payload (String)</label>
              <textarea class="fc" name="qris_static_payload" rows="3" placeholder="000201010211...6304XXXX"><%= settings.qris_static_payload || '' %></textarea>
              <div style="font-size:10px; color:var(--muted); margin-top:4px">Jika diisi, sistem akan membuat QRIS dinamis per transaksi (nominal langsung terisi saat scan). Jika kosong, sistem pakai URL gambar seperti biasa.</div>
            </div>
            <div class="fg" style="margin-top:10px">
              <label class="fl">Upload Gambar QRIS (opsional)</label>
              <div style="display:flex; gap:10px; align-items:stretch; flex-wrap:wrap">
                <input class="fc" type="file" id="qris_upload_file" name="qris_file" accept="image/png,image/jpeg,image/jpg,image/webp" style="flex:1 1 200px; margin:0">
                <button class="btn btn-s" type="button" id="qris_upload_btn" style="flex:none; white-space:nowrap"><i class="bi bi-upload"></i> Upload</button>
              </div>
              <div style="font-size:10px; color:var(--muted); margin-top:4px">Jika di-upload, sistem akan menyimpan file dan otomatis mengisi URL QRIS.</div>
            </div>
            <% if (settings.qris_static_qr_url) { %>
              <div style="margin-top:10px; display:flex; gap:12px; align-items:center; flex-wrap:wrap">
                <div style="font-size:10px; color:var(--muted)">Preview:</div>
                <img src="<%= settings.qris_static_qr_url %>" alt="QRIS" style="height:72px; width:72px; object-fit:contain; background:#fff; border-radius:12px; padding:8px; border:1px solid rgba(0,0,0,0.08)">
                <div style="font-size:10px; color:var(--muted)">Gunakan tombol <span style="font-weight:700">QR</span> di menu Billing untuk membuat nominal unik per invoice.</div>
              </div>
            <% } %>

            <!-- Webhook Integration for MacroDroid -->
            <div style="margin-top: 15px; border-top: 1px dashed rgba(0,0,0,0.1); padding-top: 15px;">
              <h6 style="font-size:11px; margin-bottom: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px;"><i class="bi bi-phone"></i> Webhook Notifikasi SMS/E-Wallet (MacroDroid)</h6>
              <div class="fg">
                <label class="fl">Webhook Secret Key <span style="color:#ef4444">*wajib diisi min. 8 karakter</span></label>
                <input class="fc" id="webhook_secret_input" name="webhook_secret" value="<%= settings.webhook_secret || '' %>" placeholder="Buat kata sandi rahasia unik, minimal 8 karakter" type="text">
                <div style="font-size:10px; color:var(--muted); margin-top:4px">Tanpa mengisi ini, semua notifikasi masuk dari MacroDroid akan DITOLAK (403 Forbidden) oleh server.</div>
              </div>
              <div class="fg" style="margin-top:10px">
                <label class="fl">Link Webhook MacroDroid (URL POST)</label>
                <div style="display:flex;gap:8px">
                  <%
                    // Selalu ikuti domain aktif yang sedang diakses admin (bukan public_base_url
                    // statis di settings) agar link otomatis mengikuti saat domain berganti.
                    const base = (typeof activeBaseUrl !== 'undefined' && activeBaseUrl) ? activeBaseUrl : (settings.public_base_url ? settings.public_base_url.replace(/\/+$/, '') : '');
                    const secret = settings.webhook_secret || process.env.MY_WEBHOOK_SECRET || '';
                    const macroWebhookUrl = base ? (base + '/api/webhook/v1/payment-notif?secret_key=' + secret) : '/api/webhook/v1/payment-notif?secret_key=' + secret;
                  %>
                  <input class="fc" id="macro_webhook_url" readonly value="<%= macroWebhookUrl %>">
                  <button type="button" class="btn btn-g" onclick="copyInput('macro_webhook_url', 'Link Webhook')"><i class="bi bi-copy"></i></button>
                </div>
                <div style="font-size:10px; color:var(--muted); margin-top:4px">Kirimkan request HTTP POST ke URL ini dari MacroDroid Anda (sudah termasuk kunci rahasia). Link ini otomatis mengikuti domain yang sedang Anda akses saat ini.</div>
              </div>
            </div>
          </div>

        </div>
        <div class="card-bd" style="border-top:1px solid var(--border);padding-top:20px;text-align:right">
          <button type="submit" class="btn btn-p"><i class="bi bi-save"></i> Simpan Pengaturan</button>
        </div>
      </div>
    </form>

    </div><!-- End TAB: Konfigurasi -->

  </div>
</div>

<script src="https://unpkg.com/jsqr@1.4.0/dist/jsQR.js" integrity="sha384-b5Ya4Bq3qCyz39m2ISh+4DxjAIljdeFwK/BsXLuj9gugaNwAcj/ia15fxNZL9Nlx" crossorigin="anonymous"></script>
<script>

function copyInput(id, name) {
  const el = document.getElementById(id);
  if (el) {
    el.select();
    document.execCommand('copy');
    alert(name + ' berhasil disalin!');
  }
}

(function () {
  const fileInput = document.getElementById('qris_upload_file');
  const btn = document.getElementById('qris_upload_btn');
  if (!fileInput || !btn) return;

  const normalizePayload = (raw) => {
    let s = String(raw || '').replace(/[\r\n\t]+/g, '').trim();
    const idx = s.indexOf('000201');
    if (idx > 0) s = s.slice(idx);
    const lastCrc = s.lastIndexOf('6304');
    if (lastCrc >= 0 && s.length >= lastCrc + 8) s = s.slice(0, lastCrc + 8);
    return s;
  };

  const decodeQrPayloadInBrowser = async (file) => {
    try {
      if (!window.jsQR) return '';
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.decoding = 'async';
      img.src = url;
      await new Promise((resolve, reject) => {
        img.onload = () => resolve();
        img.onerror = () => reject(new Error('Gagal membaca gambar'));
      });
      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return '';
      canvas.width = img.naturalWidth || img.width || 0;
      canvas.height = img.naturalHeight || img.height || 0;
      if (!canvas.width || !canvas.height) return '';
      ctx.drawImage(img, 0, 0);
      const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      const res = window.jsQR(imageData.data, canvas.width, canvas.height, { inversionAttempts: 'attemptBoth' });
      URL.revokeObjectURL(url);
      if (!res || !res.data) return '';
      const s = normalizePayload(res.data);
      return s.startsWith('000201') ? s : '';
    } catch {
      return '';
    }
  };

  btn.addEventListener('click', async () => {
    const f = fileInput.files && fileInput.files[0] ? fileInput.files[0] : null;
    if (!f) return;
    const fd = new FormData();
    fd.append('qris_file', f);
    const payload = await decodeQrPayloadInBrowser(f);
    if (payload) fd.append('qris_payload', payload);
    btn.disabled = true;
    try {
      const r = await fetch('/admin/settings/qris-upload?redirect=' + encodeURIComponent('/admin/payment-qris-static'), { method: 'POST', body: fd, credentials: 'same-origin' });
      if (!r.ok) throw new Error('Upload gagal');
      window.location.href = '/admin/payment-qris-static';
    } catch (e) {
      window.location.href = '/admin/payment-qris-static';
    } finally {
      btn.disabled = false;
    }
  });
})();
</script>
</body>
</html>
