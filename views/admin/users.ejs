<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= t('admin.nav.user_management', 'Akses Role') %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .perm-wrap{border:1px solid var(--border,#e5e7eb);border-radius:10px;padding:12px;max-height:340px;overflow:auto;background:var(--card2,rgba(0,0,0,.02))}
    .perm-sec{margin-bottom:12px}
    .perm-sec:last-child{margin-bottom:0}
    .perm-sec-hd{display:flex;align-items:center;justify-content:space-between;font-size:11px;font-weight:700;letter-spacing:.5px;color:var(--muted);margin-bottom:6px;text-transform:uppercase}
    .perm-sec-hd a{font-size:11px;font-weight:500;text-transform:none;letter-spacing:0;cursor:pointer}
    .perm-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:6px 12px}
    .perm-item{display:flex;align-items:center;gap:8px;font-size:13px;padding:4px 6px;border-radius:6px}
    .perm-item:hover{background:rgba(0,0,0,.04)}
    .perm-item input{width:16px;height:16px;accent-color:var(--primary,#2563eb)}
    .perm-item i{opacity:.7;font-size:13px}
    .perm-toggle{display:flex;align-items:center;gap:10px;padding:10px 12px;border:1px solid var(--border,#e5e7eb);border-radius:10px;margin-bottom:10px}
    .perm-toggle small{display:block;color:var(--muted);font-size:11.5px}
    .perm-toggle input{width:18px;height:18px}
    .badge-custom{font-size:10px;padding:2px 6px;margin-left:4px;vertical-align:middle}
    .mb.wide{max-width:720px;width:95%}
    .role-pill{display:inline-flex;align-items:center;gap:6px}
  </style>
</head>
<body>
<%- include('partials/sidebar', { activePage: 'user_management', company }) %>

<div class="mw">
<%- include('partials/licenseGraceBar') %>
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-person-lines-fill"></i>
      <span><%= t('admin.users.title', 'Akses Role') %></span>
    </div>
    <div class="tb-right">
      <span class="adm-badge">
        <i class="bi bi-person-fill"></i> <%= t('admin.role.admin', 'Admin') %>
      </span>
      <button class="btn btn-p btn-sm" onclick="openModal('addUserModal')"><i class="bi bi-plus-lg"></i> <%= t('admin.users.create', 'Buat Pengguna') %></button>
    </div>
  </div>

  <div class="page">
    <% if (msg) { %>
      <div class="alert alert-<%= msg.type==='error'?'d':'s' %>"><%= msg.text %></div>
    <% } %>

    <%
      const allUsers = (typeof allUsersForStats !== 'undefined' && allUsersForStats) ? allUsersForStats : (users || []);
      const cnt = (fn) => allUsers.filter(fn).length;
      const statTotal = allUsers.length;
      const statActive = cnt(u => u.active);
      const statCashier = cnt(u => u.source === 'cashiers' && u.active);
      const statField = cnt(u => (u.source === 'technicians' || u.source === 'collectors') && u.active);
      const statReseller = cnt(u => u.source === 'agents' && u.active);
      const statCustom = cnt(u => u.customPermissions);
    %>
    <div class="stat-grid">
      <div class="sc p">
        <i class="bi bi-people-fill sc-icon"></i>
        <div class="sc-label"><%= t('admin.users.stats.total', 'Total Pengguna') %></div>
        <div class="sc-val"><%= statTotal %></div>
        <div class="sc-sub"><%= statActive %> <%= t('common.active', 'Aktif').toLowerCase() %> Â· <%= statTotal - statActive %> <%= t('common.inactive', 'Nonaktif').toLowerCase() %></div>
      </div>
      <div class="sc s">
        <i class="bi bi-cash-coin sc-icon"></i>
        <div class="sc-label"><%= t('admin.users.stats.cashiers', 'Kasir Aktif') %></div>
        <div class="sc-val"><%= statCashier %></div>
        <div class="sc-sub"><%= t('admin.users.stats.cashiers_sub', 'Akses panel admin terbatas') %></div>
      </div>
      <div class="sc w">
        <i class="bi bi-tools sc-icon"></i>
        <div class="sc-label"><%= t('admin.users.stats.field', 'Tim Lapangan') %></div>
        <div class="sc-val"><%= statField %></div>
        <div class="sc-sub"><%= t('admin.users.stats.field_sub', 'Teknisi & Kolektor aktif') %> Â· <%= statReseller %> reseller</div>
      </div>
      <div class="sc i">
        <i class="bi bi-sliders sc-icon"></i>
        <div class="sc-label"><%= t('admin.users.stats.custom', 'Akses Kustom') %></div>
        <div class="sc-val"><%= statCustom %></div>
        <div class="sc-sub"><%= t('admin.users.stats.custom_sub', 'Pengguna dengan hak akses khusus') %></div>
      </div>
    </div>

    <div class="card" style="margin-bottom:16px">
      <div class="card-bd" style="padding:14px">
        <div class="filter-title"><i class="bi bi-funnel-fill"></i> <%= t('admin.common.search_filter', 'Pencarian & Filter') %></div>
        <form method="GET" action="/admin/users" class="d-flex gap-2 flex-wrap" style="align-items:center">
          <input type="text" name="q" class="fc" style="max-width:260px" placeholder="<%= t('admin.users.search_placeholder', 'Cari nama, username, atau HP...') %>" value="<%= q || '' %>">
          <select name="role" class="fs" style="max-width:200px">
            <option value=""><%= t('admin.users.all_roles', 'Semua Role') %></option>
            <% canonicalRoles.forEach(r => { %>
              <option value="<%= r %>" <%= roleFilter===r ? 'selected' : '' %>><%= roleLabels[r] || r %></option>
            <% }) %>
          </select>
          <select name="status" class="fs" style="max-width:160px">
            <option value=""><%= t('common.all_status', 'Semua Status') %></option>
            <option value="active" <%= statusFilter==='active' ? 'selected' : '' %>><%= t('common.active', 'Aktif') %></option>
            <option value="inactive" <%= statusFilter==='inactive' ? 'selected' : '' %>><%= t('common.inactive', 'Nonaktif') %></option>
          </select>
          <button type="submit" class="btn btn-g btn-sm"><i class="bi bi-search"></i> <%= t('admin.users.search', 'Cari') %></button>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card-hd">
        <h6><i class="bi bi-list-ul"></i> <%= t('admin.users.list', 'Daftar Pengguna') %></h6>
      </div>
      <div class="tbl-wrap">
        <table class="dtbl">
          <thead>
            <tr>
              <th><%= t('admin.users.table.name', 'Nama') %></th>
              <th><%= t('admin.users.table.username', 'Username') %></th>
              <th><%= t('admin.users.table.role', 'Role') %></th>
              <th><%= t('admin.users.table.access', 'Hak Akses') %></th>
              <th><%= t('admin.users.table.status', 'Status') %></th>
              <th><%= t('admin.users.table.actions', 'Aksi') %></th>
            </tr>
          </thead>
          <tbody>
            <% if (!users || users.length === 0) { %>
              <tr><td colspan="6" class="text-center text-muted" style="padding:20px"><%= t('admin.users.empty', 'Tidak ada pengguna ditemukan.') %></td></tr>
            <% } else { %>
              <% users.forEach(u => { %>
                <tr>
                  <td><strong><%= u.name %></strong><% if (u.phone) { %><div class="text-muted" style="font-size:11.5px"><%= u.phone %></div><% } %></td>
                  <td><code><%= u.username %></code></td>
                  <td><span class="badge bp"><%= u.roleLabel %></span></td>
                  <td>
                    <% if (u.customPermissions) { %>
                      <span class="badge bw" title="Hak akses dikustomisasi"><i class="bi bi-sliders"></i> <%= u.permissions.length %> menu</span>
                    <% } else { %>
                      <span class="text-muted" style="font-size:12px"><i class="bi bi-check2-all"></i> Default role</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge <%= u.active ? 'bs' : 'bd' %>">
                      <%= u.active ? t('common.active', 'Aktif') : t('common.inactive', 'Nonaktif') %>
                    </span>
                  </td>
                  <td>
                    <div class="d-flex gap-2">
                      <button class="btn btn-g btn-icon btn-sm" title="Edit & Hak Akses" onclick='editUser(<%- JSON.stringify(u) %>)'><i class="bi bi-pencil"></i></button>
                      <button class="btn btn-g btn-icon btn-sm" title="Reset Password" onclick='openResetPassword("<%= u.source %>", <%= u.id %>)'><i class="bi bi-key"></i></button>
                      <form action="/admin/users/<%= u.source %>/<%= u.id %>/status" method="POST" onsubmit="return confirm(<%= u.active ? 'I18N.confirmDisable' : 'I18N.confirmEnable' %>)">
                        <input type="hidden" name="active" value="<%= u.active ? '0' : '1' %>">
                        <button type="submit" class="btn <%= u.active ? 'btn-w' : 'btn-p' %> btn-icon btn-sm" title="<%= u.active ? 'Nonaktifkan' : 'Aktifkan' %>">
                          <i class="bi <%= u.active ? 'bi-slash-circle' : 'bi-check-circle' %>"></i>
                        </button>
                      </form>
                      <form action="/admin/users/<%= u.source %>/<%= u.id %>/delete" method="POST" onsubmit="return confirm(I18N.confirmDelete)">
                        <button type="submit" class="btn btn-d btn-icon btn-sm" title="Hapus"><i class="bi bi-trash"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%
  const ROLE_ICONS = { technicians: 'bi-tools', cashiers: 'bi-cash-coin', collectors: 'bi-wallet2', agents: 'bi-shop' };
  function renderPermissionBlock(prefix) {
%>
  <div class="perm-toggle">
    <input type="checkbox" id="<%= prefix %>-custom" name="use_custom_permissions" value="1" onchange="togglePermBox('<%= prefix %>')">
    <label for="<%= prefix %>-custom" style="cursor:pointer;flex:1">
      <strong><%= t('admin.users.custom_access', 'Atur hak akses menu secara khusus') %></strong>
      <small><%= t('admin.users.custom_access_hint', 'Jika tidak dicentang, pengguna mendapat semua menu default sesuai role-nya.') %></small>
    </label>
  </div>
  <div id="<%= prefix %>-permbox" style="display:none">
    <% Object.keys(permissionCatalog).forEach(source => { %>
      <div class="perm-wrap perm-source" data-source="<%= source %>" id="<%= prefix %>-perm-<%= source %>" style="display:none">
        <% permissionCatalog[source].forEach(sec => { %>
          <div class="perm-sec">
            <div class="perm-sec-hd">
              <span><%= t(sec.labelKey, sec.labelDefault) %></span>
              <a onclick="toggleSection(this, true)">Pilih semua</a>
            </div>
            <div class="perm-grid">
              <% sec.items.forEach(item => { %>
                <label class="perm-item">
                  <input type="checkbox" name="permissions" value="<%= item.key %>" data-key="<%= item.key %>">
                  <i class="<%= item.icon %>"></i>
                  <span><%= t(item.labelKey, item.label) %></span>
                </label>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </div>
<% } %>

<!-- Modal Create -->
<div class="mo" id="addUserModal">
  <div class="mb wide">
    <form action="/admin/users" method="POST" autocomplete="off">
      <div class="mh"><span class="mt"><%= t('admin.users.create', 'Buat Pengguna') %></span><button type="button" class="mc" onclick="closeModal('addUserModal')">&times;</button></div>
      <div class="mbody">
        <div class="fg">
          <label class="fl"><%= t('admin.users.table.role', 'Role') %></label>
          <select name="source" id="au-source" class="fs" required onchange="onSourceChange('au', this.value)">
            <% Object.keys(sourceToRole).filter(s => permissionCatalog[s]).forEach(s => { %>
              <option value="<%= s %>"><%= roleLabels[sourceToRole[s]] %></option>
            <% }) %>
          </select>
        </div>
        <div class="fg"><label class="fl"><%= t('admin.users.form.full_name', 'Nama Lengkap') %></label><input type="text" name="name" class="fc" required></div>
        <div class="d-flex gap-2" style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div class="fg"><label class="fl">Username</label><input type="text" name="username" class="fc" required autocomplete="off"></div>
          <div class="fg"><label class="fl">Password</label><input type="password" name="password" class="fc" required minlength="4" autocomplete="new-password"></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div class="fg"><label class="fl"><%= t('admin.users.form.whatsapp', 'No. WhatsApp') %></label><input type="text" name="phone" class="fc"></div>
          <div class="fg" id="au-area-group"><label class="fl"><%= t('admin.users.form.area', 'Area Tugas') %></label><input type="text" name="area" class="fc"></div>
        </div>
        <hr style="border:0;border-top:1px solid var(--border,#e5e7eb);margin:6px 0 12px">
        <% renderPermissionBlock('au') %>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('addUserModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> <%= t('common.save', 'Simpan') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit -->
<div class="mo" id="editUserModal">
  <div class="mb wide">
    <form id="editUserForm" method="POST" autocomplete="off">
      <div class="mh"><span class="mt"><%= t('admin.users.edit', 'Edit Pengguna') %> <span class="badge bp badge-custom" id="eu-role"></span></span><button type="button" class="mc" onclick="closeModal('editUserModal')">&times;</button></div>
      <div class="mbody">
        <div class="fg"><label class="fl"><%= t('admin.users.form.full_name', 'Nama Lengkap') %></label><input type="text" name="name" id="eu-name" class="fc" required></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div class="fg"><label class="fl">Username</label><input type="text" name="username" id="eu-username" class="fc" required></div>
          <div class="fg"><label class="fl"><%= t('admin.users.form.whatsapp', 'No. WhatsApp') %></label><input type="text" name="phone" id="eu-phone" class="fc"></div>
        </div>
        <div class="fg" id="eu-area-group"><label class="fl"><%= t('admin.users.form.area', 'Area Tugas') %></label><input type="text" name="area" id="eu-area" class="fc"></div>
        <hr style="border:0;border-top:1px solid var(--border,#e5e7eb);margin:6px 0 12px">
        <% renderPermissionBlock('eu') %>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('editUserModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><i class="bi bi-check-lg"></i> <%= t('common.save', 'Simpan') %></button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Reset Password -->
<div class="mo" id="resetPwModal">
  <div class="mb">
    <form id="resetPwForm" method="POST">
      <div class="mh"><span class="mt"><%= t('admin.users.reset_password', 'Reset Password') %></span><button type="button" class="mc" onclick="closeModal('resetPwModal')">&times;</button></div>
      <div class="mbody">
        <div class="fg"><label class="fl"><%= t('admin.users.new_password', 'Password Baru') %></label><input type="password" name="new_password" class="fc" required minlength="4" autocomplete="new-password"></div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('resetPwModal')"><%= t('common.cancel', 'Batal') %></button>
        <button type="submit" class="btn btn-p"><%= t('common.save', 'Simpan') %></button>
      </div>
    </form>
  </div>
</div>

<script>
const I18N = {
  confirmDisable: "<%= t('admin.users.confirm_disable', 'Nonaktifkan pengguna ini?') %>",
  confirmEnable: "<%= t('admin.users.confirm_enable', 'Aktifkan pengguna ini?') %>",
  confirmDelete: "<%= t('admin.users.confirm_delete', 'Hapus pengguna ini secara permanen?') %>"
};
const ROLE_LABELS = <%- JSON.stringify(roleLabels) %>;
const SOURCE_TO_ROLE = <%- JSON.stringify(sourceToRole) %>;
const AREA_SOURCES = ['technicians', 'collectors'];

function openModal(id) { document.getElementById(id).classList.add('show'); }
function closeModal(id) { document.getElementById(id).classList.remove('show'); }

function showPermSource(prefix, source) {
  document.querySelectorAll('#' + prefix + '-permbox .perm-source').forEach(el => {
    const on = el.dataset.source === source;
    el.style.display = on ? '' : 'none';
    // nonaktifkan input pada blok role lain agar tidak terkirim
    el.querySelectorAll('input[name="permissions"]').forEach(cb => { cb.disabled = !on; });
  });
}

function togglePermBox(prefix) {
  const on = document.getElementById(prefix + '-custom').checked;
  document.getElementById(prefix + '-permbox').style.display = on ? '' : 'none';
}

function toggleSection(link, _) {
  const grid = link.closest('.perm-sec').querySelector('.perm-grid');
  const boxes = grid.querySelectorAll('input[type=checkbox]');
  const allChecked = Array.from(boxes).every(b => b.checked);
  boxes.forEach(b => { b.checked = !allChecked; });
  link.textContent = allChecked ? 'Pilih semua' : 'Hapus semua';
}

function onSourceChange(prefix, source) {
  document.getElementById(prefix + '-area-group').style.display = AREA_SOURCES.includes(source) ? '' : 'none';
  showPermSource(prefix, source);
}

function setPermChecks(prefix, source, keys) {
  const box = document.getElementById(prefix + '-perm-' + source);
  if (!box) return;
  const set = new Set(keys || []);
  box.querySelectorAll('input[name="permissions"]').forEach(cb => { cb.checked = set.has(cb.value); });
}

function editUser(u) {
  document.getElementById('editUserForm').action = '/admin/users/' + u.source + '/' + u.id + '/update';
  document.getElementById('eu-role').textContent = ROLE_LABELS[u.role] || u.role;
  document.getElementById('eu-name').value = u.name || '';
  document.getElementById('eu-username').value = u.username || '';
  document.getElementById('eu-phone').value = u.phone || '';
  document.getElementById('eu-area').value = u.area || '';
  onSourceChange('eu', u.source);

  const custom = Array.isArray(u.permissions);
  document.getElementById('eu-custom').checked = custom;
  togglePermBox('eu');
  // default: jika belum custom, centang semua (agar admin bisa uncheck yang ingin dibatasi)
  if (custom) {
    setPermChecks('eu', u.source, u.permissions);
  } else {
    const box = document.getElementById('eu-perm-' + u.source);
    if (box) box.querySelectorAll('input[name="permissions"]').forEach(cb => { cb.checked = true; });
  }
  openModal('editUserModal');
}

function openResetPassword(source, id) {
  document.getElementById('resetPwForm').action = '/admin/users/' + source + '/' + id + '/reset-password';
  openModal('resetPwModal');
}

// init modal tambah
(function () {
  const sel = document.getElementById('au-source');
  onSourceChange('au', sel.value);
  const box = document.getElementById('au-perm-' + sel.value);
  if (box) box.querySelectorAll('input[name="permissions"]').forEach(cb => { cb.checked = true; });
  sel.addEventListener('change', function () {
    const b = document.getElementById('au-perm-' + this.value);
    if (b) b.querySelectorAll('input[name="permissions"]').forEach(cb => { cb.checked = true; });
  });
})();
</script>
</body>
</html>
