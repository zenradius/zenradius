<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | <%= company %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<%- include('partials/sidebar', { activePage: activePage || 'update', company }) %>
<div class="mw">
  <div class="topbar">
    <div class="tb-title"><button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button><i class="bi bi-cloud-arrow-down"></i> <%= t('admin.update.title', 'Update GitHub') %></div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= t('admin.role.admin', 'Admin') %></span>
            <div class="lang-dropdown">
        <button type="button" class="lang-btn" onclick="toggleLangDropdown(this)" aria-haspopup="true" aria-expanded="false">
          <i class="bi bi-globe"></i> <span><%= (lang || 'id').toUpperCase() %></span> <i class="bi bi-chevron-down" style="font-size:10px"></i>
        </button>
        <div class="lang-menu">
          <a href="/lang/id" class="lang-item <%= (lang || 'id') === 'id' ? 'active' : '' %>">Indonesia</a>
          <a href="/lang/en" class="lang-item <%= (lang || 'id') === 'en' ? 'active' : '' %>">English</a>
        </div>
      </div>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i> <%= t('common.logout', 'Logout') %></a>
    </div>
  </div>
  <div class="page">
    <% if (msg) { %>
      <div class="alert alert-<%= msg.type==='success'?'s':'d' %>">
        <i class="bi bi-<%= msg.type==='success'?'check-circle':'exclamation-circle' %>"></i> <%= msg.text %>
      </div>
    <% } %>

    <div class="card mb16">
      <div class="card-hd"><h6><i class="bi bi-git"></i> <%= t('admin.update.status_title', 'Status Versi') %></h6></div>
      <div class="card-bd">
        <% if (info && info.error) { %>
          <div class="alert alert-d"><i class="bi bi-exclamation-circle"></i> <%= info.error %></div>
        <% } %>
        <div class="form-row" style="align-items:flex-start">
          <div class="fg" style="flex-basis:100%">
            <label class="fl">Repository GitHub</label>
            <div class="fc" style="display:flex;align-items:center;gap:8px;word-break:break-all">
              <i class="bi bi-github"></i>
              <span style="font-weight:700"><%= info?.remoteUrl || info?.repository || '-' %></span>
            </div>
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.update.server_version', 'Versi Server (version.txt)') %></label>
            <div class="fc" style="display:flex;align-items:center;gap:8px">
              <i class="bi bi-hdd-network"></i>
              <span style="font-weight:800"><%= info?.localVersion || '-' %></span>
            </div>
          </div>
          <div class="fg">
            <label class="fl"><%= t('admin.update.github_version_prefix', 'Versi GitHub (origin/') %><%= info?.branch || '-' %><%= t('admin.update.github_version_suffix', ')') %></label>
            <div class="fc" style="display:flex;align-items:center;gap:8px">
              <i class="bi bi-github"></i>
              <span style="font-weight:800"><%= info?.remoteVersion || '-' %></span>
              <% if (info?.needsUpdate) { %>
                <span class="badge bd" style="margin-left:8px"><i class="bi bi-arrow-up-circle"></i> <%= t('admin.update.has_update', 'Ada update') %></span>
              <% } else { %>
                <span class="badge bs" style="margin-left:8px"><i class="bi bi-check2-circle"></i> <%= t('admin.update.latest', 'Terbaru') %></span>
              <% } %>
            </div>
          </div>
        </div>

        <div class="form-row" style="align-items:flex-start;margin-top:10px">
          <div class="fg">
            <label class="fl">Versi Lokal</label>
            <div class="fc" style="font-family:ui-monospace,monospace;font-size:12px;word-break:break-all"><%= info?.localCommit || '-' %></div>
          </div>
          <div class="fg">
            <label class="fl">Versi Repository</label>
            <div class="fc" style="font-family:ui-monospace,monospace;font-size:12px;word-break:break-all"><%= info?.remoteCommit || '-' %></div>
          </div>
        </div>

        <% if (info?.needsUpdate && info?.changelog && info.changelog.length > 0) { %>
          <div class="fg" style="margin-top:14px">
            <label class="fl"><i class="bi bi-list-ul"></i> <%= t('admin.update.changelog_title', 'Keterangan Update Terbaru') %> (<%= info.changelog.length %>)</label>
            <div class="fc" style="max-height:260px;overflow-y:auto;padding:0">
              <ul style="list-style:none;margin:0;padding:0">
                <% info.changelog.forEach(function(item, idx) { %>
                  <li style="display:flex;gap:10px;align-items:flex-start;padding:8px 12px;<%= idx < info.changelog.length - 1 ? 'border-bottom:1px solid rgba(0,0,0,0.08)' : '' %>">
                    <span class="badge bm" style="font-family:ui-monospace,monospace;flex-shrink:0"><%= item.hash %></span>
                    <div style="flex:1;min-width:0">
                      <div style="font-size:13px;word-break:break-word"><%= item.message %></div>
                      <div style="font-size:11px;color:var(--muted);margin-top:2px"><i class="bi bi-person"></i> <%= item.author %> &middot; <i class="bi bi-calendar3"></i> <%= item.date %></div>
                    </div>
                  </li>
                <% }); %>
              </ul>
            </div>
          </div>
        <% } else if (info?.needsUpdate) { %>
          <div class="fg" style="margin-top:14px">
            <div class="alert alert-w" style="margin:0"><i class="bi bi-exclamation-triangle"></i> Ada update tersedia, namun rincian perubahan tidak dapat dimuat.</div>
          </div>
        <% } %>

        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:12px">
          <form method="GET" action="/admin/update">
            <button type="submit" class="btn btn-g"><i class="bi bi-arrow-repeat"></i> <%= t('admin.update.check', 'Cek Versi') %></button>
          </form>
          <form method="POST" action="/admin/update/run" onsubmit="return confirmUpdate()">
            <button type="submit" class="btn btn-s" <%= (info && info.error) ? 'disabled' : '' %>><i class="bi bi-cloud-arrow-down"></i> <%= t('admin.update.run', 'Update Sekarang') %></button>
          </form>
          <form method="POST" action="/admin/update/restart" onsubmit="return confirmRestart()">
            <button type="submit" class="btn btn-p"><i class="bi bi-arrow-clockwise"></i> Restart Aplikasi</button>
          </form>
        </div>

        <div style="margin-top:12px;color:var(--muted);font-size:12px;line-height:1.5">
          File yang dipertahankan: settings.json, .env, database, data, public/uploads, public/img, dan sesi WhatsApp. Sistem membandingkan versi aplikasi dengan repository branch <strong><%= info?.branch || 'main' %></strong>. Setelah update selesai, klik <strong>Restart Aplikasi</strong> untuk menerapkan perubahan.
        </div>
      </div>
    </div>

    <div class="card mb16">
      <div class="card-hd"><h6><i class="bi bi-patch-check"></i> Official Release Channel (GitHub Release)</h6></div>
      <div class="card-bd">
        <% if (!release || !release.configured) { %>
          <div class="alert alert-d"><i class="bi bi-exclamation-circle"></i> Release resmi belum dikonfigurasi. Jalur update Git di atas tetap tersedia sebagai fallback.</div>
        <% } else { %>
          <div class="form-row" style="align-items:flex-start">
            <div class="fg">
              <label class="fl">Sumber Release</label>
              <div class="fc"><%= release.source === 'github_release' ? 'GitHub Release' : (release.source === 'manifest_url' ? 'Manifest URL (override)' : '-') %></div>
            </div>
            <div class="fg">
              <label class="fl">Release Public Key</label>
              <div class="fc"><%= release.trustAnchorConfigured ? 'Terkonfigurasi' : 'Belum dikonfigurasi (fail-closed)' %></div>
            </div>
            <div class="fg">
              <label class="fl">Status Terakhir</label>
              <div class="fc"><%= release.lastRun?.state || 'idle' %></div>
            </div>
          </div>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:12px">
            <button type="button" class="btn btn-g" onclick="checkRelease()"><i class="bi bi-arrow-repeat"></i> Cek Release Resmi</button>
            <button type="button" class="btn btn-s" onclick="runRelease()" <%= release.trustAnchorConfigured ? '' : 'disabled' %>><i class="bi bi-cloud-arrow-down"></i> Update via Release Resmi</button>
          </div>
          <div id="releaseSummary" style="margin-top:10px;font-size:13px"></div>
          <div id="releaseNotesBox" style="margin-top:8px;font-size:12px;white-space:pre-wrap;word-break:break-word;background:rgba(0,0,0,0.06);padding:10px;border-radius:8px;display:none"></div>
          <div id="releaseResult" style="margin-top:10px;font-size:12px;white-space:pre-wrap;word-break:break-word"></div>
        <% } %>
      </div>
    </div>

    <script>
      async function checkRelease() {
        const summary = document.getElementById('releaseSummary');
        const notesBox = document.getElementById('releaseNotesBox');
        summary.textContent = 'Memeriksa...';
        notesBox.style.display = 'none';
        try {
          const res = await fetch('/admin/update/release/check');
          const data = await res.json();
          const r = data.result || {};
          // Values inserted via textContent only — release notes are
          // untrusted remote text and are NEVER rendered as HTML.
          summary.textContent = `Versi saat ini: ${r.currentVersion || '-'} | Versi tersedia: ${r.availableVersion || '-'} | Update tersedia: ${r.updateAvailable ? 'Ya' : 'Tidak'} | Channel: ${r.channel || '-'} | Status: ${r.status || '-'}`;
          if (r.releaseNotes) {
            notesBox.textContent = r.releaseNotes;
            notesBox.style.display = 'block';
          }
        } catch (e) { summary.textContent = 'Gagal memeriksa release.'; }
      }
      async function runRelease() {
        if (!confirm('Jalankan update via release resmi sekarang?')) return;
        const box = document.getElementById('releaseResult');
        box.textContent = 'Menjalankan update...';
        try {
          const res = await fetch('/admin/update/release/run', { method: 'POST' });
          const data = await res.json();
          box.textContent = JSON.stringify(data, null, 2);
        } catch (e) { box.textContent = 'Gagal menjalankan update.'; }
      }
    </script>

    <% if (log) { %>
      <div class="card mb16">
        <div class="card-hd"><h6><i class="bi bi-terminal"></i> <%= t('admin.update.log_title', 'Log Update') %></h6></div>
        <div class="card-bd">
          <pre style="white-space:pre-wrap;word-break:break-word;margin:0;background:rgba(0,0,0,0.08);padding:12px;border-radius:12px"><%= log %></pre>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script>
  function confirmUpdate() {
    return confirm("<%= t('admin.update.confirm', 'Jalankan update dari GitHub sekarang? Pastikan koneksi internet aman dan aplikasi akan direstart setelah selesai.') %>");
  }

  function confirmRestart() {
    return confirm('Restart aplikasi sekarang? Koneksi panel akan terputus sebentar dan dapat dibuka kembali setelah proses selesai.');
  }
</script>
</body>
</html>
