<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#173945">
  <meta name="robots" content="noindex, nofollow">
  <title>Aktivasi Lisensi Diperlukan - ZenRadius</title>
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" type="image/png">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    :root{--bg:#173945;--bg3:#1b4656;--border:rgba(190,239,255,.22);--text:#edf7f5;--muted:#a8bec2;--primary:#22D3EE;--pdim:rgba(34,211,238,.14);--success:#34D399;--sdim:rgba(52,211,153,.14);--danger:#F87171}
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{min-height:100%}
    body{
      background:var(--bg);
      background-image:radial-gradient(circle at 8% 0%,#236060 0%,transparent 34%),radial-gradient(circle at 100% 100%,#173e4d 0%,transparent 42%),linear-gradient(135deg,#173740 0%,#183f51 52%,#194251 100%);
      color:var(--text);font-family:'DM Sans',system-ui,sans-serif;
      min-height:100dvh;display:flex;flex-direction:column;
      padding:0;
    }
    /* Mobile-first: full-bleed sheet */
    .lock-card{
      flex:1;display:flex;flex-direction:column;
      background:var(--bg);border:0;width:100%;
      padding:calc(18px + env(safe-area-inset-top)) 16px calc(16px + env(safe-area-inset-bottom));
    }
    .brand{display:flex;flex-direction:column;align-items:center;gap:6px;margin-bottom:14px;text-align:center}
    .brand img{width:min(160px,60%);max-height:50px;object-fit:contain;display:block}
    .brand small{font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;font-weight:500}

    h3{font-size:17px;font-weight:700;color:#fff;display:flex;align-items:center;gap:8px;justify-content:center;margin-bottom:6px}
    h3 i{color:#f59e0b;filter:drop-shadow(0 0 8px rgba(245,158,11,.4))}
    .lock-copy{color:var(--muted);font-size:12.5px;line-height:1.6;text-align:center;margin:0 auto 14px;max-width:420px}

    .domain-badge{
      display:flex;align-items:center;justify-content:center;gap:8px;width:100%;
      background:var(--pdim);border:1px solid rgba(34,211,238,.3);padding:10px 14px;border-radius:10px;
      font-family:ui-monospace,Consolas,monospace;color:var(--primary);font-size:13px;font-weight:700;word-break:break-all;margin-bottom:12px
    }

    .alert-mismatch{
      width:100%;background:rgba(248,113,113,.1);border:1px solid rgba(248,113,113,.3);color:#fca5a5;
      padding:10px 12px;border-radius:10px;font-size:12px;line-height:1.5;display:flex;align-items:flex-start;gap:8px;margin-bottom:12px
    }
    .alert-mismatch i{flex-shrink:0;margin-top:1px}

    .price{
      background:linear-gradient(145deg,var(--pdim) 0%,var(--bg3) 70%);border:1px solid var(--border);border-radius:12px;
      padding:12px 14px;margin-bottom:12px;display:flex;flex-direction:column;gap:8px
    }
    .price-label{font-size:10.5px;font-weight:500;color:var(--muted);text-transform:uppercase;letter-spacing:.4px;margin-bottom:3px}
    .price-value{font-size:21px;font-weight:700;color:var(--text);line-height:1.1}
    .price-value span{font-size:12px;font-weight:500;color:var(--muted)}
    .price-note{font-size:10.5px;color:var(--muted);margin-top:5px;line-height:1.5}
    .price-badge{align-self:flex-start;background:var(--sdim);color:var(--success);border:1px solid rgba(52,211,153,.35);border-radius:999px;padding:4px 10px;font-size:11px;font-weight:700;white-space:nowrap}

    .steps{width:100%;background:rgba(0,0,0,.22);border:1px solid rgba(190,239,255,.1);border-radius:12px;padding:12px 14px;margin-bottom:14px;text-align:left}
    .steps ol{padding-left:18px;color:var(--muted);font-size:12px;line-height:1.6}
    .steps li{margin-bottom:6px}.steps li:last-child{margin-bottom:0}
    .steps strong{color:#fff}
    .steps code{font-family:ui-monospace,Consolas,monospace;color:var(--primary);font-size:11.5px}

    .spacer{flex:1}
    .actions{width:100%;display:flex;flex-direction:column;gap:8px;margin-top:auto}
    .btn{width:100%;min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 16px;border-radius:10px;font-size:13px;font-weight:700;font-family:inherit;cursor:pointer;transition:all .2s ease;text-decoration:none}
    .btn-primary{background:linear-gradient(135deg,#236060 0%,#183f51 52%,#194251 100%);color:#f4fffd;border:1px solid rgba(126,231,219,.48);box-shadow:0 8px 20px rgba(10,41,50,.24)}
    .btn-primary:hover{background:linear-gradient(135deg,#2d7774 0%,#1d5264 52%,#205b68 100%);border-color:rgba(166,247,235,.72);color:#fff}
    .btn-whatsapp{background:rgba(190,239,255,.08);color:var(--text);border:1px solid rgba(190,239,255,.22)}
    .btn-whatsapp:hover{background:var(--sdim);border-color:var(--success);color:#fff}
    .btn-whatsapp i{color:var(--success)}

    .foot{width:100%;margin-top:14px;padding-top:12px;border-top:1px solid rgba(124,221,218,.15);color:rgba(237,250,250,.5);font-size:11px;text-align:center}

    /* ≥640px: centered card */
    @media (min-width:640px){
      body{align-items:center;justify-content:center;padding:24px}
      .lock-card{flex:0 1 auto;width:100%;max-width:460px;border:1px solid rgba(190,239,255,.28);border-radius:16px;padding:32px 28px 24px;box-shadow:0 20px 48px rgba(3,14,20,.45)}
      .brand img{width:min(200px,75%);max-height:56px}
      h3{font-size:1.3rem}
      .lock-copy{font-size:13px;margin-bottom:18px}
      .price{flex-direction:row;align-items:center;justify-content:space-between;gap:12px;padding:14px 16px}
      .price-badge{align-self:center}
      .actions{margin-top:0}
      .btn{min-height:0;padding:11px 18px}
      .spacer{display:none}
    }
  </style>
</head>
<body>
  <% const li = (typeof licenseInfo !== 'undefined' && licenseInfo) ? licenseInfo : null; %>
  <% const priceLabel = li ? li.LICENSE_PRICE_LABEL : 'Rp 150.000'; %>
  <% const waUrl = li ? li.buildOrderUrl(domain, installCode || '') : ('https://wa.me/6285178008881?text=' + encodeURIComponent('Halo Developer ZenRadius, saya ingin memesan lisensi untuk ' + (domain === 'local' ? 'instalasi lokal. Kode Instalasi: ' + (installCode || '-') : 'domain ' + domain))); %>

  <main class="lock-card" role="main">
    <div class="brand">
      <img src="/img/logo.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" alt="ZenRadius" onerror="this.src='/img/icon.png'">
      <small>Lisensi Resmi Seumur Hidup</small>
    </div>

    <h3><i class="bi bi-shield-lock-fill"></i> Aktivasi Lisensi Diperlukan</h3>
    <p class="lock-copy">ZenRadius dikembangkan dan dirawat secara berkelanjutan oleh Developer independen. Untuk terus menikmati seluruh fitur premium, instansi ini memerlukan lisensi resmi yang terdaftar pada <%= domain === 'local' ? 'instalasi lokal ini' : 'domain berikut' %>.</p>

    <div class="domain-badge"><i class="bi bi-globe2"></i> <%= domain === 'local' ? 'Instalasi Lokal' : domain %></div>
    <% if (installCode) { %>
      <div style="margin:10px 0;padding:9px 12px;border:1px solid rgba(96,165,250,.35);border-radius:10px;background:rgba(96,165,250,.10);font-size:12px;text-align:center;">
        <i class="bi bi-fingerprint"></i> Kode Instalasi: <code><%= installCode %></code>
      </div>
    <% } %>

    <% if (hasKey) { %>
      <div class="alert-mismatch">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span><%= (typeof reasonText !== 'undefined' && reasonText) ? reasonText : 'Kode lisensi yang terpasang tidak cocok dengan instalasi atau alamat akses ini. Lisensi hanya berlaku untuk instalasi yang didaftarkan.' %></span>
      </div>
    <% } %>

    <div class="price">
      <div>
        <div class="price-label">Lisensi Resmi &bull; 1 Domain</div>
        <div class="price-value"><%= priceLabel %> <span>/ seumur hidup</span></div>
        <div class="price-note">Sekali bayar &bull; Pembaruan berkelanjutan &bull; Tanpa biaya tersembunyi</div>
      </div>
      <span class="price-badge"><i class="bi bi-infinity"></i> Lifetime</span>
    </div>

    <div class="steps">
      <ol>
        <li><strong>Order Lisensi</strong> via WhatsApp Developer resmi. Untuk instalasi lokal, sertakan Kode Instalasi di atas.</li>
        <li>Login sebagai Super Admin, buka <strong>Pengaturan &rarr; Lisensi Domain</strong>.</li>
        <li>Tempel kode <code>XXXX-XXXX-XXXX-XXXX</code> lalu klik <strong>Aktivasi Lisensi</strong>.</li>
      </ol>
    </div>

    <div class="spacer"></div>

    <div class="actions">
      <a class="btn btn-primary" href="/admin/settings#license"><i class="bi bi-patch-check-fill"></i> Aktivasi Lisensi</a>
      <a class="btn btn-whatsapp" href="<%= waUrl %>" target="_blank" rel="noopener noreferrer"><i class="bi bi-whatsapp"></i> Order Lisensi</a>
    </div>

    <div class="foot">&copy; <%= new Date().getFullYear() %> ZenRadius &middot; Terima kasih telah mendukung pengembangan berkelanjutan</div>
  </main>
</body>
</html>
