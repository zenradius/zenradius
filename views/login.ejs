      gap: 12px;
      z-index: 1060;
      font-family: var(--font-sans);
    }
    .customer-chat-panel {
      width: min(320px, calc(100vw - 32px));
      background: linear-gradient(180deg, rgba(13, 25, 30, 0.96), rgba(15, 29, 36, 0.96));
      border: 1px solid rgba(124, 221, 218, 0.18);
      border-radius: 18px;
      box-shadow: 0 18px 42px rgba(3, 14, 20, 0.35);
      padding: 16px 16px 14px;
      color: var(--portal-text);
      opacity: 0;
      transform: translateY(10px);
      pointer-events: none;
      transition: opacity .2s ease, transform .2s ease;
    }
    .customer-chat-widget.is-open .customer-chat-panel {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    .customer-chat-panel-icon {
      width: 38px;
      height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      background: linear-gradient(135deg, rgba(45, 212, 191, 0.2), rgba(34, 167, 240, 0.18));
      border: 1px solid rgba(124, 221, 218, 0.2);
      color: #d9fffb;
      font-size: 1.1rem;
    }
    .customer-chat-panel h6 {
      margin: 0;
      color: #f8fbff;
      font-size: 1rem;
      font-weight: 800;
    }
    .customer-chat-status {
      display: inline-flex;
      align-items: center;
      color: rgba(237, 250, 250, 0.8);
      font-size: 0.72rem;
      font-weight: 600;
    }
    .customer-chat-panel p {
      margin: 12px 0 14px;
      color: rgba(237, 250, 250, 0.8);
      font-size: 0.86rem;
      line-height: 1.55;
    }
    .customer-chat-body {
      display: flex;
      flex-direction: column;
      gap: 8px;
      max-height: 230px;
      overflow-y: auto;
      margin: 12px 0 14px;
      padding-right: 4px;
    }
    .customer-chat-message {
      max-width: 92%;
      padding: 9px 10px;
      border-radius: 12px;
      font-size: 0.78rem;
      line-height: 1.45;
      word-break: break-word;
    }
    .customer-chat-message-bot {
      align-self: flex-start;
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid rgba(124, 221, 218, 0.12);
      color: rgba(237, 250, 250, 0.95);
    }
    .customer-chat-message-user {
      align-self: flex-end;
      background: linear-gradient(135deg, rgba(45, 212, 191, 0.96), rgba(34, 167, 240, 0.9));
      color: #062c2a;
      font-weight: 700;
    }
    .customer-chat-input-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 10px;
    }
    .customer-chat-input {
      flex: 1;
      min-width: 0;
      border: 1px solid rgba(124, 221, 218, 0.2);
      background: rgba(8, 20, 26, 0.65);
      color: #f1fbff;
      border-radius: 10px;
      padding: 9px 10px;
      font-size: 0.8rem;
      outline: none;
    }
    .customer-chat-input:focus {
      border-color: rgba(45, 212, 191, 0.65);
      box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.15);
    }
    .customer-chat-send {
      border: 0;
      border-radius: 10px;
      padding: 9px 12px;
      background: linear-gradient(135deg, var(--portal-primary), var(--portal-primary-strong));
      color: #062c2a;
      font-weight: 800;
      cursor: pointer;
    }
    .customer-chat-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 10px;
    }
    .customer-chat-suggest {
      border: 1px solid rgba(124, 221, 218, 0.18);
      background: rgba(15, 23, 42, 0.66);
      color: rgba(237, 250, 250, 0.9);
      border-radius: 999px;
      padding: 6px 10px;
      font-size: 0.72rem;
      font-weight: 700;
      cursor: pointer;
      transition: all .15s ease;
    }
    .customer-chat-suggest:hover {
      border-color: rgba(45, 212, 191, 0.38);
      background: rgba(20, 31, 38, 0.88);
      transform: translateY(-1px);
    }
    .customer-chat-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      border: 0;
      border-radius: 12px;
      padding: 11px 14px;
      background: linear-gradient(135deg, var(--portal-primary) 0%, var(--portal-primary-strong) 52%, #2563eb 100%);
      color: #062c2a;
      text-decoration: none;
      font-weight: 800;
      box-shadow: 0 10px 22px rgba(45, 212, 191, 0.2);
      cursor: pointer;
    }
    .customer-chat-link:hover {
      color: #062c2a;
      filter: brightness(1.04);
    }
    .customer-chat-fallback {
      margin: 12px 0 0;
      color: rgba(237, 250, 250, 0.75);
      font-size: 0.78rem;
      line-height: 1.5;
    }
    .customer-chat-fallback a {
      color: #7dd3fc;
      text-decoration: none;
    }
    .customer-chat-toggle {
      width: 62px;
      height: 62px;
      border: 1px solid rgba(124, 221, 218, 0.3);
      border-radius: 50%;
      background: linear-gradient(135deg, var(--portal-primary) 0%, var(--portal-primary-strong) 52%, #2563eb 100%);
      color: #042126;
      box-shadow: 0 18px 40px rgba(45, 212, 191, 0.28);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      cursor: pointer;
      transition: transform .2s ease, box-shadow .2s ease;
    }
    .customer-chat-toggle:hover {
      transform: translateY(-2px);
      box-shadow: 0 22px 48px rgba(45, 212, 191, 0.3);
    }
    .customer-chat-toggle:focus-visible {
      outline: 3px solid rgba(45, 212, 191, 0.35);
      outline-offset: 3px;
    }
    @media (max-width: 767.98px) {
      .pkg-simulator { padding: 22px 18px; }
      .sim-title { font-size: 1.3rem; }
    }
    @media (max-width: 420px) { .sim-needs { grid-template-columns: 1fr; } }
    @media (max-width: 576px) {
      .customer-chat-widget {
        right: 14px;
        bottom: 14px;
      }
      .customer-chat-panel {
        width: min(290px, calc(100vw - 26px));
      }
      .customer-chat-toggle {
        width: 56px;
        height: 56px;
      }
    }

    @media (min-width: 992px) {
      .hero-section > .container {
        max-width: 100%;
        padding-left: 32px;
        padding-right: 32px;
      }

      .hero-grid {
        grid-template-columns: minmax(0, 1fr) minmax(450px, 500px);
        max-width: none;
        gap: 40px;
        align-items: end;
      }

      .hero-copy {
        max-width: 756px;
      }

      .hero-title {
        max-width: 720px;
      }

      .hero-subtitle,
      .hero-stats {
        max-width: 720px;
      }

      .hero-cta-grid {
        max-width: 684px;
      }

      .hero-stats {
        max-width: 756px;
      }

      .hero-package-simulator,
      .pkg-simulator {
        max-width: 500px;
      }

      .hero-package-simulator {
        align-self: end;
      }

      #contact-info .company-info-card {
        position: relative;
        top: 8px;
      }
    }

    @media (min-width: 768px) and (max-width: 991.98px) {
      .hero-section > .container,
      .section-padding > .container,
      .testimonials-section > .container,
      .faq-section > .container,
      #contact-info > .container {
        max-width: 720px;
      }

      .hero-section {
        padding: 38px 0 52px;
      }

      .hero-grid {
        gap: 28px;
      }

      .hero-package-simulator,
      .pkg-simulator {
        max-width: 560px;
      }
    }

    @media (min-width: 992px) and (max-width: 1199.98px) {
      .custom-navbar .nav-link {
        padding-left: 0.38rem !important;
        padding-right: 0.38rem !important;
        font-size: 0.75rem;
      }

      .custom-navbar .nav-link .me-1 {
        margin-right: 0.2rem !important;
      }

      .custom-navbar .header-actions {
        margin-left: 0.35rem;
      }
    }

    @media (max-width: 767.98px) {
      .hero-section > .container,
      .section-padding > .container,
      .testimonials-section > .container,
      .faq-section > .container,
      #contact-info > .container {
        max-width: 100%;
      }

      .hero-section {
        padding: 28px 0 44px;
      }

      .hero-title {
        font-size: clamp(1.8rem, 8vw, 2.2rem);
        line-height: 1.16;
      }

      .hero-subtitle {
        font-size: 0.94rem;
      }

      .hero-cta-grid {
        width: 100%;
        gap: 10px;
      }

      .hero-cta-grid .btn {
        min-height: 52px;
        padding-left: 12px !important;
        padding-right: 12px !important;
        white-space: normal;
      }

      .hero-stats {
        width: 100%;
      }

      .hero-package-simulator,
      .pkg-simulator {
        width: 100%;
        max-width: 100%;
      }

      .section-title {
        font-size: clamp(1.65rem, 7vw, 2rem);
      }

      .section-subtitle {
        font-size: 0.94rem;
        margin-bottom: 30px;
      }

      .pkg-card,
      .feature-box,
      .testimonial-card {
        padding: 22px 18px;
      }

      .faq-accordion .accordion-button {
        padding: 16px;
        font-size: 0.94rem;
      }

      .faq-accordion .accordion-body {
        padding: 0 16px 16px;
        font-size: 0.9rem;
      }
    }

    @media (max-width: 420px) {
      .hero-badge {
        max-width: 100%;
        text-align: center;
      }

      .holo-speed {
        padding: 9px 12px;
      }

      .pkg-simulator {
        padding: 18px 14px 16px;
      }

      .sim-needs {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .sim-need-btn {
        min-height: 68px;
      }
    }

    .section-padding,
    .testimonials-section {
      padding-top: 52px;
      padding-bottom: 52px;
    }

    #contact-info {
      padding-top: 52px;
      padding-bottom: 52px;
    }

    .section-title-badge {
      margin-bottom: 8px;
    }

    .section-title {
      margin-bottom: 10px;
    }

    .section-subtitle {
      margin-bottom: 26px;
    }

    #features .row,
    #packages .row,
    #services .row,
    #contact-info .row.g-4.align-items-center {
      --bs-gutter-x: 1rem;
      --bs-gutter-y: 1rem;
    }

    .testimonials {
      gap: 18px;
    }

    .faq-accordion {
      gap: 12px;
    }

    @media (max-width: 767.98px) {
      .section-padding,
      .testimonials-section,
      #contact-info {
        padding-top: 44px;
        padding-bottom: 44px;
      }

      .section-subtitle {
        margin-bottom: 22px;
      }
    }

    @media (max-width: 575.98px) {
      .section-padding,
      .testimonials-section,
      #contact-info {
        padding-top: 40px;
        padding-bottom: 40px;
      }
    }

    .hero-cta-grid .btn,
    .btn-pkg-action,
    .sim-cta,
    .btn-submit-login,
    .btn-quick-tool,
    .btn-portal-access {
      background: linear-gradient(135deg, #236060 0%, #183f51 52%, #194251 100%) !important;
      border-color: rgba(126, 231, 219, 0.48) !important;
      color: #f4fffd !important;
      box-shadow: 0 8px 20px rgba(10, 41, 50, 0.24);
    }

    .hero-cta-grid .btn:hover,
    .btn-pkg-action:hover,
    .sim-cta:hover,
    .btn-submit-login:hover,
    .btn-quick-tool:hover,
    .btn-portal-access:hover {
      background: linear-gradient(135deg, #2d7774 0%, #1d5264 52%, #205b68 100%) !important;
      border-color: rgba(166, 247, 235, 0.72) !important;
      color: #ffffff !important;
      filter: brightness(1.04);
    }

    .feature-box,
    .pkg-card,
    .info-card,
    .testimonial-card,
    .company-info-card,
    .contact-info-card,
    .faq-accordion .accordion-item,
    .faq-accordion .accordion-button,
    .faq-accordion .accordion-body,
    .pkg-simulator,
    .sim-recommend,
    .stat-item,
    .login-card-container .glass-card {
      background: #173945 !important;
      border-color: rgba(190, 239, 255, 0.58) !important;
    }

    .faq-accordion .accordion-button:not(.collapsed) {
      background: rgba(126, 231, 219, 0.18) !important;
    }

    body,
    .hero-section,
    .section-padding,
    .testimonials-section,
    .faq-section,
    #contact-info,
    #services,
    #features,
    #packages,
    #faq,
    #testimonials {
      background: var(--landing-bg) !important;
    }
    </style>
</head>

<body class="<%= typeof landingOnly !== 'undefined' && landingOnly ? 'landing-only' : '' %>">

  <!-- Header / Navbar Section -->
  <nav class="navbar navbar-expand-lg sticky-top custom-navbar">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center gap-2" href="#">
        <img src="/img/logo.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" alt="<%= settings.company_header || 'ZenRadius' %>" onerror="this.style.display='none'">
      </a>

      <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
        aria-controls="navbarContent" aria-expanded="false" aria-label="Buka navigasi">
        <i class="bi bi-list fs-2"></i>
      </button>

      <div class="collapse navbar-collapse" id="navbarContent">
        <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-1">
          <li class="nav-item">
            <a class="nav-link active" href="#hero"><i class="bi bi-house-door me-1"></i> Beranda</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#features"><i class="bi bi-shield-check me-1"></i> Keunggulan</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#packages"><i class="bi bi-wifi me-1"></i> Paket Layanan</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#services"><i class="bi bi-grid me-1"></i> Akses Layanan</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#faq"><i class="bi bi-question-circle me-1"></i> Tanya Jawab</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#testimonials"><i class="bi bi-chat-quote me-1"></i> Testimoni</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#contact-info"><i class="bi bi-headset me-1"></i> Informasi</a>
          </li>
        </ul>

        <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0 header-actions">
          <div class="dropdown">
            <button class="btn btn-portal-access btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-person-circle me-1"></i> Member
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/customer/login"><i class="bi bi-box-arrow-in-right me-2"></i>Login</a></li>
              <li><a class="dropdown-item" href="/customer/register"><i class="bi bi-person-plus me-2"></i>Daftar</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero & Login Section -->
  <section class="hero-section" id="hero">
    <div class="container">
      <div class="hero-grid">

        <!-- Left Column: Company Value Proposition -->
        <div class="hero-copy">
          <div class="hero-badge">
            <i class="bi bi-lightning-charge-fill text-warning"></i>
            <span>Internet Fiber Optic Cepat, Stabil, dan Tanpa Batas</span>
          </div>

          <h1 class="hero-title">
            Nikmati Koneksi Internet Terbaik Tanpa Batas Kuota
          </h1>

          <p class="hero-subtitle">
            Selamat datang di pusat layanan resmi <strong><%= settings.company_header || 'ZenRadius' %></strong>. Kami menghadirkan konektivitas internet cepat, stabil, dan terjangkau untuk kebutuhan rumah tangga, bisnis, hiburan, serta aktivitas digital Anda.
          </p>

          <div class="hero-cta-grid">
            <a href="/customer/register" class="btn btn-primary btn-lg rounded-3 fw-bold px-4 py-3 shadow-lg flex-fill d-inline-flex align-items-center justify-content-center" style="min-width: 260px;">
              <i class="bi bi-person-plus-fill me-2 fs-5"></i> Daftar Sekarang
            </a>
            <button type="button" id="btn-install-pwa-hero" class="btn btn-warning btn-lg rounded-3 fw-bold px-4 py-3 shadow-lg text-dark flex-fill d-inline-flex align-items-center justify-content-center" style="min-width: 260px;" onclick="triggerPwaInstall()">
              <i class="bi bi-download me-2 fs-5"></i> Download Aplikasi
            </button>
            <a href="/customer/check-billing" class="btn btn-outline-light btn-lg rounded-3 fw-bold px-4 py-3 w-100 d-inline-flex align-items-center justify-content-center cta-billing">
              <i class="bi bi-receipt me-2 fs-5"></i> Cek Tagihan
            </a>
          </div>

          <section class="stats-strip">
            <div class="hero-stats">
              <div class="stat-item">
                <div class="stat-number"><i class="bi bi-speedometer2 text-info me-1"></i> 100%</div>
                <div class="stat-label">Fiber Optic</div>
              </div>
              <div class="stat-item">
                <div class="stat-number"><i class="bi bi-infinity text-success me-1"></i> Tanpa FUP</div>
                <div class="stat-label">Tanpa Batas Kuota</div>
              </div>
              <div class="stat-item">
                <div class="stat-number"><i class="bi bi-shield-lock-fill text-warning me-1"></i> 99.9%</div>
                <div class="stat-label">Uptime SLA</div>
              </div>
              <div class="stat-item">
                <div class="stat-number"><i class="bi bi-headset text-primary me-1"></i> 24/7</div>
                <div class="stat-label">Dukungan Pelanggan</div>
              </div>
            </div>
          </section>

        </div>

        <% if (typeof landingOnly !== 'undefined' && landingOnly) { %>
        <div class="hero-package-simulator" id="simulator-section">
          <%- include('partials/package-simulator') %>
        </div>
        <% } else { %>
        <div class="login-card-container" id="login-section">
          <div class="glass-card shadow-2xl">
            <div class="login-card-header">
              <div class="d-inline-flex align-items-center justify-content-center bg-dark bg-opacity-50 border border-secondary border-opacity-25 rounded-circle p-3 mb-2" style="width:70px; height:70px;">
                <i class="bi bi-person-circle text-white" style="font-size: 40px; line-height: 1;"></i>
              </div>
              <p class="small text-white opacity-75 mb-0">Masuk ke pusat layanan pelanggan untuk mengelola layanan internet Anda.</p>
            </div>

            <div class="login-card-body">
              <form method="POST" action="/customer/login">
                <div class="form-floating">
                  <input type="tel" class="form-control" id="phone" name="phone" placeholder=" " required autofocus>
                  <label for="phone">
                    <i class="bi bi-whatsapp me-2"></i>Nomor WhatsApp
                  </label>
                </div>

                <div class="form-floating password-field-wrapper">
                  <input type="password" class="form-control" id="password" name="password" placeholder=" " required>
                  <button type="button" class="eye-toggle" data-target="password" aria-label="Tampilkan password" title="Tampilkan/Sembunyikan password">
                    <i class="bi bi-eye"></i>
                  </button>
                  <label for="password">
                    <i class="bi bi-key me-2"></i>Password
                  </label>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3 small" style="color: #C8D0E0;">
                  <span><i class="bi bi-info-circle me-1"></i>Gunakan akun pelanggan aktif.</span>
                  <button type="submit" form="forgot-password-form" class="btn btn-link btn-sm p-0 text-decoration-none" style="color: #7dd3fc;">Lupa Password?</button>
                </div>

                <% if (settings.login_otp_enabled) { %>
                  <div class="alert alert-info py-2 px-3 mb-3 small border-0 bg-info bg-opacity-15 text-info rounded-3 text-center fw-semibold">
                    <i class="bi bi-whatsapp me-1"></i> <%= t('customer.otp_sent_via_wa', 'Kode OTP akan dikirim via WhatsApp') %>
                  </div>
                <% } %>

                <button type="submit" class="btn btn-submit-login">
                  <i class="bi bi-box-arrow-in-right me-2"></i><%= t('customer.sign_in', 'Masuk ke Portal') %>
                </button>
              </form>

              <form id="forgot-password-form" method="POST" action="/customer/forgot-password" class="d-none">
                <input type="hidden" name="phone" id="forgot-phone">
              </form>

              <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success mt-3 py-2 px-3 text-center small rounded-3 border-success border-opacity-25 fw-semibold">
                  <i class="bi bi-check-circle me-2"></i>
                  <%= success %>
                </div>
              <% } %>

              <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger mt-3 py-2 px-3 text-center small rounded-3 border-danger border-opacity-25 fw-semibold">
                  <i class="bi bi-exclamation-triangle me-2"></i>
                  <%= error === 'Nomor HP tidak valid atau belum terdaftar.' ? 'ID/Tag tidak valid atau belum terdaftar.' : error %>
                </div>
              <% } %>

              <!-- Fast Tool Shortcuts -->
              <div class="quick-tools-grid">
                <a href="/customer/check-billing" class="btn-quick-tool">
                  <i class="bi bi-receipt text-info fs-5"></i> Cek Tagihan
                </a>
                <a href="/customer/voucher" class="btn-quick-tool">
                  <i class="bi bi-ticket-perforated text-warning fs-5"></i> Dapatkan Voucher
                </a>
              </div>

              <div class="text-center mt-4 pt-2 border-top border-secondary border-opacity-20">
                <p class="mb-0 small" style="color: #C8D0E0;">
                  <%= t('customer.not_subscribed', 'Belum menjadi pelanggan?') %>
                  <a href="/customer/register" class="fw-bold text-decoration-none ms-1" style="color: #4ddbff;">
                    <%= t('customer.register_new', 'Daftar Sekarang') %> <i class="bi bi-arrow-right"></i>
                  </a>
                </p>
              </div>

            </div>
          </div>
        </div>
        <% } %>

      </div>

    </div>
  </section>

  <!-- Features Highlight Section -->
  <section class="section-padding" id="features">
    <div class="container">
