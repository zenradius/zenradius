  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const forgotPhoneInput = document.getElementById('forgot-phone');
    const phoneInput = document.getElementById('phone');

    const customerChatWidget = document.querySelector('.customer-chat-widget');
    const customerChatToggle = document.querySelector('.customer-chat-toggle');
    const customerChatPanel = document.querySelector('.customer-chat-panel');
    const customerChatInput = document.querySelector('.customer-chat-input');
    const customerChatBody = document.querySelector('.customer-chat-body');
    const customerChatSend = document.querySelector('.customer-chat-send');
    const customerChatSuggestions = document.querySelectorAll('.customer-chat-suggest');
    const customerChatFallback = document.querySelector('.customer-chat-fallback');

    if (customerChatWidget && customerChatToggle && customerChatPanel) {
      document.addEventListener('click', (event) => {
        if (!customerChatWidget.contains(event.target)) {
          customerChatWidget.classList.remove('is-open');
          customerChatToggle.setAttribute('aria-expanded', 'false');
          customerChatPanel.setAttribute('aria-hidden', 'true');
        }
      });
    }

    const sendLocalAi = async () => {
      if (!customerChatInput || !customerChatBody) return;
      const value = customerChatInput.value.trim();
      if (!value) return;
      appendChatMessage(value, true);
      customerChatInput.value = '';
      const reply = await sendAiApiRequest(value);
      appendChatMessage(reply, false);
    };

    customerChatSend?.addEventListener('click', () => { sendLocalAi(); });
    customerChatInput?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        sendLocalAi();
      }
    });

    customerChatSuggestions?.forEach((button) => {
      button.addEventListener('click', () => {
        const prompt = button.dataset.prompt || '';
        if (!prompt) return;
        if (customerChatInput) {
          customerChatInput.value = prompt;
          sendLocalAi();
        }
      });
    });

    if (customerChatFallback) {
      customerChatFallback.hidden = true;
    }

    if (phoneInput && forgotPhoneInput) {
      phoneInput.addEventListener('input', function () {
        forgotPhoneInput.value = this.value.trim();
      });
    }

    // PWA Prompt Handler
    let deferredPwaPrompt = null;

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPwaPrompt = e;

      // Highlight install buttons
      const navBtn = document.getElementById('btn-install-pwa-nav');
      const heroBtn = document.getElementById('btn-install-pwa-hero');
      if (navBtn) navBtn.classList.add('shadow-lg');
      if (heroBtn) heroBtn.classList.add('shadow-lg');
    });

    function triggerPwaInstall() {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then((choiceResult) => {
          if (choiceResult.outcome === 'accepted') {
            dismissPwaBanner();
          }
          deferredPwaPrompt = null;
        });
      }
    }

    function dismissPwaBanner() {
      const banner = document.getElementById('pwa-install-banner');
      if (banner) banner.style.display = 'none';
      localStorage.setItem('pwa_banner_dismissed', 'true');
    }

    window.addEventListener('appinstalled', () => {
      dismissPwaBanner();
      deferredPwaPrompt = null;
    });

    document.querySelectorAll('.eye-toggle').forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.getAttribute('data-target');
        const input = document.getElementById(targetId);
        if (!input) return;

        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';

        const icon = button.querySelector('i');
        if (icon) {
          icon.className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
        }

        button.setAttribute('aria-label', isPassword ? 'Sembunyikan password' : 'Tampilkan password');
        button.title = isPassword ? 'Sembunyikan password' : 'Tampilkan password';
      });
    });

    // Defer service worker registration
    if ('serviceWorker' in navigator) {
      setTimeout(() => {
        navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).catch(() => {});
      }, 1500);
    }

    // Auto-focus input on page load if user is near top
    window.addEventListener('load', () => {
      if (window.scrollY < 400) {
        const phoneInput = document.getElementById('phone');
        if (phoneInput && !('ontouchstart' in window)) {
          phoneInput.focus();
        }
      }
    });

    // Highlight active nav item on scroll
    const sections = document.querySelectorAll('section[id], header[id]');
    const navLinks = document.querySelectorAll('.nav-link');

    window.addEventListener('scroll', () => {
      let current = '';
      sections.forEach(section => {
        const sectionTop = section.offsetTop - 100;
        if (pageYOffset >= sectionTop) {
          current = section.getAttribute('id');
        }
      });

      navLinks.forEach(link => {
        link.classList.remove('active');
        if (link.getAttribute('href') === `#${current}`) {
          link.classList.add('active');
        }
      });
    });
  </script>
</body>

</html>
