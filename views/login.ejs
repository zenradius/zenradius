<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZenRadius - One Platform for Your Network</title>

  <!-- Preconnect to CDN for faster loading -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <!-- Premium Minimalist Corporate typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="theme-color" content="#0052FF">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="apple-touch-icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" type="image/png">
  <link rel="stylesheet" href="/css/unified.css">

    <style>    /* ── CSS Variables for Typography ── */
    :root {
      --font-sans: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif;
      --font-display: 'Space Grotesk', 'Plus Jakarta Sans', system-ui, sans-serif;
      --font-mono: 'Space Grotesk', monospace;
      --portal-bg: #101820;
      --portal-panel: rgba(17, 29, 36, 0.94);
      --portal-panel-strong: rgba(12, 23, 30, 0.98);
      --portal-line: rgba(124, 221, 218, 0.18);
      --portal-primary: #2dd4bf;
      --portal-primary-strong: #22a7f0;
      --portal-accent: #fbbf24;
      --portal-text: #edf7f5;
      --portal-muted: #a8bec2;
      --landing-bg: radial-gradient(circle at 8% 0%, #236060 0%, transparent 34%),
            radial-gradient(circle at 100% 100%, #173e4d 0%, transparent 42%),
            linear-gradient(135deg, #173740 0%, #183f51 52%, #194251 100%);
      --portal-surface: linear-gradient(140deg, rgba(68, 203, 184, 0.24) 0%, rgba(46, 160, 211, 0.22) 46%, rgba(49, 184, 168, 0.17) 100%);
    }

    body {
      background: var(--landing-bg);
      color: var(--portal-text);
    }

    .custom-navbar {
      background: rgba(23, 57, 69, 0.96) !important;
      border-bottom: 1px solid rgba(190, 239, 255, 0.38);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }

    .custom-navbar .nav-link,
    .custom-navbar .navbar-brand,
    .custom-navbar .btn {
      color: var(--portal-text) !important;
    }

    .custom-navbar .navbar-nav {
      align-items: center;
      gap: 2px !important;
    }

    .custom-navbar .nav-link {
      padding: 0.52rem 0.62rem !important;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 600;
      white-space: nowrap;
      transition: background 0.18s ease, color 0.18s ease;
    }

    .custom-navbar .nav-link:hover,
    .custom-navbar .nav-link:focus,
    .custom-navbar .nav-link.active {
      background: rgba(45, 212, 191, 0.1);
      color: #ffffff !important;
    }

    .custom-navbar .header-actions {
      margin-left: 0.75rem;
    }

    .custom-navbar .navbar-brand img {
      max-height: 42.5px;
      width: auto;
      object-fit: contain;
    }

    .custom-navbar .btn-portal-access {
      padding: 0.48rem 0.85rem;
      border-radius: 9px;
      white-space: nowrap;
    }

    .custom-navbar .dropdown-menu {
      background: rgba(23, 57, 69, 0.98);
      border: 1px solid rgba(190, 239, 255, 0.38);
      border-radius: 12px;
      box-shadow: 0 12px 28px rgba(2, 10, 14, 0.32);
      padding: 0.5rem 0;
    }

    .custom-navbar .dropdown-item {
      color: var(--portal-text);
      padding: 0.7rem 1rem;
      font-weight: 600;
    }

    .custom-navbar .dropdown-item:hover,
    .custom-navbar .dropdown-item:focus {
      background: rgba(45, 212, 191, 0.12);
      color: #ffffff;
    }

    .btn-portal-access {
      background: linear-gradient(135deg, var(--portal-primary) 0%, var(--portal-primary-strong) 52%, #2563eb 100%);
      border: 1px solid rgba(45, 212, 191, 0.6);
      color: #062c2a !important;
      font-weight: 700;
      box-shadow: 0 10px 22px rgba(45, 212, 191, 0.22);
    }

    .btn-portal-access:hover {
      filter: brightness(1.05);
      color: #062c2a !important;
    }

    .btn-submit-login {
      background: linear-gradient(135deg, var(--portal-primary) 0%, var(--portal-primary-strong) 52%, #2563eb 100%);
      border: 1px solid rgba(45, 212, 191, 0.6);
      color: #042126;
      font-weight: 800;
      box-shadow: 0 10px 24px rgba(45, 212, 191, 0.22);
    }

    .btn-submit-login:hover {
      filter: brightness(1.04);
      color: #042126;
    }

    .password-field-wrapper {
      position: relative;
      width: 100%;
    }

    .password-field-wrapper .form-control {
      padding-right: 42px;
    }

    .password-field-wrapper .eye-toggle {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      border: none;
      background: transparent;
      color: rgba(190, 239, 255, 0.72);
      width: 24px;
      height: 24px;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      z-index: 2;
      transition: all 0.2s ease;
      box-shadow: none;
    }

    .password-field-wrapper .eye-toggle:hover {
      background: transparent;
      color: rgba(45, 212, 191, 0.95);
      border: none;
      box-shadow: none;
    }

    .password-field-wrapper .eye-toggle:focus {
      outline: none;
      box-shadow: none;
    }

    /* ── HERO SECTION — Dark portal theme to match login/register ── */
    .hero-section {
      padding: 44px 0 64px;
      background: var(--landing-bg);
    }

    .section-padding,
    .testimonials-section,
    .faq-section,
    #contact-info,
    #services,
    #features,
    #packages,
    #faq,
    #testimonials {
      background: linear-gradient(180deg, rgba(11, 20, 26, 0.96), rgba(16, 24, 32, 0.92));
      color: var(--portal-text);
    }

    .section-padding {
      padding: 72px 0;
    }

    #contact-info {
      padding-top: 78px;
      padding-bottom: 78px;
    }

    .feature-box,
    .pkg-card,
    .testimonial-card,
    .info-card,
    .contact-info-card,
    .pkg-simulator,
    .sim-recommend,
    .sim-estimate-block,
    .faq-accordion .accordion-item,
    .faq-accordion .accordion-button,
    .faq-accordion .accordion-body {
      background: rgba(12, 29, 36, 0.74) !important;
      border-color: rgba(124, 221, 218, 0.18) !important;
      color: var(--portal-text) !important;
    }

    .faq-accordion .accordion-button:not(.collapsed) {
      color: #d9fffb !important;
      background: rgba(45, 212, 191, 0.08) !important;
    }

    .faq-accordion .accordion-button::after {
      filter: brightness(1.4);
    }

    .hero-package-simulator {
      background: transparent;
    }

    .sim-step-btn {
      color: var(--portal-text);
    }

    .sim-step-btn:hover {
      border-color: rgba(45, 212, 191, 0.5);
      color: #d9fffb;
    }

    .sim-need-btn {
      color: var(--portal-text);
    }

    .sim-need-btn.active {
      background: linear-gradient(135deg, var(--portal-primary) 0%, var(--portal-primary-strong) 52%, #2563eb 100%);
      border-color: transparent;
      color: #062c2a;
    }

    .sim-estimate,
    .sim-rec-name,
    .sim-step-value,
    .sim-title {
      color: #f8fbff !important;
    }

    .sim-label,
    .sim-users-unit,
    .sim-eyebrow,
    .sim-rec-meta,
    .sim-est-label,
    .sim-custom-msg,
    .sim-need-btn .sim-need-icon {
      color: rgba(237, 250, 250, 0.78) !important;
    }

    .sim-estimate-block,
    .sim-recommend,
    .sim-need-btn,
    .sim-step-btn,
    .sim-cta.is-contact {
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(460px, 560px);
      gap: 18px;
      align-items: center;
      max-width: 1320px;
      margin: 0 auto;
    }

    .hero-section > .container {
      max-width: 1400px;
    }

    .hero-grid > * {
      min-width: 0;
    }

    .hero-copy {
      max-width: 760px;
      width: 100%;
      justify-self: start;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      padding-right: 10px;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(45, 212, 191, 0.12);
      border: 1px solid rgba(45, 212, 191, 0.24);
      color: #dfeff0;
      padding: 7px 14px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
      margin-bottom: 16px;
      font-family: var(--font-sans);
    }

    .hero-badge .bi { font-size: 1rem; }

    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 3vw, 2.7rem);
      font-weight: 800;
      line-height: 1.18;
      letter-spacing: -0.02em;
      color: #f8fbff;
      margin-bottom: 14px;
      max-width: 780px;
    }

    .holo-speed {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 16px;
      background: rgba(12, 29, 36, 0.72);
      border: 1px solid rgba(124, 221, 218, 0.22);
      border-radius: 12px;
      margin-bottom: 16px;
      font-family: var(--font-display);
    }

    .holo-bolt { color: #F59E0B; font-size: 1.2em; }

    .holo-num {
      font-size: 1.5rem;
      font-weight: 800;
      color: #f8fbff;
    }

    .holo-sub {
      font-size: 0.85rem;
      color: #d9fffb;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .hero-subtitle {
      font-family: var(--font-sans);
      font-size: 1rem;
      color: rgba(237, 250, 250, 0.82);
      line-height: 1.65;
      margin-bottom: 18px;
      max-width: 820px;
    }

    .hero-cta-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 22px;
      width: min(100%, 760px);
    }

    .hero-cta-grid .btn {
      min-width: 0 !important;
      width: 100%;
      padding-top: 0.82rem !important;
      padding-bottom: 0.82rem !important;
    }

    .cta-billing {
      grid-column: 1 / -1;
      background: rgba(255, 255, 255, 0.04) !important;
      border-color: rgba(124, 221, 218, 0.2) !important;
      color: #edf7f5 !important;
    }

    .cta-billing:hover {
      background: rgba(45, 212, 191, 0.08) !important;
      border-color: rgba(45, 212, 191, 0.45) !important;
      color: #d9fffb !important;
    }

    .stats-strip {
      background: transparent;
      padding: 12px 0 18px;
      margin-top: 0;
      width: 100%;
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(110px, 1fr));
      gap: 10px;
      width: 100%;
      max-width: 760px;
      margin: 0 auto;
    }

    .stat-item {
      min-width: 0;
      background: rgba(12, 29, 36, 0.72);
      border: 1px solid rgba(124, 221, 218, 0.14);
      padding: 11px 9px;
      border-radius: 12px;
      text-align: center;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      min-height: 78px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }

    .stat-item:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.2);
    }

    .stat-number {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-family: var(--font-display);
      font-size: 0.98rem;
      font-weight: 800;
      color: #f8fbff;
      margin-bottom: 3px;
      line-height: 1.2;
    }

    .stat-number .bi { font-size: 0.9em; }

    .stat-label {
      font-family: var(--font-sans);
      font-size: 0.62rem;
      color: #d9fffb;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      line-height: 1.3;
    }

    /* Responsive */
    @media (max-width: 991.98px) {
      .hero-grid { grid-template-columns: 1fr; gap: 32px; }
      .hero-copy { max-width: 100%; text-align: center; justify-self: stretch; align-items: center; padding-right: 0; }
      .hero-badge { margin-left: auto; margin-right: auto; }
      .hero-cta-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .hero-package-simulator { justify-self: center; margin-left: 0; }
      .hero-stats {
        max-width: 100%;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 575.98px) {
      .hero-section { padding: 40px 0 60px; }
      .hero-cta-grid { grid-template-columns: 1fr; }
      .stats-strip { padding-bottom: 12px; }
      .hero-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        padding: 0;
        margin: 0;
        width: 100%;
      }
      .stat-item { min-height: 84px; }
      .stat-number { font-size: 0.98rem; }
      .stat-label { font-size: 0.66rem; }
    }

    /* ── GLASSMORPHISM BASE CLASS — Light Theme ── */
    .glass-card {
      background: rgba(12, 29, 36, 0.7);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(124, 221, 218, 0.15);
      border-radius: 20px;
      box-shadow: 0 4px 20px rgba(3, 14, 20, 0.28);
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease, background 0.3s ease;
    }

    .glass-card:hover {
      background: rgba(16, 30, 40, 0.85);
      border-color: rgba(45, 212, 191, 0.45);
      box-shadow: 0 12px 30px rgba(45, 212, 191, 0.12);
      transform: translateY(-2px);
    }

    /* ── SECTION BASE STYLES — Light Theme ── */
    .section-padding {
      padding: 72px 0;
    }

    .section-title-badge {
      display: inline-block;
      background: rgba(45, 212, 191, 0.10);
      border: 1px solid rgba(45, 212, 191, 0.28);
      color: #d9fffb;
      padding: 7px 18px;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 12px;
      font-family: var(--font-sans);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    .section-title {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 3vw, 2.5rem);
      font-weight: 800;
      color: #f8fbff;
      margin-bottom: 15px;
    }

    .section-subtitle {
      font-family: var(--font-sans);
      color: rgba(237, 250, 250, 0.82) !important;
      font-size: 1.05rem;
      max-width: 650px;
      margin: 0 auto 45px;
      line-height: 1.6;
    }

    /* Package Cards — Light Theme */
    .pkg-card {
      padding: 30px 24px;
      height: 100%;
      display: flex;
      flex-direction: column;
      position: relative;
      background: rgba(12, 29, 36, 0.72);
      border: 1px solid rgba(124, 221, 218, 0.15);
      border-radius: 16px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .pkg-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(45, 212, 191, 0.12);
      border-color: rgba(45, 212, 191, 0.45);
    }

    .pkg-badge-popular {
      position: absolute;
      top: -14px;
      right: 20px;
      background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 4px 12px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
      font-family: var(--font-sans);
    }

    .pkg-speed-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(45, 212, 191, 0.12);
      color: #d9fffb;
      padding: 4px 14px;
      border-radius: 8px;
      font-size: 0.88rem;
      font-weight: 700;
      margin-bottom: 15px;
      width: fit-content;
      font-family: var(--font-sans);
    }

    .pkg-name {
      font-family: var(--font-display);
      font-size: 1.4rem;
      font-weight: 700;
      color: #f8fbff;
      margin-bottom: 8px;
    }

    .pkg-price {
      font-family: var(--font-display);
      font-size: 1.9rem;
      font-weight: 800;
      color: #f8fbff;
      margin-bottom: 4px;
    }

    .pkg-period {
      font-family: var(--font-sans);
      font-size: 0.88rem;
      color: rgba(237, 250, 250, 0.7);
      margin-bottom: 20px;
    }

    .pkg-features {
      list-style: none;
      padding: 0;
      margin: 0 0 25px 0;
      flex-grow: 1;
    }

    .pkg-features li {
      padding: 10px 0;
      border-bottom: 1px solid rgba(148, 163, 184, 0.14);
      font-size: 0.95rem;
      color: rgba(237, 250, 250, 0.8);
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: var(--font-sans);
    }

    .pkg-features li:last-child {
      border-bottom: none;
    }

    .pkg-features li i {
      color: #10B981;
      font-size: 1.1rem;
    }

    .btn-pkg-action {
      background: rgba(45, 212, 191, 0.08);
      border: 1px solid rgba(45, 212, 191, 0.26);
      color: #d9fffb;
      border-radius: 12px;
      padding: 12px;
      font-weight: 600;
      text-decoration: none;
      text-align: center;
      display: block;
      transition: all 0.3s ease;
      font-family: var(--font-sans);
    }

    .btn-pkg-action:hover {
      background: linear-gradient(135deg, var(--portal-primary) 0%, var(--portal-primary-strong) 52%, #2563eb 100%);
      border-color: transparent;
      color: #042126;
      box-shadow: 0 8px 20px rgba(45, 212, 191, 0.24);
    }

    /* Features Highlight Cards — Light Theme */
    .feature-box {
      padding: 28px 22px;
      height: 100%;
      border-radius: 18px;
      background: rgba(12, 29, 36, 0.72);
      border: 1px solid rgba(124, 221, 218, 0.15);
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .feature-box:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(45, 212, 191, 0.12);
      border-color: rgba(45, 212, 191, 0.45);
    }

    .feature-icon-wrapper {
      width: 54px;
      height: 54px;
      border-radius: 14px;
      background: linear-gradient(135deg, rgba(45, 212, 191, 0.18) 0%, rgba(34, 167, 240, 0.16) 100%);
      border: 1px solid rgba(45, 212, 191, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      color: #d9fffb;
      margin-bottom: 20px;
    }

    .feature-title {
      font-family: var(--font-display);
      font-size: 1.18rem;
      font-weight: 700;
      color: #f8fbff;
      margin-bottom: 10px;
    }

    .feature-desc {
      font-family: var(--font-sans);
      color: rgba(237, 250, 250, 0.8) !important;
      font-size: 0.94rem;
      line-height: 1.6;
      margin: 0;
    }

    /* Contact & Quick Service Info Cards — Light Theme */
    .info-card {
      padding: 24px;
      border-radius: 16px;
      display: flex;
      align-items: flex-start;
      gap: 16px;
      height: 100%;
      background: rgba(12, 29, 36, 0.72);
      border: 1px solid rgba(124, 221, 218, 0.15);
      transition: all 0.3s ease;
    }

    .info-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(45, 212, 191, 0.12);
      border-color: rgba(45, 212, 191, 0.45);
    }

    .info-card h5 {
      font-family: var(--font-display);
      color: #f8fbff !important;
      font-weight: 700;
      font-size: 1.1rem;
      margin-bottom: 6px;
    }

    .info-card p, .info-card .card-text-desc {
      font-family: var(--font-sans);
      color: rgba(237, 250, 250, 0.8) !important;
      font-size: 0.9rem;
      line-height: 1.55;
      margin: 0;
    }

    .info-icon {
      font-size: 1.8rem;
      color: #d9fffb;
      background: linear-gradient(135deg, rgba(45, 212, 191, 0.18) 0%, rgba(34, 167, 240, 0.18) 100%);
      border: 1px solid rgba(45, 212, 191, 0.3);
      width: 50px;
      height: 50px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    /* Testimonials — Light Theme */
