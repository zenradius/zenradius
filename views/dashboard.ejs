  <!-- JAVASCRIPT HANDLERS -->
  <script>
    let currentInvId = null;
    let selectedBatchInvoiceIds = [];
    let pModal = null;

    function openPaymentModal(invId, amount) {
      currentInvId = invId;
      selectedBatchInvoiceIds = [];
      let num = 0;
      if (typeof amount === 'number') {
        num = isNaN(amount) ? 0 : amount;
      } else if (amount) {
        const clean = String(amount).replace(/[^0-9.]/g, '');
        num = parseFloat(clean) || 0;
      }
      document.getElementById('pay_amount_text').innerText = 'Rp ' + Math.round(num).toLocaleString('id-ID');
      const selectionInfo = document.getElementById('paymentSelectionInfo');
      if (selectionInfo) selectionInfo.textContent = 'Pembayaran untuk satu tagihan.';
      if (!pModal) pModal = new bootstrap.Modal(document.getElementById('paymentModal'));
      pModal.show();
    }

    function submitPayment(method) {
      const methodCode = encodeURIComponent(String(method || 'QRIS'));
      if (selectedBatchInvoiceIds.length > 1) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/customer/payment/batch/create';
        for (const invoiceId of selectedBatchInvoiceIds) {
          const input = document.createElement('input');
          input.type = 'hidden'; input.name = 'invoice_ids'; input.value = invoiceId;
          form.appendChild(input);
        }
        const methodInput = document.createElement('input');
        methodInput.type = 'hidden'; methodInput.name = 'method'; methodInput.value = decodeURIComponent(methodCode);
        form.appendChild(methodInput);
        document.body.appendChild(form);
        form.submit();
        return;
      }
      if (!currentInvId) return;
      window.location.href = `/customer/payment/create/${encodeURIComponent(currentInvId)}?method=${methodCode}`;
    }

    function openBatchPaymentModal() {
      if (selectedBatchInvoiceIds.length < 2) return;
      const total = Array.from(new Map(Array.from(document.querySelectorAll('.batch-invoice:checked')).map(el => [String(el.value), Number(el.dataset.amount || 0)])).values())
        .reduce((sum, amount) => sum + amount, 0);
      currentInvId = null;
      const amountText = document.getElementById('pay_amount_text');
      if (amountText) amountText.innerText = 'Rp ' + Math.round(total).toLocaleString('id-ID');
      const selectionInfo = document.getElementById('paymentSelectionInfo');
      if (selectionInfo) selectionInfo.textContent = `Pembayaran gabungan ${selectedBatchInvoiceIds.length} tagihan.`;
      if (!pModal) pModal = new bootstrap.Modal(document.getElementById('paymentModal'));
      pModal.show();
    }

    function updateBatchSelection() {
      const selected = Array.from(document.querySelectorAll('.batch-invoice:checked'));
      const unique = new Map(selected.map(el => [String(el.value), Number(el.dataset.amount || 0)]));
      selectedBatchInvoiceIds = Array.from(unique.keys());
      const total = Array.from(unique.values()).reduce((sum, amount) => sum + amount, 0);
      const text = document.getElementById('batchSelectionText');
      const button = document.getElementById('payBatchBtn');
      if (text) text.textContent = selectedBatchInvoiceIds.length > 1
        ? `${selectedBatchInvoiceIds.length} tagihan dipilih • Rp ${total.toLocaleString('id-ID')} • tekan Bayar Tagihan untuk melanjutkan.`
        : 'Pilih minimal 2 tagihan untuk pembayaran gabungan.';
      if (button) button.disabled = selectedBatchInvoiceIds.length < 2;
      if (selectedBatchInvoiceIds.length > 1) {
        currentInvId = null;
        const amountText = document.getElementById('pay_amount_text');
        if (amountText) amountText.innerText = 'Rp ' + Math.round(total).toLocaleString('id-ID');
      }
    }

    document.querySelectorAll('.batch-invoice').forEach(input => input.addEventListener('change', updateBatchSelection));
    document.getElementById('selectAllUnpaid')?.addEventListener('change', function () {
      document.querySelectorAll('.batch-invoice').forEach(input => { input.checked = this.checked; });
      updateBatchSelection();
    });

    async function refreshPaymentStatus() {
      try {
        const response = await fetch('/customer/payment/status', { credentials: 'same-origin', headers: { Accept: 'application/json' } });
        const status = await response.json();
        if (response.ok && status.success) {
          const knownUnpaid = <%= unpaidCount %>;
          if (Number(status.unpaidCount) < knownUnpaid) window.location.reload();
        }
      } catch (_) {}
    }

    window.addEventListener('focus', refreshPaymentStatus);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) refreshPaymentStatus(); });

    function togglePassVisibility() {
      const input = document.getElementById('wifiPassInput');
      const icon = document.getElementById('eyeIcon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash';
      } else {
        input.type = 'password';
        icon.className = 'bi bi-eye';
      }
    }

    function openNotifDrawer() {
      const modal = new bootstrap.Modal(document.getElementById('notifDrawerModal'));
      modal.show();
      
      // Mark notifications as viewed
      const badge = document.getElementById('notifCountBadge');
      if (badge) {
        badge.style.display = 'none';
        localStorage.setItem('notifViewed', 'true');
      }
    }

    function editSsid(deviceId, currentSsid) {
      document.getElementById('modalSsidInput').value = currentSsid || '';
      const m = new bootstrap.Modal(document.getElementById('editSsidModal'));
      m.show();
    }

    function openWifiSettingsModal(deviceId, currentSsid) {
      document.getElementById('modalSsidInput').value = currentSsid || '';
      document.getElementById('modalPassInput').value = '';
      const m = new bootstrap.Modal(document.getElementById('editSsidModal'));
      m.show();
    }

    function editPassword(deviceId) {
      document.getElementById('modalPassInput').value = '';
      const m = new bootstrap.Modal(document.getElementById('editPasswordModal'));
      m.show();
    }

    function rebootDevice(deviceId) {
      const m = new bootstrap.Modal(document.getElementById('rebootModal'));
      m.show();
    }

    // LIVE TRAFFIC GAUGES CANVAS
    function drawGauge(canvasId, valueMbps, maxMbps, strokeColor) {
      const canvas = document.getElementById(canvasId);
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const w = canvas.width;
      const h = canvas.height;
      const cx = w / 2;
      const cy = h - 20;
      const radius = 75;

      ctx.clearRect(0, 0, w, h);

      // Track Arc (180 deg)
      ctx.beginPath();
      ctx.arc(cx, cy, radius, Math.PI, 2 * Math.PI, false);
      ctx.lineWidth = 14;
      ctx.strokeStyle = 'rgba(30, 41, 59, 0.8)';
      ctx.lineCap = 'round';
      ctx.stroke();

      // Progress Arc
      const val = Math.min(Math.max(0, valueMbps), maxMbps);
      const ratio = maxMbps > 0 ? val / maxMbps : 0;
      const endAngle = Math.PI + ratio * Math.PI;

      if (ratio > 0) {
        ctx.beginPath();
        ctx.arc(cx, cy, radius, Math.PI, endAngle, false);
        ctx.lineWidth = 14;
        ctx.strokeStyle = strokeColor;
        ctx.lineCap = 'round';
        ctx.stroke();
      }
    }

    async function fetchTrafficData() {
      try {
        const res = await fetch('/customer/api/pppoe-traffic', { cache: 'no-store' });
        if (!res.ok) return;
        const data = await res.json();

        const rxGauge = document.getElementById('pppoe_rx_gauge');
        const txGauge = document.getElementById('pppoe_tx_gauge');

        const maxDown = parseFloat(rxGauge?.dataset?.max) || 10;
        const maxUp = parseFloat(txGauge?.dataset?.max) || 10;

        const rx = parseFloat(data.rxMbps || data.rx_rate || 0) || 0;
        const tx = parseFloat(data.txMbps || data.tx_rate || 0) || 0;

        const rxValEl = document.getElementById('pppoe_rx_value');
        const rxUnitEl = document.getElementById('pppoe_rx_unit');
        if (rxValEl) rxValEl.innerText = rx < 0.1 ? (rx * 1000).toFixed(0) : rx.toFixed(2);
        if (rxUnitEl) rxUnitEl.innerText = rx < 0.1 ? 'Kbps' : 'Mbps';

        const txValEl = document.getElementById('pppoe_tx_value');
        const txUnitEl = document.getElementById('pppoe_tx_unit');
        if (txValEl) txValEl.innerText = tx < 0.1 ? (tx * 1000).toFixed(0) : tx.toFixed(2);
        if (txUnitEl) txUnitEl.innerText = tx < 0.1 ? 'Kbps' : 'Mbps';

        drawGauge('pppoe_rx_gauge', rx, maxDown, '#06b6d4');
        drawGauge('pppoe_tx_gauge', tx, maxUp, '#10b981');
      } catch (e) {
        console.error('[Traffic] Fetch error:', e);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadCustomerWebNotifs();
      fetchTrafficData();
      setInterval(fetchTrafficData, 3000);

      const btnRefresh = document.getElementById('btnDeviceRefresh');
      if (btnRefresh) {
        btnRefresh.addEventListener('click', async () => {
          btnRefresh.disabled = true;
          btnRefresh.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Memeriksa ONU...';
          try {
            await fetch('/customer/poll-onu', { method: 'POST' });
            location.reload();
          } catch (e) {
            location.reload();
          }
        });
      }
    });

    function loadCustomerWebNotifs() {
      const container = document.getElementById('notifListContainer');
      if (!container) return;

      const notifs = [];
      <% if (paidInvoices && paidInvoices.length > 0) { %>
        <% paidInvoices.slice(0, 3).forEach(inv => { %>
          <% const pAmt = inv.amount != null ? inv.amount : (inv.package_price != null ? inv.package_price : 0); %>
          notifs.push({
            id: 'paid-<%= inv.id %>',
            type: 'payment',
            title: 'Pelunasan Tagihan Berhasil',
            message: 'Tagihan bulan <%= inv.period_month %>/<%= inv.period_year %> sebesar Rp <%= parseInt(pAmt || 0).toLocaleString("id-ID") %> telah LUNAS.',
            time: 'Terkonfirmasi Sistem'
          });
        <% }) %>
      <% } %>

      <% if (hasUnpaid) { %>
        <% const uAmt = latestUnpaid.amount != null ? latestUnpaid.amount : (latestUnpaid.package_price != null ? latestUnpaid.package_price : 0); %>
        notifs.push({
          id: 'unpaid-latest',
          type: 'warning',
          title: 'Pengingat Tagihan Bulanan',
          message: 'Tagihan bulan <%= latestUnpaid.period_month %>/<%= latestUnpaid.period_year %> sebesar Rp <%= parseInt(uAmt || 0).toLocaleString("id-ID") %> menunggu pembayaran.',
          time: 'Jatuh Tempo Tgl 20'
        });
      <% } %>

      const badge = document.getElementById('notifCountBadge');
      const notifViewed = localStorage.getItem('notifViewed');
      
      if (badge && notifs.length > 0 && !notifViewed) {
        badge.innerText = notifs.length;
        badge.style.display = 'flex';
      } else if (badge) {
        badge.style.display = 'none';
      }

      if (notifs.length === 0) {
        container.innerHTML = '<div class="text-center text-muted py-4"><i class="bi bi-bell-slash fs-1 d-block mb-2"></i>Belum ada notifikasi baru</div>';
      } else {
        container.innerHTML = notifs.map(n => `
          <div class="notif-item ${n.type === 'payment' ? 'unread' : ''}">
            <div class="d-flex align-items-center gap-2 mb-1">
              <i class="bi bi-${n.type === 'payment' ? 'check-circle-fill text-success' : 'exclamation-circle-fill text-warning'}"></i>
              <span class="fw-bold small text-white">${n.title}</span>
            </div>
            <div class="small text-slate-300 mb-1" style="font-size:12px;">${n.message}</div>
            <div class="text-muted" style="font-size:10px;">${n.time}</div>
          </div>
        `).join('');
      }
    }

    // Eye toggle functionality for password fields
    document.querySelectorAll('.eye-toggle-btn').forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const targetId = this.getAttribute('data-target');
        const input = document.getElementById(targetId);
        const icon = this.querySelector('i');
        
        if (input.type === 'password') {
          input.type = 'text';
          icon.classList.remove('bi-eye');
          icon.classList.add('bi-eye-slash');
        } else {
          input.type = 'password';
          icon.classList.remove('bi-eye-slash');
          icon.classList.add('bi-eye');
        }
      });
    });
  </script>
  <script>
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).catch(() => {});
  </script>
</body>

</html>
