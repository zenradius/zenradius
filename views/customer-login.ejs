<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
  <meta name="theme-color" content="#173945">
  <title>Login Pelanggan | <%= settings.company_header || 'ZenRadius' %></title>
  <link rel="icon" href="/img/icon.png" type="image/png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    /* -- Custom Premium Scrollbar -- */
    ::-webkit-scrollbar {
      width: 10px;
      height: 10px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(23, 57, 69, 0.3);
      border-radius: 100px;
    }
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(180deg, #2dd4bf 0%, #22a7f0 100%);
      border: 2px solid #173945;
      border-radius: 100px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: linear-gradient(180deg, #22a7f0 0%, #2dd4bf 100%);
      filter: brightness(1.1);
    }
    * {
      scrollbar-width: thin;
      scrollbar-color: #2dd4bf rgba(23, 57, 69, 0.3);
    }

    *{box-sizing:border-box;margin:0;padding:0}
    html,body{height:100%}
    body{
      font-family:'DM Sans',system-ui,sans-serif;
      background:#173945;
      background-image:radial-gradient(circle at 8% 0%,#236060 0%,transparent 34%),radial-gradient(circle at 100% 100%,#173e4d 0%,transparent 42%),linear-gradient(135deg,#173740 0%,#183f51 52%,#194251 100%);
      display:flex;align-items:center;justify-content:center;
      min-height:100vh;min-height:100dvh;padding:24px;color:#edf7f5;
    }
    .wrap{width:100%;max-width:420px;display:flex;flex-direction:column;align-items:center}
    .card{
      width:100%;background:#173945;border:1px solid rgba(190,239,255,.28);
      border-radius:16px;padding:38px 32px 28px;box-shadow:0 20px 48px rgba(3,14,20,.45);
      display:flex;flex-direction:column;align-items:center;
    }
    .logo{width:min(220px,72%);height:auto;object-fit:contain;display:block;margin:0 auto 16px}
    .sub{font-size:13px;color:rgba(237,250,250,.72);font-weight:600;letter-spacing:.02em;margin-bottom:6px;text-align:center}
    .copy{font-size:12px;color:rgba(237,250,250,.58);text-align:center;line-height:1.6;max-width:300px;margin:0 auto 26px}
    .alert{width:100%;border-radius:10px;font-size:13px;padding:11px 12px;display:flex;align-items:center;gap:10px;margin-bottom:14px}
    .alert-danger{background:rgba(248,81,73,.1);color:#ff7b72;border:1px solid rgba(248,81,73,.22)}
    .alert-success{background:rgba(74,222,128,.1);color:#86efac;border:1px solid rgba(74,222,128,.22)}
    form{width:100%;max-width:320px;display:flex;flex-direction:column;align-items:stretch}
    .fg{margin-bottom:16px;width:100%}
    .fg:last-of-type{margin-bottom:22px}
    .fl{font-size:11px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:#d9fffb;margin-bottom:7px;display:block;text-align:left}
    .field{position:relative;width:100%}
    .field i{position:absolute;left:13px;top:50%;transform:translateY(-50%);color:rgba(190,239,255,.7);font-size:15px;pointer-events:none}
    .fc{
      width:100%;padding:12px 14px 12px 40px;font-size:14px;color:#f0fdfa;
      background:rgba(255,255,255,.06);border:1px solid rgba(190,239,255,.22);border-radius:10px;outline:none;transition:border-color .2s,box-shadow .2s,background .2s;
    }
    .fc::placeholder{color:rgba(237,250,250,.38)}
    .fc:focus{background:rgba(255,255,255,.09);border-color:rgba(45,212,191,.55);box-shadow:0 0 0 3px rgba(45,212,191,.14);color:#fff}
    .btn-p{
      align-self:center;min-width:160px;max-width:220px;padding:10px 22px;font-size:13px;font-weight:800;
      color:#f4fffd;background:linear-gradient(135deg,#236060 0%,#183f51 52%,#194251 100%);border:1px solid rgba(126,231,219,.48);border-radius:10px;box-shadow:0 8px 20px rgba(10,41,50,.24);
      display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:all .25s;
    }
    .btn-p:hover{background:linear-gradient(135deg,#2d7774 0%,#1d5264 52%,#205b68 100%)!important;border-color:rgba(166,247,235,.72)!important;color:#fff!important;filter:brightness(1.04);transform:translateY(-1px)}
    .links{width:100%;max-width:320px;display:flex;justify-content:space-between;gap:12px;margin-top:14px;font-size:12px}
    .links a{color:#7dd3fc;font-weight:700;text-decoration:none}.links a:hover{text-decoration:underline}
    .cta-app{width:auto;margin:16px auto 0;text-align:center}
    .btn-install{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:8px 16px;border:1px solid rgba(126,231,219,.38);border-radius:9px;background:rgba(45,212,191,.08);color:#d9fffb;font-size:12px;font-weight:800}
    .foot{margin-top:16px;padding-top:14px;border-top:1px solid rgba(190,239,255,.12);font-size:11px;color:rgba(237,250,250,.48);text-align:center;width:100%}
    .foot a{color:#7dd3fc;text-decoration:none;font-weight:700}.foot-links{font-size:11px;display:flex;justify-content:center;flex-wrap:wrap;gap:12px;margin:10px 0}
    .foot-links a{font-weight:400;color:rgba(237,250,250,.62)}
    
    /* Eye Toggle Button */
    .eye-toggle {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: rgba(190, 239, 255, 0.72);
      cursor: pointer;
      padding: 0;
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      transition: all 0.2s ease;
      border-radius: 6px;
      box-shadow: none;
    }
    
    .eye-toggle:hover {
      color: rgba(45, 212, 191, 0.95);
      background: transparent;
      border: none;
      box-shadow: none;
    }
    
    .eye-toggle:active {
      transform: translateY(-50%) scale(0.96);
    }
    
    .fc.with-eye {
      padding-right: 42px;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <img class="logo" src="/img/logo.png?v=zenradius" alt="<%= settings.company_header || 'ZenRadius' %>" onerror="this.src='/img/icon.png'">
      <p class="sub">Pusat Layanan Pelanggan</p>
      <p class="copy">Masuk untuk memantau layanan, meninjau tagihan, dan memperoleh bantuan secara praktis.</p>
      <% if (error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
      <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success" role="status"><%= success %></div><% } %>
      <form method="post" action="/customer/login" id="login-form" onsubmit="return validateLoginForm(event)">
        <div class="fg">
          <label class="fl" for="customer-phone">Nomor WhatsApp terdaftar</label>
          <div class="field"><i class="bi bi-telephone"></i><input class="fc" id="customer-phone" name="phone" type="tel" autocomplete="username" placeholder="Contoh: 081234567890" required></div>
          <small id="phone-error" style="color:#ff7b72;font-size:11px;display:none;margin-top:4px"></small>
        </div>
        <div class="fg">
          <label class="fl" for="customer-password">Kata sandi</label>
          <div class="field">
            <i class="bi bi-key"></i>
            <input class="fc" id="customer-password" name="password" type="password" autocomplete="current-password" placeholder="Masukkan kata sandi Anda" required>
            <button type="button" class="eye-toggle" data-target="customer-password" title="Tampilkan/Sembunyikan password">
              <i class="bi bi-eye"></i>
            </button>
          </div>
          <small id="password-error" style="color:#ff7b72;font-size:11px;display:none;margin-top:4px"></small>
        </div>
        <button class="btn-p" type="submit" id="login-btn"><i class="bi bi-box-arrow-in-right"></i> Masuk ke Akun Saya</button>
      </form>
      <div class="links"><a href="/customer/register">Belum punya akun? Daftar</a><a href="/customer/forgot-password">Lupa kata sandi?</a></div>
      <div class="cta-app">
        <button class="btn-install" id="btn-install-pwa" type="button"><i class="bi bi-download"></i> Aplikasi Pelanggan</button>
      </div>
      
      <div class="foot">
        <div>&copy; <%= new Date().getFullYear() %> <%- footerInfo %></div>
      </div>
    </div>
  </div>
  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function validateLoginForm(e) {
      e.preventDefault();
      
      const phone = document.getElementById('customer-phone').value.trim();
      const password = document.getElementById('customer-password').value.trim();
      const phoneError = document.getElementById('phone-error');
      const passwordError = document.getElementById('password-error');
      const loginBtn = document.getElementById('login-btn');
      
      // Reset errors
      phoneError.style.display = 'none';
      passwordError.style.display = 'none';
      
      let isValid = true;
      
      // Validate phone
      if (!phone) {
        phoneError.textContent = 'Nomor WhatsApp wajib diisi.';
        phoneError.style.display = 'block';
        isValid = false;
      } else if (!/^[0-9]{10,15}$/.test(phone.replace(/\D/g, ''))) {
        phoneError.textContent = 'Nomor WhatsApp harus berisi 10-15 digit angka.';
        phoneError.style.display = 'block';
        isValid = false;
      }
      
      // Validate password
      if (!password) {
        passwordError.textContent = 'Kata sandi wajib diisi.';
        passwordError.style.display = 'block';
        isValid = false;
      } else if (password.length < 3) {
        passwordError.textContent = 'Kata sandi minimal 3 karakter.';
        passwordError.style.display = 'block';
        isValid = false;
      }
      
      if (isValid) {
        loginBtn.disabled = true;
        loginBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Memproses...';
        e.target.submit();
      }
      
      return false;
    }
    
    let deferredPwaPrompt = null;
    window.addEventListener('beforeinstallprompt', e => { 
      e.preventDefault(); 
      deferredPwaPrompt = e; 
    });

    document.getElementById('btn-install-pwa')?.addEventListener('click', () => {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then(() => {
          deferredPwaPrompt = null;
        });
      }
    });

    // Eye Toggle Functionality
    function togglePasswordVisibility(button) {
      const targetId = button.getAttribute('data-target');
      const passwordInput = document.getElementById(targetId);
      const isPassword = passwordInput.type === 'password';
      
      if (isPassword) {
        passwordInput.type = 'text';
        button.classList.add('visible');
        button.innerHTML = '<i class="bi bi-eye-slash"></i>';
      } else {
        passwordInput.type = 'password';
        button.classList.remove('visible');
        button.innerHTML = '<i class="bi bi-eye"></i>';
      }
    }

    // Initialize eye toggle buttons
    document.querySelectorAll('.eye-toggle').forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        togglePasswordVisibility(button);
      });
    });

    // Add "with-eye" class to password inputs for proper spacing
    document.querySelectorAll('.eye-toggle').forEach(button => {
      const targetId = button.getAttribute('data-target');
      const input = document.getElementById(targetId);
      if (input) {
        input.classList.add('with-eye');
      }
    });
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js', { scope: '/customer/' }).catch(()=>{});
  </script>
</body>
</html>
