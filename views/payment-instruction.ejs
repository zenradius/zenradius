<!DOCTYPE html>
<html lang="id" data-app-theme="<%= typeof appTheme !== 'undefined' ? appTheme : 'current' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Instruksi Pembayaran - <%= settings.company_header || 'ZenRadius' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/unified.css">
  <link rel="stylesheet" href="/css/theme-tokens.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body{margin:0;font-family:'Plus Jakarta Sans',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:linear-gradient(135deg,#173740 0%,#183f51 52%,#194251 100%);color:#edf7f5;min-height:100vh}
    .wrap{max-width:860px;margin:0 auto;padding:20px}
    .panel{background:linear-gradient(180deg,rgba(23,57,69,.96) 0%,rgba(19,50,62,.95) 100%);border:1px solid rgba(190,239,255,.16);border-radius:20px;padding:22px;box-shadow:0 18px 42px rgba(0,0,0,.24)}
    .top{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:16px}
    .title{font-size:22px;font-weight:800;letter-spacing:0}
    .muted{color:rgba(190,239,255,.72)}
    .grid{display:grid;grid-template-columns:1fr;gap:14px}
    .box{background:rgba(30,41,59,.72);border:1px solid rgba(190,239,255,.12);border-radius:16px;padding:16px}
    .hero{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);gap:14px;align-items:stretch}
    .amount{display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap}
    .amount strong{font-size:28px;line-height:1}
    .badge{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:6px 10px;font-size:12px;font-weight:800;border:1px solid rgba(190,239,255,.2);background:rgba(190,239,255,.08)}
    .badge.ok{background:rgba(16,185,129,.14);border-color:rgba(16,185,129,.24);color:#6ee7b7}
    .badge.warn{background:rgba(251,191,36,.14);border-color:rgba(251,191,36,.24);color:#fcd34d}
    .kv{display:grid;grid-template-columns:160px 1fr;gap:10px 12px;align-items:start}
    .kv div:nth-child(odd){color:rgba(190,239,255,.72)}
    .mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;word-break:break-word}
    .qr{max-width:320px;width:100%;background:#fff;padding:12px;border-radius:18px;display:block;margin:0 auto;box-shadow:0 12px 30px rgba(0,0,0,.25)}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:12px;border:1px solid rgba(190,239,255,.18);background:rgba(34,211,238,.12);color:#edf7f5;text-decoration:none;font-weight:700}
    .btn:hover{background:rgba(34,211,238,.18)}
    .summary-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .summary-item{background:rgba(15,23,42,.55);border:1px solid rgba(190,239,255,.1);border-radius:14px;padding:12px 14px}
    .summary-item .label{font-size:12px;color:rgba(190,239,255,.68);margin-bottom:4px}
    .summary-item .value{font-weight:700;word-break:break-word}
    .instruction-line{font-size:15px;line-height:1.6;word-break:break-word}
    @media (max-width: 780px){.hero{grid-template-columns:1fr}.summary-grid{grid-template-columns:1fr}}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="panel">
      <div class="top">
        <div>
          <div class="title">Instruksi Pembayaran</div>
          <div class="muted"><%= settings.company_header || 'ZenRadius' %></div>
        </div>
        <% if (backUrl) { %>
          <a class="btn" href="<%= backUrl %>"><i class="bi bi-arrow-left"></i> Kembali</a>
        <% } %>
      </div>

      <% if (error) { %>
        <div class="box"><%= error %></div>
      <% } else { %>
        <% if (info) { %><div class="box" style="margin-bottom:16px"><%= info %></div><% } %>
        <div class="grid">
          <div class="hero">
            <div class="box">
              <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-2">
                <div class="badge ok"><i class="bi bi-check2-circle"></i> Pembayaran berhasil dibuat</div>
                <div class="badge"><%= gateway || '-' %></div>
              </div>
              <div class="amount mb-3">
                <strong>Rp <%= Number(amount || 0).toLocaleString('id-ID') %></strong>
                <% if (method) { %><span class="badge warn"><%= method %></span><% } %>
              </div>
              <div class="summary-grid">
                <div class="summary-item">
                  <div class="label">Referensi</div>
                  <div class="value mono"><%= reference || '-' %></div>
                </div>
                <div class="summary-item">
                  <div class="label">Instruksi</div>
                  <div class="value"><%= (details && details.via) || instruction || '-' %></div>
                </div>
              </div>
            </div>

            <div class="box" style="text-align:center;display:flex;align-items:center;justify-content:center">
              <% if (qrImageUrl) { %>
                <img class="qr" src="<%= qrImageUrl %>" alt="QR / pembayaran">
              <% } else { %>
                <div>
                  <div class="badge warn mb-3"><i class="bi bi-clipboard2"></i> Simpan detail di bawah</div>
                  <div class="muted">Beberapa metode VA menampilkan nomor rekening atau kode pembayaran, bukan tautan QR.</div>
                </div>
              <% } %>
            </div>
          </div>

          <div class="box">
            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-3">
              <div style="font-weight:800">Detail Pembayaran</div>
              <div class="badge"><%= method || 'PAYMENT' %></div>
            </div>
            <div class="kv">
              <div>Session ID</div><div class="mono"><%= details?.sessionId || '-' %></div>
              <div>Transaction ID</div><div class="mono"><%= details?.transactionId || '-' %></div>
              <div>Reference ID</div><div class="mono"><%= details?.referenceId || '-' %></div>
              <div>Payment No</div><div class="mono"><%= details?.paymentNo || '-' %></div>
              <div>Channel</div><div><%= details?.via || '-' %><% if (details?.channel) { %> / <%= details.channel %><% } %></div>
              <div>Nama</div><div><%= details?.paymentName || '-' %></div>
              <div>Expired</div><div><%= details?.expired || '-' %></div>
              <div>Subtotal</div><div>Rp <%= Number(details?.subtotal || 0).toLocaleString('id-ID') %></div>
              <div>Biaya</div><div>Rp <%= Number(details?.fee || 0).toLocaleString('id-ID') %></div>
              <div>Total</div><div><strong>Rp <%= Number(details?.total || amount || 0).toLocaleString('id-ID') %></strong></div>
            </div>
          </div>

          <% if (helpText) { %>
            <div class="box muted"><%= helpText %></div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>