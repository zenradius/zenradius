<!DOCTYPE html>
<html lang="id" data-app-theme="<%= typeof appTheme !== 'undefined' ? appTheme : 'current' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Instruksi Pembayaran - <%= settings.company_header || 'ZenRadius' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/unified.css">
  <link rel="stylesheet" href="/css/theme-tokens.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:linear-gradient(135deg,#173740 0%,#183f51 52%,#194251 100%);color:#edf7f5;min-height:100vh}
    .wrap{max-width:760px;margin:0 auto;padding:20px}
    .panel{background:rgba(23,57,69,.94);border:1px solid rgba(190,239,255,.16);border-radius:16px;padding:20px;box-shadow:0 16px 40px rgba(0,0,0,.22)}
    .top{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:16px}
    .title{font-size:20px;font-weight:800}
    .muted{color:rgba(190,239,255,.72)}
    .grid{display:grid;grid-template-columns:1fr;gap:16px}
    .box{background:rgba(30,41,59,.72);border:1px solid rgba(190,239,255,.12);border-radius:14px;padding:16px}
    .code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;word-break:break-word;white-space:pre-wrap}
    .qr{max-width:320px;width:100%;background:#fff;padding:10px;border-radius:14px;display:block;margin:0 auto}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:12px;border:1px solid rgba(190,239,255,.18);background:rgba(34,211,238,.12);color:#edf7f5;text-decoration:none;font-weight:700}
    .btn:hover{background:rgba(34,211,238,.18)}
    .kv{display:grid;grid-template-columns:140px 1fr;gap:8px 12px;align-items:start}
    .kv div:nth-child(odd){color:rgba(190,239,255,.72)}
    @media (max-width: 560px){.kv{grid-template-columns:1fr}.kv div:nth-child(odd){margin-top:8px}}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="panel">
      <div class="top">
        <div>
          <div class="title">Instruksi Pembayaran</div>
          <div class="muted"><%= settings.company_header || 'ZenRadius' %></div>
        </div>
        <% if (backUrl) { %>
          <a class="btn" href="<%= backUrl %>"><i class="bi bi-arrow-left"></i> Kembali</a>
        <% } %>
      </div>

      <% if (error) { %>
        <div class="box"><%= error %></div>
      <% } else { %>
        <% if (info) { %><div class="box" style="margin-bottom:16px"><%= info %></div><% } %>
        <div class="grid">
          <div class="box">
            <div class="kv">
              <div>Referensi</div><div><strong><%= reference || '-' %></strong></div>
              <div>Gateway</div><div><%= gateway || '-' %></div>
              <div>Metode</div><div><%= method || '-' %></div>
              <div>Nominal</div><div><strong>Rp <%= Number(amount || 0).toLocaleString('id-ID') %></strong></div>
            </div>
          </div>

          <% if (paymentUrl) { %>
            <div class="box" style="text-align:center">
              <img class="qr" src="<%= paymentUrl %>" alt="QR / pembayaran">
            </div>
          <% } %>

          <% if (instruction) { %>
            <div class="box">
              <div style="font-weight:800;margin-bottom:8px">Detail Instruksi</div>
              <div class="code"><%= instruction %></div>
            </div>
          <% } %>

          <div class="box">
            <div style="font-weight:800;margin-bottom:8px">Payload Pembayaran</div>
            <div class="code"><%= payloadText %></div>
          </div>

          <% if (helpText) { %>
            <div class="box muted"><%= helpText %></div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>