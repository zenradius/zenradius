<!DOCTYPE html>
<html lang="id" data-app-theme="<%= typeof appTheme !== 'undefined' ? appTheme : 'current' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Instruksi Pembayaran - <%= settings.company_header || 'ZenRadius' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/unified.css">
  <link rel="stylesheet" href="/css/theme-tokens.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body{margin:0;font-family:'Plus Jakarta Sans',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:
      var(--body-bg-image, linear-gradient(135deg,#173740 0%,#183f51 52%,#194251 100%));
      background-color:var(--body-bg-solid, #173945);color:var(--portal-ink, #edf7f5);min-height:100vh}
    .wrap{max-width:980px;margin:0 auto;padding:20px}
    .panel{background:linear-gradient(180deg, color-mix(in srgb, var(--portal-surface, #183f51) 92%, transparent) 0%, color-mix(in srgb, var(--portal-surface-raised, #1b4656) 94%, transparent) 100%);border:1px solid color-mix(in srgb, var(--portal-line, rgba(190,239,255,.16)) 85%, transparent);border-radius:24px;padding:22px;box-shadow:0 18px 42px rgba(0,0,0,.24);overflow:hidden}
    .top{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:16px}
    .title{font-size:22px;font-weight:800;letter-spacing:0}
    .muted{color:rgba(190,239,255,.72)}
    .grid{display:grid;grid-template-columns:1fr;gap:14px}
    .box{background:color-mix(in srgb, var(--portal-surface-raised, #1b4656) 70%, transparent);border:1px solid color-mix(in srgb, var(--portal-line, rgba(190,239,255,.12)) 80%, transparent);border-radius:18px;padding:18px}
    .hero{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.9fr);gap:14px;align-items:stretch}
    .amount{display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap}
    .amount strong{font-size:30px;line-height:1}
    .badge{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:6px 10px;font-size:12px;font-weight:800;border:1px solid color-mix(in srgb, var(--portal-line, rgba(190,239,255,.2)) 88%, transparent);background:color-mix(in srgb, var(--portal-surface-raised, #1b4656) 52%, transparent)}
    .badge.ok{background:color-mix(in srgb, var(--soft-success, rgba(16,185,129,.14)) 82%, transparent);border-color:color-mix(in srgb, var(--success, #34D399) 28%, transparent);color:var(--success, #34D399)}
    .badge.warn{background:color-mix(in srgb, var(--soft-warning, rgba(251,191,36,.14)) 82%, transparent);border-color:color-mix(in srgb, var(--warning, #FBBF24) 30%, transparent);color:var(--warning, #FBBF24)}
    .kv{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}
    .kv-row{background:color-mix(in srgb, var(--portal-surface, #1b4656) 68%, transparent);border:1px solid color-mix(in srgb, var(--portal-line, rgba(190,239,255,.1)) 86%, transparent);border-radius:14px;padding:12px}
    .kv-label{font-size:12px;color:color-mix(in srgb, var(--portal-muted, rgba(190,239,255,.72)) 92%, transparent);margin-bottom:4px}
    .kv-value{font-weight:700;word-break:break-word}
    .mono{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;word-break:break-word}
    .qr{max-width:336px;width:100%;background:color-mix(in srgb, var(--portal-surface, #fff) 8%, #fff);padding:14px;border-radius:22px;display:block;margin:0 auto;box-shadow:0 18px 38px rgba(0,0,0,.28)}
    .btn{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:12px;border:1px solid color-mix(in srgb, var(--portal-line, rgba(190,239,255,.18)) 86%, transparent);background:color-mix(in srgb, var(--soft-primary, rgba(34,211,238,.12)) 82%, transparent);color:var(--portal-ink, #edf7f5);text-decoration:none;font-weight:700}
    .btn:hover{background:color-mix(in srgb, var(--soft-primary, rgba(34,211,238,.18)) 88%, transparent)}
    .summary-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
    .summary-item{background:color-mix(in srgb, var(--portal-surface, #1b4656) 70%, transparent);border:1px solid color-mix(in srgb, var(--portal-line, rgba(190,239,255,.1)) 86%, transparent);border-radius:16px;padding:12px 14px}
    .summary-item .label{font-size:12px;color:var(--portal-muted, rgba(190,239,255,.68));margin-bottom:4px}
    .summary-item .value{font-weight:700;word-break:break-word}
    .instruction-line{font-size:15px;line-height:1.6;word-break:break-word}
    .hero-copy{display:flex;flex-direction:column;gap:12px}
    .hero-note{font-size:14px;line-height:1.6;color:color-mix(in srgb, var(--portal-ink, #edf7f5) 88%, transparent)}
    .hero-actions{display:flex;gap:10px;flex-wrap:wrap}
    .hero-actions .btn{min-width:140px;justify-content:center}
    .amount-card{display:flex;align-items:center;justify-content:space-between;gap:14px;background:linear-gradient(135deg, color-mix(in srgb, var(--soft-primary, rgba(34,211,238,.14)) 88%, transparent), color-mix(in srgb, var(--soft-success, rgba(45,212,191,.08)) 88%, transparent));border:1px solid color-mix(in srgb, var(--portal-line, rgba(190,239,255,.14)) 88%, transparent);border-radius:18px;padding:16px}
    .amount-meta{display:flex;flex-direction:column;gap:3px}
    .amount-meta .label{font-size:12px;color:rgba(190,239,255,.72);text-transform:uppercase;letter-spacing:.08em}
    .amount-meta .value{font-size:18px;font-weight:800}
    .mode-qris .hero{grid-template-columns:minmax(0,1.08fr) minmax(320px,.92fr)}
    .mode-va .hero{grid-template-columns:minmax(0,1fr) minmax(300px,.86fr)}
    .mode-va .qr{display:none}
    .mode-qris .va-panel{display:none}
    .mode-va .va-code{display:block;font-size:34px;font-weight:800;line-height:1.05;word-break:break-word}
    .mode-va .va-title{font-size:16px;font-weight:800;margin-bottom:6px}
    .mode-va .va-bank{font-size:13px;color:var(--portal-muted, rgba(190,239,255,.74));text-transform:uppercase;letter-spacing:.04em}
    .mode-va .va-panel{background:linear-gradient(180deg,color-mix(in srgb, var(--portal-surface, #1b4656) 92%, transparent), color-mix(in srgb, var(--portal-surface-raised, #1b4656) 96%, transparent));border:1px solid color-mix(in srgb, var(--portal-line, rgba(190,239,255,.14)) 86%, transparent);border-radius:20px;padding:18px}
    .mode-va .va-chip{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:6px 10px;font-size:12px;font-weight:800;background:color-mix(in srgb, var(--soft-primary, rgba(34,211,238,.12)) 82%, transparent);border:1px solid color-mix(in srgb, var(--portal-line, rgba(34,211,238,.2)) 86%, transparent);color:var(--portal-primary, #a5f4ed)}
    .mode-qris .qr-frame{display:flex;flex-direction:column;align-items:center;gap:12px}
    .mode-qris .qr-side{display:flex;flex-direction:column;gap:12px}
    .mode-qris .scan-chip{display:inline-flex;align-items:center;gap:8px;border-radius:999px;padding:8px 12px;background:color-mix(in srgb, var(--soft-success, rgba(16,185,129,.12)) 82%, transparent);border:1px solid color-mix(in srgb, var(--success, #34D399) 26%, transparent);color:var(--success, #6ee7b7);font-size:12px;font-weight:800}
    .mode-qris .qr-stage{background:linear-gradient(180deg,color-mix(in srgb, var(--portal-surface-raised, #1b4656) 96%, transparent), color-mix(in srgb, var(--portal-surface, #1b4656) 98%, transparent));border:1px solid color-mix(in srgb, var(--portal-line, rgba(190,239,255,.18)) 88%, transparent);border-radius:24px;padding:20px}
    .mode-qris .hero-copy{background:linear-gradient(180deg, color-mix(in srgb, var(--portal-surface, #1b4656) 88%, transparent), color-mix(in srgb, var(--portal-surface-raised, #1b4656) 96%, transparent));border:1px solid color-mix(in srgb, var(--portal-line, rgba(190,239,255,.14)) 88%, transparent);border-radius:20px;padding:18px}
    .mode-qris .amount-card{background:linear-gradient(135deg, color-mix(in srgb, var(--soft-primary, rgba(34,211,238,.18)) 88%, transparent), color-mix(in srgb, var(--soft-success, rgba(45,212,191,.12)) 88%, transparent));border-color:color-mix(in srgb, var(--portal-line, rgba(190,239,255,.18)) 86%, transparent)}
    .mode-va .va-panel{box-shadow:0 16px 34px rgba(0,0,0,.18)}
    .mode-va .summary-item{background:rgba(15,23,42,.62)}
    @media (max-width: 780px){.hero{grid-template-columns:1fr}.summary-grid{grid-template-columns:1fr}.amount-card{align-items:flex-start;flex-direction:column}.kv{grid-template-columns:1fr}}
  </style>
</head>
<body class="mode-<%= mode || ((details && details.mode) || 'va') %>">
  <div class="wrap">
    <div class="panel">
      <div class="top">
        <div>
          <div class="title">Instruksi Pembayaran</div>
          <div class="muted"><%= settings.company_header || 'ZenRadius' %></div>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <% if (typeof changeMethodUrl !== 'undefined' && changeMethodUrl) { %>
            <a class="btn" href="<%= changeMethodUrl %>"><i class="bi bi-arrow-repeat"></i> Ubah Metode</a>
          <% } %>
          <% if (typeof cancelUrl !== 'undefined' && cancelUrl) { %>
            <form method="POST" action="<%= cancelUrl %>" onsubmit="return confirm('Batalkan transaksi pembayaran ini?');" style="display:inline">
              <button type="submit" class="btn" style="color:#fca5a5;border-color:color-mix(in srgb, #ef4444 40%, transparent)"><i class="bi bi-x-circle"></i> Batalkan</button>
            </form>
          <% } %>
          <% if (backUrl) { %>
            <a class="btn" href="<%= backUrl %>"><i class="bi bi-arrow-left"></i> Kembali</a>
          <% } %>
        </div>
      </div>

      <% if (error) { %>
        <div class="box"><%= error %></div>
      <% } else { %>
        <% if (info) { %><div class="box" style="margin-bottom:16px"><%= info %></div><% } %>
        <div class="grid">
          <div class="hero">
            <div class="box hero-copy">
              <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                <div class="badge ok"><i class="bi bi-shield-check"></i> Instruksi pembayaran aktif</div>
                <div class="badge"><%= gateway || '-' %></div>
              </div>
              <div class="amount-card">
                <div class="amount-meta">
                  <div class="label"><%= mode === 'qris' ? 'Total QRIS' : 'Nominal VA' %></div>
                  <div class="value">Rp <%= Number((details && details.total) || amount || 0).toLocaleString('id-ID') %></div>
                </div>
                <div class="d-flex flex-wrap gap-2 justify-content-end">
                  <% if (method) { %><span class="badge warn"><%= method %></span><% } %>
                  <% if (details && details.expired) { %><span class="badge"><i class="bi bi-clock"></i> <%= details.expired %></span><% } %>
                </div>
              </div>
              <div class="hero-note">
                <%= mode === 'qris'
                  ? 'Scan QR menggunakan aplikasi perbankan atau dompet digital yang mendukung QRIS.'
                  : 'Salin nomor virtual account, lalu selesaikan pembayaran melalui aplikasi perbankan atau ATM.' %>
              </div>
              <div class="summary-grid">
                <div class="summary-item">
                  <div class="label">Referensi</div>
                  <div class="value mono"><%= reference || '-' %></div>
                </div>
                <div class="summary-item">
                  <div class="label">Instruksi</div>
                  <div class="value"><%= (details && details.via) || instruction || '-' %></div>
                </div>
              </div>
              <div class="hero-actions">
                <% if (mode !== 'qris' && details && details.paymentNo) { %>
                  <button class="btn" type="button" id="copyVaBtn"><i class="bi bi-clipboard"></i> Salin Nomor VA</button>
                <% } %>
                <button class="btn" type="button" id="copyAmountBtn"><i class="bi bi-cash-coin"></i> Salin Nominal</button>
              </div>
            </div>

            <div class="box qr-frame" style="text-align:center;display:flex;align-items:center;justify-content:center">
              <% if (mode === 'qris' && qrImageUrl) { %>
                <div class="w-100">
                  <div class="scan-chip mb-3"><i class="bi bi-qr-code-scan"></i> Scan untuk bayar</div>
                  <img class="qr" src="<%= qrImageUrl %>" alt="QR / pembayaran">
                </div>
              <% } else { %>
                <div class="va-panel w-100 text-start">
                  <div class="va-bank mb-1 d-flex align-items-center gap-2">
                    <% var vaBankColor = typeof bankLogoFor === 'function' ? bankLogoFor(((details && details.channel) || method || gateway)) : ''; %>
                    <i class="bi bi-bank" style="<%= vaBankColor ? 'color:' + vaBankColor : '' %>"></i>
                    <span><%= (details && details.via) || gateway || 'PAYMENT' %><% if (details && details.channel) { %> / <%= details.channel %><% } %></span>
                  </div>
                  <div class="va-title">Nomor Pembayaran</div>
                  <div class="va-code mono mb-3"><%= (details && details.paymentNo) || instruction || '-' %></div>
                  <div class="d-flex flex-wrap gap-2">
                    <span class="va-chip"><i class="bi bi-clock"></i> <%= (details && details.expired) || 'Expired belum tersedia' %></span>
                    <span class="va-chip"><i class="bi bi-receipt"></i> Rp <%= Number((details && details.total) || amount || 0).toLocaleString('id-ID') %></span>
                  </div>
                </div>
              <% } %>
            </div>
          </div>

          <div class="box">
            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap mb-3">
              <div style="font-weight:800">Ringkasan Pembayaran</div>
              <div class="badge"><%= mode === 'qris' ? 'QRIS' : 'VIRTUAL ACCOUNT' %></div>
            </div>
            <div class="kv">
              <div class="kv-row"><div class="kv-label">Referensi</div><div class="kv-value mono"><%= reference || details?.referenceId || '-' %></div></div>
              <div class="kv-row"><div class="kv-label"><%= mode === 'qris' ? 'Metode' : 'Bank / Channel' %></div><div class="kv-value"><%= mode === 'qris' ? 'QRIS' : (details?.channel || details?.via || method || '-') %></div></div>
              <div class="kv-row"><div class="kv-label">Berlaku Sampai</div><div class="kv-value"><%= details?.expired || '-' %></div></div>
            </div>
          </div>

          <% if (helpText) { %>
            <div class="box muted"><%= helpText %></div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    /* eslint-disable */
    (function () {
      var amount = <%= Number(amount || 0) || 0 %>;
      var paymentNo = <%- JSON.stringify(String((details && details.paymentNo) || '')) %>;
      var copy = async function (text) {
        try {
          if (navigator && navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(String(text));
            return true;
          }
        } catch (e) {}
        try {
          var ta = document.createElement('textarea');
          ta.value = String(text);
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.focus();
          ta.select();
          var ok = document.execCommand('copy');
          document.body.removeChild(ta);
          return ok;
        } catch (e) {
          return false;
        }
      };

      var vaBtn = document.getElementById('copyVaBtn');
      if (vaBtn) vaBtn.addEventListener('click', function () {
        if (!paymentNo) return;
        copy(paymentNo);
      });

      var amountBtn = document.getElementById('copyAmountBtn');
      if (amountBtn) amountBtn.addEventListener('click', function () {
        if (!amount) return;
        copy(amount);
      });
    })();
    /* eslint-enable */
  </script>
</body>
</html>