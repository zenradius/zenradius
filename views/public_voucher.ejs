<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Voucher Hotspot | <%= settings.company_header || 'ZenRadius - Pusat Layanan' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" type="image/png">
  <link rel="stylesheet" href="/css/unified.css">
  <style>
    :root {
      /* Matches landing page (views/login.ejs) portal theme exactly */
      --font-sans: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif;
      --font-display: 'Space Grotesk', 'Plus Jakarta Sans', system-ui, sans-serif;
      --portal-bg: #101820;
      --portal-panel: rgba(17, 29, 36, 0.94);
      --portal-panel-strong: rgba(12, 23, 30, 0.98);
      --portal-line: rgba(124, 221, 218, 0.18);
      --portal-primary: #2dd4bf;
      --portal-primary-strong: #22a7f0;
      --portal-accent: #fbbf24;
      --portal-text: #edf7f5;
      --portal-muted: #a8bec2;
      --landing-bg: radial-gradient(circle at 8% 0%, #236060 0%, transparent 34%),
            radial-gradient(circle at 100% 100%, #173e4d 0%, transparent 42%),
            linear-gradient(135deg, #173740 0%, #183f51 52%, #194251 100%);
    }
    @keyframes softGlow {
      0%, 100% { box-shadow: 0 0 0 rgba(45, 212, 191, 0.06), 0 8px 18px rgba(23, 57, 69, 0.14); }
      50% { box-shadow: 0 0 0 2px rgba(45, 212, 191, 0.10), 0 12px 22px rgba(45, 212, 191, 0.12); }
    }
    body{
      background: var(--landing-bg);
      color: var(--portal-text);
      font-family: var(--font-sans);
      -webkit-tap-highlight-color: transparent;
    }
    .wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:18px}
    .cardx{background: linear-gradient(180deg, rgba(11, 20, 26, 0.96), rgba(16, 24, 32, 0.92));backdrop-filter: blur(12px);border: 1px solid var(--portal-line);border-radius: 16px;box-shadow: 0 16px 38px rgba(2, 10, 14, 0.32);overflow:hidden;max-width: 720px;width:100%;position: relative;}
    .cardx::before { content:""; position:absolute; inset:0 auto auto 0; width:100%; height:140%; background: linear-gradient(135deg, rgba(255,255,255,0.04), transparent 40%, rgba(148,163,184,0.04)); pointer-events:none; }
    .head{background:var(--portal-panel-strong);padding:26px 20px;border-bottom:1px solid var(--portal-line)}
    .body{padding:22px 20px}
    .form-control,.form-select{
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--portal-line);
      color: var(--portal-text);
      border-radius: 10px;
      transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }
    .form-control::placeholder{
      color: rgba(237, 250, 250, 0.38);
    }
    .form-control:focus,.form-select:focus{
      background: rgba(255, 255, 255, 0.09);
      border-color: var(--portal-primary);
      box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.14);
      color: #fff;
    }
    .muted{color: var(--portal-muted)}
    .btnx{border-radius:12px;font-weight:700;font-family: var(--font-display);transition: transform .18s ease, box-shadow .18s ease, filter .18s ease; min-height: 46px; padding: 10px 16px; line-height: 1.2;}
    .btnx:hover{transform: translateY(-2px); filter: brightness(1.03);}
    .btn-primary{background:linear-gradient(135deg, var(--portal-primary) 0%, var(--portal-primary-strong) 52%, #2563eb 100%);border:1px solid rgba(45, 212, 191, 0.6);color:#062c2a;box-shadow:0 10px 22px rgba(45, 212, 191, 0.22);animation:softGlow 5s ease-in-out infinite}
    .btn-primary:hover{filter:brightness(1.05)!important;color:#062c2a!important}
    a{color:#a5f4ed}
    .pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:700;border:1px solid rgba(148,163,184,.18)}
    .pill-u{background: rgba(248, 81, 73, .12);color:#fca5a5;border-color: rgba(248, 81, 73, .28)}
    .pill-p{background: rgba(63, 185, 80, .12);color:#86efac;border-color: rgba(63, 185, 80, .28)}

    /* Order Status Card — modern professional redesign */
    .order-status-card{
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--portal-line);
      border-radius: 14px;
      padding: 18px 16px;
    }
    .order-status-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap}
    .order-status-label{display:block;font-family:var(--font-display);font-weight:700;font-size:15px;color:var(--portal-text)}
    .order-status-meta{display:block;font-size:12px;color:var(--portal-muted);margin-top:2px}
    @keyframes spinSlow{from{transform:rotate(0)}to{transform:rotate(360deg)}}
    .spin-slow{display:inline-block;animation:spinSlow 2.2s linear infinite}

    .order-steps{display:flex;align-items:center;margin:18px 0 4px}
    .order-step{display:flex;flex-direction:column;align-items:center;gap:6px;flex:0 0 auto;width:88px}
    .order-step-dot{
      width:30px;height:30px;border-radius:50%;
      display:flex;align-items:center;justify-content:center;
      background: rgba(255,255,255,0.06);
      border:1.5px solid var(--portal-line);
      color: var(--portal-muted);
      font-size:14px;
      transition: all .3s ease;
    }
    .order-step.is-done .order-step-dot{
      background: linear-gradient(135deg, var(--portal-primary), var(--portal-primary-strong));
      border-color: transparent;
      color:#062c2a;
      box-shadow: 0 4px 14px rgba(45,212,191,.35);
    }
    .order-step.is-active .order-step-dot{
      border-color: var(--portal-primary);
      color: var(--portal-primary);
      box-shadow: 0 0 0 4px rgba(45,212,191,.14);
    }
    .order-step-text{font-size:10.5px;text-align:center;color:var(--portal-muted);font-weight:600;letter-spacing:.2px}
    .order-step.is-done .order-step-text,.order-step.is-active .order-step-text{color:var(--portal-text)}
    .order-step-line{flex:1 1 auto;height:2px;background:var(--portal-line);margin:0 -4px;margin-bottom:16px;transition: background .3s ease}
    .order-step-line.is-done{background: linear-gradient(90deg, var(--portal-primary), var(--portal-primary-strong))}

    .order-detail-row{display:flex;flex-wrap:wrap;gap:10px 20px;margin-top:16px;padding-top:14px;border-top:1px solid var(--portal-line)}
    .order-detail-item{display:flex;flex-direction:column;gap:2px}
    .order-detail-k{font-size:10.5px;text-transform:uppercase;letter-spacing:.6px;color:var(--portal-muted);font-weight:700}
    .order-detail-v{font-size:13.5px;color:var(--portal-text);font-weight:700}

    .order-result{border-radius:12px;padding:14px 16px;border:1px solid var(--portal-line)}
    .order-result-title{font-family:var(--font-display);font-weight:700;font-size:14px;color:var(--portal-text)}
    .order-result-success{background: rgba(45,212,191,.07);border-color: rgba(45,212,191,.25)}
    .order-result-info{background: rgba(34,167,240,.07);border-color: rgba(34,167,240,.22)}
    .order-result-codes{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px}
    .order-code-box{
      flex:1 1 140px;
      background: rgba(0,0,0,0.18);
      border:1px dashed var(--portal-line);
      border-radius:10px;
      padding:8px 12px;
      display:flex;flex-direction:column;gap:2px;
    }
    .order-code-k{font-size:10px;text-transform:uppercase;letter-spacing:.6px;color:var(--portal-muted);font-weight:700}
    .order-code-v{font-family:var(--font-display);font-size:15px;font-weight:700;color:var(--portal-accent);letter-spacing:.5px;word-break:break-all}
    .order-code-box-single{flex:1 1 100%;align-items:center;text-align:center;padding:14px 12px}
    .order-code-box-single .order-code-v{font-size:22px;letter-spacing:2px}
    .order-progress-bar{height:5px;border-radius:999px;background:rgba(255,255,255,.08);overflow:hidden}
    .order-progress-fill{height:100%;width:40%;border-radius:999px;background:linear-gradient(90deg, var(--portal-primary), var(--portal-primary-strong));animation:progressSlide 1.6s ease-in-out infinite}
    @keyframes progressSlide{0%{transform:translateX(-100%)}50%{transform:translateX(60%)}100%{transform:translateX(250%)}}

    /* Voucher card artwork and layout: /css/voucher-cards.css */

    /* Confirmation Dialog Modal styles */
    .c-modal-overlay{
      position:fixed;
      inset:0;
      background:rgba(6, 14, 18, .82);
      backdrop-filter:blur(8px);
      z-index:9999;
      display:flex;
      align-items:center;
      justify-content:center;
      opacity:0;
      pointer-events:none;
      transition:opacity .25s ease;
    }
    .c-modal-overlay.active{
      opacity:1;
      pointer-events:auto;
    }
    .c-modal{
      background:var(--portal-panel-strong);
      border:1px solid var(--portal-line);
      border-radius:16px;
      padding:24px;
      max-width:480px;
      width:90%;
      box-shadow:0 24px 48px rgba(2, 10, 14, .5);
      transform:scale(0.95);
      transition:transform .25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .c-modal-overlay.active .c-modal{
      transform:scale(1);
    }
    .c-modal-title{
      font-size:18px;
      font-weight:800;
      font-family: var(--font-display);
      color:#fff;
      margin-bottom:8px;
      display:flex;
      align-items:center;
      gap:10px;
    }
    .c-modal-body{
      font-size:14px;
      color:var(--portal-muted);
      line-height:1.5;
      margin-bottom:20px;
    }
    .c-modal-detail{
      background:rgba(45, 212, 191, .06);
      border:1px solid var(--portal-line);
      border-radius:10px;
      padding:12px 16px;
      margin-top:10px;
    }
    .c-modal-actions{
      display:flex;
      gap:10px;
      justify-content:flex-end;
    }
    
    .payment-methods-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:14px;margin-top:12px}
    @media (max-width: 768px){.payment-methods-grid{grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px}}
    @media (max-width: 576px){.payment-methods-grid{grid-template-columns:repeat(2,1fr);gap:10px}}
    .pm-radio{position:absolute;opacity:0;pointer-events:none}
    .pay-method-item{display:flex;align-items:center;gap:12px;padding:14px 12px;background: rgba(15,23,42,.62);border: 2px solid rgba(148,163,184,.18);border-radius: 14px;cursor:pointer;transition: all .25s cubic-bezier(0.4, 0, 0.2, 1);flex-direction:column;text-align:center;position:relative;overflow:hidden}
    .pay-method-item::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background: linear-gradient(135deg, rgba(25,211,197,.06) 0%, rgba(34,167,240,.06) 100%);opacity:0;transition: opacity .25s ease}
    .pay-method-item:hover{background: rgba(15,23,42,.8);border-color: rgba(25,211,197,.45);transform: translateY(-2px);box-shadow: 0 12px 35px rgba(0,0,0,.4), 0 0 0 1px rgba(25,211,197,.1)}
    .pay-method-item:hover::before{opacity:1}
    .pm-radio:checked + .pay-method-item{background: rgba(25,211,197,.12);border-color: rgba(25,211,197,.8);box-shadow: 0 8px 25px rgba(25,211,197,.18), 0 0 0 1px rgba(25,211,197,.3);transform: translateY(-1px)}
    .pm-radio:checked + .pay-method-item::after{content:'\F272';font-family:'bootstrap-icons';position:absolute;top:8px;right:8px;width:20px;height:20px;background: linear-gradient(135deg, #19d3c5, #22a7f0);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;color:#fff;box-shadow: 0 4px 12px rgba(25,211,197,.4)}
    .p-icon{width:48px;height:48px;background: rgba(30,41,59,.95);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;color:#6366f1;box-shadow: 0 8px 20px rgba(0,0,0,.35);overflow:hidden;flex:0 0 auto;margin:0 auto 8px;position:relative;z-index:1}
    .p-logo{width:100%;height:100%;object-fit:contain;padding:8px;background: rgba(255,255,255,.98)}
    .p-badge{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800}
    .pb-dana{background: linear-gradient(135deg, #3b82f6, #0ea5e9);color:#fff}
    .pb-ovo{background: linear-gradient(135deg, #a855f7, #6366f1);color:#fff}
    .pb-shopeepay{background: linear-gradient(135deg, #f97316, #f43f5e);color:#fff}
    .pb-linkaja{background: linear-gradient(135deg, #ef4444, #f43f5e);color:#fff}
    .pb-gopay{background: linear-gradient(135deg, #22c55e, #10b981);color:#fff}
    .pb-bank{background: linear-gradient(135deg, #1e293b, #334155);color:#e2e8f0}
    .pb-qris{background: linear-gradient(135deg, #6366f1, #8b5cf6);color:#fff}
    .p-info{display:flex;flex-direction:column;min-width:0;gap:4px;width:100%;position:relative;z-index:1}
    .p-name{font-size:13px;font-weight:700;color:#f8fafc;line-height:1.3;word-break:break-word}
    .p-sub{font-size:10px;color: rgba(148,163,184,.95);display:flex;flex-wrap:wrap;gap:4px;justify-content:center;margin-top:2px}
    .p-chip{display:inline-flex;align-items:center;padding:3px 7px;border-radius:999px;border:1px solid rgba(99,102,241,.3);background: rgba(99,102,241,.12);color: rgba(226,232,240,.95);font-size:9px;font-weight:700;line-height:1.2;white-space:nowrap}
    @media (min-width: 769px){.pay-method-item{flex-direction:row;text-align:left;gap:14px;padding:14px 16px}.p-icon{margin:0 0 0 0}.p-info{align-items:flex-start}.p-sub{justify-content:flex-start}}
    @media (max-width: 576px){.pay-method-item{padding:12px 10px;gap:10px}.p-icon{width:42px;height:42px;font-size:20px;margin-bottom:6px}.p-name{font-size:12px}.p-sub{font-size:9px}.p-chip{padding:2px 6px;font-size:8px}}
    @media (max-width: 480px){
      .wrap{padding:10px}
      .head{padding:20px 16px}
      .head img{height:36px!important}
      .body{padding:16px 14px}
      .c-modal{padding:18px;width:94%;max-width:420px}
      .c-modal-title{font-size:16px}
      .c-modal-body{font-size:13px}
      .payment-methods-grid{gap:8px!important}
      .c-modal-actions{flex-wrap:wrap;gap:8px}
      .c-modal-actions .btn{flex:1 1 auto;padding:10px 14px!important}
    }
  </style>
  <link rel="stylesheet" href="/css/voucher-cards.css?v=1">
</head>
<body>
  <div class="wrap">
    <div class="cardx">
      <div class="head" style="text-align:center;padding-top:28px;padding-bottom:22px;">
        <img src="/img/logo.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" alt="ZenRadius" style="height:42px;width:auto;max-width:220px;object-fit:contain;display:block;margin:0 auto 14px;" onerror="this.style.display='none'">
        <p class="muted small mb-0 mx-auto" style="max-width:480px;line-height:1.7;">Dapatkan voucher internet harian dan mingguan secara instan — pilih paket pilihan Anda, selesaikan pelunasan via QRIS / VA / m-banking, dan ambil kode voucher aktif secara langsung tanpa hambatan.</p>
      </div>
      <div class="body">
        <% if (error) { %>
          <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
          </div>
        <% } %>
        <% if (info) { %>
          <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i><%= info %>
          </div>
        <% } %>

        <% if (order) { %>
          <% const st = String(order.status || 'pending'); %>
          <div class="order-status-card mb-3">
            <div class="order-status-head">
              <div class="order-status-id">
                <span class="order-status-label">Status Pesanan</span>
                <span class="order-status-meta">Order #<%= order.id %> &middot; WA <%= order.buyer_phone %></span>
              </div>
              <% if (st === 'fulfilled') { %>
                <span class="pill pill-p"><i class="bi bi-check-circle-fill"></i> Selesai</span>
              <% } else if (st === 'paid') { %>
                <span class="pill pill-u"><i class="bi bi-arrow-repeat spin-slow"></i> Diproses</span>
              <% } else { %>
                <span class="pill pill-u"><i class="bi bi-clock-history"></i> Menunggu Pembayaran</span>
              <% } %>
            </div>

            <!-- Progress Stepper -->
            <div class="order-steps">
              <div class="order-step <%= 'is-done' %>">
                <div class="order-step-dot"><i class="bi bi-check-lg"></i></div>
                <div class="order-step-text">Pesanan Dibuat</div>
              </div>
              <div class="order-step-line <%= (st === 'paid' || st === 'fulfilled') ? 'is-done' : '' %>"></div>
              <div class="order-step <%= (st === 'paid' || st === 'fulfilled') ? 'is-done' : (st === 'pending' ? 'is-active' : '') %>">
                <div class="order-step-dot"><i class="bi <%= (st === 'paid' || st === 'fulfilled') ? 'bi-check-lg' : 'bi-credit-card' %>"></i></div>
                <div class="order-step-text">Pembayaran</div>
              </div>
              <div class="order-step-line <%= st === 'fulfilled' ? 'is-done' : '' %>"></div>
              <div class="order-step <%= st === 'fulfilled' ? 'is-done' : (st === 'paid' ? 'is-active' : '') %>">
                <div class="order-step-dot"><i class="bi <%= st === 'fulfilled' ? 'bi-check-lg' : 'bi-ticket-perforated' %>"></i></div>
                <div class="order-step-text">Voucher Siap</div>
              </div>
            </div>

            <div class="order-detail-row">
              <div class="order-detail-item">
                <span class="order-detail-k">Paket</span>
                <span class="order-detail-v"><%= order.profile_name %></span>
              </div>
              <div class="order-detail-item">
                <span class="order-detail-k">Durasi</span>
                <span class="order-detail-v"><%= order.validity || '-' %></span>
              </div>
              <div class="order-detail-item">
                <span class="order-detail-k">Harga</span>
                <span class="order-detail-v">Rp <%= Number(order.price || 0).toLocaleString('id-ID') %></span>
              </div>
            </div>

            <% if (String(order.status) === 'fulfilled' && order.voucher_code) { %>
              <div class="order-result order-result-success mt-3">
                <div class="order-result-title"><i class="bi bi-patch-check-fill me-2"></i>Voucher Siap Digunakan</div>
                <div class="order-result-codes">
                  <div class="order-code-box order-code-box-single">
                    <span class="order-code-k">Kode Voucher (Username &amp; Password)</span>
                    <span class="order-code-v"><%= order.voucher_code %></span>
                  </div>
                </div>
                <% if (Number(order.wa_sent || 0) === 1) { %>
                  <div class="muted small mt-2"><i class="bi bi-whatsapp me-1"></i>Voucher berhasil dikirim ke WhatsApp Anda.</div>
                <% } else if (order.wa_error) { %>
                  <div class="text-warning small mt-2"><i class="bi bi-exclamation-triangle me-1"></i>Pengiriman WhatsApp gagal, namun voucher tetap aktif dan tersimpan.</div>
                  <div class="muted small">Silakan catat/screenshot kode voucher di atas sebagai cadangan.</div>
                <% } else { %>
                  <div class="muted small mt-2">Simpan halaman ini sebagai cadangan jika notifikasi WhatsApp belum diterima.</div>
                <% } %>
              </div>
            <% } else if (String(order.status) === 'paid') { %>
              <div class="order-result order-result-info mt-3">
                <div class="order-result-title"><i class="bi bi-stars me-2"></i>Pembayaran Berhasil Dikonfirmasi</div>
                <div class="muted small">Voucher Anda sedang disiapkan secara otomatis dan akan tersedia sesaat lagi. Halaman ini akan diperbarui secara otomatis.</div>
                <div class="order-progress-bar mt-2"><div class="order-progress-fill"></div></div>
              </div>
            <% } else if (String(order.status) === 'pending' && (String(order.payment_gateway || '') === 'qris_static' || order.qris_amount_unique)) { %>
              <% if (orderToken) { %>
                <a class="btn btn-primary btnx mt-3 w-100" href="/customer/voucher/qris/<%= order.id %>?t=<%= encodeURIComponent(orderToken) %>">
                  <i class="bi bi-qr-code-scan me-1"></i> Buka QRIS Statis
                </a>
              <% } else { %>
                <div class="alert alert-warning mt-3 mb-0">Link QRIS tidak tersedia.</div>
              <% } %>
            <% } else if (String(order.status) === 'pending' && order.payment_link) { %>
              <a class="btn btn-primary btnx mt-3 w-100" href="<%= order.payment_link %>">
                <i class="bi bi-credit-card me-1"></i> Lanjutkan Pembayaran
              </a>
            <% } %>
          </div>
          <hr style="border-color: rgba(148,163,184,.18)">
        <% } %>

        <form method="POST" action="/customer/public/voucher/create-payment" class="d-grid gap-2" id="voucherForm">
          <!-- Hidden TOS state injector to bypass backend checks cleanly -->
          <input type="hidden" name="tos" value="1">

          <div class="row g-2">
            <div class="col-12">
              <div class="filter-title mb-3" style="display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--portal-muted)">
                <i class="bi bi-ticket-perforated" style="color:var(--portal-primary);font-size:13px"></i>
                <span>Pilih Paket Internet Terbaik</span>
                <div style="flex:1;height:1px;background:linear-gradient(90deg,var(--portal-line),transparent);margin-left:8px"></div>
              </div>
              <% if (!profiles || profiles.length === 0) { %>
                <div class="muted small mt-1">Belum ada profile voucher (metadata Mikhmon) di MikroTik.</div>
              <% } else { %>
                <div class="voucher-grid mt-1">
                  <%
                    function formatCardValidity(value) {
                      const raw = String(value || '-').trim();
                      const match = raw.match(/^(\d+)\s*([wdhms])$/i);
                      const units = { w: 'Minggu', d: 'Hari', h: 'Jam', m: 'Menit', s: 'Detik' };
                      return match ? `${Number(match[1])} ${units[match[2].toLowerCase()]}` : raw;
                    }
                    (profiles || []).forEach((p, idx) => {
                      const price = Number(p.price || 0);
                      const priceText = price.toLocaleString('id-ID');
                      const priceClass = priceText.length > 9 ? 'v-price-extra-long' : (priceText.length > 6 ? 'v-price-long' : '');
                      const validityText = formatCardValidity(p.validity);
                  %>
                    <input
                      class="voucher-radio"
                      type="radio"
                      name="profile_name"
                      id="vprofile_<%= idx %>"
                      value="<%= p.name %>"
                      data-price="<%= price %>"
                      data-validity="<%= validityText %>"
                      aria-label="<%= p.name %>, Rp <%= priceText %>, <%= validityText %>"
                      aria-describedby="step1Hint"
                      <%= idx === 0 ? 'required' : '' %>
                    >
                    <label class="voucher-card" for="vprofile_<%= idx %>">
                      <span class="v-selected" aria-hidden="true"><i class="bi bi-check-circle-fill"></i> Dipilih</span>
                      <div class="v-brand" aria-hidden="true">
                        <div class="v-brand-logo-container">
                          <img src="/img/logo.png?v=<%= typeof brandVersion !== 'undefined' ? brandVersion : 'zenradius' %>" alt="Logo" class="v-brand-real-logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                          <div class="v-brand-fallback-group" style="display:none">
                            <span class="v-brand-name"><%= settings.company_header || 'WiFi' %></span>
                            <span class="v-brand-sub">HOTSPOT</span>
                          </div>
                        </div>
                      </div>
                      <span class="v-tagline">Internet Cepat, Hidup Lebih Mudah</span>
                      <span class="v-ribbon">VOUCHER INTERNET</span>
                      <span class="v-offer">
                        <span class="voucher-price <%= priceClass %>"><span class="v-currency">Rp</span><%= priceText %></span>
                        <span class="v-divider" aria-hidden="true"></span>
                        <span class="v-validity <%= validityText.length > 9 ? 'v-validity-long' : '' %>"><%= validityText %></span>
                      </span>
                      <span class="v-package" title="<%= p.name %>"><%= p.name %></span>
                      <span class="v-benefits">
                        <span class="v-benefit">
                          <span class="v-benefit-icon" aria-hidden="true"><i class="bi bi-lightning-charge-fill"></i></span>
                          <span>Akses<br>Cepat</span>
                        </span>
                        <span class="v-benefit">
                          <span class="v-benefit-icon" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
                          <span>Aman<br>&amp; Stabil</span>
                        </span>
                        <span class="v-benefit">
                          <span class="v-benefit-icon" aria-hidden="true"><i class="bi bi-phone"></i></span>
                          <span>Bisa di Semua<br>Perangkat</span>
                        </span>
                      </span>
                      <span class="v-signature" aria-hidden="true">Stay<br>Connected</span>
                    </label>
                  <% }) %>
                </div>
                <div class="p-3 mt-3 rounded-3" style="background:rgba(45,212,191,0.04);border:1px solid var(--portal-line);display:flex;align-items:start;gap:10px;" id="step1Hint">
                  <i class="bi bi-info-circle" style="color:var(--portal-primary);font-size:15px;margin-top:2px"></i>
                  <span style="font-size:12.5px;line-height:1.5;color:rgba(168,190,194,0.95)">Klik paket voucher pilihan Anda di atas untuk langsung melakukan pengisian data nomor WhatsApp dan pembayaran cepat.</span>
                </div>
              <% } %>
            </div>
          </div>

          <a class="d-inline-flex align-items-center justify-content-center gap-1 text-decoration-none small mt-2 mx-auto" href="/" style="color:#a5f4ed;font-weight:700;">
            <i class="bi bi-arrow-left"></i> Kembali Halaman
          </a>

          <!-- Confirmation Popup Modal overlay inside the FORM wrapper so inputs submit perfectly -->
          <div class="c-modal-overlay" id="confirmModal">
            <div class="c-modal">
              <div class="c-modal-title">
                <i class="bi bi-wallet2" style="color:#2dd4bf"></i>
                <span>Selesaikan Pembayaran Voucher</span>
              </div>
              <div class="c-modal-body text-start">
                <div style="font-size:13.5px;line-height:1.5;margin-bottom:12px">Silakan masukkan nomor WhatsApp pembeli dan pilih metode pembayaran untuk melanjutkan pesanan Anda:</div>
                
                <!-- Paket selected display -->
                <div class="c-modal-detail" style="margin-top:0;margin-bottom:16px;background:rgba(45,212,191,.04);border-color:rgba(45,212,191,.15)">
                  <div style="font-weight:800;color:#fff;font-size:15px" id="popName">-</div>
                  <div style="color:var(--portal-muted);font-size:12.5px;margin-top:2px;display:flex;align-items:center;gap:4px">
                    <i class="bi bi-clock-history"></i> Masa Aktif: <span id="popValidity">-</span>
                  </div>
                  <div style="font-weight:900;color:#2dd4bf;font-size:18px;margin-top:6px;" id="popPrice">-</div>
                </div>

                <!-- Input WhatsApp directly inside popup -->
                <div class="mb-3">
                  <label class="muted small mb-1 fw-bold">Nomor WhatsApp Pembeli</label>
                  <div style="position:relative; width: 100%;">
                    <i class="bi bi-whatsapp" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#2dd4bf;font-size:15px;pointer-events:none;z-index:4;"></i>
                    <input class="form-control" name="buyer_phone" id="buyerPhone" inputmode="numeric" placeholder="Contoh: 081234567890" style="padding-left: 38px; height: 46px;" required>
                  </div>
                  <div class="muted small mt-1" style="font-size:11px">Voucher terkirim instan via WhatsApp.</div>
                </div>

                <!-- Payment channels inside popup -->
                <div class="mb-2">
                  <label class="muted small mb-1 fw-bold">Metode Pembayaran</label>
                  <% const hasStaticQris = (String(settings.qris_static_qr_url || '').trim() || String(settings.qris_static_payload || '').trim()) && (settings.qris_static_enabled !== false && settings.qris_static_enabled !== 'false' && settings.qris_static_enabled !== 0 && settings.qris_static_enabled !== '0'); %>
                  <% if (!hasStaticQris && (!paymentChannels || paymentChannels.length === 0)) { %>
                    <input type="hidden" name="method" value="QRIS">
                    <div class="payment-methods-grid mt-1" style="grid-template-columns:1fr">
                      <div class="pay-method-item" style="cursor:default;flex-direction:row;padding:10px 14px;background:rgba(255,255,255,.03)">
                        <div class="p-icon" style="width:36px;height:36px;font-size:16px;margin:0"><i class="bi bi-qr-code-scan"></i></div>
                        <div class="p-info" style="align-items:flex-start">
                          <span class="p-name" style="font-size:12.5px">QRIS / E-Wallet</span>
                        </div>
                      </div>
                    </div>
                  <% } else { %>
                    <div class="payment-methods-grid mt-1" style="grid-template-columns:repeat(2,1fr);gap:8px">
                      <% if (hasStaticQris) { %>
                        <input
                          class="pm-radio"
                          type="radio"
                          name="method"
                          id="pm_static"
                          value="QRIS_STATIC"
                          checked
                          style="position:absolute;opacity:0;pointer-events:none"
                        >
                        <label class="pay-method-item" for="pm_static" style="padding:10px;gap:6px;border-radius:10px;background:rgba(15,23,42,.62)">
                          <div class="p-icon" style="width:32px;height:32px;font-size:15px;margin-bottom:0"><i class="bi bi-qr-code-scan"></i></div>
                          <div class="p-info">
                            <span class="p-name" style="font-size:11.5px">QRIS Instan</span>
                          </div>
                        </label>
                      <% } %>
                      <% paymentChannels.forEach((ch, idx) => {
                        const code = String(ch.code || '').toUpperCase();
                        const name = ch.name || code;
                        const group = String(ch.group || '').toLowerCase();
                        let icon = 'bi-wallet2';
                        let badgeClass = 'pb-bank';
                        
                        if (code === 'QRIS' || code.includes('QRIS')) {
                          icon = 'bi-qr-code-scan';
                          badgeClass = 'pb-bank';
                        } else if (code.includes('DANA')) {
                          icon = 'bi-wallet2';
                          badgeClass = 'pb-dana';
                        } else if (code.includes('OVO')) {
                          icon = 'bi-wallet2';
                          badgeClass = 'pb-ovo';
                        } else if (code.includes('SHOPEE')) {
                          icon = 'bi-wallet2';
                          badgeClass = 'pb-shopeepay';
                        } else if (code.includes('LINKAJA')) {
                          icon = 'bi-wallet2';
                          badgeClass = 'pb-linkaja';
                        } else if (code.includes('GOPAY')) {
                          icon = 'bi-wallet2';
                          badgeClass = 'pb-gopay';
                        } else if (code.includes('VA') || group.includes('virtual')) {
                          icon = 'bi-bank';
                          badgeClass = 'pb-bank';
                        } else if (code.includes('SNAP') || code.includes('XENDIT') || code.includes('DUITKU')) {
                          icon = 'bi-credit-card';
                          badgeClass = 'pb-bank';
                        }
                      %>
                        <input
                          class="pm-radio"
                          type="radio"
                          name="method"
                          id="pm_<%= idx %>"
                          value="<%= code %>"
                          <%= (!hasStaticQris && idx === 0) ? 'checked' : '' %>
                          style="position:absolute;opacity:0;pointer-events:none"
                        >
                        <label class="pay-method-item" for="pm_<%= idx %>" style="padding:10px;gap:6px;border-radius:10px;background:rgba(15,23,42,.62)">
                          <div class="p-icon" style="width:32px;height:32px;font-size:15px;margin-bottom:0">
                            <% if (ch.icon_url) { %>
                              <img src="<%= ch.icon_url %>" alt="<%= name %>" class="p-logo" style="padding:4px">
                            <% } else { %>
                              <div class="p-badge <%= badgeClass %>" style="font-size:14px">
                                <i class="<%= icon %>"></i>
                              </div>
                            <% } %>
                          </div>
                          <div class="p-info">
                            <span class="p-name" style="font-size:11.5px"><%= name %></span>
                          </div>
                        </label>
                      <% }) %>
                    </div>
                  <% } %>
                </div>

              </div>
              <div class="c-modal-actions" style="margin-top:10px">
                <button class="btn btn-ghost btn-sm" type="button" style="border-radius:10px;padding:10px 18px" onclick="cancelConfirm()"><i class="bi bi-x-lg me-1"></i>Batal</button>
                <button class="btn btn-primary btn-sm" type="submit" style="border-radius:10px;min-height:unset;padding:10px 22px">
                  Bayar & Aktivasi <i class="bi bi-lightning-charge-fill ms-1"></i>
                </button>
              </div>
            </div>
          </div>
        </form>

        <footer class="site-footer" style="background:#173945;border-top:1px solid rgba(190,239,255,0.32);padding:26px 0 18px;margin-top:32px;margin-left:-20px;margin-right:-20px;margin-bottom:-20px;border-radius:0 0 16px 16px">
          <div class="container text-center">
            <div class="footer-bottom text-center" style="font-family:var(--font-sans);font-size:0.8rem;color:rgba(237, 250, 250, 0.72);margin-top:4px;padding-top:0">
              &copy; <%= new Date().getFullYear() %> <%- footerInfo %>
            </div>
          </div>
        </footer>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const radios = Array.from(document.querySelectorAll('input.voucher-radio'));
      let activeRadio = null;
      let focusTimer = null;

      // Native radio changes support mouse, touch and keyboard without inline profile strings.
      radios.forEach(r => r.addEventListener('change', function () {
        if (!r.checked) return;
        activeRadio = r;
        document.getElementById('popName').textContent = r.value;
        document.getElementById('popValidity').textContent = r.dataset.validity || '-';
        document.getElementById('popPrice').textContent = 'Rp ' + Number(r.dataset.price || 0).toLocaleString('id-ID');
        document.getElementById('confirmModal')?.classList.add('active');
        clearTimeout(focusTimer);
        focusTimer = setTimeout(() => document.getElementById('buyerPhone')?.focus(), 220);
      }));

      window.cancelConfirm = function () {
        clearTimeout(focusTimer);
        document.getElementById('confirmModal')?.classList.remove('active');
        radios.forEach(r => { r.checked = false; });
        activeRadio?.focus({ preventScroll: true });
        activeRadio = null;
      };

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && document.getElementById('confirmModal')?.classList.contains('active')) {
          window.cancelConfirm();
        }
      });
    })();
  </script>
  <% if (order && (String(order.status) === 'paid' || String(order.status) === 'pending') && !order.voucher_code) { %>
  <script>
    setTimeout(() => {
      try { window.location.reload(); } catch (e) {}
    }, 5000);
  </script>
  <% } %>
</body>
</html>
