<!DOCTYPE html>
<html lang="<%= lang || 'id' %>" data-app-theme="<%= typeof appTheme !== 'undefined' ? appTheme : 'current' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Voucher Hotspot | <%= settings.company_header || 'ZenRadius - Pusat Layanan' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" type="image/png">
  <link rel="stylesheet" href="/css/unified.css">
  <link rel="stylesheet" href="/css/theme-tokens.css">
  <style>
    :root {
      /* Matches landing page (views/login.ejs) portal theme exactly */
      --font-sans: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif;
      --font-display: 'Space Grotesk', 'Plus Jakarta Sans', system-ui, sans-serif;
      --portal-bg: var(--bg, #101820);
      --portal-panel: var(--bg2, rgba(17, 29, 36, 0.94));
      --portal-panel-strong: var(--bg3, rgba(12, 23, 30, 0.98));
      --portal-line: var(--border, rgba(124, 221, 218, 0.18));
      --portal-primary: var(--primary, #2dd4bf);
      --portal-primary-strong: var(--accent, #22a7f0);
      --portal-accent: var(--warning, #fbbf24);
      --portal-text: var(--text, #edf7f5);
      --portal-muted: var(--muted, #a8bec2);
      --landing-bg: var(--body-bg-image, radial-gradient(circle at 8% 0%, #236060 0%, transparent 34%),
            radial-gradient(circle at 100% 100%, #173e4d 0%, transparent 42%),
            linear-gradient(135deg, #173740 0%, #183f51 52%, #194251 100%));
      /* Admin panel palette â€” dipakai untuk menyelaraskan pop-up pembayaran dengan pop-up Detail Pesanan Voucher di admin */
      --admin-bg2: var(--bg2, #173945);
      --admin-bg3: var(--bg3, #1b4656);
      --admin-border: var(--border, rgba(190,239,255,0.22));
      --admin-primary: var(--primary, #22D3EE);
      --admin-pdim: var(--pdim, color-mix(in srgb, var(--primary) 14%, transparent));
      --admin-btn-bg: var(--btn-bg, linear-gradient(135deg,#236060 0%,#183f51 52%,#194251 100%));
      --admin-btn-color: var(--btn-color, #f4fffd);
      --admin-btn-border: var(--btn-border, rgba(126,231,219,.48));
      --admin-btn-shadow: var(--btn-shadow, 0 8px 20px rgba(10,41,50,.24));
      --admin-btn-g-bg: var(--btn-g-bg, rgba(190,239,255,.08));
      --admin-btn-g-border: var(--btn-g-border, rgba(190,239,255,.22));
    }
    @keyframes softGlow {
      0%, 100% { box-shadow: 0 0 0 rgba(45, 212, 191, 0.06), 0 8px 18px rgba(23, 57, 69, 0.14); }
      50% { box-shadow: 0 0 0 2px rgba(45, 212, 191, 0.10), 0 12px 22px rgba(45, 212, 191, 0.12); }
    }
    body{
      background: var(--body-bg-solid, var(--admin-bg2));
      background-image: var(--body-bg-image, none);
      color: var(--portal-text);
      font-family: var(--font-sans);
      -webkit-tap-highlight-color: transparent;
    }
    .wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:18px}
    .cardx{background: linear-gradient(180deg, var(--admin-bg2) 0%, var(--admin-bg3) 100%);backdrop-filter: blur(12px);border: 1px solid var(--admin-border);border-radius: 16px;box-shadow: 0 16px 38px rgba(2, 10, 14, 0.32);overflow:hidden;max-width: 720px;width:100%;position: relative;}
    .cardx::before { content:""; position:absolute; inset:0 auto auto 0; width:100%; height:140%; background: linear-gradient(135deg, rgba(255,255,255,0.04), transparent 40%, rgba(148,163,184,0.04)); pointer-events:none; }
    /* Premium Modern Header Card with Nebular Glassmorphism & Fixed Background Image support */
    .head {
      position: relative;
      background: linear-gradient(135deg, rgba(16, 24, 40, 0.72) 0%, rgba(10, 15, 30, 0.88) 100%) !important;
      padding: 34px 24px 28px !important;
      border-bottom: 1px solid var(--admin-border) !important;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .head::before {
      content: "";
      position: absolute;
      inset: 0;
      background: 
        radial-gradient(circle at 15% 15%, rgba(91, 108, 255, 0.16) 0%, transparent 45%),
        radial-gradient(circle at 85% 85%, color-mix(in srgb, var(--portal-primary) 14%, transparent) 0%, transparent 45%);
      filter: blur(20px);
      z-index: 1;
      pointer-events: none;
    }
    .head > * {
      position: relative;
      z-index: 2;
    }
    .brand-logo {
      height: 48px;
      width: auto;
      max-width: 240px;
      object-fit: contain;
      display: block;
      margin: 0 auto 16px;
      filter: drop-shadow(0 4px 12px rgba(91, 108, 255, 0.25));
    }
    .brand-desc {
      font-size: 13.5px !important;
      color: rgba(255, 255, 255, 0.75) !important;
      font-weight: 500 !important;
      letter-spacing: 0.015em;
    }
    .hero-steps {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 12px;
      margin-top: 22px;
    }
    .hero-step {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.05);
      color: #ffffff;
      font-size: 12.5px;
      font-weight: 600;
      line-height: 1.2;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
      transition: all 0.25s ease;
    }
    .hero-step:hover {
      background: var(--pdim);
      border-color: color-mix(in srgb, var(--portal-primary) 25%, transparent);
      transform: translateY(-1px);
    }
    .hero-step .hs-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--portal-primary) 0%, var(--portal-primary-strong) 100%);
      color: #ffffff;
      font-size: 11px;
      font-weight: 800;
      flex: 0 0 auto;
      box-shadow: 0 0 10px color-mix(in srgb, var(--portal-primary) 40%, transparent);
    }
    .hero-step .hs-icon {
      color: var(--portal-primary-strong);
      font-size: 15px;
    }
    .hero-step-arrow {
      display: inline-flex;
      align-items: center;
      color: color-mix(in srgb, var(--portal-primary) 45%, transparent);
      font-size: 15px;
      animation: pulseArrow 2s infinite ease-in-out;
    }
    @keyframes pulseArrow {
      0%, 100% { transform: translateX(0); opacity: 0.5; }
      50% { transform: translateX(3px); opacity: 1; }
    }
    @media (max-width: 576px) {
      .head { padding: 26px 16px 20px !important; }
      .brand-logo { height: 40px; margin-bottom: 12px; }
      .brand-desc { font-size: 12px !important; line-height: 1.6 !important; }
      .hero-steps { gap: 8px; margin-top: 16px; }
      .hero-step { padding: 6px 12px; font-size: 11px; gap: 6px; border-radius: 10px; }
      .hero-step .hs-num { width: 18px; height: 18px; font-size: 9.5px; }
      .hero-step .hs-icon { font-size: 13px; }
      .hero-step-arrow { display: none; }
    }
      box-shadow: 0 4px 14px rgba(45,212,191,.35);
    }
    .order-step.is-active .order-step-dot{
      border-color: var(--portal-primary);
      color: var(--portal-primary);
      box-shadow: 0 0 0 4px rgba(45,212,191,.14);
    }
    .order-step-text{font-size:10.5px;text-align:center;color:var(--portal-muted);font-weight:600;letter-spacing:.2px}
    .order-step.is-done .order-step-text,.order-step.is-active .order-step-text{color:var(--portal-text)}
    .order-step-line{flex:1 1 auto;height:2px;background:var(--portal-line);margin:0 -4px;margin-bottom:16px;transition: background .3s ease}
    .order-step-line.is-done{background: linear-gradient(90deg, var(--portal-primary), var(--portal-primary-strong))}

    .order-detail-row{display:flex;flex-wrap:wrap;gap:10px 20px;margin-top:16px;padding-top:14px;border-top:1px solid var(--portal-line)}
    .order-detail-item{display:flex;flex-direction:column;gap:2px}
    .order-detail-k{font-size:10.5px;text-transform:uppercase;letter-spacing:.6px;color:var(--portal-muted);font-weight:700}
    .order-detail-v{font-size:13.5px;color:var(--portal-text);font-weight:700}

    .order-result{border-radius:12px;padding:14px 16px;border:1px solid var(--portal-line)}
    .order-result-title{font-family:var(--font-display);font-weight:700;font-size:14px;color:var(--portal-text)}
    .order-result-success{background: rgba(45,212,191,.07);border-color: rgba(45,212,191,.25)}
    .order-result-info{background: rgba(34,167,240,.07);border-color: rgba(34,167,240,.22)}
    .order-result-codes{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px}
    .order-code-box{
      flex:1 1 140px;
      background: rgba(0,0,0,0.18);
      border:1px dashed var(--portal-line);
      border-radius:10px;
      padding:8px 12px;
      display:flex;flex-direction:column;gap:2px;
    }
    .order-code-k{font-size:10px;text-transform:uppercase;letter-spacing:.6px;color:var(--portal-muted);font-weight:700}
    .order-code-v{font-family:var(--font-display);font-size:15px;font-weight:700;color:var(--portal-accent);letter-spacing:.5px;word-break:break-all}
    .order-code-box-single{flex:1 1 100%;align-items:center;text-align:center;padding:14px 12px}
    .order-code-box-single .order-code-v{font-size:22px;letter-spacing:2px}
    .order-progress-bar{height:5px;border-radius:999px;background:rgba(255,255,255,.08);overflow:hidden}
    .order-progress-fill{height:100%;width:40%;border-radius:999px;background:linear-gradient(90deg, var(--portal-primary), var(--portal-primary-strong));animation:progressSlide 1.6s ease-in-out infinite}
    @keyframes progressSlide{0%{transform:translateX(-100%)}50%{transform:translateX(60%)}100%{transform:translateX(250%)}}

    /* Voucher card artwork and layout: /css/voucher-cards.css */

    /* Confirmation Dialog Modal styles */
    .c-modal-overlay{
      position:fixed;
      inset:0;
      background:rgba(6, 14, 18, .82);
      backdrop-filter:blur(8px);
      z-index:9999;
      display:flex;
      align-items:center;
      justify-content:center;
      opacity:0;
      pointer-events:none;
      transition:opacity .25s ease;
    }
    .c-modal-overlay.active{
      opacity:1;
      pointer-events:auto;
    }
    .c-modal{
      background:var(--admin-bg2);
      border:1px solid var(--admin-border);
      border-radius:16px;
      padding:24px;
      max-width:480px;
      width:90%;
      box-shadow:0 24px 48px rgba(2, 10, 14, .5);
      transform:scale(0.95);
      transition:transform .25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .c-modal-overlay.active .c-modal{
      transform:scale(1);
    }
    .c-modal-title{
      font-size:18px;
      font-weight:800;
      font-family: var(--font-display);
      color:#fff;
      margin-bottom:8px;
      display:flex;
      align-items:center;
      gap:10px;
    }
    .c-modal-body{
      font-size:14px;
      color:var(--portal-muted);
      line-height:1.5;
      margin-bottom:20px;
    }
    .c-modal-detail{
      background:var(--admin-bg3);
      border:1px solid var(--admin-border);
      border-radius:10px;
      padding:12px 16px;
      margin-top:10px;
    }
    .c-modal-actions{
      display:flex;
      gap:10px;
      justify-content:flex-end;
    }
    /* Action buttons â€” aligned with landing page CTA tokens (--btn-bg/--btn-color) */
    .btn-pay{
      background: var(--btn-bg) !important;
      border: 1px solid var(--btn-border) !important;
      color: var(--btn-color) !important;
      font-weight: 800;
      box-shadow: var(--btn-shadow);
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:5px;
      min-height:44px;
      text-shadow: 0 1px 2px rgba(0,0,0,.15);
      transition: background .18s ease, border-color .18s ease, color .18s ease, filter .18s ease, box-shadow .18s ease;
    }
    .btn-pay:hover{
      background: var(--btn-bg-hover) !important;
      border-color: var(--btn-border-hover) !important;
      color: var(--btn-color-hover) !important;
      filter: brightness(1.05);
    }
    .btn-pay:disabled{opacity:.6;pointer-events:none}
    .btn-cancel{
      background: var(--btn-g-bg, rgba(190,239,255,.08)) !important;
      border: 1px solid var(--btn-g-border, rgba(190,239,255,.22)) !important;
      color: var(--portal-text, #edf7f5) !important;
      font-weight: 700;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:5px;
      min-height:44px;
      text-shadow: 0 1px 1px rgba(0,0,0,.18);
      transition: background .18s ease, border-color .18s ease, color .18s ease;
    }
    .btn-cancel:hover{
      background: color-mix(in srgb, var(--portal-primary) 12%, transparent) !important;
      border-color: color-mix(in srgb, var(--portal-primary) 45%, transparent) !important;
      color: #ffffff !important;
    }
    .btnx{
      background: var(--btn-bg) !important;
      border: 1px solid var(--btn-border) !important;
      color: var(--btn-color) !important;
      font-weight: 700;
      box-shadow: var(--btn-shadow);
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:6px;
      min-height:46px;
      text-shadow: 0 1px 2px rgba(0,0,0,.15);
      transition: background .18s ease, border-color .18s ease, color .18s ease, filter .18s ease;
    }
    .btnx:hover{
      background: var(--btn-bg-hover) !important;
      border-color: var(--btn-border-hover) !important;
      color: var(--btn-color-hover) !important;
      filter: brightness(1.05);
    }
    .c-modal-section-label{
      display:flex;
      align-items:center;
      gap:6px;
      font-size:11.5px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.4px;
      color:var(--admin-primary);
      margin-bottom:8px;
    }
    .c-modal-section-label i{font-size:13px}
    .cmpk-card{
      position:relative;
      border-radius:14px;
      padding:16px 18px;
      margin-bottom:16px;
      overflow:hidden;
      background-image: radial-gradient(circle at 8% 0%, color-mix(in srgb, var(--admin-primary) 55%, transparent) 0%, transparent 45%), radial-gradient(circle at 100% 100%, color-mix(in srgb, var(--admin-primary) 40%, transparent) 0%, transparent 55%), linear-gradient(135deg, var(--admin-bg2, #173740) 0%, var(--admin-bg2, #183f51) 52%, var(--admin-bg2, #194251) 100%);
      border:1px solid var(--admin-border);
      box-shadow:0 8px 24px rgba(2,44,99,.18);
    }
    .cmpk-ribbon{
      display:inline-flex;
      align-items:center;
      gap:5px;
      padding:4px 11px;
      border-radius:999px;
      background: linear-gradient(90deg, var(--vc-turquoise, #2dd4bf), var(--vc-electric, #22a7f0));
      color:#04211f;
      font-size:10px;
      font-weight:900;
      letter-spacing:.03em;
      text-transform:uppercase;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.18);
    }
    .cmpk-name{font-weight:800;color:#fff;font-size:15px;margin-top:10px;line-height:1.3;word-break:break-word}
    .cmpk-offer{display:flex;align-items:baseline;gap:12px;margin-top:8px;flex-wrap:wrap}
    .cmpk-price{display:flex;align-items:baseline;font-weight:900;font-size:24px;color:#fff;letter-spacing:-.02em;text-shadow:0 2px 6px rgba(0,0,0,.18)}
    .cmpk-currency{font-size:12px;font-weight:700;margin-right:5px;opacity:.9}
    .cmpk-divider{width:2px;height:22px;background:rgba(255,255,255,.14);transform:skew(-15deg)}
    .cmpk-validity{display:flex;align-items:center;gap:5px;font-size:12.5px;font-weight:700;color:rgba(255,255,255,.92)}
    .cmpk-signature{
      position:absolute;
      top:16px;
      right:18px;
      transform:rotate(-6deg);
      color:rgba(255,255,255,.65);
      font-family:'Brush Script MT','Segoe Script',cursive;
      font-size:15px;
      font-style:italic;
      line-height:.95;
      text-align:center;
      opacity:.85;
    }
    .pm-grid-modal{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:2px}
    .pm-item-modal{min-height:68px;display:flex;align-items:center;gap:10px;padding:11px 12px;border-radius:12px;background:color-mix(in srgb,var(--portal-panel-strong) 90%,transparent);border:1px solid var(--portal-line);cursor:pointer;transition:border-color .18s ease,background .18s ease,box-shadow .18s ease;position:relative}
    .pm-item-modal:hover{border-color:var(--portal-primary);background:color-mix(in srgb,var(--soft-primary) 70%,var(--portal-panel-strong))}
    .pm-radio-modal:checked + .pm-item-modal{background:color-mix(in srgb,var(--soft-primary) 82%,var(--portal-panel-strong));border-color:var(--portal-primary);box-shadow:0 0 0 2px color-mix(in srgb,var(--portal-primary) 18%,transparent)}
    .pm-radio-modal:checked + .pm-item-modal::after{content:'\F272';font-family:'bootstrap-icons';position:absolute;top:7px;right:7px;width:17px;height:17px;background:var(--portal-primary);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:900;color:var(--portal-bg)}
    .pm-item-modal .pm-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:16px;flex:0 0 auto;overflow:hidden;background:var(--soft-primary)!important;border:1px solid color-mix(in srgb,var(--portal-primary) 28%,transparent);color:var(--portal-primary)!important}
    .pm-item-modal .pm-icon img{width:100%;height:100%;object-fit:contain;padding:3px;background:rgba(255,255,255,.98);border-radius:8px}
    .pm-item-modal .pm-label{font-size:12px;font-weight:700;color:var(--portal-text);line-height:1.3;word-break:break-word;padding-right:14px}
    @media(max-width:520px){.pm-grid-modal{grid-template-columns:1fr}}
    
    .payment-methods-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:14px;margin-top:12px}
    @media (max-width: 768px){.payment-methods-grid{grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px}}
    @media (max-width: 576px){.payment-methods-grid{grid-template-columns:repeat(2,1fr);gap:10px}}
    .pm-radio{position:absolute;opacity:0;pointer-events:none}
    .pay-method-item{display:flex;align-items:center;gap:12px;padding:14px 12px;background: rgba(15,23,42,.62);border: 2px solid rgba(148,163,184,.18);border-radius: 14px;cursor:pointer;transition: all .25s cubic-bezier(0.4, 0, 0.2, 1);flex-direction:column;text-align:center;position:relative;overflow:hidden}
    .pay-method-item::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background: linear-gradient(135deg, rgba(25,211,197,.06) 0%, rgba(34,167,240,.06) 100%);opacity:0;transition: opacity .25s ease}
    .pay-method-item:hover{background: rgba(15,23,42,.8);border-color: rgba(25,211,197,.45);transform: translateY(-2px);box-shadow: 0 12px 35px rgba(0,0,0,.4), 0 0 0 1px rgba(25,211,197,.1)}
    .pay-method-item:hover::before{opacity:1}
    .pm-radio:checked + .pay-method-item{background: rgba(25,211,197,.12);border-color: rgba(25,211,197,.8);box-shadow: 0 8px 25px rgba(25,211,197,.18), 0 0 0 1px rgba(25,211,197,.3);transform: translateY(-1px)}
    .pm-radio:checked + .pay-method-item::after{content:'\F272';font-family:'bootstrap-icons';position:absolute;top:8px;right:8px;width:20px;height:20px;background: linear-gradient(135deg, #19d3c5, #22a7f0);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;color:#fff;box-shadow: 0 4px 12px rgba(25,211,197,.4)}
    .p-icon{width:48px;height:48px;background: rgba(30,41,59,.95);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;color:var(--portal-primary);box-shadow: 0 8px 20px rgba(0,0,0,.35);overflow:hidden;flex:0 0 auto;margin:0 auto 8px;position:relative;z-index:1}
    .p-logo{width:100%;height:100%;object-fit:contain;padding:8px;background: rgba(255,255,255,.98)}
    .p-badge{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800}
    .pb-dana{background: linear-gradient(135deg, #3b82f6, #0ea5e9);color:#fff}
    .pb-ovo{background: linear-gradient(135deg, #a855f7, #6366f1);color:#fff}
    .pb-shopeepay{background: linear-gradient(135deg, #f97316, #f43f5e);color:#fff}
    .pb-linkaja{background: linear-gradient(135deg, #ef4444, #f43f5e);color:#fff}
    .pb-gopay{background: linear-gradient(135deg, #22c55e, #10b981);color:#fff}
    .pb-bank{background: linear-gradient(135deg, #1e293b, #334155);color:#e2e8f0}
    .pb-qris{background: linear-gradient(135deg, var(--portal-primary), var(--portal-primary-strong));color:#fff}
    .p-info{display:flex;flex-direction:column;min-width:0;gap:4px;width:100%;position:relative;z-index:1}
    .p-name{font-size:13px;font-weight:700;color:#f8fafc;line-height:1.3;word-break:break-word}
    .p-sub{font-size:10px;color: rgba(148,163,184,.95);display:flex;flex-wrap:wrap;gap:4px;justify-content:center;margin-top:2px}
    .p-chip{display:inline-flex;align-items:center;padding:3px 7px;border-radius:999px;border:1px solid color-mix(in srgb,var(--portal-primary) 30%,transparent);background: var(--pdim, rgba(99,102,241,.12));color: rgba(226,232,240,.95);font-size:9px;font-weight:700;line-height:1.2;white-space:nowrap}
    @media (min-width: 769px){.pay-method-item{flex-direction:row;text-align:left;gap:14px;padding:14px 16px}.p-icon{margin:0 0 0 0}.p-info{align-items:flex-start}.p-sub{justify-content:flex-start}}
    @media (max-width: 576px){.pay-method-item{padding:12px 10px;gap:10px}.p-icon{width:42px;height:42px;font-size:20px;margin-bottom:6px}.p-name{font-size:12px}.p-sub{font-size:9px}.p-chip{padding:2px 6px;font-size:8px}}
    @media (max-width: 480px){
      .wrap{padding:10px}
      .head{padding:20px 16px}
      .head img{height:36px!important}
      .body{padding:16px 14px}
      .c-modal{padding:18px;width:94%;max-width:420px}
      .c-modal-title{font-size:16px}
      .c-modal-body{font-size:13px}
      .payment-methods-grid{gap:8px!important}
      .c-modal-actions{flex-wrap:wrap;gap:8px}
      .c-modal-actions .btn{flex:1 1 auto;padding:10px 14px!important}
    }
    .hero-steps{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:16px}
    .hero-step{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;background:var(--admin-btn-g-bg);border:1px solid var(--admin-btn-g-border);color:var(--portal-text);font-size:12px;font-weight:600;line-height:1.2}
    .hero-step .hs-num{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:50%;background:var(--admin-btn-bg);color:var(--admin-btn-color);font-size:11px;font-weight:800;flex:0 0 auto}
    .hero-step .hs-icon{color:var(--admin-primary);font-size:14px}
    .hero-step-arrow{display:inline-flex;align-items:center;color:rgba(190,239,255,.4);font-size:14px}
    @media (max-width: 576px){
      .hero-steps{gap:6px}
      .hero-step{padding:6px 10px;font-size:11px;gap:6px}
      .hero-step .hs-num{width:18px;height:18px;font-size:10px}
      .hero-step-arrow{display:none}
    }
  </style>
  <link rel="stylesheet" href="/css/voucher-cards.css?v=1">
</head>
<body>
  <div class="wrap">
    <div class="cardx">
      <div class="head">
        <img class="brand-logo" src="/img/logo.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" alt="ZenRadius" onerror="this.style.display='none'">
        <p class="muted small mb-0 mx-auto brand-desc" style="max-width:480px;line-height:1.7;text-align:center;">Dapatkan voucher internet harian dan mingguan secara instan â€” pilih paket, bayar, dan langsung terhubung.</p>
        <div class="hero-steps">
          <span class="hero-step"><span class="hs-num">1</span><i class="bi bi-ui-checks-grid hs-icon"></i> Pilih Paket</span>
          <span class="hero-step-arrow"><i class="bi bi-chevron-right"></i></span>
          <span class="hero-step"><span class="hs-num">2</span><i class="bi bi-qr-code-scan hs-icon"></i> Bayar via QRIS / VA / M-Banking</span>
          <span class="hero-step-arrow"><i class="bi bi-chevron-right"></i></span>
          <span class="hero-step"><span class="hs-num">3</span><i class="bi bi-lightning-charge-fill hs-icon"></i> Kode Voucher Aktif Instan</span>
        </div>
      </div>
      <div class="body">
        <% if (error) { %>
          <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
          </div>
        <% } %>
        <% if (info) { %>
          <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i><%= info %>
          </div>
        <% } %>

        <% if (order) { %>
          <% const st = String(order.status || 'pending'); %>
          <div class="order-status-card mb-3">
            <div class="order-status-head">
              <div class="order-status-id">
                <span class="order-status-label">Status Pesanan</span>
                <span class="order-status-meta">Order #<%= order.id %> &middot; WA <%= order.buyer_phone %></span>
              </div>
              <% if (st === 'fulfilled') { %>
                <span class="pill pill-p"><i class="bi bi-check-circle-fill"></i> Selesai</span>
              <% } else if (st === 'paid') { %>
                <span class="pill pill-u"><i class="bi bi-arrow-repeat spin-slow"></i> Diproses</span>
              <% } else { %>
                <span class="pill pill-u"><i class="bi bi-clock-history"></i> Menunggu Pembayaran</span>
              <% } %>
            </div>

            <!-- Progress Stepper -->
            <div class="order-steps">
              <div class="order-step <%= 'is-done' %>">
                <div class="order-step-dot"><i class="bi bi-check-lg"></i></div>
                <div class="order-step-text">Pesanan Dibuat</div>
              </div>
              <div class="order-step-line <%= (st === 'paid' || st === 'fulfilled') ? 'is-done' : '' %>"></div>
              <div class="order-step <%= (st === 'paid' || st === 'fulfilled') ? 'is-done' : (st === 'pending' ? 'is-active' : '') %>">
                <div class="order-step-dot"><i class="bi <%= (st === 'paid' || st === 'fulfilled') ? 'bi-check-lg' : 'bi-credit-card' %>"></i></div>
                <div class="order-step-text">Pembayaran</div>
              </div>
              <div class="order-step-line <%= st === 'fulfilled' ? 'is-done' : '' %>"></div>
              <div class="order-step <%= st === 'fulfilled' ? 'is-done' : (st === 'paid' ? 'is-active' : '') %>">
                <div class="order-step-dot"><i class="bi <%= st === 'fulfilled' ? 'bi-check-lg' : 'bi-ticket-perforated' %>"></i></div>
                <div class="order-step-text">Voucher Siap</div>
              </div>
            </div>

            <div class="order-detail-row">
              <div class="order-detail-item">
                <span class="order-detail-k">Paket</span>
                <span class="order-detail-v"><%= order.profile_name %></span>
              </div>
              <div class="order-detail-item">
                <span class="order-detail-k">Durasi</span>
                <span class="order-detail-v"><%= order.validity || '-' %></span>
              </div>
              <div class="order-detail-item">
                <span class="order-detail-k">Harga</span>
                <span class="order-detail-v">Rp <%= Number(order.price || 0).toLocaleString('id-ID') %></span>
              </div>
            </div>

            <% if (String(order.status) === 'fulfilled' && order.voucher_code) { %>
              <div class="order-result order-result-success mt-3">
                <div class="order-result-title"><i class="bi bi-patch-check-fill me-2"></i>Voucher Siap Digunakan</div>
                <div class="order-result-codes">
                  <div class="order-code-box order-code-box-single">
                    <span class="order-code-k">Kode Voucher (Username &amp; Password)</span>
                    <span class="order-code-v"><%= order.voucher_code %></span>
                  </div>
                </div>
                <% if (Number(order.wa_sent || 0) === 1) { %>
                  <div class="muted small mt-2"><i class="bi bi-whatsapp me-1"></i>Voucher berhasil dikirim ke WhatsApp Anda.</div>
                <% } else if (order.wa_error) { %>
                  <div class="text-warning small mt-2"><i class="bi bi-exclamation-triangle me-1"></i>Pengiriman WhatsApp gagal, namun voucher tetap aktif dan tersimpan.</div>
                  <div class="muted small">Silakan catat/screenshot kode voucher di atas sebagai cadangan.</div>
                <% } else { %>
                  <div class="muted small mt-2">Simpan halaman ini sebagai cadangan jika notifikasi WhatsApp belum diterima.</div>
                <% } %>
              </div>
            <% } else if (String(order.status) === 'paid') { %>
              <div class="order-result order-result-info mt-3">
                <div class="order-result-title"><i class="bi bi-stars me-2"></i>Pembayaran Berhasil Dikonfirmasi</div>
                <div class="muted small">Voucher Anda sedang disiapkan secara otomatis dan akan tersedia sesaat lagi. Halaman ini akan diperbarui secara otomatis.</div>
                <div class="order-progress-bar mt-2"><div class="order-progress-fill"></div></div>
              </div>
            <% } else if (String(order.status) === 'pending' && (String(order.payment_gateway || '') === 'qris_static' || order.qris_amount_unique)) { %>
              <% if (orderToken) { %>
                <a class="btn btn-primary btnx mt-3 w-100" href="/pelanggan/voucher/qris/<%= order.id %>?t=<%= encodeURIComponent(orderToken) %>">
                  <i class="bi bi-qr-code-scan me-1"></i> Buka QRIS Statis
                </a>
              <% } else { %>
                <div class="alert alert-warning mt-3 mb-0">Link QRIS tidak tersedia.</div>
              <% } %>
            <% } else if (String(order.status) === 'pending' && (order.payment_link || order.payment_payload)) { %>
              <% if (orderToken) { %>
                <a class="btn btn-primary btnx mt-3 w-100" href="/pelanggan/voucher/payment/<%= order.id %>?t=<%= encodeURIComponent(orderToken) %>">
                  <i class="bi bi-credit-card me-1"></i> Lanjutkan Pembayaran
                </a>
              <% } else { %>
                <div class="alert alert-warning mt-3 mb-0">Instruksi pembayaran tidak tersedia.</div>
              <% } %>
            <% } %>
          </div>
          <hr style="border-color: rgba(148,163,184,.18)">
        <% } %>

        <form method="POST" action="/pelanggan/public/voucher/create-payment" class="d-grid gap-2" id="voucherForm">
          <!-- Hidden TOS state injector to bypass backend checks cleanly -->
          <input type="hidden" name="tos" value="1">
          <!-- Anti-bot: honeypot field (must stay empty) + form render timestamp (rejects instant/scripted submits) -->
          <input type="text" name="website" id="hp_website" autocomplete="off" tabindex="-1" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" aria-hidden="true">
          <input type="hidden" name="form_ts" value="<%= Date.now() %>">

          <div class="row g-2">
            <div class="col-12">
              <div class="filter-title mb-3" style="display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;color:var(--portal-muted)">
                <i class="bi bi-ticket-perforated" style="color:var(--portal-primary);font-size:13px"></i>
                <span>Pilih Paket Internet Terbaik</span>
                <div style="flex:1;height:1px;background:linear-gradient(90deg,var(--portal-line),transparent);margin-left:8px"></div>
              </div>
              <% if (!profiles || profiles.length === 0) { %>
                <div class="muted small mt-1">Belum ada profile voucher (metadata Mikhmon) di MikroTik.</div>
              <% } else { %>
                <div class="voucher-grid mt-1">
                  <%
                    function formatCardValidity(value) {
                      const raw = String(value || '-').trim();
                      const match = raw.match(/^(\d+)\s*([wdhms])$/i);
                      const units = { w: 'Minggu', d: 'Hari', h: 'Jam', m: 'Menit', s: 'Detik' };
                      return match ? `${Number(match[1])} ${units[match[2].toLowerCase()]}` : raw;
                    }
                    (profiles || []).forEach((p, idx) => {
                      const price = Number(p.price || 0);
                      const priceText = price.toLocaleString('id-ID');
                      const priceClass = priceText.length > 9 ? 'v-price-extra-long' : (priceText.length > 6 ? 'v-price-long' : '');
                      const validityText = formatCardValidity(p.validity);
                  %>
                    <input
                      class="voucher-radio"
                      type="radio"
                      name="profile_name"
                      id="vprofile_<%= idx %>"
                      value="<%= p.name %>"
                      data-price="<%= price %>"
                      data-validity="<%= validityText %>"
                      aria-label="<%= p.name %>, Rp <%= priceText %>, <%= validityText %>"
                      aria-describedby="step1Hint"
                      <%= idx === 0 ? 'required' : '' %>
                    >
                    <label class="voucher-card" for="vprofile_<%= idx %>">
                      <span class="v-selected" aria-hidden="true"><i class="bi bi-check-circle-fill"></i> Dipilih</span>
                      <div class="v-brand" aria-hidden="true">
                        <div class="v-brand-logo-container">
                          <img src="/img/logo.png?v=<%= typeof brandVersion !== 'undefined' ? brandVersion : 'zenradius' %>" alt="Logo" class="v-brand-real-logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                          <div class="v-brand-fallback-group" style="display:none">
                            <span class="v-brand-name"><%= settings.company_header || 'WiFi' %></span>
                            <span class="v-brand-sub">HOTSPOT</span>
                          </div>
                        </div>
                      </div>
                      <span class="v-tagline">Internet Cepat, Hidup Lebih Mudah</span>
                      <span class="v-ribbon">VOUCHER INTERNET</span>
                      <span class="v-offer">
                        <span class="voucher-price <%= priceClass %>"><span class="v-currency">Rp</span><%= priceText %></span>
                        <span class="v-divider" aria-hidden="true"></span>
                        <span class="v-validity <%= validityText.length > 9 ? 'v-validity-long' : '' %>"><%= validityText %></span>
                      </span>
                      <span class="v-package" title="<%= p.name %>"><%= p.name %></span>
                      <span class="v-benefits">
                        <span class="v-benefit">
                          <span class="v-benefit-icon" aria-hidden="true"><i class="bi bi-lightning-charge-fill"></i></span>
                          <span>Akses<br>Cepat</span>
                        </span>
                        <span class="v-benefit">
                          <span class="v-benefit-icon" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
                          <span>Aman<br>&amp; Stabil</span>
                        </span>
                        <span class="v-benefit">
                          <span class="v-benefit-icon" aria-hidden="true"><i class="bi bi-phone"></i></span>
                          <span>Bisa di Semua<br>Perangkat</span>
                        </span>
                      </span>
                      <span class="v-signature" aria-hidden="true">Stay<br>Connected</span>
                    </label>
                  <% }) %>
                </div>
                <div class="p-3 mt-3 rounded-3" style="background:rgba(45,212,191,0.04);border:1px solid var(--portal-line);display:flex;align-items:start;gap:10px;" id="step1Hint">
                  <i class="bi bi-info-circle" style="color:var(--portal-primary);font-size:15px;margin-top:2px"></i>
                  <span style="font-size:12.5px;line-height:1.5;color:rgba(168,190,194,0.95)">Pilih salah satu paket voucher di atas untuk melanjutkan ke pengisian nomor WhatsApp dan proses pembayaran. Perlu diperhatikan, <strong style="color:#fff">satu kode voucher hanya berlaku untuk satu perangkat</strong> â€” kode yang telah diaktivasi pada perangkat pertama tidak dapat digunakan kembali pada perangkat lain.</span>
                </div>
              <% } %>
            </div>
          </div>

          <a class="d-inline-flex align-items-center justify-content-center gap-1 text-decoration-none small mt-2 mx-auto" href="/" style="color:#a5f4ed;font-weight:700;">
            <i class="bi bi-arrow-left"></i> Kembali Halaman
          </a>

          <!-- Confirmation Popup Modal overlay inside the FORM wrapper so inputs submit perfectly -->
          <div class="c-modal-overlay" id="confirmModal">
            <div class="c-modal">
              <div class="c-modal-title">
                <i class="bi bi-wallet2" style="color:#2dd4bf"></i>
                <span>Selesaikan Pembayaran Voucher</span>
              </div>
              <div class="c-modal-body text-start">
                <div style="font-size:13.5px;line-height:1.5;margin-bottom:12px">Silakan masukkan nomor WhatsApp pembeli dan pilih metode pembayaran untuk melanjutkan pesanan Anda:</div>
                
                <!-- Paket selected display -->
                <div class="cmpk-card">
                  <span class="cmpk-signature" aria-hidden="true">Stay<br>Connected</span>
                  <span class="cmpk-ribbon"><i class="bi bi-wifi"></i> Voucher Internet</span>
                  <div class="cmpk-name" id="popName">-</div>
                  <div class="cmpk-offer">
                    <span class="cmpk-price"><span class="cmpk-currency">Rp</span><span id="popPrice">-</span></span>
                    <span class="cmpk-divider" aria-hidden="true"></span>
                    <span class="cmpk-validity"><i class="bi bi-clock-history"></i> <span id="popValidity">-</span></span>
                  </div>
                </div>

                <!-- Input WhatsApp directly inside popup -->
                <div class="mb-3">
                  <div class="c-modal-section-label"><i class="bi bi-whatsapp"></i> Nomor WhatsApp Pembeli</div>
                  <div style="position:relative; width: 100%;">
                    <i class="bi bi-whatsapp" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#2dd4bf;font-size:15px;pointer-events:none;z-index:4;"></i>
                    <input class="form-control" name="buyer_phone" id="buyerPhone" inputmode="numeric" placeholder="Contoh: 081234567890" style="padding-left: 38px; height: 46px;" required>
                  </div>
                  <div class="muted small mt-1" style="font-size:11px">Voucher terkirim instan via WhatsApp.</div>
                </div>

                <!-- Payment channels inside popup -->
                <div class="mb-2">
                  <div class="c-modal-section-label"><i class="bi bi-credit-card-2-front"></i> Pilih Metode Pembayaran</div>
                  <% const hasStaticQris = (String(settings.qris_static_qr_url || '').trim() || String(settings.qris_static_payload || '').trim()) && (settings.qris_static_enabled !== false && settings.qris_static_enabled !== 'false' && settings.qris_static_enabled !== 0 && settings.qris_static_enabled !== '0'); %>
                  <% if (!hasStaticQris && (!paymentChannels || paymentChannels.length === 0)) { %>
                    <input type="hidden" name="method" value="QRIS">
                    <div class="pm-item-modal" style="cursor:default;grid-column:1/-1">
                      <div class="pm-icon"><i class="bi bi-qr-code-scan"></i></div>
                      <span class="pm-label">QRIS Otomatis</span>
                    </div>
                  <% } else { %>
                    <div class="pm-grid-modal">
                      <% if (hasStaticQris) { %>
                        <input
                          class="pm-radio-modal"
                          type="radio"
                          name="method"
                          id="pm_static"
                          value="QRIS_STATIC"
                          checked
                          style="position:absolute;opacity:0;pointer-events:none"
                        >
                        <label class="pm-item-modal" for="pm_static">
                          <div class="pm-icon"><i class="bi bi-qr-code-scan"></i></div>
                          <span class="pm-label">QRIS Statis</span>
                        </label>
                      <% } %>
                      <% paymentChannels.forEach((ch, idx) => {
                        const code = String(ch.code || '').toUpperCase();
                        const name = ch.name || code;
                        const group = String(ch.group || '').toLowerCase();
                        const isQris = code === 'QRIS' || code.includes('QRIS');
                        const isVa = code.includes('VA') || group.includes('virtual');
                        const displayName = isQris ? 'QRIS Otomatis' : (isVa ? String(name).replace(/Virtual Account/i, 'VA') : name);
                        let icon = 'bi-wallet2';

                        if (isQris) {
                          icon = 'bi-qr-code-scan';
                        } else if (code.includes('DANA')) {
                          icon = 'bi-wallet2';
                        } else if (code.includes('OVO')) {
                          icon = 'bi-wallet2';
                        } else if (code.includes('SHOPEE')) {
                          icon = 'bi-wallet2';
                        } else if (code.includes('LINKAJA')) {
                          icon = 'bi-wallet2';
                        } else if (code.includes('GOPAY')) {
                          icon = 'bi-wallet2';
                        } else if (isVa) {
                          icon = 'bi-bank';
                        } else if (code.includes('SNAP') || code.includes('XENDIT') || code.includes('DUITKU')) {
                          icon = 'bi-credit-card';
                        }
                      %>
                        <input
                          class="pm-radio-modal"
                          type="radio"
                          name="method"
                          id="pm_<%= idx %>"
                          value="<%= code %>"
                          <%= (!hasStaticQris && idx === 0) ? 'checked' : '' %>
                          style="position:absolute;opacity:0;pointer-events:none"
                        >
                        <label class="pm-item-modal" for="pm_<%= idx %>">
                          <div class="pm-icon">
                            <% if (ch.icon_url) { %>
                              <img src="<%= ch.icon_url %>" alt="<%= name %>">
                            <% } else if (isVa && typeof bankLogoFor === 'function' && bankLogoFor(code)) { %>
                              <i class="bi bi-bank" style="color:<%= bankLogoFor(code) %>"></i>
                            <% } else { %>
                              <i class="<%= icon %>"></i>
                            <% } %>
                          </div>
                          <span class="pm-label"><%= displayName %></span>
                        </label>
                      <% }) %>
                    </div>
                  <% } %>
                </div>

              </div>
              <div class="c-modal-actions" style="margin-top:10px">
                <button class="btn btn-cancel" type="button" style="border-radius:10px;padding:11px 20px;font-size:14px" onclick="cancelConfirm()"><i class="bi bi-x-lg me-1"></i>Batal</button>
                <button class="btn btn-pay" type="submit" style="border-radius:10px;padding:11px 24px;font-size:14px">
                  Bayar & Aktivasi <i class="bi bi-lightning-charge-fill ms-1"></i>
                </button>
              </div>
            </div>
          </div>
        </form>

        <footer class="site-footer" style="background:var(--portal-bg, #173945);border-top:1px solid rgba(190,239,255,0.32);padding:26px 0 18px;margin-top:32px;margin-left:-20px;margin-right:-20px;margin-bottom:-20px;border-radius:0 0 16px 16px">
          <div class="container text-center">
            <div class="footer-bottom text-center" style="font-family:var(--font-sans);font-size:0.8rem;color:rgba(237, 250, 250, 0.72);margin-top:4px;padding-top:0">
              &copy; <%= new Date().getFullYear() %> <%- footerInfo %>
            </div>
          </div>
        </footer>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const radios = Array.from(document.querySelectorAll('input.voucher-radio'));
      let activeRadio = null;
      let focusTimer = null;

      // Native radio changes support mouse, touch and keyboard without inline profile strings.
      radios.forEach(r => r.addEventListener('change', function () {
        if (!r.checked) return;
        activeRadio = r;
        document.getElementById('popName').textContent = r.value;
        document.getElementById('popValidity').textContent = r.dataset.validity || '-';
        document.getElementById('popPrice').textContent = Number(r.dataset.price || 0).toLocaleString('id-ID');
        document.getElementById('confirmModal')?.classList.add('active');
        clearTimeout(focusTimer);
        focusTimer = setTimeout(() => document.getElementById('buyerPhone')?.focus(), 220);
      }));

      window.cancelConfirm = function () {
        clearTimeout(focusTimer);
        document.getElementById('confirmModal')?.classList.remove('active');
        radios.forEach(r => { r.checked = false; });
        activeRadio?.focus({ preventScroll: true });
        activeRadio = null;
      };

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && document.getElementById('confirmModal')?.classList.contains('active')) {
          window.cancelConfirm();
        }
      });
    })();
  </script>
  <% if (order && (String(order.status) === 'paid' || String(order.status) === 'pending') && !order.voucher_code) { %>
  <script>
    setTimeout(() => {
      try { window.location.reload(); } catch (e) {}
    }, 5000);
  </script>
  <% } %>
</body>
</html>
