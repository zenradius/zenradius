<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Voucher Hotspot | <%= settings.company_header || 'ZenRadius - Pusat Layanan' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" type="image/png">
  <link rel="stylesheet" href="/css/unified.css">
  <style>
    :root {
      --portal-bg: #173945;
      --portal-panel: #173945;
      --portal-line: rgba(190, 239, 255, 0.32);
      --portal-primary: #2dd4bf;
      --portal-secondary: #14b8a6;
      --portal-text: #edf7f5;
      --portal-muted: #a8bec2;
    }
    @keyframes softGlow {
      0%, 100% { box-shadow: 0 0 0 rgba(35, 96, 96, 0.06), 0 8px 18px rgba(23, 57, 69, 0.14); }
      50% { box-shadow: 0 0 0 2px rgba(35, 96, 96, 0.08), 0 12px 22px rgba(35, 96, 96, 0.10); }
    }
    body{
      background: #173945;
      background-image: radial-gradient(circle at 8% 0%, #236060 0%, transparent 34%), radial-gradient(circle at 100% 100%, #173e4d 0%, transparent 42%), linear-gradient(135deg, #173740 0%, #183f51 52%, #194251 100%);
      color: var(--portal-text);
      font-family: 'DM Sans', sans-serif;
      -webkit-tap-highlight-color: transparent;
    }
    .wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:18px}
    .cardx{background: #173945;backdrop-filter: blur(12px);border: 1px solid rgba(190,239,255,.32);border-radius: 14px;box-shadow: 0 16px 38px rgba(15,23,42,.18);overflow:hidden;max-width: 720px;width:100%;position: relative;}
    .cardx::before { content:""; position:absolute; inset:0 auto auto 0; width:100%; height:140%; background: linear-gradient(135deg, rgba(255,255,255,0.04), transparent 40%, rgba(148,163,184,0.04)); pointer-events:none; }
    .head{background:#173945;padding:22px 20px;border-bottom:1px solid rgba(190,239,255,.22)}
    .body{padding:22px 20px}
    .form-control,.form-select{
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(190, 239, 255, 0.22);
      color: var(--portal-text);
      border-radius: 10px;
      transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }
    .form-control::placeholder{
      color: rgba(237, 250, 250, 0.38);
    }
    .form-control:focus,.form-select:focus{
      background: rgba(255, 255, 255, 0.09);
      border-color: rgba(45, 212, 191, 0.55);
      box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.14);
      color: #fff;
    }
    .muted{color: var(--portal-muted)}
    .btnx{border-radius:12px;font-weight:700;transition: transform .18s ease, box-shadow .18s ease, filter .18s ease; min-height: 46px; padding: 10px 16px; line-height: 1.2;}
    .btnx:hover{transform: translateY(-2px); filter: brightness(1.03);}
    .btn-primary{background:linear-gradient(135deg, #236060 0%, #183f51 52%, #194251 100%);border:1px solid rgba(126,231,219,.48);color:#f4fffd;box-shadow:0 8px 20px rgba(10,41,50,.24);animation:softGlow 5s ease-in-out infinite}
    .btn-primary:hover{background:linear-gradient(135deg, #2d7774 0%, #1d5264 52%, #205b68 100%)!important;border-color:rgba(166,247,235,.72)!important;color:#fff!important;filter:brightness(1.04)}
    a{color:#a5f4ed}
    .pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:700;border:1px solid rgba(148,163,184,.18)}
    /* Redesigned Cards with Dark Glassmorphism to Match Page Palette */
    .voucher-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px}
    @media (max-width: 576px){.voucher-grid{grid-template-columns:1fr;gap:14px}}
    .voucher-radio{position:absolute;opacity:0;pointer-events:none}
    
    .voucher-card{
      position:relative;
      border:1px solid rgba(190,239,255,.18);
      background:rgba(15,23,42,.62);
      backdrop-filter:blur(8px);
      border-radius:14px;
      padding:0;
      cursor:pointer;
      transition:all .25s ease-in-out;
      overflow:hidden;
      display:flex;
      flex-direction:column;
      min-height:165px;
      color:var(--portal-text);
      box-shadow:0 6px 20px rgba(0,0,0,.25);
    }
    .voucher-card::after {
      content:"";
      position:absolute;
      inset:0;
      background:radial-gradient(circle at 100% 0%, rgba(255,255,255,.05) 0%, transparent 60%);
      pointer-events:none;
    }
    .voucher-card:hover{
      transform:translateY(-5px);
      border-color:rgba(45,212,191,.45);
      background:rgba(15,23,42,.8);
      box-shadow:0 12px 28px rgba(0,0,0,.45);
    }
    .voucher-radio:checked + .voucher-card{
      border-color:#29d3c5;
      background:rgba(45,212,191,.06);
      box-shadow:0 0 0 3px rgba(41,211,197,.25), 0 12px 28px rgba(0,0,0,.4);
    }

    /* Top Layout: Brand Logo & Price */
    .v-top{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:14px 16px;
      border-bottom:1px solid rgba(190,239,255,.12);
    }
    .v-brand{
      display:flex;
      align-items:center;
    }
    .v-brand-logo{
      height:22px;
      width:auto;
      object-fit:contain;
      display:block;
    }
    .v-brand-text{
      font-size:14px;
      font-weight:900;
      color:#fff;
      letter-spacing:.2px;
    }
    .voucher-price{
      font-weight:900;
      font-size:22px;
      color:#2dd4bf;
      display:flex;
      align-items:baseline;
    }
    .voucher-price .v-currency{
      font-size:13px;
      font-weight:800;
      margin-right:2px;
      color:rgba(45,212,191,.8);
    }

    /* Middle Layout: Label, Validity and Info */
    .v-mid{
      padding:14px 16px;
      display:flex;
      flex-direction:column;
      gap:2px;
      flex-grow:1;
    }
    .v-label-main{
      font-size:10px;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:1px;
      color:rgba(190,239,255,.5);
    }
    .voucher-title{
      font-weight:800;
      font-size:18px;
      color:#fff;
      margin:2px 0 0 0;
      line-height:1.2;
    }
    .v-dur{
      font-size:11px;
      color:var(--portal-muted);
      margin-top:6px;
      display:flex;
      align-items:center;
      gap:5px;
      font-weight:600;
    }
    .v-dur i{
      color:#2dd4bf;
    }

    /* Footer: Web Domain Info banner */
    .v-foot-cs{
      background:rgba(255,255,255,.05);
      border-top:1px solid rgba(190,239,255,.08);
      color:var(--portal-muted);
      font-size:10.5px;
      font-weight:800;
      padding:8px 16px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      letter-spacing:.4px;
      text-transform:uppercase;
    }

    /* Modern Theme color palettes for selected vouchers */
    .v-theme-green .voucher-price { color:#4ade80; }
    .v-theme-green .voucher-price .v-currency { color:rgba(74,222,128,.8); }
    .v-theme-green .v-foot-cs { background:rgba(74,222,128,.04); color:#4ade80; border-top-color:rgba(74,222,128,.15); }
    .v-theme-green.voucher-card:hover, .voucher-radio:checked + .v-theme-green { border-color:rgba(74,222,128,.5); }

    .v-theme-blue .voucher-price { color:#60a5fa; }
    .v-theme-blue .voucher-price .v-currency { color:rgba(96,165,250,.8); }
    .v-theme-blue .v-foot-cs { background:rgba(96,165,250,.04); color:#60a5fa; border-top-color:rgba(96,165,250,.15); }
    .v-theme-blue.voucher-card:hover, .voucher-radio:checked + .v-theme-blue { border-color:rgba(96,165,250,.5); }

    .v-theme-orange .voucher-price { color:#f97316; }
    .v-theme-orange .voucher-price .v-currency { color:rgba(249,115,22,.8); }
    .v-theme-orange .v-foot-cs { background:rgba(249,115,22,.04); color:#f97316; border-top-color:rgba(249,115,22,.15); }
    .v-theme-orange.voucher-card:hover, .voucher-radio:checked + .v-theme-orange { border-color:rgba(249,115,22,.5); }

    .v-theme-purple .voucher-price { color:#c084fc; }
    .v-theme-purple .voucher-price .v-currency { color:rgba(192,132,252,.8); }
    .v-theme-purple .v-foot-cs { background:rgba(192,132,252,.04); color:#c084fc; border-top-color:rgba(192,132,252,.15); }
    .v-theme-purple.voucher-card:hover, .voucher-radio:checked + .v-theme-purple { border-color:rgba(192,132,252,.5); }
    
    /* Confirmation Dialog Modal styles */
    .c-modal-overlay{
      position:fixed;
      inset:0;
      background:rgba(15,23,42,.85);
      backdrop-filter:blur(8px);
      z-index:9999;
      display:flex;
      align-items:center;
      justify-content:center;
      opacity:0;
      pointer-events:none;
      transition:opacity .25s ease;
    }
    .c-modal-overlay.active{
      opacity:1;
      pointer-events:auto;
    }
    .c-modal{
      background:#173945;
      border:1px solid rgba(190,239,255,.32);
      border-radius:16px;
      padding:24px;
      max-width:420px;
      width:90%;
      box-shadow:0 24px 48px rgba(0,0,0,.5);
      transform:scale(0.95);
      transition:transform .25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .c-modal-overlay.active .c-modal{
      transform:scale(1);
    }
    .c-modal-title{
      font-size:18px;
      font-weight:800;
      color:#fff;
      margin-bottom:8px;
      display:flex;
      align-items:center;
      gap:10px;
    }
    .c-modal-body{
      font-size:14px;
      color:var(--portal-muted);
      line-height:1.5;
      margin-bottom:20px;
    }
    .c-modal-detail{
      background:rgba(255,255,255,.04);
      border:1px solid rgba(190,239,255,.12);
      border-radius:10px;
      padding:10px 14px;
      margin-top:10px;
    }
    .c-modal-actions{
      display:flex;
      gap:10px;
      justify-content:flex-end;
    }
    
    .payment-methods-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:14px;margin-top:12px}
    @media (max-width: 768px){.payment-methods-grid{grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px}}
    @media (max-width: 576px){.payment-methods-grid{grid-template-columns:repeat(2,1fr);gap:10px}}
    .pm-radio{position:absolute;opacity:0;pointer-events:none}
    .pay-method-item{display:flex;align-items:center;gap:12px;padding:14px 12px;background: rgba(15,23,42,.62);border: 2px solid rgba(148,163,184,.18);border-radius: 14px;cursor:pointer;transition: all .25s cubic-bezier(0.4, 0, 0.2, 1);flex-direction:column;text-align:center;position:relative;overflow:hidden}
    .pay-method-item::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background: linear-gradient(135deg, rgba(25,211,197,.06) 0%, rgba(34,167,240,.06) 100%);opacity:0;transition: opacity .25s ease}
    .pay-method-item:hover{background: rgba(15,23,42,.8);border-color: rgba(25,211,197,.45);transform: translateY(-2px);box-shadow: 0 12px 35px rgba(0,0,0,.4), 0 0 0 1px rgba(25,211,197,.1)}
    .pay-method-item:hover::before{opacity:1}
    .pm-radio:checked + .pay-method-item{background: rgba(25,211,197,.12);border-color: rgba(25,211,197,.8);box-shadow: 0 8px 25px rgba(25,211,197,.18), 0 0 0 1px rgba(25,211,197,.3);transform: translateY(-1px)}
    .pm-radio:checked + .pay-method-item::after{content:'?';position:absolute;top:8px;right:8px;width:20px;height:20px;background: linear-gradient(135deg, #19d3c5, #22a7f0);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:900;color:#fff;box-shadow: 0 4px 12px rgba(25,211,197,.4)}
    .p-icon{width:48px;height:48px;background: rgba(30,41,59,.95);border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;color:#6366f1;box-shadow: 0 8px 20px rgba(0,0,0,.35);overflow:hidden;flex:0 0 auto;margin:0 auto 8px;position:relative;z-index:1}
    .p-logo{width:100%;height:100%;object-fit:contain;padding:8px;background: rgba(255,255,255,.98)}
    .p-badge{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800}
    .pb-dana{background: linear-gradient(135deg, #3b82f6, #0ea5e9);color:#fff}
    .pb-ovo{background: linear-gradient(135deg, #a855f7, #6366f1);color:#fff}
    .pb-shopeepay{background: linear-gradient(135deg, #f97316, #f43f5e);color:#fff}
    .pb-linkaja{background: linear-gradient(135deg, #ef4444, #f43f5e);color:#fff}
    .pb-gopay{background: linear-gradient(135deg, #22c55e, #10b981);color:#fff}
    .pb-bank{background: linear-gradient(135deg, #1e293b, #334155);color:#e2e8f0}
    .pb-qris{background: linear-gradient(135deg, #6366f1, #8b5cf6);color:#fff}
    .p-info{display:flex;flex-direction:column;min-width:0;gap:4px;width:100%;position:relative;z-index:1}
    .p-name{font-size:13px;font-weight:700;color:#f8fafc;line-height:1.3;word-break:break-word}
    .p-sub{font-size:10px;color: rgba(148,163,184,.95);display:flex;flex-wrap:wrap;gap:4px;justify-content:center;margin-top:2px}
    .p-chip{display:inline-flex;align-items:center;padding:3px 7px;border-radius:999px;border:1px solid rgba(99,102,241,.3);background: rgba(99,102,241,.12);color: rgba(226,232,240,.95);font-size:9px;font-weight:700;line-height:1.2;white-space:nowrap}
    @media (min-width: 769px){.pay-method-item{flex-direction:row;text-align:left;gap:14px;padding:14px 16px}.p-icon{margin:0 0 0 0}.p-info{align-items:flex-start}.p-sub{justify-content:flex-start}}
    @media (max-width: 576px){.pay-method-item{padding:12px 10px;gap:10px}.p-icon{width:42px;height:42px;font-size:20px;margin-bottom:6px}.p-name{font-size:12px}.p-sub{font-size:9px}.p-chip{padding:2px 6px;font-size:8px}}
    /* Step wizard */
    .steps{display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:18px}
    .step{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:700;color:var(--portal-muted)}
    .step .num{width:26px;height:26px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;border:1px solid rgba(190,239,255,.32);font-size:12px;background:rgba(255,255,255,.04)}
    .step.active{color:#fff}
    .step.active .num{background:linear-gradient(135deg,#2dd4bf,#14b8a6);border-color:transparent;color:#0b2a30}
    .step.done .num{background:rgba(45,212,191,.18);border-color:rgba(45,212,191,.5);color:#a5f4ed}
    .step-line{width:36px;height:1px;background:rgba(190,239,255,.28)}
    .step-pane{display:none}
    .step-pane.active{display:block;animation:fadeIn .25s ease}
    @keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
    .summary{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 14px;border:1px solid rgba(45,212,191,.4);background:rgba(45,212,191,.08);border-radius:12px;margin-bottom:14px}
    .summary .lbl{font-size:11px;color:var(--portal-muted);font-weight:700;text-transform:uppercase;letter-spacing:.4px}
    .summary .val{font-weight:800}
    .btn-ghost{background:transparent;border:1px solid rgba(190,239,255,.32);color:var(--portal-text)}
    .btn-ghost:hover{background:rgba(255,255,255,.06);color:#fff}
  </style>
</head>
<body>
  <div class="wrap">
    <div class="cardx">
      <div class="head" style="text-align:center;padding-top:28px;padding-bottom:22px;">
        <img src="/img/logo.png?v=<%= typeof brandVersion !== "undefined" ? brandVersion : "zenradius" %>" alt="ZenRadius" style="height:42px;width:auto;max-width:220px;object-fit:contain;display:block;margin:0 auto 14px;" onerror="this.style.display='none'">
        <p class="muted small mb-0 mx-auto" style="max-width:480px;line-height:1.7;">Dapatkan voucher internet harian dan mingguan secara instan &mdash; pilih paket pilihan Anda, selesaikan pelunasan via QRIS / VA / m-banking, dan ambil kode voucher aktif secara langsung tanpa hambatan.</p>
      </div>
      <div class="body">
        <% if (error) { %>
          <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
          </div>
        <% } %>
        <% if (info) { %>
          <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i><%= info %>
          </div>
        <% } %>

        <% if (order) { %>
          <div class="mb-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
              <div>
                <div class="fw-bold">Status Pesanan</div>
                <div class="muted small">Order #<%= order.id %> &middot; WA: <%= order.buyer_phone %></div>
              </div>
              <div>
                <% const st = String(order.status || 'pending'); %>
                <% if (st === 'fulfilled') { %>
                  <span class="pill pill-p"><i class="bi bi-check-circle"></i> Selesai</span>
                <% } else if (st === 'paid') { %>
                  <span class="pill pill-u"><i class="bi bi-hourglass-split"></i> Diproses</span>
                <% } else { %>
                  <span class="pill pill-u"><i class="bi bi-clock"></i> Menunggu</span>
                <% } %>
              </div>
            </div>
            <div class="mt-2">
              <div class="muted small">Paket: <span class="text-white"><%= order.profile_name %></span> &middot; Durasi: <span class="text-white"><%= order.validity || '-' %></span> &middot; Harga: <span class="text-white">Rp <%= Number(order.price || 0).toLocaleString('id-ID') %></span></div>
              <% if (String(order.status) === 'fulfilled' && order.voucher_code) { %>
                <div class="alert alert-success mt-3 mb-0">
                  <div class="fw-bold mb-1"><i class="bi bi-ticket-perforated me-2"></i>Voucher Siap</div>
                  <div>User: <b><%= order.voucher_code %></b></div>
                  <div>Pass: <b><%= order.voucher_password %></b></div>
                  <% if (Number(order.wa_sent || 0) === 1) { %>
                    <div class="muted small mt-1">Voucher berhasil dikirim ke WhatsApp pembeli.</div>
                  <% } else if (order.wa_error) { %>
                    <div class="text-warning small mt-1">WhatsApp gagal terkirim: <%= order.wa_error %></div>
                    <div class="muted small">Cadangan: simpan kode voucher yang tampil di halaman ini.</div>
                  <% } else { %>
                    <div class="muted small mt-1">Jika WhatsApp gagal terkirim, kode voucher tetap tampil di halaman ini.</div>
                  <% } %>
                </div>
              <% } else if (String(order.status) === 'paid') { %>
                <div class="alert alert-info mt-3 mb-0">
                  <div class="fw-bold mb-1"><i class="bi bi-hourglass-split me-2"></i>Pembayaran Berhasil</div>
                  <div class="muted small">Voucher sedang dibuat di MikroTik. Halaman ini akan diperbarui otomatis.</div>
                </div>
              <% } else if (String(order.status) === 'pending' && (String(order.payment_gateway || '') === 'qris_static' || order.qris_amount_unique)) { %>
                <% if (orderToken) { %>
                  <a class="btn btn-primary btnx mt-3 w-100" href="/customer/voucher/qris/<%= order.id %>?t=<%= encodeURIComponent(orderToken) %>">
                    <i class="bi bi-qr-code-scan me-1"></i> Buka QRIS Statis
                  </a>
                <% } else { %>
                  <div class="alert alert-warning mt-3 mb-0">Link QRIS tidak tersedia.</div>
                <% } %>
              <% } else if (String(order.status) === 'pending' && order.payment_link) { %>
                <a class="btn btn-primary btnx mt-3 w-100" href="<%= order.payment_link %>">
                  <i class="bi bi-credit-card me-1"></i> Lanjutkan Pembayaran
                </a>
              <% } %>
            </div>
          </div>
          <hr style="border-color: rgba(148,163,184,.18)">
        <% } %>

        <form method="POST" action="/customer/public/voucher/create-payment" class="d-grid gap-2" id="voucherForm">
          <!-- Hidden TOS state injector to bypass backend checks cleanly -->
          <input type="hidden" name="tos" value="1">

          <!-- STEP 1: Pilih paket voucher -->
          <div class="step-pane active" id="stepPane1">
            <label class="muted small mb-1">Pilih Paket Internet Terbaik</label>
            <% if (!profiles || profiles.length === 0) { %>
              <div class="muted small mt-1">Belum ada profile voucher (metadata Mikhmon) di MikroTik.</div>
            <% } else { %>
              <div class="voucher-grid mt-1">
                <% (profiles || []).forEach((p, idx) => { 
                  // Tentukan warna tema dinamis berdasarkan level harga layaknya sampel gambar
                  const price = Number(p.price || 0);
                  let themeClass = 'v-theme-green';
                  if (price >= 35000) themeClass = 'v-theme-purple';
                  else if (price >= 10000) themeClass = 'v-theme-orange';
                  else if (price >= 4000) themeClass = 'v-theme-blue';

                  // Ambil domain as CS dari konfigurasi
                  const csDomain = String(settings.public_base_url || '').trim()
                    .replace(/^https?:\/\//i, '')
                    .replace(/\/$/i, '') || 'BINUSNET.COM';
                %>
                  <input
                    class="voucher-radio"
                    type="radio"
                    name="profile_name"
                    id="vprofile_<%= idx %>"
                    value="<%= p.name %>"
                    data-price="<%= price %>"
                    data-validity="<%= p.validity %>"
                    <%= idx === 0 ? 'required' : '' %>
                  >
                  <label class="voucher-card <%= themeClass %>" for="vprofile_<%= idx %>" onclick="selectCardAndGo('<%= p.name %>')">
                    <!-- Top: Brand & Price -->
                    <div class="v-top">
                      <div class="v-brand">
                        <img src="/img/logo.png?v=<%= typeof brandVersion !== 'undefined' ? brandVersion : 'zenradius' %>" alt="Logo" class="v-brand-logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                        <span class="v-brand-text" style="display:none;"><%= settings.company_header || 'WiFi' %></span>
                      </div>
                      <div class="voucher-price">
                        <span class="v-currency">Rp</span><%= price.toLocaleString('id-ID') %>
                      </div>
                    </div>
                    
                    <!-- Mid: Name & Validity -->
                    <div class="v-mid">
                      <span class="v-label-main">VOUCHER</span>
                      <h3 class="voucher-title"><%= p.name %></h3>
                      <div class="v-dur">
                        <i class="bi bi-clock-history"></i> Masa Aktif: <%= p.validity %>
                      </div>
                    </div>

                    <!-- Foot: CS Banner -->
                    <div class="v-foot-cs">
                      <span><%= csDomain %></span>
                      <i class="bi bi-qr-code-scan"></i>
                    </div>
                  </label>
                <% }) %>
              </div>
              <div class="muted small mt-2" id="step1Hint">Klik paket voucher di atas untuk langsung melakukan pembelian & pembayaran.</div>
            <% } %>
          </div>

          <!-- STEP 2: Pembayaran -->
          <!-- Diabaikan karena input langsung berpindah ke dialogue pop-up modal -->
          <div style="display:none;">
            <div class="summary">
              <div>
                <div class="lbl">Paket dipilih</div>
                <div class="val">-</div>
                <div class="muted small"><i class="bi bi-hourglass-split me-1"></i><span>-</span></div>
              </div>
              <div class="text-end">
                <div class="lbl">Total</div>
                <div class="val" style="font-size:18px">-</div>
              </div>
            </div>
          </div>
              <% const hasStaticQris = (String(settings.qris_static_qr_url || '').trim() || String(settings.qris_static_payload || '').trim()) && (settings.qris_static_enabled !== false && settings.qris_static_enabled !== 'false' && settings.qris_static_enabled !== 0 && settings.qris_static_enabled !== '0'); %>
              <% if (!hasStaticQris && (!paymentChannels || paymentChannels.length === 0)) { %>
                <input type="hidden" name="method" value="QRIS">
                <div class="payment-methods-grid mt-1">
                  <div class="pay-method-item" style="cursor: default">
                    <div class="p-icon"><i class="bi bi-qr-code-scan"></i></div>
                    <div class="p-info">
                      <span class="p-name">QRIS / E-Wallet</span>
                      <span class="p-sub">
                        <span class="p-chip">DANA</span>
                        <span class="p-chip">OVO</span>
                        <span class="p-chip">ShopeePay</span>
                        <span class="p-chip">LinkAja</span>
                      </span>
                    </div>
                  </div>
                </div>
              <% } else { %>
                <div class="payment-methods-grid mt-1">
                  <% if (hasStaticQris) { %>
                    <input
                      class="pm-radio"
                      type="radio"
                      name="method"
                      id="pm_static"
                      value="QRIS_STATIC"
                      checked
                      style="position:absolute;opacity:0;pointer-events:none"
                    >
                    <label class="pay-method-item" for="pm_static">
                      <div class="p-icon"><i class="bi bi-qr-code-scan"></i></div>
                      <div class="p-info">
                        <span class="p-name">QRIS Statis (Scan)</span>
                        <span class="p-sub">
                          <span class="p-chip">Nominal unik</span>
                          <span class="p-chip">E-Wallet</span>
                        </span>
                      </div>
                    </label>
                  <% } %>
                  <% paymentChannels.forEach((ch, idx) => {
                    const code = String(ch.code || '').toUpperCase();
                    const name = ch.name || code;
                    const group = String(ch.group || '').toLowerCase();
                    let icon = 'bi-wallet2';
                    let badgeClass = 'pb-bank';
                    
                    if (code === 'QRIS' || code.includes('QRIS')) {
                      icon = 'bi-qr-code-scan';
                      badgeClass = 'pb-bank';
                    } else if (code.includes('DANA')) {
                      icon = 'bi-wallet2';
                      badgeClass = 'pb-dana';
                    } else if (code.includes('OVO')) {
                      icon = 'bi-wallet2';
                      badgeClass = 'pb-ovo';
                    } else if (code.includes('SHOPEE')) {
                      icon = 'bi-wallet2';
                      badgeClass = 'pb-shopeepay';
                    } else if (code.includes('LINKAJA')) {
                      icon = 'bi-wallet2';
                      badgeClass = 'pb-linkaja';
                    } else if (code.includes('GOPAY')) {
                      icon = 'bi-wallet2';
                      badgeClass = 'pb-gopay';
                    } else if (code.includes('VA') || group.includes('virtual')) {
                      icon = 'bi-bank';
                      badgeClass = 'pb-bank';
                    } else if (code.includes('SNAP') || code.includes('XENDIT') || code.includes('DUITKU')) {
                      icon = 'bi-credit-card';
                      badgeClass = 'pb-bank';
                    }
                  %>
                    <input
                      class="pm-radio"
                      type="radio"
                      name="method"
                      id="pm_<%= idx %>"
                      value="<%= code %>"
                      <%= (!hasStaticQris && idx === 0) ? 'checked' : '' %>
                      style="position:absolute;opacity:0;pointer-events:none"
                    >
                    <label class="pay-method-item" for="pm_<%= idx %>">
                      <div class="p-icon">
                        <% if (ch.icon_url) { %>
                          <img src="<%= ch.icon_url %>" alt="<%= name %>" class="p-logo">
                        <% } else { %>
                          <div class="p-badge <%= badgeClass %>">
                            <i class="<%= icon %>"></i>
                          </div>
                        <% } %>
                      </div>
                      <div class="p-info">
                        <span class="p-name"><%= name %></span>
                        <% if (ch.total_fee && ch.total_fee.flat) { %>
                          <span class="p-sub">
                            <span class="p-chip">Fee: Rp <%= Number(ch.total_fee.flat).toLocaleString('id-ID') %></span>
                          </span>
                        <% } %>
                      </div>
                    </label>
          </div>

          <a class="d-inline-flex align-items-center justify-content-center gap-1 text-decoration-none small mt-2 mx-auto" href="/" style="color:#a5f4ed;font-weight:700;">
            <i class="bi bi-arrow-left"></i> Kembali Halaman
          </a>
        </form>

        <div class="muted small mt-4 text-center" style="line-height:1.55;">
          &copy; <%= new Date().getFullYear() %> <strong><%- footerInfo %></strong>
        </div>
      </div>
    </div>
  </div>
        </form>

        <div class="muted small mt-4 text-center" style="line-height:1.55;">
          &copy; <%= new Date().getFullYear() %> <strong><%- footerInfo %></strong>
        </div>
      </div>
    </div>
  </div>

  <!-- Confirmation Popup Modal overlay -->
  <div class="c-modal-overlay" id="confirmModal">
    <div class="c-modal">
      <div class="c-modal-title">
        <i class="bi bi-wallet2" style="color:#2dd4bf"></i>
        <span>Selesaikan Pembayaran Voucher</span>
      </div>
      <div class="c-modal-body">
        <div style="font-size:13.5px;line-height:1.5;margin-bottom:12px">Silakan masukkan nomor WhatsApp pembeli dan pilih metode pembayaran untuk melanjutkan pesanan Anda:</div>
        
        <!-- Paket selected display -->
        <div class="c-modal-detail" style="margin-top:0;margin-bottom:16px;background:rgba(45,212,191,.04);border-color:rgba(45,212,191,.15)">
          <div style="font-weight:800;color:#fff;font-size:15px" id="popName">-</div>
          <div style="color:var(--portal-muted);font-size:12.5px;margin-top:2px;display:flex;align-items:center;gap:4px">
            <i class="bi bi-clock-history"></i> Masa Aktif: <span id="popValidity">-</span>
          </div>
          <div style="font-weight:900;color:#2dd4bf;font-size:18px;margin-top:6px;" id="popPrice">-</div>
        </div>

        <!-- Input WhatsApp directly inside popup -->
        <div class="mb-3">
          <label class="muted small mb-1 fw-bold">Nomor WhatsApp Pembeli</label>
          <div style="position:relative; width: 100%;">
            <i class="bi bi-whatsapp" style="position:absolute;left:13px;top:50%;transform:translateY(-50%);color:#2dd4bf;font-size:15px;pointer-events:none;z-index:4;"></i>
            <input class="form-control" name="buyer_phone" id="buyerPhone" inputmode="numeric" placeholder="Contoh: 081234567890" style="padding-left: 38px; height: 46px;" required>
          </div>
          <div class="muted small mt-1" style="font-size:11px">Voucher terkirim instan via WhatsApp.</div>
        </div>

        <!-- Payment channels inside popup -->
        <div class="mb-2">
          <label class="muted small mb-1 fw-bold">Metode Pembayaran</label>
          <% const hasStaticQris = (String(settings.qris_static_qr_url || '').trim() || String(settings.qris_static_payload || '').trim()) && (settings.qris_static_enabled !== false && settings.qris_static_enabled !== 'false' && settings.qris_static_enabled !== 0 && settings.qris_static_enabled !== '0'); %>
          <% if (!hasStaticQris && (!paymentChannels || paymentChannels.length === 0)) { %>
            <input type="hidden" name="method" value="QRIS">
            <div class="payment-methods-grid mt-1" style="grid-template-columns:1fr">
              <div class="pay-method-item" style="cursor:default;flex-direction:row;padding:10px 14px;background:rgba(255,255,255,.03)">
                <div class="p-icon" style="width:36px;height:36px;font-size:16px;margin:0"><i class="bi bi-qr-code-scan"></i></div>
                <div class="p-info" style="align-items:flex-start">
                  <span class="p-name" style="font-size:12.5px">QRIS / E-Wallet</span>
                </div>
              </div>
            </div>
          <% } else { %>
            <div class="payment-methods-grid mt-1" style="grid-template-columns:repeat(2,1fr);gap:8px">
              <% if (hasStaticQris) { %>
                <input
                  class="pm-radio"
                  type="radio"
                  name="method"
                  id="pm_static"
                  value="QRIS_STATIC"
                  checked
                  style="position:absolute;opacity:0;pointer-events:none"
                >
                <label class="pay-method-item" for="pm_static" style="padding:10px;gap:6px;border-radius:10px;background:rgba(15,23,42,.62)">
                  <div class="p-icon" style="width:32px;height:32px;font-size:15px;margin-bottom:0"><i class="bi bi-qr-code-scan"></i></div>
                  <div class="p-info">
                    <span class="p-name" style="font-size:11.5px">QRIS Instan</span>
                  </div>
                </label>
              <% } %>
              <% paymentChannels.forEach((ch, idx) => {
                const code = String(ch.code || '').toUpperCase();
                const name = ch.name || code;
                const group = String(ch.group || '').toLowerCase();
                let icon = 'bi-wallet2';
                let badgeClass = 'pb-bank';
                
                if (code === 'QRIS' || code.includes('QRIS')) {
                  icon = 'bi-qr-code-scan';
                  badgeClass = 'pb-bank';
                } else if (code.includes('DANA')) {
                  icon = 'bi-wallet2';
                  badgeClass = 'pb-dana';
                } else if (code.includes('OVO')) {
                  icon = 'bi-wallet2';
                  badgeClass = 'pb-ovo';
                } else if (code.includes('SHOPEE')) {
                  icon = 'bi-wallet2';
                  badgeClass = 'pb-shopeepay';
                } else if (code.includes('LINKAJA')) {
                  icon = 'bi-wallet2';
                  badgeClass = 'pb-linkaja';
                } else if (code.includes('GOPAY')) {
                  icon = 'bi-wallet2';
                  badgeClass = 'pb-gopay';
                } else if (code.includes('VA') || group.includes('virtual')) {
                  icon = 'bi-bank';
                  badgeClass = 'pb-bank';
                } else if (code.includes('SNAP') || code.includes('XENDIT') || code.includes('DUITKU')) {
                  icon = 'bi-credit-card';
                  badgeClass = 'pb-bank';
                }
              %>
                <input
                  class="pm-radio"
                  type="radio"
                  name="method"
                  id="pm_<%= idx %>"
                  value="<%= code %>"
                  <%= (!hasStaticQris && idx === 0) ? 'checked' : '' %>
                  style="position:absolute;opacity:0;pointer-events:none"
                >
                <label class="pay-method-item" for="pm_<%= idx %>" style="padding:10px;gap:6px;border-radius:10px;background:rgba(15,23,42,.62)">
                  <div class="p-icon" style="width:32px;height:32px;font-size:15px;margin-bottom:0">
                    <% if (ch.icon_url) { %>
                      <img src="<%= ch.icon_url %>" alt="<%= name %>" class="p-logo" style="padding:4px">
                    <% } else { %>
                      <div class="p-badge <%= badgeClass %>" style="font-size:14px">
                        <i class="<%= icon %>"></i>
                      </div>
                    <% } %>
                  </div>
                  <div class="p-info">
                    <span class="p-name" style="font-size:11.5px"><%= name %></span>
                  </div>
                </label>
              <% }) %>
            </div>
          <% } %>
        </div>

      </div>
      <div class="c-modal-actions" style="margin-top:10px">
        <button class="btn btn-ghost btn-sm" type="button" style="border-radius:10px;padding:10px 18px" onclick="cancelConfirm()">Batal</button>
        <button class="btn btn-primary btn-sm" type="submit" style="border-radius:10px;min-height:unset;padding:10px 22px">
          Bayar & Aktivasi <i class="bi bi-lightning-charge ms-1"></i>
        </button>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const radios = Array.from(document.querySelectorAll('input.voucher-radio'));
      let pendingProfileName = null;

      function selected() { return radios.find(r => r.checked) || null; }

      window.selectCardAndGo = function (profileName) {
        pendingProfileName = profileName;
        const r = radios.find(rad => rad.value === profileName);
        if (r) {
          // Centang radio button pilihan secara tersembunyi
          r.checked = true;

          // Set detail di pop-up modal
          document.getElementById('popName').textContent = r.value;
          document.getElementById('popValidity').textContent = r.dataset.validity || '-';
          document.getElementById('popPrice').textContent = 'Rp ' + Number(r.dataset.price || 0).toLocaleString('id-ID');
          
          // Tampilkan pop-up modal konfirmasi beserta formulir input
          document.getElementById('confirmModal')?.classList.add('active');
          setTimeout(() => document.getElementById('buyerPhone')?.focus(), 220);
        }
      };

      window.cancelConfirm = function () {
        pendingProfileName = null;
        document.getElementById('confirmModal')?.classList.remove('active');
      };
    })();
  </script>
  <% if (order && (String(order.status) === 'paid' || String(order.status) === 'pending') && !order.voucher_code) { %>
  <script>
    setTimeout(() => {
      try { window.location.reload(); } catch (e) {}
    }, 5000);
  </script>
  <% } %>
</body>
</html>
