<!-- views/partials/customer_bottom_nav.ejs -->
<% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
<style>
  .customer-bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 72px;
    background: linear-gradient(180deg, var(--card-bg, rgba(23, 57, 69, 0.95)), var(--bg3, rgba(19, 50, 62, 0.92)));
    backdrop-filter: blur(16px) saturate(180%);
    border-top: 1px solid var(--card-border, rgba(190, 239, 255, 0.15));
    display: flex;
    justify-content: space-around;
    align-items: center;
    z-index: 1050;
    padding-bottom: env(safe-area-inset-bottom);
    box-shadow: 0 -1px 0 color-mix(in srgb, var(--accent-primary, #22d3ee) 25%, transparent), 0 -12px 35px rgba(0, 0, 0, 0.5);
  }

  .nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    color: var(--text-muted, #cbd5e1);
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    transition: color 0.25s ease;
    flex: 1;
    height: 100%;
    cursor: pointer;
    position: relative;
  }

  .nav-icon-wrap {
    width: 40px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    transition: background 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .nav-item i {
    font-size: 18px;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .nav-item:hover {
    color: #ffffff;
  }

  .nav-item:hover .nav-icon-wrap {
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-item.active {
    color: var(--accent-primary, #22d3ee);
  }

  .nav-item.active .nav-icon-wrap {
    background: var(--soft-primary, rgba(45, 212, 191, 0.14));
    transform: translateY(-3px);
    box-shadow: 0 6px 16px color-mix(in srgb, var(--accent-primary, #22d3ee) 30%, transparent);
  }

  .nav-item.active i {
    color: var(--accent-primary, #22d3ee);
  }

  /* Hide on desktop, show only on mobile */
  @media (min-width: 992px) {
    .customer-bottom-nav {
      display: none;
    }
    body {
      padding-bottom: 0 !important;
    }
  }
</style>

<nav class="customer-bottom-nav">
  <a href="/pelanggan/dashboard#home-section" class="nav-item <%= activeNav === 'home' ? 'active' : '' %>">
    <span class="nav-icon-wrap"><i class="bi bi-house-door-fill"></i></span>
    <span>Beranda</span>
  </a>
  <a href="/pelanggan/dashboard#billing-section" class="nav-item <%= activeNav === 'billing' ? 'active' : '' %>">
    <span class="nav-icon-wrap"><i class="bi bi-receipt-cutoff text-warning"></i></span>
    <span>Tagihan</span>
  </a>
  <a href="/pelanggan/dashboard#home-section" class="nav-item" onclick="triggerWifiSettingsNav()" title="WiFi Settings" style="cursor:pointer;">
    <span class="nav-icon-wrap"><i class="bi bi-wifi" style="color:var(--accent-primary);"></i></span>
    <span>WiFi</span>
  </a>
  <a href="/pelanggan/topup" class="nav-item" title="Top Up Saldo">
    <span class="nav-icon-wrap"><i class="bi bi-wallet2" style="color:var(--accent-success, #34d399);"></i></span>
    <span>Top Up</span>
  </a>
  <div class="nav-item" onclick="triggerProfileNav()" title="Profil">
    <span class="nav-icon-wrap"><i class="bi bi-person-circle" style="color:#a78bfa;"></i></span>
    <span>Profil</span>
  </div>
</nav>

<script>
  function triggerWifiSettingsNav() {
    if (typeof openWifiSettingsModal === 'function') {
      const devId = (typeof customer !== 'undefined' && customer && customer.id) ? customer.id : '';
      const ssid = (typeof customer !== 'undefined' && customer && customer.ssid) ? customer.ssid : '';
      openWifiSettingsModal(devId, ssid);
    } else {
      window.location.href = '/pelanggan/dashboard#home-section';
    }
  }

  function triggerProfileNav() {
    const el = document.getElementById('profileModal');
    if (el && typeof bootstrap !== 'undefined') {
      const m = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el);
      m.show();
    } else {
      window.location.href = '/pelanggan/dashboard#home-section';
    }
  }

  function updateActiveNav() {
    const hash = window.location.hash;
    document.querySelectorAll('.customer-bottom-nav .nav-item').forEach(item => {
      item.classList.remove('active');
      if (item.getAttribute('href') && item.getAttribute('href').includes(hash) && hash !== '') {
        item.classList.add('active');
      }
    });
    
    if (hash === '' || hash === '#home-section') {
       const homeNav = document.querySelector('.customer-bottom-nav a[href*="home-section"]');
       if (homeNav) homeNav.classList.add('active');
    }
  }

  window.addEventListener('hashchange', updateActiveNav);
  window.addEventListener('load', updateActiveNav);
</script>
<% } %>
