<%#
  Partial: navigasi tab internal modul POS.
  `activeTab` diisi oleh halaman pemanggil: dashboard | kasir | produk |
  pembelian | hutang | kas | shift | laporan | pelanggan | pengaturan
%>
<div class="pos-tabs">
  <a href="/toko" class="pos-tab <%= activeTab === 'dashboard' ? 'active' : '' %>"><i class="bi bi-speedometer2"></i> Ringkasan</a>
  <a href="/toko/kasir" class="pos-tab <%= activeTab === 'kasir' ? 'active' : '' %>"><i class="bi bi-cart-check"></i> Kasir</a>
  <a href="/toko/produk" class="pos-tab <%= activeTab === 'produk' ? 'active' : '' %>"><i class="bi bi-box-seam"></i> Produk</a>
  <a href="/toko/pembelian" class="pos-tab <%= activeTab === 'pembelian' ? 'active' : '' %>"><i class="bi bi-truck"></i> Pembelian</a>
  <a href="/toko/hutang" class="pos-tab <%= activeTab === 'hutang' ? 'active' : '' %>"><i class="bi bi-cash-coin"></i> Piutang &amp; Hutang</a>
  <a href="/toko/kas" class="pos-tab <%= activeTab === 'kas' ? 'active' : '' %>"><i class="bi bi-wallet2"></i> Buku Kas</a>
  <a href="/toko/shift" class="pos-tab <%= activeTab === 'shift' ? 'active' : '' %>"><i class="bi bi-clock-history"></i> Shift</a>
  <a href="/toko/laporan" class="pos-tab <%= activeTab === 'laporan' ? 'active' : '' %>"><i class="bi bi-bar-chart-line"></i> Laporan</a>
  <a href="/toko/pelanggan" class="pos-tab <%= activeTab === 'pelanggan' ? 'active' : '' %>"><i class="bi bi-people"></i> Pelanggan</a>
  <% if (typeof session !== 'undefined' && session && session.isAdmin) { %>
    <a href="/toko/pengaturan" class="pos-tab <%= activeTab === 'pengaturan' ? 'active' : '' %>"><i class="bi bi-gear"></i> Pengaturan</a>
  <% } %>
</div>
