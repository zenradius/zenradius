<%#
  Partial: <head> + sidebar + topbar untuk seluruh halaman Point of Sale.
  Dipakai lewat include dengan variabel:
    title, activePage (menuKey), company, brandVersion, lang, appTheme
  Setelah include, halaman membuka <div class="page"> sendiri.
%>
<!DOCTYPE html>
<html lang="<%= lang || 'id' %>" data-app-theme="<%= typeof appTheme !== 'undefined' ? appTheme : 'current' %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | <%= company %></title>
  <meta name="theme-color" content="<%= (typeof appTheme !== 'undefined' && appTheme === 'space') ? '#0B1028' : (typeof appTheme !== 'undefined' && appTheme === 'orbit') ? '#F2F5FA' : '#0f172a' %>">
  <link rel="icon" href="/img/icon.png?v=<%= typeof brandVersion !== 'undefined' ? brandVersion : 'zenradius' %>" type="image/png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/theme-tokens.css">
  <link rel="stylesheet" href="/css/toko.css">
</head>
<body>
<%- include('../../admin/partials/sidebar', { activePage: 'pos_toko', company }) %>
<div class="mw">
  <%- include('../../admin/partials/licenseGraceBar') %>
  <div class="topbar">
    <div class="tb-title">
      <button class="hb-menu" onclick="toggleSidebar()"><i class="bi bi-list"></i></button>
      <i class="bi bi-shop"></i>
      <span><%= title %></span>
    </div>
    <div class="tb-right">
      <span class="adm-badge"><i class="bi bi-shop-window"></i> <%= storeName || company %></span>
      <span class="adm-badge"><i class="bi bi-person-fill"></i> <%= (typeof session !== 'undefined' && session && session.isCashier) ? 'Kasir' : 'Admin' %></span>
      <a href="/admin/logout" class="btn btn-g btn-sm"><i class="bi bi-box-arrow-left"></i> Logout</a>
    </div>
  </div>
  <div class="page">
    <% if (typeof msg !== 'undefined' && msg) { %>
      <div class="alert alert-<%= msg.type === 'success' ? 's' : 'd' %> mb16">
        <i class="bi bi-<%= msg.type === 'success' ? 'check-circle' : 'exclamation-triangle' %>"></i>
        <%= msg.text %>
      </div>
    <% } %>
