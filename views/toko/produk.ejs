<%- include('partials/head', { title: 'Produk Toko' }) %>
<%- include('partials/nav', { activeTab: 'produk' }) %>

<div class="card">
  <div class="card-hd" style="flex-wrap:wrap;gap:10px">
    <h6><i class="bi bi-box-seam"></i> Daftar Produk (<%= products.length %>)</h6>
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
      <form method="GET" action="/toko/produk" style="display:flex;gap:8px;align-items:center;margin:0;flex-wrap:wrap">
        <div class="sinput">
          <i class="bi bi-search"></i>
          <input type="text" class="fc" name="q" value="<%= search %>" placeholder="Cari nama / SKU...">
        </div>
        <select class="fs" name="category" style="width:auto;min-width:150px">
          <option value="">Semua kategori</option>
          <% categories.forEach(function(c){ %>
            <option value="<%= c.id %>" <%= String(categoryId) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
        <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);white-space:nowrap">
          <input type="checkbox" name="low" value="1" <%= lowOnly ? 'checked' : '' %>> Stok menipis
        </label>
        <button class="btn btn-g btn-sm" type="submit"><i class="bi bi-funnel"></i> Filter</button>
      </form>
      <button class="btn btn-p btn-sm" onclick="openItemModal()"><i class="bi bi-plus-lg"></i> Produk Baru</button>
      <button class="btn btn-g btn-sm" onclick="openModal('catModal')"><i class="bi bi-tags"></i> Kategori</button>
    </div>
  </div>
  <div class="tbl-wrap">
    <table class="dtbl">
      <thead>
        <tr>
          <th>Produk</th><th>Kategori</th><th class="num">Modal</th><th class="num">Harga Jual</th>
          <th class="num">Stok</th><th>Kadaluarsa</th><th>Aksi</th>
        </tr>
      </thead>
      <tbody>
      <% if (!products.length) { %>
        <tr><td colspan="7" style="text-align:center;color:var(--muted);padding:26px">
          Belum ada produk. Klik <strong>Produk Baru</strong> untuk mulai mengisi katalog toko.
        </td></tr>
      <% } %>
      <% products.forEach(function(p){ %>
        <tr>
          <td>
            <div style="font-weight:600"><%= p.name %></div>
            <div style="font-size:11px;color:var(--muted);font-family:ui-monospace,monospace"><%= p.sku || 'tanpa SKU' %> · <%= p.unit %></div>
          </td>
          <td><%= p.category_name || '-' %></td>
          <td class="num"><%= formatMoney(p.cost_price) %></td>
          <td class="num"><%= formatMoney(p.price_retail) %>
            <div style="font-size:10.5px;color:var(--muted)"><%= (p.units || []).length %> satuan</div>
          </td>
          <td class="num"
              style="font-weight:700;color:<%= p.stock <= 0 ? 'var(--danger)' : (p.min_stock > 0 && p.stock <= p.min_stock ? 'var(--warning)' : 'var(--text)') %>">
            <%= p.stock %>
            <% if (p.min_stock > 0 && p.stock <= p.min_stock) { %><div style="font-size:10px">min <%= p.min_stock %></div><% } %>
          </td>
          <td><%= p.expiry_date || '-' %></td>
          <td>
            <div style="display:flex;gap:5px;flex-wrap:wrap">
              <button type="button" class="btn btn-g btn-sm" onclick="openStockModal(<%= p.id %>, '<%= String(p.name).replace(/'/g, "\\'") %>', <%= p.stock %>)"><i class="bi bi-plus-slash-minus"></i></button>
              <button type="button" class="btn btn-g btn-sm" onclick="openItemModal(<%= p.id %>)"><i class="bi bi-pencil"></i></button>
              <form method="POST" action="/toko/produk/hapus" style="margin:0" onsubmit="return confirm('Hapus produk <%= String(p.name).replace(/'/g, "\\'") %>?')">
                <input type="hidden" name="id" value="<%= p.id %>">
                <button class="btn btn-g btn-sm" type="submit"><i class="bi bi-trash3"></i></button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:16px">
  <!-- Riwayat mutasi stok -->
  <div class="card">
    <div class="card-hd"><h6><i class="bi bi-clock-history"></i> Riwayat Mutasi Stok</h6></div>
    <div class="tbl-wrap" style="max-height:420px;overflow-y:auto">
      <table class="dtbl">
        <thead><tr><th>Waktu</th><th>Produk</th><th>Jenis</th><th class="num">Perubahan</th><th class="num">Sisa</th></tr></thead>
        <tbody>
        <% if (!stockLogs.length) { %>
          <tr><td colspan="5" style="text-align:center;color:var(--muted);padding:22px">Belum ada mutasi</td></tr>
        <% } %>
        <% stockLogs.forEach(function(l){ %>
          <tr>
            <td style="font-size:11px;white-space:nowrap"><%= new Date(l.created_at).toLocaleString('id-ID') %></td>
            <td><%= l.product_name || '-' %><div style="font-size:10.5px;color:var(--muted)"><%= l.reference || '' %></div></td>
            <td><span style="font-size:11px"><%= l.type %></span></td>
            <td class="num" style="color:<%= l.qty_change < 0 ? 'var(--danger)' : 'var(--success)' %>;font-weight:700"><%= l.qty_change > 0 ? '+' : '' %><%= l.qty_change %></td>
            <td class="num"><%= l.stock_after !== null && l.stock_after !== undefined ? l.stock_after : '-' %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mendekati kadaluarsa -->
  <div class="card">
    <div class="card-hd"><h6><i class="bi bi-calendar-x"></i> Mendekati / Lewat Kadaluarsa (60 hari)</h6></div>
    <div class="tbl-wrap" style="max-height:420px;overflow-y:auto">
      <table class="dtbl">
        <thead><tr><th>Produk</th><th>Tanggal</th><th class="num">Sisa Hari</th></tr></thead>
        <tbody>
        <% if (!expiring.length) { %>
          <tr><td colspan="3" style="text-align:center;color:var(--muted);padding:22px">Tidak ada produk yang mendekati kadaluarsa</td></tr>
        <% } %>
        <% expiring.forEach(function(p){ %>
          <tr>
            <td><%= p.name %><div style="font-size:10.5px;color:var(--muted)"><%= p.sku || '-' %> · stok <%= p.stock %></div></td>
            <td><%= p.expiry_date %></td>
            <td class="num" style="font-weight:700;color:<%= p.days_until_expiry < 0 ? 'var(--danger)' : 'var(--warning)' %>">
              <%= p.days_until_expiry %><%= p.days_until_expiry < 0 ? ' (lewat)' : '' %>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- ── Modal: produk ── -->
<div class="mo" id="itemModal">
  <div class="mb" style="max-width:720px">
    <form method="POST" action="/toko/produk/simpan">
      <div class="mh">
        <span class="mt" id="itemTitle">Produk Baru</span>
        <button type="button" class="mc" onclick="closeModal('itemModal')"><i class="bi bi-x-lg"></i></button>
      </div>
      <div class="mbody">
        <input type="hidden" name="id" id="itemId">
        <div class="form-row">
          <div class="fg">
            <label class="fl">Nama Produk <span style="color:var(--danger)">*</span></label>
            <input type="text" class="fc" name="name" id="itemName" required placeholder="Contoh: Gula Pasir 1kg">
          </div>
          <div class="fg">
            <label class="fl">SKU / Barcode</label>
            <input type="text" class="fc" name="sku" id="itemSku" placeholder="Scan atau ketik kode">
            <div class="pos-hint">Dikosongkan bila belum ada. Bisa dipakai scanner barcode di kasir.</div>
          </div>
        </div>
        <div class="form-row">
          <div class="fg">
            <label class="fl">Kategori</label>
            <select class="fc" name="category_id" id="itemCategory">
              <option value="">Tanpa kategori</option>
              <% categories.forEach(function(c){ %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="fg">
            <label class="fl">Satuan Dasar</label>
            <input type="text" class="fc" name="unit" id="itemUnit" value="pcs" placeholder="pcs / kg / botol">
          </div>
        </div>
        <div class="form-row">
          <div class="fg">
            <label class="fl">Harga Modal (per satuan dasar)</label>
            <input type="number" class="fc" name="cost_price" id="itemCost" min="0" step="100" value="0">
          </div>
          <div class="fg">
            <label class="fl">Harga Jual (per satuan dasar)</label>
            <input type="number" class="fc" name="price_retail" id="itemPrice" min="0" step="100" value="0">
          </div>
        </div>
        <div class="form-row">
          <div class="fg" id="stockField">
            <label class="fl">Stok Awal</label>
            <input type="number" class="fc" name="stock" id="itemStock" min="0" step="1" value="0">
            <div class="pos-hint">Hanya untuk produk baru. Setelah tersimpan, gunakan tombol penyesuaian stok.</div>
          </div>
          <div class="fg">
            <label class="fl">Stok Minimum</label>
            <input type="number" class="fc" name="min_stock" id="itemMinStock" min="0" step="1" value="<%= settings.default_min_stock || 5 %>">
            <div class="pos-hint">Sistem menandai produk saat stok mencapai angka ini.</div>
          </div>
        </div>
        <div class="fg">
          <label class="fl">Tanggal Kadaluarsa (opsional)</label>
          <input type="date" class="fc" name="expiry_date" id="itemExpiry">
        </div>

        <label class="fl" style="margin-top:6px">Satuan &amp; Harga Grosir</label>
        <div class="pos-hint" style="margin-bottom:8px">
          Isi bila produk dijual dalam satuan besar (mis. Pak = 10 pcs, Dus = 40 pcs).
          Harga grosir dipakai otomatis saat jumlah beli mencapai minimum.
        </div>
        <div id="unitRows"></div>
        <button type="button" class="btn btn-g btn-sm" onclick="addUnitRow()"><i class="bi bi-plus-lg"></i> Tambah Satuan</button>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('itemModal')">Batal</button>
        <button type="submit" class="btn btn-p"><i class="bi bi-save"></i> Simpan Produk</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Modal: penyesuaian stok ── -->
<div class="mo" id="stockModal">
  <div class="mb" style="max-width:420px">
    <form method="POST" action="/toko/produk/stok">
      <div class="mh">
        <span class="mt"><i class="bi bi-plus-slash-minus"></i> Sesuaikan Stok</span>
        <button type="button" class="mc" onclick="closeModal('stockModal')"><i class="bi bi-x-lg"></i></button>
      </div>
      <div class="mbody">
        <input type="hidden" name="product_id" id="stockProductId">
        <div class="fg">
          <label class="fl">Produk</label>
          <div class="fc" id="stockProductName" style="background:var(--bg3)"></div>
        </div>
        <div class="fg">
          <label class="fl">Perubahan Stok</label>
          <input type="number" class="fc" name="qty_change" required step="1" placeholder="Contoh: 10 atau -3">
          <div class="pos-hint">Gunakan angka positif untuk menambah, negatif untuk mengurangi (mis. barang rusak).</div>
        </div>
        <div class="fg">
          <label class="fl">Alasan / Catatan</label>
          <input type="text" class="fc" name="note" placeholder="Contoh: stok opname, barang rusak">
        </div>
      </div>
      <div class="mf">
        <button type="button" class="btn btn-g" onclick="closeModal('stockModal')">Batal</button>
        <button type="submit" class="btn btn-p"><i class="bi bi-save"></i> Simpan</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Modal: kategori ── -->
<div class="mo" id="catModal">
  <div class="mb" style="max-width:520px">
    <div class="mh">
      <span class="mt"><i class="bi bi-tags"></i> Kategori Produk</span>
      <button type="button" class="mc" onclick="closeModal('catModal')"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="mbody">
      <div class="tbl-wrap" style="max-height:240px;overflow-y:auto;margin-bottom:16px">
        <table class="dtbl">
          <thead><tr><th>Nama</th><th>Keterangan</th><th>Aksi</th></tr></thead>
          <tbody>
          <% if (!categories.length) { %>
            <tr><td colspan="3" style="text-align:center;color:var(--muted);padding:18px">Belum ada kategori</td></tr>
          <% } %>
          <% categories.forEach(function(c){ %>
            <tr>
              <td style="font-weight:600"><%= c.name %></td>
              <td style="font-size:12px;color:var(--muted)"><%= c.description || '-' %></td>
              <td>
                <form method="POST" action="/toko/kategori/hapus" style="margin:0" onsubmit="return confirm('Hapus kategori <%= c.name %>?')">
                  <input type="hidden" name="id" value="<%= c.id %>">
                  <button class="btn btn-g btn-sm" type="submit"><i class="bi bi-trash3"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <form method="POST" action="/toko/kategori/simpan">
        <div class="fg">
          <label class="fl">Nama Kategori Baru</label>
          <input type="text" class="fc" name="name" required placeholder="Contoh: Minuman">
        </div>
        <div class="fg">
          <label class="fl">Keterangan</label>
          <input type="text" class="fc" name="description" placeholder="Opsional">
        </div>
        <button type="submit" class="btn btn-p" style="width:100%;justify-content:center"><i class="bi bi-plus-lg"></i> Tambah Kategori</button>
      </form>
    </div>
  </div>
</div>

</div></div><!-- /.page /.mw -->

<script>
  const PRODUCTS = <%= JSON.stringify(products).replace(/</g, '\\u003c') %>;

  function openModal(id) { document.getElementById(id).classList.add('show'); }
  function closeModal(id) { document.getElementById(id).classList.remove('show'); }
  document.querySelectorAll('.mo').forEach(function (m) {
    m.addEventListener('click', function (e) { if (e.target === m) m.classList.remove('show'); });
  });
  setTimeout(function () { document.querySelectorAll('.alert').forEach(function (a) { a.style.display = 'none'; }); }, 5000);

  /* ── Baris satuan konversi ── */
  function unitRow(u) {
    const data = u || {};
    const div = document.createElement('div');
    div.className = 'pos-unit-row';
    div.innerHTML =
      '<div><label class="fl">Satuan</label><input type="text" class="fc" name="unit_name" value="' + (data.unit_name || '') + '" placeholder="pak / dus"></div>'
      + '<div><label class="fl">Isi</label><input type="number" class="fc" name="unit_factor" min="1" step="1" value="' + (data.conversion_factor || 1) + '"></div>'
      + '<div><label class="fl">Harga Jual</label><input type="number" class="fc" name="unit_price" min="0" step="100" value="' + (data.price_retail || 0) + '"></div>'
      + '<div><label class="fl">Harga Grosir</label><input type="number" class="fc" name="unit_wholesale" min="0" step="100" value="' + (data.price_wholesale || 0) + '"></div>'
      + '<div><label class="fl">Min. Grosir</label><input type="number" class="fc" name="unit_wholesale_min" min="0" step="1" value="' + (data.wholesale_min_qty || 0) + '"></div>'
      + '<div><button type="button" class="btn btn-g btn-sm" onclick="this.closest(\'.pos-unit-row\').remove()"><i class="bi bi-x-lg"></i></button></div>';
    return div;
  }

  function addUnitRow(u) {
    document.getElementById('unitRows').appendChild(unitRow(u));
  }

  /* ── Modal produk: mode baru atau edit ── */
  function openItemModal(id) {
    const wrap = document.getElementById('unitRows');
    wrap.innerHTML = '';

    if (!id) {
      document.getElementById('itemTitle').textContent = 'Produk Baru';
      document.getElementById('itemId').value = '';
      document.getElementById('itemName').value = '';
      document.getElementById('itemSku').value = '';
      document.getElementById('itemCategory').value = '';
      document.getElementById('itemUnit').value = 'pcs';
      document.getElementById('itemCost').value = 0;
      document.getElementById('itemPrice').value = 0;
      document.getElementById('itemStock').value = 0;
      document.getElementById('itemMinStock').value = <%= settings.default_min_stock || 5 %>;
      document.getElementById('itemExpiry').value = '';
      document.getElementById('stockField').style.display = 'block';
      addUnitRow({ unit_name: 'pcs', conversion_factor: 1, price_retail: 0 });
    } else {
      const p = PRODUCTS.find(function (x) { return String(x.id) === String(id); });
      if (!p) return;
      document.getElementById('itemTitle').textContent = 'Edit Produk';
      document.getElementById('itemId').value = p.id;
      document.getElementById('itemName').value = p.name || '';
      document.getElementById('itemSku').value = p.sku || '';
      document.getElementById('itemCategory').value = p.category_id || '';
      document.getElementById('itemUnit').value = p.unit || 'pcs';
      document.getElementById('itemCost').value = p.cost_price || 0;
      document.getElementById('itemPrice').value = p.price_retail || 0;
      document.getElementById('itemMinStock').value = p.min_stock || 0;
      document.getElementById('itemExpiry').value = p.expiry_date || '';
      document.getElementById('stockField').style.display = 'none';
      (p.units || []).forEach(function (u) { addUnitRow(u); });
      if (!(p.units || []).length) addUnitRow({ unit_name: p.unit || 'pcs', conversion_factor: 1, price_retail: p.price_retail || 0 });
    }
    openModal('itemModal');
  }

  function openStockModal(id, name, stock) {
    document.getElementById('stockProductId').value = id;
    document.getElementById('stockProductName').textContent = name + '  (stok saat ini: ' + stock + ')';
    openModal('stockModal');
  }
</script>
</body>
</html>
