<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Struk Thermal #INV-<%= String(invoice.id).padStart(4, '0') %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Courier New', Courier, monospace, 'Lucida Console', sans-serif;
      font-size: 12px;
      line-height: 1.35;
      color: #000;
      background: #e2e8f0;
      padding: 15px 10px;
    }
    .ticket {
      width: 58mm;
      max-width: 100%;
      margin: 0 auto;
      background: #ffffff;
      padding: 10px 8px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.15);
      border-radius: 4px;
    }
    .text-center { text-align: center; }
    .text-end { text-align: right; }
    .fw-bold { font-weight: bold; }
    .title { font-size: 13px; font-weight: bold; text-transform: uppercase; margin-bottom: 2px; }
    .subtitle { font-size: 10px; margin-bottom: 4px; color: #222; }
    .divider { border-top: 1px dashed #000; margin: 6px 0; }
    .row-item { display: flex; justify-content: space-between; margin-bottom: 3px; font-size: 11px; }
    .row-item .label { color: #333; }
    .row-item .val { font-weight: bold; text-align: right; word-break: break-word; }
    .total-box {
      border: 1px dashed #000;
      padding: 6px;
      margin: 8px 0;
      text-align: center;
    }
    .total-amount { font-size: 15px; font-weight: bold; margin-top: 2px; }
    .badge-status {
      display: inline-block;
      padding: 2px 8px;
      font-weight: bold;
      font-size: 12px;
      border: 1px solid #000;
      margin-top: 4px;
      background: #f8fafc;
    }
    .no-print {
      margin-top: 16px;
      text-align: center;
      display: flex;
      gap: 8px;
      justify-content: center;
    }
    .btn-print {
      background: linear-gradient(135deg, #22d3ee, #06b6d4);
      color: #062c2a;
      border: none;
      padding: 10px 16px;
      border-radius: 10px;
      font-weight: bold;
      cursor: pointer;
      font-size: 12px;
      box-shadow: 0 4px 12px rgba(34, 211, 238, 0.25);
      transition: all 0.22s ease;
    }
    .btn-print:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(34, 211, 238, 0.35);
      filter: brightness(1.05);
    }
    .btn-close {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(127, 29, 29, 0.1));
      color: #fecaca;
      border: 1px solid rgba(248, 113, 113, 0.45);
      padding: 10px 16px;
      border-radius: 10px;
      font-weight: bold;
      cursor: pointer;
      font-size: 12px;
      transition: all 0.22s ease;
    }
    .btn-close:hover {
      background: linear-gradient(135deg, rgba(239, 68, 68, 0.25), rgba(127, 29, 29, 0.15));
      color: #fff;
    }
    @media print {
      @page {
        size: 58mm auto;
        margin: 0;
      }
      body {
        width: 58mm;
        padding: 0;
        margin: 0;
        background: #fff;
      }
      .ticket {
        width: 100%;
        padding: 4px;
        box-shadow: none;
        border-radius: 0;
      }
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
<body>
  <div class="ticket">
    <div class="text-center">
      <div class="title"><%= settings.company_name || company || 'INTERNET SERVICE' %></div>
      <div class="subtitle"><%= settings.company_address || 'Layanan Internet Terpercaya' %></div>
      <% if (settings.company_phone) { %>
        <div class="subtitle">Telp/WA: <%= settings.company_phone %></div>
      <% } %>
    </div>

    <div class="divider"></div>

    <div class="text-center fw-bold" style="font-size: 11px; margin: 4px 0;">STRUK BUKTI PEMBAYARAN</div>

    <div class="divider"></div>

    <div class="row-item"><span class="label">No. Faktur:</span><span class="val">#INV-<%= String(invoice.id).padStart(4, '0') %></span></div>
    <div class="row-item"><span class="label">Waktu:</span><span class="val"><%= formatDateLocal(getNowLocal()) %></span></div>
    <div class="row-item"><span class="label">Kolektor:</span><span class="val"><%= collectorName %></span></div>

    <div class="divider"></div>

    <div class="row-item"><span class="label">ID Pelg:</span><span class="val">#<%= customer.id %></span></div>
    <div class="row-item"><span class="label">Nama:</span><span class="val"><%= customer.name %></span></div>
    <% if (customer.phone) { %>
      <div class="row-item"><span class="label">No. HP:</span><span class="val"><%= customer.phone %></span></div>
    <% } %>
    <div class="row-item"><span class="label">Paket:</span><span class="val"><%= invoice.package_name || customer.package_name || 'Internet' %></span></div>
    <div class="row-item"><span class="label">Periode:</span><span class="val"><%= invoice.period_month %>/<%= invoice.period_year %></span></div>

    <div class="divider"></div>

    <div class="total-box">
      <div style="font-size: 10px;">TOTAL PEMBAYARAN</div>
      <% const amt = invoice.amount != null ? invoice.amount : (customer.package_price != null ? customer.package_price : 0); %>
      <div class="total-amount">Rp <%= parseInt(amt || 0).toLocaleString('id-ID') %></div>
      <div class="badge-status">*** LUNAS ***</div>
    </div>

    <div class="text-center subtitle" style="margin-top: 8px;">
      Simpan struk ini sebagai<br>bukti pembayaran sah.<br>
      <strong>Terima Kasih!</strong>
    </div>

    <div class="no-print">
      <button class="btn-print" onclick="window.print()">🖨️ Pilih Printer & Cetak</button>
      <button class="btn-close" onclick="window.close()">❌ Tutup</button>
    </div>
  </div>

  <script>
    // Otomatis buka dialog pemilih printer saat halaman dimuat
    window.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        window.print();
      }, 350);
    });
  </script>
</body>
</html>
