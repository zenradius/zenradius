<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> | <%= company %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    *{box-sizing:border-box} html,body{height:100%}
    body{background:#173945;background-image:radial-gradient(circle at 8% 0%,#236060 0%,transparent 34%),radial-gradient(circle at 100% 100%,#173e4d 0%,transparent 42%),linear-gradient(135deg,#173740 0%,#183f51 52%,#194251 100%);color:#edf7f5;font-family:'DM Sans',sans-serif;min-height:100vh;min-height:100dvh;padding:24px;display:flex;align-items:center;justify-content:center}
    .card{background:#173945;border:1px solid rgba(190,239,255,.28);border-radius:16px;box-shadow:0 20px 48px rgba(3,14,20,.45);display:flex;flex-direction:column;align-items:center;padding:32px 28px}
    .card form{width:100%;max-width:320px;display:flex;flex-direction:column;align-items:stretch}
    .card .form-label{font-size:11px;letter-spacing:.06em;text-transform:uppercase}
    .form-control{background:rgba(255,255,255,.06);border:1px solid rgba(190,239,255,.22);color:#f0fdfa;border-radius:10px;padding:12px 14px 12px 40px;font-size:14px}
    .form-control::placeholder{color:rgba(237,250,250,.38)}
    .form-control:focus{background:rgba(255,255,255,.09);box-shadow:0 0 0 3px rgba(45,212,191,.14);border-color:rgba(45,212,191,.55);color:#fff}
    .btn-primary{background:linear-gradient(135deg,#236060 0%,#183f51 52%,#194251 100%);border:1px solid rgba(126,231,219,.48);color:#f4fffd;font-weight:800;min-width:160px;max-width:220px;margin:10px auto 0;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 22px;border-radius:10px;box-shadow:0 8px 20px rgba(10,41,50,.24)}
    .btn-primary:hover{background:linear-gradient(135deg,#2d7774 0%,#1d5264 52%,#205b68 100%)!important;border-color:rgba(166,247,235,.72)!important;color:#fff!important}
    .collector-logo{display:block;width:210px;max-width:80%;height:auto;margin:0 auto 16px}
    .collector-copy{color:rgba(237,250,250,.7);font-size:12px;line-height:1.55;margin:8px auto 22px;max-width:310px}
    .collector-footer{margin-top:22px;padding-top:14px;border-top:1px solid rgba(124,221,218,.15);color:rgba(237,250,250,.56);font-size:11px;text-align:center}
    .card .form-label{color:#d9fffb;font-weight:700}
    
    /* Eye Toggle Button */
    .password-field-wrapper {
      position: relative;
    }
    
    .password-field-wrapper .eye-toggle {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: rgba(190, 239, 255, 0.72);
      cursor: pointer;
      padding: 0;
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      transition: all 0.2s ease;
      border-radius: 6px;
      z-index: 10;
      box-shadow: none;
    }
    
    .password-field-wrapper .eye-toggle:hover {
      color: rgba(45, 212, 191, 0.95);
      background: transparent;
      border: none;
      box-shadow: none;
    }
    
    .password-field-wrapper .eye-toggle:active {
      transform: translateY(-50%) scale(0.96);
    }
    
    .password-field-wrapper .form-control.with-eye {
      padding-right: 42px;
    }
  </style>
</head>
<body>
  <div class="container" style="max-width:420px;padding-top:60px">
    <div class="mb-3 text-center">
      <img class="collector-logo" src="/img/logo.png?v=zenradius" alt="ZenRadius" onerror="this.src='/img/icon.png'">
      <div style="font-weight:800;letter-spacing:-.02em">Pusat Operasional Kolektor</div>
      <div class="collector-copy">Kelola penagihan dan pencatatan pembayaran pelanggan secara teratur dan efisien.</div>
    </div>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <div class="card p-3">
      <form method="POST" action="/collector/login">
        <div class="mb-3">
          <label class="form-label">Username</label>
          <input class="form-control" name="username" autocomplete="username" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <div class="password-field-wrapper">
            <input type="password" id="collector-password" class="form-control" name="password" autocomplete="current-password" required>
            <button type="button" class="eye-toggle" data-target="collector-password" title="Tampilkan/Sembunyikan password">
              <i class="bi bi-eye"></i>
            </button>
          </div>
        </div>
        <button class="btn btn-primary w-100" type="submit">Masuk</button>
      </form>
      <div style="margin-top: 16px; margin-bottom: 8px;">
        <button type="button" id="btn-install-pwa" class="btn btn-sm d-inline-flex align-items-center gap-2 px-3 py-2 fw-bold text-center" style="background: rgba(45, 212, 191, 0.08); border: 1px solid rgba(126, 231, 219, 0.38); color: #d9fffb; border-radius: 9px; font-size: 12px; transition: all 0.25s;" onmouseover="this.style.background='rgba(45, 212, 191, 0.16)'" onmouseout="this.style.background='rgba(45, 212, 191, 0.08)'">
          <i class="bi bi-download"></i> Aplikasi Kolektor
        </button>
      </div>

      <div class="collector-footer">&copy; <%= new Date().getFullYear() %> <%- footerInfo %></div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Eye Toggle Functionality
    function togglePasswordVisibility(button) {
      const targetId = button.getAttribute('data-target');
      const passwordInput = document.getElementById(targetId);
      const isPassword = passwordInput.type === 'password';
      
      if (isPassword) {
        passwordInput.type = 'text';
        button.classList.add('visible');
        button.innerHTML = '<i class="bi bi-eye-slash"></i>';
      } else {
        passwordInput.type = 'password';
        button.classList.remove('visible');
        button.innerHTML = '<i class="bi bi-eye"></i>';
      }
    }

    // Initialize eye toggle buttons
    document.querySelectorAll('.eye-toggle').forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        togglePasswordVisibility(button);
      });
    });

    // Add "with-eye" class to password inputs for proper spacing
    document.querySelectorAll('.eye-toggle').forEach(button => {
      const targetId = button.getAttribute('data-target');
      const input = document.getElementById(targetId);
      if (input) {
        input.classList.add('with-eye');
      }
    });

    let deferredPwaPrompt = null;
    window.addEventListener('beforeinstallprompt', e => { 
      e.preventDefault(); 
      deferredPwaPrompt = e; 
    });

    document.getElementById('btn-install-pwa')?.addEventListener('click', () => {
      if (deferredPwaPrompt) {
        deferredPwaPrompt.prompt();
        deferredPwaPrompt.userChoice.then(() => {
          deferredPwaPrompt = null;
        });
      }
    });
  </script>
</body>
</html>

