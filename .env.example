# ZenRadius — Contoh Konfigurasi Environment
# Salin berkas ini menjadi .env lalu sesuaikan nilainya sebelum menjalankan aplikasi.
#   cp .env.example .env

# Port yang dipakai aplikasi (harus sama dengan yang diarahkan Nginx/Cloudflare Tunnel)
PORT=3001

# Mode environment: development | production
NODE_ENV=production

# Kredensial admin utama (master admin) — SEGERA ganti dari nilai default ini
MASTER_ADMIN_USERNAME=zenradius
MASTER_ADMIN_PASSWORD=zenradius123

# Secret session Express — WAJIB diisi nilai unik & acak di production
# (aplikasi akan menolak start di NODE_ENV=production jika ini kosong/placeholder)
SESSION_SECRET=ganti-dengan-string-acak-panjang-dan-rahasia

# Secret untuk verifikasi webhook pembayaran (QRIS/VA)
MY_WEBHOOK_SECRET=ganti-dengan-secret-anda-sendiri
