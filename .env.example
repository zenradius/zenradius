# ZenRadius — Contoh Konfigurasi Environment
# Salin berkas ini menjadi .env sebelum menjalankan aplikasi:
#   cp .env.example .env

# Port aplikasi (harus sama dengan port yang diarahkan Nginx/Cloudflare Tunnel)
PORT=3001

# Mode environment: development | production
NODE_ENV=production

# Login admin default untuk instalasi pertama kali (bootstrap).
# Kredensial ini otomatis NONAKTIF setelah Anda mengisi Username/Password Admin
# di menu Pengaturan > Kredensial Admin pada panel.
MASTER_ADMIN_USERNAME=zenradius
MASTER_ADMIN_PASSWORD=zenradius123

# Secret session Express — wajib diisi nilai unik & acak sebelum production.
# Aplikasi akan menolak start di NODE_ENV=production jika nilai ini kosong
# atau masih placeholder.
SESSION_SECRET=ganti-dengan-string-acak-panjang-dan-rahasia

# Secret untuk verifikasi webhook pembayaran (QRIS/VA)
MY_WEBHOOK_SECRET=ganti-dengan-secret-anda-sendiri

# Kunci enkripsi field sensitif di settings.json (wajib di production).
# install.sh mengisi otomatis jika masih kosong/placeholder. JANGAN diubah
# setelah ada data terenkripsi, karena data lama tidak bisa didekripsi.
SETTINGS_MASTER_KEY=ganti-dengan-string-acak-panjang-dan-rahasia
