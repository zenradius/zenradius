# ZenRadius — Konfigurasi Environment
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# Login Admin Bootstrap
MASTER_ADMIN_USERNAME=zenradius
MASTER_ADMIN_PASSWORD=zenradius123

# Rahasia Sistem (Wajib Unik & Acak)
SESSION_SECRET=ganti-dengan-string-acak-panjang-dan-rahasia
SETTINGS_MASTER_KEY=ganti-dengan-string-acak-panjang-dan-rahasia

# Webhook Pembayaran
MY_WEBHOOK_SECRET=ganti-dengan-secret-anda-sendiri

# GenieACS eksternal (opsional; kosongkan jika memakai Built-in ACS)
GENIEACS_URL=
GENIEACS_USERNAME=
GENIEACS_PASSWORD=

# Path Data (Opsional)
ZENRADIUS_DB_PATH=
ZENRADIUS_SETTINGS_PATH=

# Lisensi & Status
ZENRADIUS_HEARTBEAT=on
# Hanya untuk development lokal; tetap 0 pada production (localhost tetap wajib lisensi)
ZENRADIUS_DEV_LICENSE=0
LICENSE_ACCEPT_LEGACY=on
HEALTH_CHECK_URL=http://127.0.0.1:3001/health